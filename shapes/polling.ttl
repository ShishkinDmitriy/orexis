@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rules for perception. The shapes below target ONLY agents that HAVE the capability, and
# capability is derived from hardware (rules/polling.ru) — so what an agent is required to
# believe follows from what it is wired to. An agent on a pull-mode sensor must state a
# cadence; an agent on a push-mode one must not be asked for one, because it has no way to
# apply it. Same ontology, different obligations, decided by the device.

ag:PollingAgentShape a sh:NodeShape ;
    rdfs:comment "An agent that DRIVES its sensors must be wired to one, and must hold the numbers that set its attention. The cadence bounds are the constitutional ones from ontology/polling.ttl." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:prefixes ag: ;
        sh:select """
            SELECT ?this WHERE { ?this <http://example.org/agora#hasCapability>
                                       <http://example.org/agora#Polling> }
        """ ] ;

    sh:property [ sh:path ag:polls ; sh:minCount 1 ; sh:class ag:Sensor ;
                  sh:message "an agent that polls must be wired to at least one sensor" ] ;

    # "fast" must not be slower than "slow", or the policy is inverted: it would watch LESS
    # closely exactly when it is in trouble.
    sh:property [ sh:path ag:fastSleepS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minInclusive 10 ; sh:maxInclusive 900 ;
                  sh:lessThanOrEquals ag:slowSleepS ;
                  sh:message "fast cadence must be within the constitutional bounds and no slower than the slow one" ] ;
    sh:property [ sh:path ag:slowSleepS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minInclusive 10 ; sh:maxInclusive 900 ;
                  sh:message "no agent may sleep past the constitutional ceiling — autonomy over attention, never the freedom to sleep through a drought" ] ;
    sh:property [ sh:path ag:maxReadingAgeS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minExclusive 0 ;
                  sh:message "an agent that polls must say how stale a reading may be before it stops trusting it" ] .

ag:SensorShape a sh:NodeShape ;
    rdfs:comment "A sensor reads exactly one subject, says which property it observes, and states where it publishes and where it listens." ;
    sh:targetClass ag:Sensor ;
    sh:property [ sh:path ag:monitors ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path sosa:observes ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ag:readingTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "a sensor must state where it publishes; nothing derives a topic from a name" ] ;
    sh:property [ sh:path ag:senseMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ag:SenseMode ;
                  sh:message "a sensor must say how it is driven — its agent's capability follows from it" ] .

ag:ObservationShape a sh:NodeShape ;
    rdfs:comment "Every observation is a complete, authored, versioned MEASUREMENT — and carries the time it was taken, which is what the freshness rule checks. No band: the verdict is each agent's own and is never recorded." ;
    sh:targetClass sosa:Observation ;
    sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path sosa:observedProperty ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path sosa:hasSimpleResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path sosa:resultTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path sosa:madeBySensor ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ag:underWorldVersion ; sh:minCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "every reading carries an author" ] .


ag:ListeningAgentShape a sh:NodeShape ;
    rdfs:comment "An agent that only RECEIVES readings still decides how stale a reading may be before it stops trusting it — that judgment is about belief, not control, and survives the loss of the cadence. It is deliberately NOT asked for fastSleepS/slowSleepS: requiring a policy it cannot enforce would be theatre." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this <http://example.org/agora#hasCapability>
                                       <http://example.org/agora#Listening> }
        """ ] ;
    sh:property [ sh:path ag:polls ; sh:minCount 1 ; sh:class ag:Sensor ] ;
    sh:property [ sh:path ag:maxReadingAgeS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path ag:fastSleepS ; sh:maxCount 0 ;
                  sh:message "a listening agent cannot set a cadence — its sensor does not take one" ] .

ag:PullSensorShape a sh:NodeShape ;
    rdfs:comment "Only a pull-mode sensor has a command channel; that is what makes it drivable. A push-mode board takes no orders, and stating one for it would be a lie about the hardware." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this <http://example.org/agora#senseMode>
                                       <http://example.org/agora#Pull> }
        """ ] ;
    sh:property [ sh:path ag:commandTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "a pull-mode sensor must state where it takes its cadence" ] .
