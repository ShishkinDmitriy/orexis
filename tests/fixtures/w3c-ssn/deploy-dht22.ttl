# OURS, not theirs — the deployment half of `dht22.ttl`.
#
# Their file describes a PART: what a DHT22 is, what its two channels can do, and how accurate
# they are under stated conditions. None of it mentions this society, and it could not: a vendor
# cannot know that you drive the board on a schedule, that it watches your fern, or which topic
# it publishes on. That is the part/deployment boundary, and this file is the deployment side of
# it — everything their description is missing and everything it is right to be missing.
#
# Nothing here restates a fact their file already carries. The frequency floor, the accuracy, the
# operating range and the sub-system structure all come from them, untouched.

@prefix ag:         <http://example.org/orexis#> .
# The subject is the SITE's — a deployment file is our half, and the world owns
# its individuals, so the pot is named in the world's namespace, not the vocabulary's.
@prefix world:      <http://example.org/orexis/world/sensing#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix mqtt:       <http://example.org/orexis/mqtt#> .
@prefix scaling:    <http://example.org/orexis/scaling#> .
@prefix water:      <http://example.org/orexis/water#> .
@prefix unit:       <http://qudt.org/vocab/unit/> .
@prefix sosa:       <http://www.w3.org/ns/sosa/> .
@prefix dht22:      <http://example.org/data/DHT22/4578#> .

# Their two channels, deployed. `ag:Device` is ours and is the conjunct that carries a name on
# our wire — see the audit in capabilities/sensing/ontology.ttl for why that class survives
# where `sensing:Sensor` did not.
# No senseMode on either channel since #96: the clock is the BOARD's — the device whose wire
# these channels ride states it once, and a channel claiming its own would now be refused. A
# deployment overlay says what the channel watches and where it speaks; who holds the clock was
# never a per-channel fact to say.
dht22:TemperatureSensor a ag:Device ;
    ag:localId "vendor_air_temp" ;
    sensing:monitors world:fern ;
    sosa:observes water:AirTemperature ;
    scaling:quantityUnit unit:DEG_C ;
    mqtt:readingTopic "sensors/moisture_sensor_fern/reading" ;
    mqtt:readingPointer "/temperature" ;
    mqtt:commandTopic "sensors/moisture_sensor_fern/command" .

dht22:HumiditySensor a ag:Device ;
    ag:localId "vendor_air_humidity" ;
    sensing:monitors world:fern ;
    sosa:observes water:AirHumidity ;
    scaling:quantityUnit unit:UNITLESS ;
    mqtt:readingTopic "sensors/moisture_sensor_fern/reading" ;
    mqtt:readingPointer "/humidity" ;
    mqtt:commandTopic "sensors/moisture_sensor_fern/command" .
