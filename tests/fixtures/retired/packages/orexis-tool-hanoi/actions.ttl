@prefix hanoi: <http://example.org/orexis/hanoi#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#  ONE move — the sovereign's ruling, striking the six-node grid the first build shipped.
#  The affordance ROW was always the ground instance: one row per (disk, target) the state
#  makes legal. What made a grid look necessary was that an effect could not see which row was
#  chosen; a channel for ONE parameter closed that, and the schema went back to being one node,
#  which is what an action is. The move needs TWO, and said so in the kernel's words for a
#  while — the disk was a lever and the peg was what the move was about, neither of which it is.
#  It declares them itself now.

hanoi:Move a orexis:Action ;
    rdfs:label "move a movable disk onto a legal peg" ;
    orexis:takes hanoi:disk, hanoi:onto ;
    rdfs:comment "Available once per (disk, target) the state allows: the disk is on top of its stack, and the target holds no smaller disk — bigger or empty, in the sovereign's words. The effect is deterministic because the row pins both parameters: $disk and $onto." ;
    orexis:available """
        SELECT ?disk ?onto WHERE {
             ?disk hanoi:on ?below .
                           FILTER NOT EXISTS { ?x hanoi:on ?disk } 
            ?disk hanoi:size ?ds .
            ?onto a hanoi:Peg .
            FILTER NOT EXISTS {  ?disk (hanoi:on)+ ?onto . }
            FILTER NOT EXISTS {
                 ?s (hanoi:on)+ ?onto .
                ?s hanoi:size ?ss . FILTER(?ss < ?ds) }
        }""" ;
    orexis:costs """
        SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    orexis:retracts """
        CONSTRUCT { $disk hanoi:on ?old } WHERE {
             $disk hanoi:on ?old . }""" ;
    sh:construct """
        CONSTRUCT { $disk hanoi:on ?dest } WHERE {
            OPTIONAL {  ?t (hanoi:on)+ $onto .
                                      FILTER NOT EXISTS { ?z hanoi:on ?t }  }
            BIND(COALESCE(?t, $onto) AS ?dest)
        }""" .
