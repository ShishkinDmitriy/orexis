@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix orexis:   <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dht11: <http://example.org/orexis/dht11#> .
@prefix onewire: <http://example.org/orexis/onewire#> .
@prefix mc: <http://example.org/orexis/microcontroller#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

orexis:Dht11Shape a sh:NodeShape ;
    rdfs:comment "Three legs, and all three named. A DHT that states only its data line was the old model's best effort — there was nowhere to put the other two — and it is precisely the missing ones that go wrong: a floating ground answers with silence, and the wrong rail idles the data line above what the input tolerates. The generic rules in the microcontroller vocabulary then apply to each leg on its own: the data line must reach a pin that can be driven, every leg must reach something, and the rail must match the board." ;
    sh:targetClass dht11:Dht11 ;
    sh:property [ sh:path mc:hasPin ; sh:minCount 3 ; sh:class mc:Pin ;
                  sh:message "a DHT11 has three legs: data, power and ground" ] ;
    sh:property [ sh:path ( mc:hasPin mc:pinRole ) ; sh:minCount 1 ;
                  sh:hasValue onewire:DataPinRole ;
                  sh:message "a DHT11 talks on one wire — one leg must be onewire:DataPinRole" ] ;
    sh:property [ sh:path ( mc:hasPin mc:pinRole ) ; sh:hasValue mc:PowerPinRole ;
                  sh:message "a DHT11 must say which leg is its power, because the rail it is on decides its logic level" ] ;
    sh:property [ sh:path ( mc:hasPin mc:pinRole ) ; sh:hasValue mc:GroundPinRole ;
                  sh:message "a DHT11 must say which leg is its ground — a floating ground is the commonest reason one answers with silence, and it looks exactly like a dead part" ] .

# The structure the ontology DESCRIBES, and this is what enforces it.
#
# `owl:someValuesFrom` says every DHT11 has a temperature channel and a humidity channel. Nothing
# materialises that — an existential would have to invent an individual per unit, which
# `agent/inference.py` deliberately does not do — so on its own it is a claim no gate would ever
# test. Here it becomes refusable: a world that names a DHT11 and forgets to say which of its
# sensors is the thermistor fails validation instead of quietly entailing nothing.
#
# `sh:qualifiedValueShape` rather than `sh:class` on the path, because the requirement is ONE OF
# EACH and not two of something: a part with two thermistors and no humidity element would satisfy
# a plain `sh:class dht11:TemperatureSensor ; sh:minCount 2`.
orexis:Dht11StructureShape a sh:NodeShape ;
    rdfs:comment "A DHT11 is two sensors in one package, and a world that names one owes both. The reason to refuse the omission rather than tolerate it: the channel type is what carries the accuracy, the resolution and the procedure each half implements, so a channel left untyped is a device the vocabulary describes and the graph does not — the exact shape of gap that entails nothing and fails nothing. See knowledge/decisions/a-part-is-described-once-and-fitted-many-times.md." ;
    sh:targetClass dht11:Dht11 ;
    sh:property [ sh:path ssn:hasSubSystem ;
                  sh:qualifiedValueShape [ sh:class dht11:TemperatureSensor ] ;
                  sh:qualifiedMinCount 1 ;
                  sh:message "a DHT11 has a temperature channel — say which of its sensors it is, with dht11:TemperatureSensor" ] ;
    sh:property [ sh:path ssn:hasSubSystem ;
                  sh:qualifiedValueShape [ sh:class dht11:HumiditySensor ] ;
                  sh:qualifiedMinCount 1 ;
                  sh:message "a DHT11 has a humidity channel — say which of its sensors it is, with dht11:HumiditySensor" ] .
