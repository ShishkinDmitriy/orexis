.env
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# firmware (PlatformIO build output + WiFi secrets)
.pio/
firmware/**/include/config.h

# a world's signing keys, and now each agent's credentials for the series store and the bus —
# never commit secrets. Per world, because two worlds are two societies and must not be able
# to sign for each other, nor read each other's history.
world/*/secrets/
# generated by orexis-keygen: PUBLIC key roster, but machine-generated and machine-specific —
# regenerating keys rewrites it, and committing one machine's would attest another's identities
world/*/keys.ttl

# the admin token: it opens every bucket, so it is the one thing no agent may hold. Read by
# the infra containers and by `orexis-influx` / `orexis-mqtt`. Template: infra/admin.env.example
infra/secrets/

# generated by `orexis-mqtt` from every world's wiring — regenerate, never hand-edit. The
# password file holds credential hashes; the ACL and the broker config are derived, and a
# hand-edit would be a second list. A broker per world means these live with the world.
#
# BOTH FORMS, and the second is the one that matters. A trailing-slash pattern matches a
# DIRECTORY, and git prunes an ignored directory only while nothing in it is tracked. Three
# generated files under `world/sensing/mosquitto/` were committed by the same change that
# added the rule below, so that directory could never be pruned — git descended into it, the
# directory pattern matched none of the FILES inside, and every later `git add -A` swept up a
# freshly salted password file without a murmur. Seven versions reached main that way.
# See knowledge/decisions/a-generated-credential-is-not-a-file-we-keep.md.
world/*/mosquitto/
world/*/mosquitto/**
# GENERATED by `orexis-firmware` and carries a board's password. Listed twice, once per shape,
# for the same reason — and the line between them used to be a sentence that had lost its `#`,
# so git read `firmware/*/include/config.h — both covered above.` as a pattern matching nothing.
firmware/**/include/config.h
firmware/*/include/config.h
# same again for the dashboard's server certificate
infra/grafana/certs/
# generated per world by `orexis-dashboards`
infra/grafana/dashboards/

# agent worktrees — a live checkout of this repo inside itself
.claude/worktrees/

# What WireViz renders from world/<w>/wiring.yaml. The YAML is committed because it is
# the thing that DIFFS — a changed wire is one changed line in a pull request — and a
# rendered graph layout diffs as noise. Regenerate with `wireviz world/<w>/wiring.yaml`.
world/*/wiring.svg
world/*/wiring.png
world/*/wiring.html
world/*/wiring.bom.tsv
# what a road case's store actually held when its snapshot disagreed — for `diff`, never committed
*.actual.trig
