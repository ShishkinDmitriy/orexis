.env
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# firmware (PlatformIO build output + WiFi secrets)
.pio/
firmware/**/include/config.h

# a world's signing keys, and now each agent's credentials for the series store and the bus —
# never commit secrets. Per world, because two worlds are two societies and must not be able
# to sign for each other, nor read each other's history.
world/*/secrets/

# the admin token: it opens every bucket, so it is the one thing no agent may hold. Read by
# the infra containers and by `agora-influx` / `agora-mqtt`. Template: infra/admin.env.example
infra/secrets/

# generated by `agora-mqtt` from every world's wiring — regenerate, never hand-edit. The
# password file holds hashes; the ACL is derived, and a hand-edit would be a second list.
# a broker per world means its generated files live with the world, under world/*/secrets/
# and world/*/mosquitto/
# GENERATED by `agora-firmware` and carries a board's password
firmware/*/include/config.h — both covered above.
world/*/mosquitto/
# GENERATED by `agora-firmware` and carries a board's password
firmware/*/include/config.h
# same again for the dashboard's server certificate
infra/grafana/certs/
# generated per world by `agora-dashboards`
infra/grafana/dashboards/*/

# agent worktrees — a live checkout of this repo inside itself
.claude/worktrees/

# What WireViz renders from world/<w>/wiring.yaml. The YAML is committed because it is
# the thing that DIFFS — a changed wire is one changed line in a pull request — and a
# rendered graph layout diffs as noise. Regenerate with `wireviz world/<w>/wiring.yaml`.
world/*/wiring.svg
world/*/wiring.png
world/*/wiring.html
world/*/wiring.bom.tsv
