# a_cluster_a_standing_want_is_about_is_not_minted_again
#
# A CLUSTER A STANDING WANT IS ALREADY ABOUT IS THAT WANT'S. The `two_parcels_a_constraint_joins_are_one_want`
# world halfway through its plan: the coupled want about both parcels stands, van A has delivered
# parcel A at `c0_3`, and parcel B is still astray at `c1_1`. The desire now reads unmet for parcel B
# alone, a cluster of one instance under a name of its own — and that cluster is not minted: the
# standing want's met-test targets parcel B already, so the cluster is its, and it is kept under the
# name it has. Minted, it was a second want about an instance the coupled want still pursued, and a
# second plan drove van B down the same cells, measured on the dispatcher the day the courier's drives
# took time to land and the walk first spanned passes (#901). Nothing here walks the want: the rule is
# the derivation's and asks nothing of the intentions.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .


GRAPH :ontology {
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :door_parcel_a courier:x 0 .
  :door_parcel_a courier:y 3 .
  :door_parcel_b courier:x 1 .
  :door_parcel_b courier:y 3 .
  :keeper a orexis:Agent .
  :parcel_a a courier:Parcel .
  :parcel_a courier:destination :door_parcel_a .
  :parcel_b a courier:Parcel .
  :parcel_b courier:destination :door_parcel_b .
  :van_a a courier:Van .
  :van_b a courier:Van .
}

# THE COURIER'S THREE ACTIONS, as `domains/courier/actions.ttl` states them: what the reach is
# closed over, so the constraint is asked which collisions the plans could actually make.
GRAPH :actions {
  courier:Drive a orexis:Action .
  courier:Drive orexis:takes courier:toX .
  courier:Drive orexis:takes courier:toY .
  courier:Drive orexis:takes courier:van .
  courier:Drive planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $van courier:x ?x ; courier:y ?y }
      INSERT { $van courier:x $toX ; courier:y $toY }
      WHERE  { $van courier:x ?x ; courier:y ?y }""" ] ] .
  courier:Drive planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?van ?toX ?toY WHERE {
          ?van courier:x ?x ; courier:y ?y .
          ?van a courier:Van .
          VALUES (?dx ?dy) { (1 0) (-1 0) (0 1) (0 -1) }
          BIND(?x + ?dx AS ?toX)
          BIND(?y + ?dy AS ?toY)
      }""" .
  courier:Drop a orexis:Action .
  courier:Drop orexis:takes courier:parcel .
  courier:Drop planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $parcel courier:carriedBy ?van }
      INSERT { $parcel courier:x ?x ; courier:y ?y }
      WHERE  { $parcel courier:carriedBy ?van . ?van courier:x ?x ; courier:y ?y }""" ] ] .
  courier:Drop planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?parcel WHERE {
          ?parcel courier:carriedBy ?van .
          ?parcel a courier:Parcel .
      }""" .
  courier:Pick a orexis:Action .
  courier:Pick orexis:takes courier:parcel .
  courier:Pick orexis:takes courier:van .
  courier:Pick planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $parcel courier:x ?x ; courier:y ?y }
      INSERT { $parcel courier:carriedBy $van }
      WHERE  { $parcel courier:x ?x ; courier:y ?y }""" ] ] .
  courier:Pick planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?parcel ?van WHERE {
          ?van courier:x ?x ; courier:y ?y . ?parcel courier:x ?x ; courier:y ?y .
          ?parcel a courier:Parcel .
          ?van a courier:Van .
      }""" .
}

GRAPH :desires {
  :delivered a sh:NodeShape .
  :delivered sh:sparql [ a sh:SPARQLConstraint ; planning:about sh:this ; sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT $this WHERE {
          $this courier:destination ?owed .
          ?owed courier:x ?ox ; courier:y ?oy .
          FILTER NOT EXISTS { $this courier:x ?ox ; courier:y ?oy }
      }""" ] .
  :delivered sh:targetClass courier:Parcel .
  :drivesOwed rdfs:label "drives still owed" .
  :drivesOwed sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT (SUM(?d) AS ?estimate) WHERE {
          SELECT ?p (MIN(?dist) AS ?d) WHERE {
              {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:carriedBy ?van . ?van courier:x ?vx ; courier:y ?vy .
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?ox) + ABS(?vy - ?oy) AS ?dist)
              } UNION {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:x ?px ; courier:y ?py .
                  ?v a courier:Van ; courier:x ?vx ; courier:y ?vy .
                  FILTER(?px != ?ox || ?py != ?oy)
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?px) + ABS(?vy - ?py)
                       + ABS(?px - ?ox) + ABS(?py - ?oy) AS ?dist)
              }
          } GROUP BY ?p
      }""" .
  :keeper planning:holds :keeper.every_parcel_delivered .
  :keeper.every_parcel_delivered a planning:Desire .
  :keeper.every_parcel_delivered planning:estimates :drivesOwed .
  :keeper.every_parcel_delivered planning:metWhen :delivered .
  :keeper.every_parcel_delivered rdfs:label "every parcel where it is owed" .
}

# THE WORLD'S CONSTRAINT, a `planning:Constraint` and no desire: two vans cannot share a cell. What
# coupled the two parcels into the standing want below, and never minted.
GRAPH :constraints {
  :keeper planning:holds :keeper.no_two_vans_at_one_position .
  :keeper.no_two_vans_at_one_position a planning:Constraint .
  :keeper.no_two_vans_at_one_position planning:unmetWhen :two_vans_at_one_position .
  :keeper.no_two_vans_at_one_position rdfs:label "no two vans stand at one position" .
  :two_vans_at_one_position sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT $this ?value WHERE {
          $this a courier:Van ;
              courier:x ?x ; courier:y ?y .
          ?value a courier:Van ;
              courier:x ?x ; courier:y ?y .
          FILTER(?value != $this)
      }""" .
}

GRAPH :sensed {
  :parcel_a courier:x 0 .
  :parcel_a courier:y 3 .
  :parcel_b courier:x 1 .
  :parcel_b courier:y 1 .
  :van_a courier:x 0 .
  :van_a courier:y 3 .
  :van_b courier:x 1 .
  :van_b courier:y 1 .
}

# THE COUPLED WANT, STANDING: about both parcels, as `two_parcels_a_constraint_joins_are_one_want`
# minted it an hour ago, its met-test targeting each.
GRAPH pursued:keeper.every_parcel_delivered.pursued.parcel_a.parcel_b {
  :keeper planning:holds :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b a planning:Want .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b planning:estimates :drivesOwed .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b planning:metWhen :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b.met .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b planning:state planning:Recognized .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b prov:generatedAtTime "2026-01-01T11:00:00+00:00"^^xsd:dateTime .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b prov:wasDerivedFrom :keeper.every_parcel_delivered .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b rdfs:label "pursued: every parcel where it is owed" .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b.met a sh:NodeShape .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b.met sh:sparql [ a sh:SPARQLConstraint ; planning:about sh:this ; sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT $this WHERE {
          $this courier:destination ?owed .
          ?owed courier:x ?ox ; courier:y ?oy .
          FILTER NOT EXISTS { $this courier:x ?ox ; courier:y ?oy }
      }""" ] .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b.met sh:targetNode :parcel_a .
  :keeper.every_parcel_delivered.pursued.parcel_a.parcel_b.met sh:targetNode :parcel_b .
}

GRAPH :scopes {
  :keeper.scope.1 a planning:Scope .
  :parcel_a planning:inScope :keeper.scope.1 .
  :parcel_b planning:inScope :keeper.scope.1 .
  :van_a planning:inScope :keeper.scope.1 .
  :van_b planning:inScope :keeper.scope.1 .
  courier:Drive planning:inScope :keeper.scope.1 .
  courier:Drop planning:inScope :keeper.scope.1 .
  courier:Pick planning:inScope :keeper.scope.1 .
  courier:carriedBy planning:inScope :keeper.scope.1 .
  courier:x planning:inScope :keeper.scope.1 .
  courier:y planning:inScope :keeper.scope.1 .
}

# What each graph IS, and when it holds — said once each, beside the data.
GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :constraints a orexis:Graph .
  :constraints a planning:ConstraintGraph .
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :scopes a orexis:Graph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:ownedBy :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed orexis:ownedBy :keeper .
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
  pursued:keeper.every_parcel_delivered.pursued.parcel_a.parcel_b a orexis:Graph .
  pursued:keeper.every_parcel_delivered.pursued.parcel_a.parcel_b a planning:WantGraph .
  pursued:keeper.every_parcel_delivered.pursued.parcel_a.parcel_b dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T11:00:00+00:00"^^xsd:dateTime ] .
  pursued:keeper.every_parcel_delivered.pursued.parcel_a.parcel_b orexis:arrivedBy orexis:Derived .
  pursued:keeper.every_parcel_delivered.pursued.parcel_a.parcel_b orexis:ownedBy :keeper .
}
