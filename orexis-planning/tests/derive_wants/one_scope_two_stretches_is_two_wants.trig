# one_scope_two_stretches_is_two_wants
#
# Tank1 in range now, and TWO troubles foreseen at different instants: its level drops at
# 12:30 and its temperature rises at 13:00. One lever moves both, so both predicates are in
# ONE scope — and `two_properties_one_lever` shows that two troubles in one scope at the SAME
# instant are one want, correctly, since one plan repairs both.
#
# THESE ARE NOT ONE WANT. A want's period is the stretch its trouble occupies, and these
# occupy two: a plan for the level is placed to land at 12:30 and a plan for the temperature
# at 13:00, and one want cannot be placed at both. Clustered by scope and instance alone they
# became one want starting at the EARLIER of them, which says the temperature is in trouble
# from 12:30 — it is not — and hides that the two need placing apart.
#
# WORSE WHERE ONE LIFTS. A cluster is open-ended where any of its ways of failing never lifts,
# so a transient dip joined to a standing trouble loses its own end and stands for ever.
#
# So the cluster is keyed by the STRETCH as well: same scope, same instance, different stretch
# is two clusters, two wants, two graphs with a period each.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .
@prefix prediction: <http://example.org/orexis/prediction#> .

GRAPH :ontology {
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :ontology.metadata {
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology.metadata a orexis:MetadataGraph .
  :ontology.metadata orexis:metadataOf :ontology .
}

GRAPH :world {
  :tank1 a :Tank .
}

GRAPH :world.metadata {
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
  :world.metadata a orexis:MetadataGraph .
  :world.metadata orexis:metadataOf :world .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property [ planning:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range sh:property [ planning:about :temperature ; sh:maxInclusive 30 ; sh:path :temperature ] .
  :in_range sh:targetClass :Tank .
  :keeper planning:holds :keeper.in_range .
  :keeper.in_range a planning:Desire .
  :keeper.in_range planning:about :level .
  :keeper.in_range planning:about :temperature .
  :keeper.in_range planning:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
}

GRAPH :desires.metadata {
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :desires.metadata a orexis:MetadataGraph .
  :desires.metadata orexis:metadataOf :desires .
}

GRAPH :sensed {
  :tank1 :level 20 .
  :tank1 :temperature 20 .
}

GRAPH :sensed.metadata {
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed orexis:ownedBy :keeper .
  :sensed.metadata a orexis:MetadataGraph .
  :sensed.metadata orexis:metadataOf :sensed .
}

#  THE LEVEL DROPS AT HALF PAST.
GRAPH :dip {
  :tank1 :level 5 .
}

GRAPH :dip.metadata {
  :dip a orexis:BeliefGraph .
  :dip a orexis:ForecastGraph .
  :dip a orexis:Graph .
  :dip dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T12:30:00Z"^^xsd:dateTime ] .
  :dip orexis:arrivedBy orexis:Recorded .
  :dip orexis:ownedBy :keeper .
  :dip.metadata a orexis:MetadataGraph .
  :dip.metadata orexis:metadataOf :dip .
}

#  AND THE TEMPERATURE RISES AN HOUR IN, which is a different trouble at a different instant.
GRAPH :heat {
  :tank1 :temperature 40 .
}

GRAPH :heat.metadata {
  :heat a orexis:BeliefGraph .
  :heat a orexis:ForecastGraph .
  :heat a orexis:Graph .
  :heat dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T13:00:00Z"^^xsd:dateTime ] .
  :heat orexis:arrivedBy orexis:Recorded .
  :heat orexis:ownedBy :keeper .
  :heat.metadata a orexis:MetadataGraph .
  :heat.metadata orexis:metadataOf :heat .
}

#  ONE LEVER MOVES BOTH, so both predicates are in one scope.
GRAPH :scopes {
  :fix planning:inScope :keeper.scope.1 .
  :keeper.scope.1 a planning:Scope .
  :level planning:inScope :keeper.scope.1 .
  :temperature planning:inScope :keeper.scope.1 .
}

GRAPH :scopes.metadata {
  :scopes a orexis:Graph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:ownedBy :keeper .
  :scopes.metadata a orexis:MetadataGraph .
  :scopes.metadata orexis:metadataOf :scopes .
}

GRAPH :catalogue {
}
