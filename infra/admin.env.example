# The keys to the whole series store. Copy to `infra/secrets/admin.env`, which is gitignored.
#
# Read by exactly three things: the Influx container's first-run setup, Grafana (whose view is
# legitimately cross-agent — it is the operator's, not a member's), and the `agora-influx` /
# `agora-mqtt` provisioning tools, which need admin rights to mint the scoped tokens that
# agents actually run with.
#
# Never mounted into an agent. An agent gets one token, scoped to one bucket, delivered in
# `world/<world>/secrets/influx-<agent>.env`.
#
# The token appears twice on purpose: the first name is what the container's own init script
# reads, the second is what Grafana's datasource template interpolates. One secret, two
# readers that each insist on their own spelling.

DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=admin12345
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=dev-token-change-me

INFLUX_ADMIN_TOKEN=dev-token-change-me

GF_SECURITY_ADMIN_PASSWORD=admin
