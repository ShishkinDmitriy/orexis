# Where the shared series store is, and how to get into it. Read by infra/compose.yaml to
# initialise the containers, and by agents to write their readings — the one thing that is
# still genuinely shared, since the belief base is not.

INFLUX_USER=admin
INFLUX_PASSWORD=admin12345
INFLUX_ORG=agora
INFLUX_BUCKET=sensors
INFLUX_TOKEN=dev-token-change-me
GRAFANA_PASSWORD=admin
INFLUX_URL=http://localhost:8086
