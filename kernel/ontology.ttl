@prefix ag:   <http://example.org/agora#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/agora/core> a owl:Ontology ;
    rdfs:label "Agora core" ;
    rdfs:comment """The society kernel: agents, the capabilities they compose, devices, and the versioned world they share. Everything else is a MODULE layered on this — polling, market, actuation, and the domain itself. Code may reference the terms defined here; it may never reference an instance.""" .

#################  Agents and capabilities (composition, not hierarchy)  #################

ag:Agent a owl:Class ; rdfs:label "Agent" ;
    rdfs:comment "A self-interested principal with a stake. What an agent can DO is not its class — it is the set of capabilities composed onto it, so two agents of the same kind may run different modules." .

ag:Capability a owl:Class ; rdfs:label "Capability" ;
    rdfs:comment "One thing an agent can do, defined by a module: a vocabulary (this ontology), rules (its SHACL shapes), and the code that reads them. Declaring a capability is what activates the module." .

ag:hasCapability a owl:ObjectProperty ; rdfs:domain ag:Agent ; rdfs:range ag:Capability ;
    rdfs:label "has capability" ;
    rdfs:comment "Composed onto the agent in the WORLD graph (public: peers must know what a counterparty can do). The PARAMETERS of a capability are private, in the agent's own beliefs." .

ag:actsFor a owl:ObjectProperty ; rdfs:domain ag:Agent ;
    rdfs:label "acts for" ;
    rdfs:comment "The subject whose interest this agent advances. Generic; a domain narrows the range (in the water domain, a Plant)." .

#################  Devices — dumb mechanism at the edge  #################

ag:Device a owl:Class ; rdfs:label "Device" ;
    rdfs:comment "A physical edge node: mechanism, never policy, and interchangeable with a simulated one." .

#################  The stand — what physically exists, and how it is wired  #################
#
# Here rather than in a capability or a domain because it is the same layer as ag:Device above:
# what EXISTS, independent of what anything can do with it. A capability says an agent can
# perceive; this says there is a probe, on this board, on this pin. A world about anything at
# all has a stand, so it is not domain knowledge either.
#
# It is written down for three reasons: shapes can then refuse a wiring that cannot work (see
# kernel/shapes.ttl), firmware configuration becomes derivable from the world rather than
# hand-kept in a C header, and someone debugging at 2am can ask which pin a probe is on instead
# of remembering.

ag:ComputeHost a owl:Class ; rdfs:subClassOf ag:Device ; rdfs:label "Compute host" ;
    rdfs:comment "A machine that runs agent processes. Named so the world can say where its society actually executes." .

ag:Microcontroller a owl:Class ; rdfs:subClassOf ag:Device ; rdfs:label "Microcontroller" ;
    rdfs:comment "A board at the edge, carrying peripherals and reachable over a bus. It runs firmware, not agents." .

ag:Peripheral a owl:Class ; rdfs:subClassOf ag:Device ; rdfs:label "Peripheral" ;
    rdfs:comment "Something wired to a microcontroller's pins. A sensor is one; so is an indicator." .

ag:model a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "model" ;
    rdfs:comment "What this thing IS, as a human would order it — 'ESP32-WROOM-32D'. Free text on purpose: it identifies hardware to a person, and nothing derives behaviour from it. Behaviour comes from the CLASS." .

ag:runsOn a owl:ObjectProperty ; rdfs:range ag:ComputeHost ; rdfs:label "runs on" ;
    rdfs:comment "Which host executes this agent. Documents why the bus is where it is." .

ag:carries a owl:ObjectProperty ; rdfs:domain ag:Microcontroller ; rdfs:range ag:Peripheral ;
    rdfs:label "carries" ;
    rdfs:comment "A peripheral is wired to this board. The board is what has pins, so the board is what owns the wiring." .

#################  Pins — reified, because a pin assignment has a role  #################
#
# `ag:gpio 25` alone cannot describe an RGB LED: it has three pins and they are not
# interchangeable. So an assignment is a NODE carrying both which line it is and which role it
# plays, and a single-pin device simply has one of them.

ag:PinAssignment a owl:Class ; rdfs:label "Pin assignment" ;
    rdfs:comment "One peripheral leg on one GPIO line, in one role." .

ag:pin a owl:ObjectProperty ; rdfs:domain ag:Peripheral ; rdfs:range ag:PinAssignment ;
    rdfs:label "pin" .

ag:gpio a owl:DatatypeProperty ; rdfs:domain ag:PinAssignment ; rdfs:range xsd:integer ;
    rdfs:label "gpio" ;
    rdfs:comment "The GPIO number as the board silkscreen and the firmware both name it." .

ag:pinRole a owl:ObjectProperty ; rdfs:domain ag:PinAssignment ; rdfs:range ag:PinRole ;
    rdfs:label "pin role" .

ag:PinRole a owl:Class ; rdfs:label "Pin role" ;
    rdfs:comment "What a leg is for. Roles are grouped by DIRECTION, because that is the part a shape can reason about: whether a line is driven decides which pins it may legally sit on." .

ag:InputRole a owl:Class ; rdfs:subClassOf ag:PinRole ; rdfs:label "Input role" .
ag:OutputRole a owl:Class ; rdfs:subClassOf ag:PinRole ; rdfs:label "Output role" ;
    rdfs:comment "A driven line. The distinction earns its keep on the ESP32, whose 34-39 can be read but never driven." .

ag:AnalogIn a ag:InputRole ; rdfs:label "analog in" ;
    rdfs:comment "Read with an ADC. The role that cannot sit on ADC2 while WiFi is up — the failure returns plausible numbers rather than an error, which is why a shape checks it." .
ag:DigitalIn a ag:InputRole ; rdfs:label "digital in" .
ag:DigitalOut a ag:OutputRole ; rdfs:label "digital out" .
ag:Red a ag:OutputRole ; rdfs:label "red" .
ag:Green a ag:OutputRole ; rdfs:label "green" .
ag:Blue a ag:OutputRole ; rdfs:label "blue" .
ag:I2cData a ag:PinRole ; rdfs:label "I2C SDA" ;
    rdfs:comment "Bidirectional, so neither an input nor an output role." .
ag:I2cClock a ag:OutputRole ; rdfs:label "I2C SCL" .

#################  The peripherals actually on the bench  #################

ag:CapacitiveMoistureProbe a owl:Class ; rdfs:subClassOf ag:Peripheral ;
    rdfs:label "Capacitive soil moisture probe" ;
    rdfs:comment "Reports a raw ADC count that falls as the soil wets. A class rather than a model string because how you READ it is what differs; the model is for the person holding it." .

ag:RgbLed a owl:Class ; rdfs:subClassOf ag:Peripheral ; rdfs:label "RGB LED" ;
    rdfs:comment "Three driven legs and a common return. The return is not modelled: nothing addresses it, and a shape that demanded it would be describing solder rather than software." .

ag:TempHumiditySensor a owl:Class ; rdfs:subClassOf ag:Peripheral ;
    rdfs:label "Temperature and humidity sensor" ;
    rdfs:comment "Reserved: the vocabulary is here so a world can state one before anything reads it. Nothing derives a capability from it yet." .

#################  Naming — stated, never derived  #################

ag:localId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "local id" ;
    rdfs:comment "The short name a resource is known by outside RDF. Stated here so nothing has to infer it from the shape of a URI. The ONE instance identifier a process is given is an agent's localId; everything else it discovers." .

#################  The world and its versions  #################

ag:World a owl:Class ; rdfs:label "World" ;
    rdfs:comment "The ratified world produced by genesis. Found by TYPE, never by a well-known IRI." .
ag:WorldVersion a owl:Class ; rdfs:label "World version" ;
    rdfs:comment "One ratified version of the world's topology; the chain is append-only." .
ag:currentVersion a owl:ObjectProperty ; rdfs:domain ag:World ; rdfs:range ag:WorldVersion ;
    rdfs:label "current version" .
ag:versionNumber a owl:DatatypeProperty ; rdfs:domain ag:WorldVersion ; rdfs:range xsd:integer ;
    rdfs:label "version number" .
ag:underWorldVersion a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "under world version" ;
    rdfs:comment "The world-version in force when this fact was recorded (provenance)." .

#################  Graphs — typed, self-describing (not magic strings)  #################

ag:Graph a owl:Class ; rdfs:label "Named graph" .
ag:WorldGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "World graph" ;
    rdfs:comment "Topology and composed capabilities: who is wired to what, and who can do what. Public, versioned, sovereign-authored. Stated once so no agent's beliefs repeat it." .
ag:BeliefsGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Beliefs graph" ;
    rdfs:comment "ONE agent's private parameters for the capabilities it composed. Opinion, not fact." .
ag:SensedGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Sensed graph" ;
    rdfs:comment "What sensors read. Measurement only; never a judgment." .
ag:OntologyGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Ontology graph" ;
    rdfs:comment "The T-Box: this module and every other." .
ag:beliefsOf a owl:ObjectProperty ; rdfs:domain ag:BeliefsGraph ; rdfs:range ag:Agent ;
    rdfs:label "beliefs of" ;
    rdfs:comment "Which agent owns this graph — the write boundary, made explicit." .
