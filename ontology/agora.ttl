@prefix agora: <http://example.org/agora#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/agora> a owl:Ontology ;
    rdfs:label "Agora ontology" ;
    rdfs:comment "Shared vocabulary (T-Box) for the Agora agent society. The domain is a plug-in; plant watering is the v1 example." .

#################  Graphs — typed, self-describing (not magic strings)  #################

agora:Graph a owl:Class ; rdfs:label "Named graph" .
agora:SensedGraph  a owl:Class ; rdfs:subClassOf agora:Graph ; rdfs:label "Sensed graph" ;
    rdfs:comment "Agents' sensor data — what each plant read (self-asserted, trusted-agent mode)." .
agora:OpinionGraph a owl:Class ; rdfs:subClassOf agora:Graph ; rdfs:label "Opinion graph" ;
    rdfs:comment "Agents' judgments — band, valuation, learning. Self-asserted." .
agora:StructureGraph a owl:Class ; rdfs:subClassOf agora:Graph ; rdfs:label "Structure graph" ;
    rdfs:comment "Sovereign-authored durable structure: topology, charters, world version." .
agora:OntologyGraph  a owl:Class ; rdfs:subClassOf agora:Graph ; rdfs:label "Ontology graph" ;
    rdfs:comment "This T-Box." .

#################  World + versioning  #################

agora:World a owl:Class ; rdfs:label "World" ;
    rdfs:comment "The ratified world produced by genesis." .
agora:WorldVersion a owl:Class ; rdfs:label "World version" ;
    rdfs:comment "One ratified version of the world's structure; the chain is append-only." .
agora:currentVersion a owl:ObjectProperty ; rdfs:domain agora:World ; rdfs:range agora:WorldVersion ;
    rdfs:label "current version" .
agora:versionNumber a owl:DatatypeProperty ; rdfs:domain agora:WorldVersion ; rdfs:range xsd:integer ;
    rdfs:label "version number" .
agora:underWorldVersion a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "under world version" ;
    rdfs:comment "The world-version in force when this fact was recorded (provenance)." .

#################  Agents, sources, suppliers  #################

agora:Agent a owl:Class ; rdfs:label "Agent" ;
    rdfs:comment "A staked participant (has a desire + wallet). The only tier the trust boundary constrains." .
agora:Plant a owl:Class ; rdfs:subClassOf agora:Agent ; rdfs:label "Plant" .
agora:Supplier a owl:Class ; rdfs:subClassOf agora:Agent ; rdfs:label "Supplier" .
agora:WaterSource a owl:Class ; rdfs:label "Water source" ;
    rdfs:comment "A resource a supplier dispenses; the plumbing node a cluster forms around." .

#################  Topology (the cluster boundary)  #################

agora:servedBy a owl:ObjectProperty ; rdfs:domain agora:Plant ; rdfs:range agora:WaterSource ;
    rdfs:label "served by" ;
    rdfs:comment "Plumbing/reachability: which source can water this plant. Defines who competes with whom." .
agora:suppliedBy a owl:ObjectProperty ; rdfs:domain agora:WaterSource ; rdfs:range agora:Supplier ;
    rdfs:label "supplied by" .

#################  Desire (charter)  #################

agora:hasTarget a owl:DatatypeProperty ; rdfs:domain agora:Plant ; rdfs:range xsd:decimal ;
    rdfs:label "has target" ;
    rdfs:comment "Chartered desire: target moisture fraction (0..1). Set by the sovereign." .

#################  Observation (state) — SOSA on the sensor edge  #################

agora:SoilMoisture a sosa:ObservableProperty ; rdfs:label "Soil moisture" .
agora:qualitativeBand a owl:ObjectProperty ; rdfs:domain sosa:Observation ; rdfs:range agora:Band ;
    rdfs:label "qualitative band" ;
    rdfs:comment "The gateway's numeric->qualitative call — the one authority." .
agora:hasCurrentMoisture a owl:ObjectProperty ; rdfs:domain agora:Plant ; rdfs:range agora:Band ;
    rdfs:label "has current moisture" .

agora:Band a owl:Class ; rdfs:label "Moisture band" .
agora:LOW  a agora:Band ; rdfs:label "LOW" .
agora:OK   a agora:Band ; rdfs:label "OK" .
agora:HIGH a agora:Band ; rdfs:label "HIGH" .

#################  Authorship  #################
# Trusted-agent mode: each plant authors its own :sensed / :opinion. No central witness.
# (Adversarial mode restores a signing sensor as the author.)
