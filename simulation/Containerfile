# THE SIMULATOR'S IMAGE, the one Python a world runs: the agent is `orexis-agent/Containerfile`. It reads a world as an agent
# would, so it holds the packages' documents and none of their code; and never onboarding, whose tools hold the admin token.
FROM docker.io/library/python:3.13-slim AS source
WORKDIR /src
# EVERY CRATE BY NAME, since a COPY of a glob lays their contents flat; tests/test_layout.py holds the list to the tree.
COPY orexis/ tree/orexis/
COPY orexis-agent/ tree/orexis-agent/
COPY orexis-belief/ tree/orexis-belief/
COPY orexis-coordination/ tree/orexis-coordination/
COPY orexis-execution/ tree/orexis-execution/
COPY orexis-journal/ tree/orexis-journal/
COPY orexis-journal-otlp/ tree/orexis-journal-otlp/
COPY orexis-journal-oxigraph/ tree/orexis-journal-oxigraph/
COPY orexis-metrics/ tree/orexis-metrics/
COPY orexis-planning/ tree/orexis-planning/
COPY orexis-prediction/ tree/orexis-prediction/
COPY orexis-sensing/ tree/orexis-sensing/
COPY orexis-sensing-influxdb/ tree/orexis-sensing-influxdb/
COPY orexis-speech/ tree/orexis-speech/
COPY orexis-translation/ tree/orexis-translation/
COPY orexis-transport-email/ tree/orexis-transport-email/
COPY orexis-transport-http/ tree/orexis-transport-http/
COPY orexis-transport-mqtt/ tree/orexis-transport-mqtt/
COPY orexis-transport-telegram/ tree/orexis-transport-telegram/
RUN find tree -type d -name tests -prune -exec rm -rf {} + \
 && find tree -type f ! -name '*.ttl' ! -name '*.trig' -delete

FROM docker.io/library/python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml pyproject.toml
COPY simulation/dependencies.txt simulation/dependencies.txt
RUN pip install "setuptools>=68" && pip install -e ".[simulation]"

COPY --from=source /src/tree/ ./
COPY documents/ documents/
COPY domains/ domains/
COPY simulation/ simulation/
RUN pip install --no-build-isolation --no-deps -e .

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin orexis \
 && chown -R orexis:orexis /app
USER orexis
