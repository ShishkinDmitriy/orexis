# an_aversions_want_is_repaired_by_a_step
#
# AN AVERSION IS A DESIRE, AND ITS WANT IS REPAIRED. The keeper's desire points at the AVOIDED STATE
# through planning:unmetWhen — one select whose rows are the tanks sharing a stand — and both tanks
# stand on stand A, so the desire reads unmet in the ground with a witness per tank and ONE want is
# minted under it, about both (derive_wants/two_tanks_on_one_stand). The one lever moves a tank to
# an empty stand. The search finds the one-step plan — either tank moved to stand B — and the want
# is Satisfied: a state the agent may enter and must then leave is a prohibition that is POSSIBLE
# but forbidden, which is what a desire in this form is, repaired when entered, where a
# planning:Constraint in the same words would have made the present a contradiction and minted
# nothing (expand/a_fork_that_keeps_the_presents_violation_is_impossible_too). The dispatcher's
# aversion became a constraint, so this is where the suite keeps an aversion being repaired.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .
@prefix possible: <http://example.org/orexis/graph/possible/> .
@prefix plan: <http://example.org/orexis/graph/plan/> .

GRAPH :ontology {
  :on a rdf:Property .
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:localId "keeper" .
  :stand_a a :Stand .
  :stand_b a :Stand .
  :tank1 a :Tank .
  :tank2 a :Tank .
}

# ONE LEVER: move a tank to a stand no tank is on.
GRAPH :actions {
  :move a orexis:Action .
  :move orexis:takes :tank .
  :move orexis:takes :to .
  :move planning:costs """PREFIX : <http://example.org/test#>
      SELECT (1 AS ?cost) WHERE { }""" .
  :move planning:effect [ a planning:Effect ; sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX : <http://example.org/test#>
      DELETE { $tank :on ?s }
      WHERE  { $tank :on ?s }""" ] ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX : <http://example.org/test#>
      CONSTRUCT { $tank :on $to } WHERE { }""" ] ] .
  :move planning:precondition """PREFIX : <http://example.org/test#>
      SELECT ?tank ?to WHERE {
      ?tank a :Tank ; :on ?from .
      ?to a :Stand .
      FILTER(?to != ?from)
      FILTER NOT EXISTS { ?other :on ?to } }""" .
  :tank a orexis:Parameter .
  :to a orexis:Parameter .
}

GRAPH :desires {
  :keeper planning:holds :keeper.apart .
  :keeper.apart a planning:Desire .
  :keeper.apart planning:unmetWhen :sharing_a_stand .
  :keeper.apart rdfs:label "no stand holds two tanks" .
  :sharing_a_stand sh:select "PREFIX : <http://example.org/test#> SELECT $this ?value WHERE { $this a :Tank ; :on ?value . ?other a :Tank ; :on ?value . FILTER(?other != $this) }" .
}

GRAPH :sensed {
  :tank1 :on :stand_a .
  :tank2 :on :stand_a .
}

GRAPH :scopes {
  :keeper.scope.1 a planning:Scope .
  :move planning:inScope :keeper.scope.1 .
  :on planning:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
