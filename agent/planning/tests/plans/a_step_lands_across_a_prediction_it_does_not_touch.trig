# a_step_lands_across_a_prediction_it_does_not_touch
#
# Two tanks. The first is a single fill short of its floor NOW — six, where the floor is ten and a
# fill raises the level by five; the second reads fifteen, in range, and a prediction says it
# drains to twelve from half a minute on, still in range. The fill lands a minute after the turn
# at the least, so the world it reaches is forked from the LATER ground, where the second tank
# reads twelve, with the fill applied there (#596).
#
# WHAT THE STEP PREDICTS IS THE FILL'S ALONE (#919): the first tank leaves six for eleven, and
# nothing of the second. Diffed against the world it was taken in, the present, the step also
# carried the second tank's fifteen leaving for twelve — the drain a prediction foresaw, which no
# act of this agent makes — so a fictive fill wrote the drain into the readings, and the landing
# check held the fill to the second tank's drain. The other van's next cell, in the prototype of
# #568, is the same shape.
#
# WHAT THE DIFF SHOWS: two grounds, the present and the one the prediction makes; the fill's
# world under the second ground's facts, with the two graphs derived from it that say what the
# fill changed there; and a one-step plan whose two graphs copy those.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .
@prefix possible: <http://example.org/orexis/graph/possible/> .
@prefix plan: <http://example.org/orexis/graph/plan/> .

GRAPH :ontology {
  :level a rdf:Property .
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:localId "keeper" .
  :tank1 a :Tank .
  :tank2 a :Tank .
}

# ONE LEVER: fill a tank that is below its floor, raising the level by five. It is FICTIVE, so an
# executor takes it by writing what the step predicts into the readings.
GRAPH :actions {
  :fill a orexis:Action .
  :fill execution:implementation [ a execution:Implementation ; execution:operation [ a execution:Fictive ] ] .
  :fill orexis:takes :tank .
  :fill planning:costs """PREFIX : <http://example.org/test#>
      SELECT (1 AS ?cost) WHERE { }""" .
  :fill planning:effect [ a planning:Effect ; sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX : <http://example.org/test#>
      DELETE { $tank :level ?l  }
      WHERE  { $tank :level ?l  }""" ] ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX : <http://example.org/test#>
      CONSTRUCT { ?tank :level ?next } WHERE {
      $tank :level ?l .
      BIND($tank AS ?tank) BIND(?l + 5 AS ?next) }""" ] ] .
  #  A FILL SHOWS WITHIN THREE MINUTES OF THE TURN, a minute at the least: the band a world reached by it holds over.
  :fill planning:landsAfter "SELECT ?least ?most WHERE { BIND(60 AS ?least) BIND(180 AS ?most) }" .
  :fill planning:precondition """PREFIX : <http://example.org/test#>
      SELECT ?tank WHERE {
      ?tank a :Tank ; :level ?l .
      FILTER(?l < 10) }""" .
  :tank a orexis:Parameter .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property [ planning:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range sh:targetClass :Tank .
  :keeper planning:holds :keeper.in_range .
  :keeper.in_range a planning:Desire .
  :keeper.in_range planning:about :level .
  :keeper.in_range planning:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
}

GRAPH :sensed {
  :tank1 :level 6 .
  :tank2 :level 15 .
}

# WHAT THE SECOND TANK WILL READ from half past the minute: a drain no act of this agent makes.
GRAPH :predicted-0 {
  :tank2 :level 12 .
}

GRAPH :scopes {
  :fill planning:inScope :keeper.scope.1 .
  :keeper.scope.1 a planning:Scope .
  :level planning:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :predicted-0 a orexis:Graph .
  :predicted-0 a orexis:PredictionGraph .
  :predicted-0 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T12:00:30+00:00"^^xsd:dateTime ] .
  :predicted-0 orexis:retracts "PREFIX : <http://example.org/test#> DELETE { GRAPH $state { :tank2 :level ?was } } WHERE { GRAPH $state { :tank2 :level ?was } }" .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
