# courier_corner
#
# A four-by-four grid, a van at the origin, one parcel two cells away owed at the far corner,
# and three levers: drive to a neighbouring cell, pick up a parcel standing where the van
# stands, set a carried parcel down where the van stands. Eight steps deliver it — three
# drives, the pick, three drives, the drop — and the want's estimate, the drives still owed,
# is what tells this bench from hanoi's: a uniform-cost search forks the grid in every
# direction, and an estimate that never overstates refuses most of it. The predecessor's
# figures for the same delivery were 198 forks against 78.
#
# Assembled from `world/courier/` and `packages/orexis-tool-courier/`: the texts declare
# `courier:` themselves, since this tree loads no courier ontology. The clock stands at
# 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .
@prefix possible: <http://example.org/orexis/graph/possible/> .
@prefix plan: <http://example.org/orexis/graph/plan/> .

GRAPH :ontology {
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :door courier:x 3 .
  :door courier:y 3 .
  :keeper a orexis:Agent .
  :keeper orexis:localId "keeper" .
  :parcel a courier:Parcel .
  :parcel courier:destination :door .
  :parcel rdfs:label "the parcel owed at the far corner" .
  :van a courier:Van .
  :van rdfs:label "the van" .
}

# THREE LEVERS, as `packages/orexis-tool-courier/actions.ttl` states them. Neighbouring is worked
# out, not declared: |dx| + |dy| = 1 over the cells' own coordinates.
GRAPH :actions {
  courier:Drive a orexis:Action .
  courier:Drive orexis:takes courier:toX .
  courier:Drive planning:costs "SELECT ?cost WHERE { BIND(1.0 AS ?cost) }" .
  courier:Drive planning:landsAfter "SELECT ?least ?most WHERE { BIND(30 AS ?least) BIND(60 AS ?most) }" .
  courier:Drive orexis:takes courier:toY .
  courier:Drive orexis:takes courier:van .
  courier:Drive planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $van courier:x ?x ; courier:y ?y }
      INSERT { $van courier:x $toX ; courier:y $toY }
      WHERE  { $van courier:x ?x ; courier:y ?y }""" ] ] .
  courier:Drive planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?van ?toX ?toY WHERE {
          ?van courier:x ?x ; courier:y ?y .
          ?van a courier:Van .
          VALUES (?dx ?dy) { (1 0) (-1 0) (0 1) (0 -1) }
          BIND(?x + ?dx AS ?toX)
          BIND(?y + ?dy AS ?toY)
      }""" .
  courier:Drop a orexis:Action .
  courier:Drop orexis:takes courier:parcel .
  courier:Drop planning:costs "SELECT ?cost WHERE { BIND(1.0 AS ?cost) }" .
  courier:Drop planning:landsAfter "SELECT ?least ?most WHERE { BIND(0 AS ?least) BIND(0 AS ?most) }" .
  courier:Drop planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $parcel courier:carriedBy ?van }
      INSERT { $parcel courier:x ?x ; courier:y ?y }
      WHERE  { $parcel courier:carriedBy ?van . ?van courier:x ?x ; courier:y ?y }""" ] ] .
  courier:Drop planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?parcel WHERE {
          ?parcel courier:carriedBy ?van .
          ?parcel a courier:Parcel .
      }""" .
  courier:Pick a orexis:Action .
  courier:Pick orexis:takes courier:parcel .
  courier:Pick planning:costs "SELECT ?cost WHERE { BIND(1.0 AS ?cost) }" .
  courier:Pick planning:landsAfter "SELECT ?least ?most WHERE { BIND(0 AS ?least) BIND(0 AS ?most) }" .
  courier:Pick orexis:takes courier:van .
  courier:Pick planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $parcel courier:x ?x ; courier:y ?y }
      INSERT { $parcel courier:carriedBy $van }
      WHERE  { $parcel courier:x ?x ; courier:y ?y }""" ] ] .
  courier:Pick planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?parcel ?van WHERE {
          ?van courier:x ?x ; courier:y ?y . ?parcel courier:x ?x ; courier:y ?y .
          ?parcel a courier:Parcel .
          ?van a courier:Van .
      }""" .
}

# THE DESIRE, AND THE PACKAGE'S MEASURE OF IT: every parcel where it is owed, and how far
# that still is — the van to the parcel and the parcel to its door, which never overstates
# since every drive moves one cell, and the pick and the drop the parcel is certainly owed
# (#898). The select is the domain's, `domains/courier/shapes.ttl`, copied as it stands there,
# so the bench's courier figure is the shipped estimate's.
GRAPH :desires {
  :keeper planning:holds :keeper.every_parcel_delivered .
  :keeper.every_parcel_delivered a planning:Desire .
  :keeper.every_parcel_delivered planning:estimates courier:drivesOwed .
  :keeper.every_parcel_delivered planning:metWhen courier:delivered .
  :keeper.every_parcel_delivered rdfs:label "every parcel where it is owed" .
  courier:delivered a sh:NodeShape .
  courier:delivered sh:sparql [ a sh:SPARQLConstraint ; sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT $this WHERE {
          $this courier:destination ?owed .
          ?owed courier:x ?ox ; courier:y ?oy .
          FILTER NOT EXISTS { $this courier:x ?ox ; courier:y ?oy }
      }""" ] .
  courier:delivered sh:targetClass courier:Parcel .
  courier:drivesOwed rdfs:label "drives still owed, and each parcel's pick and drop" .
  courier:drivesOwed sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT (SUM(?d) AS ?estimate) WHERE {
          SELECT ?p (MIN(?dist) AS ?d) WHERE {
              {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:carriedBy ?van . ?van courier:x ?vx ; courier:y ?vy .
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?ox) + ABS(?vy - ?oy) + 1 AS ?dist)
              } UNION {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:x ?px ; courier:y ?py .
                  ?v a courier:Van ; courier:x ?vx ; courier:y ?vy .
                  FILTER(?px != ?ox || ?py != ?oy)
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?px) + ABS(?vy - ?py)
                       + ABS(?px - ?ox) + ABS(?py - ?oy) + 2 AS ?dist)
              }
          } GROUP BY ?p
      }""" .
}

GRAPH :sensed {
  :parcel courier:x 1 .
  :parcel courier:y 2 .
  :van courier:x 0 .
  :van courier:y 0 .
}

GRAPH :scopes {
  :keeper.scope.1 a planning:Scope .
  courier:Drive planning:inScope :keeper.scope.1 .
  courier:Drop planning:inScope :keeper.scope.1 .
  courier:Pick planning:inScope :keeper.scope.1 .
  courier:carriedBy planning:inScope :keeper.scope.1 .
  courier:x planning:inScope :keeper.scope.1 .
  courier:y planning:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :scopes a orexis:Graph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:ownedBy :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed orexis:ownedBy :keeper .
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
}
