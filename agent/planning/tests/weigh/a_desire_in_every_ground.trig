# a_desire_in_every_ground
#
# Two grounds — the present with the tank at nought, and the refill from one o'clock — and the
# desire and its want with NO weighing (the derivation's were taken back, so the case is about
# weighing alone). The desire is weighed in both: unmet in the present, with tank1 as the
# violation, and MET in the refill's ground, with no violation and nothing open. The want,
# minted for the stretch until one, is weighed in both too.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .
@prefix prediction: <http://example.org/orexis/prediction#> .

GRAPH :ontology {
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :tank1 a :Tank .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property [ planning:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range sh:targetClass :Tank .
  :keeper planning:holds :keeper.in_range .
  :keeper.in_range a planning:Desire .
  :keeper.in_range planning:about :level .
  :keeper.in_range planning:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
}

GRAPH :sensed {
  :tank1 :level 0 .
}

GRAPH :scopes {
  :fill planning:inScope :keeper.scope.1 .
  :keeper.scope.1 a planning:Scope .
  :level planning:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :refill a orexis:Graph .
  :refill a orexis:PredictionGraph .
  :refill dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T13:00:00+00:00"^^xsd:dateTime ] .
  :refill orexis:retracts "PREFIX : <http://example.org/test#> DELETE { GRAPH $state { :tank1 :level ?was } } WHERE { GRAPH $state { :tank1 :level ?was } }" .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  ground:2026-01-01T120000p0000 a planning:GroundGraph .
  ground:2026-01-01T120000p0000 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T13:00:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  ground:2026-01-01T120000p0000 orexis:arrivedBy orexis:Derived .
  ground:2026-01-01T120000p0000 orexis:hash "sha256:6049dbc777f47880d902c748f455b6e2f0c0df6ee3e7cd098544d26edb928bc8" .
  ground:2026-01-01T130000p0000 a planning:GroundGraph .
  ground:2026-01-01T130000p0000 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T13:00:00+00:00"^^xsd:dateTime ] .
  ground:2026-01-01T130000p0000 orexis:arrivedBy orexis:Derived .
  ground:2026-01-01T130000p0000 orexis:hash "sha256:668afcf475ee2319100f725c49c2b6daf3ec7f5131fb575c8a3765daaea6bcb0" .
  ground:2026-01-01T130000p0000 prov:wasDerivedFrom ground:2026-01-01T120000p0000 .
  pursued:2026-01-01T120000p0000--2026-01-01T130000p0000 a orexis:Graph .
  pursued:2026-01-01T120000p0000--2026-01-01T130000p0000 a planning:WantGraph .
  pursued:2026-01-01T120000p0000--2026-01-01T130000p0000 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T13:00:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  pursued:2026-01-01T120000p0000--2026-01-01T130000p0000 orexis:arrivedBy orexis:Derived .
  pursued:2026-01-01T120000p0000--2026-01-01T130000p0000 orexis:beliefsOf :keeper .
}

GRAPH ground:2026-01-01T120000p0000 {
  :tank1 :level 0 .
}

GRAPH ground:2026-01-01T130000p0000 {
  :tank1 :level 20 .
}

GRAPH pursued:2026-01-01T120000p0000--2026-01-01T130000p0000 {
  :keeper planning:holds :keeper.in_range.pursued.tank1 .
  :keeper.in_range.pursued.tank1 a planning:Want .
  :keeper.in_range.pursued.tank1 planning:metWhen :keeper.in_range.pursued.tank1.met .
  :keeper.in_range.pursued.tank1 planning:state planning:Recognized .
  :keeper.in_range.pursued.tank1 prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
  :keeper.in_range.pursued.tank1 prov:wasDerivedFrom :keeper.in_range .
  :keeper.in_range.pursued.tank1 rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.met a sh:NodeShape .
  :keeper.in_range.pursued.tank1.met sh:property [ planning:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :keeper.in_range.pursued.tank1.met sh:targetNode :tank1 .
}

GRAPH :refill {
  :tank1 :level 20 .
}
