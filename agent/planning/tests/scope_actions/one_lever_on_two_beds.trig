# one_lever_on_two_beds
#
# AN ACTION IS IN EVERY SCOPE A FILLING OF IT FALLS IN. One pump action, two beds each with its own
# valve: the filling for the first bed writes `(below, {bed1, Moisture})` and the second
# `(below, {bed2, Moisture})`, nothing joins them, so the beds are two scopes — and the one action is
# admitted in both, since each imaginarium needs it for its own bed. The property is a key of both
# and so a member of neither; each bed is a member of its own.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  planning:ScopeGraph rdfs:subClassOf orexis:Graph .
}

# THE WORLD, public: one keeper with a pump and a heater on one bed, each moving one property.
GRAPH :world {
  :keeper :hasActuator :pump1 .
  :keeper :hasActuator :pump2 .
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :bed1 .
  :keeper orexis:actsFor :bed2 .
  :pump1 :actuates :bed1 .
  :pump1 :actuatesProperty :Moisture .
  :pump2 :actuates :bed2 .
  :pump2 :actuatesProperty :Moisture .
}

GRAPH :actions {
  :dose a orexis:Action .
  :dose planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX sensing: <http://example.org/orexis/sensing#>
        DELETE { $reading sensing:below ?range } INSERT { $reading sensing:inside ?range } WHERE { $reading sensing:below ?range }""" ] ] .
  :dose planning:precondition """PREFIX : <http://example.org/test#>
        PREFIX sensing: <http://example.org/orexis/sensing#>
        SELECT DISTINCT ?valve ?reading WHERE {
            ?me a orexis:Self ; :hasActuator ?valve ; orexis:actsFor ?subject .
            ?valve :actuates ?subject ; :actuatesProperty ?property .
            ?reading sosa:hasFeatureOfInterest ?subject ; sosa:observedProperty ?property ; sensing:below ?range . }""" .
}

GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
}
