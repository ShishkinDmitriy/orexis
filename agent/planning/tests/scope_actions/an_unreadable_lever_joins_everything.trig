# an_unreadable_lever_joins_everything
#
# The two levers of two_properties_two_levers, and a third whose effect names its predicate
# by a variable: what it writes cannot be read, so it might touch anything, and it joins
# every predicate into one scope — with all three levers in it.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
  planning:ScopeGraph rdfs:subClassOf orexis:Graph .
  planning:ScopeGraph rdfs:subClassOf orexis:WorkingGraph .
}

GRAPH :actions {
  :fill a orexis:Action .
  :fill orexis:effect [ a orexis:Effect ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . } WHERE { ?t a :Tank }""" ] ] .
  :heat a orexis:Action .
  :heat orexis:effect [ a orexis:Effect ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :temperature ?x . } WHERE { ?t a :Tank }""" ] ] .
  :tweak a orexis:Action .
  :tweak orexis:effect [ a orexis:Effect ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t ?p ?x . } WHERE { ?t a :Tank ; ?p ?x }""" ] ] .
}

GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
}
