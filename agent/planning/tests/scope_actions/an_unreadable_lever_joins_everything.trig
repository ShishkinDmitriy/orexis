# an_unreadable_lever_joins_everything
#
# The two levers of two_properties_two_levers, and a third whose effect names its predicate
# by a variable: what it writes cannot be read, so it might touch anything, and it joins
# every predicate into one scope — with all three levers in it.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  planning:ScopeGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :actions {
  :fill a orexis:Action .
  :fill planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX : <http://example.org/test#>
        INSERT { ?t :level ?x . } WHERE { ?t a :Tank }""" ] ] .
  :heat a orexis:Action .
  :heat planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX : <http://example.org/test#>
        INSERT { ?t :temperature ?x . } WHERE { ?t a :Tank }""" ] ] .
  :tweak a orexis:Action .
  :tweak planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX : <http://example.org/test#>
        INSERT { ?t ?p ?x . } WHERE { ?t a :Tank ; ?p ?x }""" ] ] .
}

GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:BeliefGraph .
  :actions a orexis:Graph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
}
