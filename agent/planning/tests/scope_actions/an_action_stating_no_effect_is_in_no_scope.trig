# an_action_stating_no_effect_is_in_no_scope
#
# An action stating no effect is one an event adopts — never on a menu, never simulated —
# so it joins nothing and is in no scope; the lever beside it is in the one scope its
# property makes.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  planning:ScopeGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :actions {
  :fill a orexis:Action .
  :fill planning:effect [ a planning:Effect ; sh:rule [ a belief:Transition ; belief:update """PREFIX : <http://example.org/test#>
        INSERT { ?t :level ?x . } WHERE { ?t a :Tank }""" ] ] .
  :look a orexis:Action .
}

GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
}
