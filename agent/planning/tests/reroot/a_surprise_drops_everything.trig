  possible:Move-disk_1-PegC.by hanoi:disk :disk_1 .
  possible:Move-disk_1-PegC.by hanoi:onto hanoi:PegC .
  possible:Move-disk_1-PegC.by planning:fills hanoi:Move .
  possible:Move-disk_1-PegC.by planning:from ground:2026-01-01T120000p0000 .
  possible:Move-disk_1-PegC.for.keeper.every_disk_home.pursued a planning:Weighing .
  possible:Move-disk_1-PegC.for.keeper.every_disk_home.pursued planning:expanded true .
  possible:Move-disk_1-PegC.for.keeper.every_disk_home.pursued planning:for :keeper.every_disk_home.pursued .
  possible:Move-disk_1-PegC.for.keeper.every_disk_home.pursued planning:met false .
  possible:Move-disk_1-PegC.for.keeper.every_disk_home.pursued planning:remaining 1 .
  possible:Move-disk_1-PegC.for.keeper.every_disk_home.pursued planning:violation [ planning:constraint 0 ; planning:instance :disk_2 ] .
  possible:Move-disk_1-PegC.for.keeper.every_disk_home.pursued planning:weighs possible:Move-disk_1-PegC .
  pursued:2026-01-01T120000p0000--open a orexis:Graph .
  pursued:2026-01-01T120000p0000--open a orexis:WantGraph .
  pursued:2026-01-01T120000p0000--open dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  pursued:2026-01-01T120000p0000--open orexis:arrivedBy orexis:Derived .
  pursued:2026-01-01T120000p0000--open orexis:beliefsOf :keeper .
}

GRAPH :desires {
  :keeper orexis:holds :keeper.every_disk_home .
  :keeper.every_disk_home a orexis:Desire .
  :keeper.every_disk_home orexis:estimates hanoi:disksAstray .
  :keeper.every_disk_home orexis:metWhen hanoi:solved .
  :keeper.every_disk_home rdfs:label "every disk home on peg C" .
  hanoi:disksAstray rdfs:label "disks not yet home" .
  hanoi:disksAstray sh:select """PREFIX hanoi: <http://example.org/orexis/hanoi#>
      SELECT (COUNT(DISTINCT ?d) AS ?estimate) WHERE {
          ?d hanoi:on ?rest . ?d (hanoi:on)+ ?p .
          ?p a hanoi:Peg .
          FILTER(?p != hanoi:PegC)
      }""" .
  hanoi:solved a sh:NodeShape .
  hanoi:solved sh:property [ sh:hasValue hanoi:PegC ; sh:path [ sh:oneOrMorePath hanoi:on ] ] .
  hanoi:solved sh:targetSubjectsOf hanoi:on .
}

GRAPH :ontology {
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :scopes {
  :keeper.scope.1 a planning:Scope .
  hanoi:Move planning:inScope :keeper.scope.1 .
  hanoi:on planning:inScope :keeper.scope.1 .
}

GRAPH :sensed {
  :disk_1 hanoi:on hanoi:PegC .
  :disk_2 hanoi:on :disk_1 .
}

GRAPH :world {
  :disk_1 a hanoi:Disk .
  :disk_1 hanoi:size 1 .
  :disk_2 a hanoi:Disk .
  :disk_2 hanoi:size 2 .
  :keeper a orexis:Agent .
  :keeper orexis:localId "keeper" .
  hanoi:PegA a hanoi:Peg .
  hanoi:PegB a hanoi:Peg .
  hanoi:PegC a hanoi:Peg .
}
