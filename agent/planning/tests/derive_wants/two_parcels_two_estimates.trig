# two_parcels_two_estimates
#
# A DESIRE OVER INSTANCES WITH AN ESTIMATE: two parcels astray under one desire that every parcel
# stand where it is owed, a select summing the drives owed over every parcel — the courier's as it
# stood before #898 counted the pick and the drop beside them, kept here as its own text since the
# case is about the BINDING and not the figure. Two wants, one per parcel
# (a-parcel-astray-is-a-want-of-its-own), and each carries the estimate as ITS OWN — the desire's
# select with `$this` bound to its parcel, under the want's name — so the two wants read two
# figures where the desire reads their sum: parcel A's van is a drive away and its door two more,
# three; parcel B's van stands on it, two. Carrying the desire's select, each want read five and
# forked the other van (#893). `test_derive_wants.py` holds the figures.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .


GRAPH :ontology {
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :door_parcel_a courier:x 0 .
  :door_parcel_a courier:y 3 .
  :door_parcel_b courier:x 1 .
  :door_parcel_b courier:y 3 .
  :parcel_a a courier:Parcel .
  :parcel_a courier:destination :door_parcel_a .
  :parcel_b a courier:Parcel .
  :parcel_b courier:destination :door_parcel_b .
  :van_a a courier:Van .
  :van_b a courier:Van .
}

GRAPH :desires {
  :delivered a sh:NodeShape .
  :delivered sh:sparql [ a sh:SPARQLConstraint ; planning:about sh:this ; sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT $this WHERE {
          $this courier:destination ?owed .
          ?owed courier:x ?ox ; courier:y ?oy .
          FILTER NOT EXISTS { $this courier:x ?ox ; courier:y ?oy }
      }""" ] .
  :delivered sh:targetClass courier:Parcel .
  :drivesOwed rdfs:label "drives still owed" .
  :drivesOwed sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT (SUM(?d) AS ?estimate) WHERE {
          SELECT ?p (MIN(?dist) AS ?d) WHERE {
              {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:carriedBy ?van . ?van courier:x ?vx ; courier:y ?vy .
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?ox) + ABS(?vy - ?oy) AS ?dist)
              } UNION {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:x ?px ; courier:y ?py .
                  ?v a courier:Van ; courier:x ?vx ; courier:y ?vy .
                  FILTER(?px != ?ox || ?py != ?oy)
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?px) + ABS(?vy - ?py)
                       + ABS(?px - ?ox) + ABS(?py - ?oy) AS ?dist)
              }
          } GROUP BY ?p
      }""" .
  :keeper planning:holds :keeper.every_parcel_delivered .
  :keeper.every_parcel_delivered a planning:Desire .
  :keeper.every_parcel_delivered planning:estimates :drivesOwed .
  :keeper.every_parcel_delivered planning:metWhen :delivered .
  :keeper.every_parcel_delivered rdfs:label "every parcel where it is owed" .
}

GRAPH :sensed {
  :parcel_a courier:x 0 .
  :parcel_a courier:y 1 .
  :parcel_b courier:x 1 .
  :parcel_b courier:y 1 .
  :van_a courier:x 0 .
  :van_a courier:y 0 .
  :van_b courier:x 1 .
  :van_b courier:y 1 .
}

GRAPH :scopes {
  :keeper.scope.1 a planning:Scope .
  :parcel_a planning:inScope :keeper.scope.1 .
  :parcel_b planning:inScope :keeper.scope.1 .
  :van_a planning:inScope :keeper.scope.1 .
  :van_b planning:inScope :keeper.scope.1 .
  courier:Drive planning:inScope :keeper.scope.1 .
  courier:Drop planning:inScope :keeper.scope.1 .
  courier:Pick planning:inScope :keeper.scope.1 .
  courier:carriedBy planning:inScope :keeper.scope.1 .
  courier:x planning:inScope :keeper.scope.1 .
  courier:y planning:inScope :keeper.scope.1 .
}

# What each graph IS, and when it holds — said once each, beside the data.
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :scopes a orexis:Graph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:ownedBy :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed orexis:ownedBy :keeper .
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
}
