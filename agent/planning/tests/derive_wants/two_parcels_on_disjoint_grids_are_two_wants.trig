# two_parcels_on_disjoint_grids_are_two_wants
#
# TWO INSTANCES NO CONSTRAINT CAN JOIN STAY TWO WANTS. The same keeper, the same desire and the same
# aversion as `two_parcels_a_constraint_joins_are_one_want`, and the vans on two grids a continent
# apart: van A and parcel A on the 2x4 at the origin, van B and parcel B on a 2x4 at x 10 and 11,
# with no cell a drive reaches from one grid to the other — neighbouring is |dx| + |dy| = 1 over the
# coordinates, and nothing is one apart. The aversion reads `at` on vans joined on the cell, and
# over the reach from where the vans stand it yields no row, since no cell can hold both; so the
# constraint joins nothing, and the two parcels are two clusters as a-parcel-astray-is-a-want-of-
# its-own left them: two wants, each named for its parcel, narrowed to it, its estimate bound to it.
# The scopes are still one — the partition is read off the public graphs, which bind either van to
# either parcel — which is why the coupling is read over the reach and not off the scopes.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .


GRAPH :ontology {
  planning:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :c0_0 a courier:Cell .
  :c0_0 courier:x 0 .
  :c0_0 courier:y 0 .
  :c0_1 a courier:Cell .
  :c0_1 courier:x 0 .
  :c0_1 courier:y 1 .
  :c0_2 a courier:Cell .
  :c0_2 courier:x 0 .
  :c0_2 courier:y 2 .
  :c0_3 a courier:Cell .
  :c0_3 courier:x 0 .
  :c0_3 courier:y 3 .
  :c1_0 a courier:Cell .
  :c1_0 courier:x 1 .
  :c1_0 courier:y 0 .
  :c1_1 a courier:Cell .
  :c1_1 courier:x 1 .
  :c1_1 courier:y 1 .
  :c1_2 a courier:Cell .
  :c1_2 courier:x 1 .
  :c1_2 courier:y 2 .
  :c1_3 a courier:Cell .
  :c1_3 courier:x 1 .
  :c1_3 courier:y 3 .
  :g10_0 a courier:Cell .
  :g10_0 courier:x 10 .
  :g10_0 courier:y 0 .
  :g10_1 a courier:Cell .
  :g10_1 courier:x 10 .
  :g10_1 courier:y 1 .
  :g10_2 a courier:Cell .
  :g10_2 courier:x 10 .
  :g10_2 courier:y 2 .
  :g10_3 a courier:Cell .
  :g10_3 courier:x 10 .
  :g10_3 courier:y 3 .
  :g11_0 a courier:Cell .
  :g11_0 courier:x 11 .
  :g11_0 courier:y 0 .
  :g11_1 a courier:Cell .
  :g11_1 courier:x 11 .
  :g11_1 courier:y 1 .
  :g11_2 a courier:Cell .
  :g11_2 courier:x 11 .
  :g11_2 courier:y 2 .
  :g11_3 a courier:Cell .
  :g11_3 courier:x 11 .
  :g11_3 courier:y 3 .
  :keeper a orexis:Agent .
  :parcel_a a courier:Parcel .
  :parcel_a courier:destination :c0_3 .
  :parcel_b a courier:Parcel .
  :parcel_b courier:destination :g10_3 .
  :van_a a courier:Van .
  :van_b a courier:Van .
}

# THE COURIER'S THREE ACTIONS, as `domains/courier/actions.ttl` states them: what the reach is
# closed over, so the constraint is asked which collisions the plans could actually make.
GRAPH :actions {
  courier:Drive a orexis:Action .
  courier:Drive orexis:takes courier:to .
  courier:Drive orexis:takes courier:van .
  courier:Drive planning:effect [ a planning:Effect ; sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $van courier:at ?old  }
      WHERE  { $van courier:at ?old  }""" ] ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX courier: <http://example.org/orexis/courier#>
      CONSTRUCT { $van courier:at $to } WHERE { }""" ] ] .
  courier:Drive planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?van ?to WHERE {
          ?van courier:at ?here .
          ?van a courier:Van .
          ?here courier:x ?hx ; courier:y ?hy .
          ?to a courier:Cell ; courier:x ?ax ; courier:y ?ay .
          FILTER(ABS(?ax - ?hx) + ABS(?ay - ?hy) = 1)
      }""" .
  courier:Drop a orexis:Action .
  courier:Drop orexis:takes courier:parcel .
  courier:Drop orexis:takes courier:to .
  courier:Drop planning:effect [ a planning:Effect ; sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $parcel courier:carriedBy ?van  }
      WHERE  { $parcel courier:carriedBy ?van  }""" ] ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX courier: <http://example.org/orexis/courier#>
      CONSTRUCT { $parcel courier:at $to } WHERE { }""" ] ] .
  courier:Drop planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?parcel ?to WHERE {
          ?parcel courier:carriedBy ?van . ?van courier:at ?to .
          ?parcel a courier:Parcel .
      }""" .
  courier:Pick a orexis:Action .
  courier:Pick orexis:takes courier:parcel .
  courier:Pick orexis:takes courier:van .
  courier:Pick planning:effect [ a planning:Effect ; sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX courier: <http://example.org/orexis/courier#>
      DELETE { $parcel courier:at ?cell  }
      WHERE  { $parcel courier:at ?cell  }""" ] ; sh:rule [ a sh:SPARQLRule ; sh:construct """PREFIX courier: <http://example.org/orexis/courier#>
      CONSTRUCT { $parcel courier:carriedBy $van } WHERE { }""" ] ] .
  courier:Pick planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT ?parcel ?van WHERE {
          ?van courier:at ?cell . ?parcel courier:at ?cell .
          ?parcel a courier:Parcel .
          ?van a courier:Van .
      }""" .
}

GRAPH :desires {
  :delivered a sh:NodeShape .
  :delivered sh:property [ planning:about sh:this ; sh:equals courier:destination ; sh:path courier:at ] .
  :delivered sh:targetClass courier:Parcel .
  :drivesOwed rdfs:label "drives still owed" .
  :drivesOwed sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT (SUM(?d) AS ?estimate) WHERE {
          SELECT ?p (MIN(?dist) AS ?d) WHERE {
              {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:carriedBy ?van . ?van courier:at ?vc .
                  ?vc courier:x ?vx ; courier:y ?vy .
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?ox) + ABS(?vy - ?oy) AS ?dist)
              } UNION {
                  $this a courier:Parcel ; courier:destination ?owed .
                  ?owed courier:x ?ox ; courier:y ?oy .
                  $this courier:at ?pc . ?v courier:at ?vc .
                  ?v a courier:Van .
                  ?pc courier:x ?px ; courier:y ?py .
                  ?vc courier:x ?vx ; courier:y ?vy .
                  FILTER(?px != ?ox || ?py != ?oy)
                  BIND($this AS ?p)
                  BIND(ABS(?vx - ?px) + ABS(?vy - ?py)
                       + ABS(?px - ?ox) + ABS(?py - ?oy) AS ?dist)
              }
          } GROUP BY ?p
      }""" .
  :keeper planning:holds :keeper.every_parcel_delivered .
  :keeper planning:holds :keeper.no_cell_holds_two_vans .
  :keeper.every_parcel_delivered a planning:Desire .
  :keeper.every_parcel_delivered planning:estimates :drivesOwed .
  :keeper.every_parcel_delivered planning:metWhen :delivered .
  :keeper.every_parcel_delivered rdfs:label "every parcel where it is owed" .
  :keeper.no_cell_holds_two_vans a planning:Desire .
  :keeper.no_cell_holds_two_vans planning:unmetWhen :two_vans_on_one_cell .
  :keeper.no_cell_holds_two_vans rdfs:label "no cell holds two vans" .
  :two_vans_on_one_cell sh:select """PREFIX courier: <http://example.org/orexis/courier#>
      SELECT $this ?value WHERE {
          $this a courier:Van ;
              courier:at ?value .
          ?other a courier:Van ;
              courier:at ?value .
          FILTER(?other != $this)
      }""" .
}

GRAPH :sensed {
  :parcel_a courier:at :c0_1 .
  :parcel_b courier:at :g10_1 .
  :van_a courier:at :c0_0 .
  :van_b courier:at :g10_0 .
}

GRAPH :scopes {
  :c0_0 planning:inScope :keeper.scope.1 .
  :c0_1 planning:inScope :keeper.scope.1 .
  :c0_2 planning:inScope :keeper.scope.1 .
  :c0_3 planning:inScope :keeper.scope.1 .
  :c1_0 planning:inScope :keeper.scope.1 .
  :c1_1 planning:inScope :keeper.scope.1 .
  :c1_2 planning:inScope :keeper.scope.1 .
  :c1_3 planning:inScope :keeper.scope.1 .
  :g10_0 planning:inScope :keeper.scope.1 .
  :g10_1 planning:inScope :keeper.scope.1 .
  :g10_2 planning:inScope :keeper.scope.1 .
  :g10_3 planning:inScope :keeper.scope.1 .
  :g11_0 planning:inScope :keeper.scope.1 .
  :g11_1 planning:inScope :keeper.scope.1 .
  :g11_2 planning:inScope :keeper.scope.1 .
  :g11_3 planning:inScope :keeper.scope.1 .
  :keeper.scope.1 a planning:Scope .
  :parcel_a planning:inScope :keeper.scope.1 .
  :parcel_b planning:inScope :keeper.scope.1 .
  :van_a planning:inScope :keeper.scope.1 .
  :van_b planning:inScope :keeper.scope.1 .
  courier:Drive planning:inScope :keeper.scope.1 .
  courier:Drop planning:inScope :keeper.scope.1 .
  courier:Pick planning:inScope :keeper.scope.1 .
  courier:at planning:inScope :keeper.scope.1 .
  courier:carriedBy planning:inScope :keeper.scope.1 .
}

# What each graph IS, and when it holds — said once each, beside the data.
GRAPH :catalogue {
  :actions a orexis:ActionGraph .
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:Graph .
  :desires a planning:DesireGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
