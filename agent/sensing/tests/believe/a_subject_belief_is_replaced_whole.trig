# a_subject_belief_is_replaced_whole
#
# The bed was believed dry of the reading of 0.299 at ten to twelve, holding to ten past. The probe read
# 0.3001 at noon, over the floor and short of the floor and its margin, and the rules — handed that
# subject belief beside the observation — judged the bed dry still. The subject belief before is
# forgotten whole and the new one written in its place: dry still, holding from noon to twenty past.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix believed: <http://example.org/orexis/graph/believed/keeper/> .

GRAPH :ontology {
  belief:RevisionGraph rdfs:subClassOf orexis:BeliefGraph .
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:BeliefGraph .
  sensing:ObservationGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:StateGraph .
  sensing:SubjectBeliefGraph rdfs:subClassOf orexis:BeliefGraph .
  sensing:SubjectBeliefGraph rdfs:subClassOf orexis:Graph .
  sensing:SubjectBeliefGraph rdfs:subClassOf orexis:StateGraph .
}

GRAPH :world {
  :SoilMoisture sensing:aboveAs :Wet .
  :SoilMoisture sensing:belowAs :Dry .
  :SoilMoisture sensing:insideAs :Moist .
  :SoilMoisture sensing:stateAs :soil .
  :bed a sosa:FeatureOfInterest .
  :bed ssn-system:hasOperatingRange :bed.operating .
  :bed ssn-system:hasSurvivalRange :bed.survival .
  :bed.operating a ssn-system:OperatingRange .
  :bed.operating ssn-system:inCondition [ schema:maxValue 0.6 ; schema:minValue 0.3 ; sensing:margin 0.0002 ; ssn:forProperty :SoilMoisture ] .
  :bed.survival a ssn-system:SurvivalRange .
  :bed.survival ssn-system:inCondition [ schema:maxValue 0.85 ; schema:minValue 0.1 ; ssn:forProperty :SoilMoisture ] .
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :bed .
  :keeper orexis:localId "keeper" .
  :probe a sosa:Sensor .
  :probe sosa:isHostedBy :bed .
  :probe sosa:observes :SoilMoisture .
  :probe ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty [ a ssn-system:Frequency ; schema:unitCode unit:SEC ; schema:value 600 ] ] .
}

GRAPH :self {
  :keeper a orexis:Self .
}

GRAPH :observed {
  orexis:obs_probe a sosa:Observation .
  orexis:obs_probe prov:wasGeneratedBy :keeper .
  orexis:obs_probe sensing:rawResult 0.3001 .
  orexis:obs_probe sensing:unchangedSince "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
  orexis:obs_probe sosa:madeBySensor :probe .
  orexis:obs_probe sosa:resultTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
}

GRAPH :observed_revisions {
  orexis:obs_probe sensing:inside :bed.operating .
  orexis:obs_probe sensing:inside :bed.survival .
  orexis:obs_probe sensing:judged :Dry .
  orexis:obs_probe sensing:scaledResult 0.3001 .
  orexis:obs_probe sosa:hasFeatureOfInterest :bed .
  orexis:obs_probe sosa:hasSimpleResult 0.3001 .
  orexis:obs_probe sosa:observedProperty :SoilMoisture .
}

GRAPH believed:bed_SoilMoisture {
  :bed :soil :Dry .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :observed a orexis:BeliefGraph .
  :observed a orexis:Graph .
  :observed a orexis:StateGraph .
  :observed a sensing:ObservationGraph .
  :observed dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:20:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  :observed orexis:arrivedBy orexis:Received .
  :observed orexis:beliefsOf :keeper .
  :observed_revisions a belief:RevisionGraph .
  :observed_revisions a orexis:BeliefGraph .
  :observed_revisions a orexis:Graph .
  :observed_revisions belief:settled true .
  :observed_revisions dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:20:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  :observed_revisions orexis:arrivedBy orexis:Derived .
  :observed_revisions orexis:beliefsOf :keeper .
  :observed_revisions prov:wasDerivedFrom :observed .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :self a orexis:BeliefGraph .
  :self a orexis:Graph .
  :self a orexis:SelfGraph .
  :self orexis:arrivedBy orexis:Asserted .
  :self orexis:beliefsOf :keeper .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  believed:bed_SoilMoisture a orexis:BeliefGraph .
  believed:bed_SoilMoisture a orexis:Graph .
  believed:bed_SoilMoisture a orexis:StateGraph .
  believed:bed_SoilMoisture a sensing:SubjectBeliefGraph .
  believed:bed_SoilMoisture dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:10:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T11:50:00+00:00"^^xsd:dateTime ] .
  believed:bed_SoilMoisture orexis:arrivedBy orexis:Derived .
  believed:bed_SoilMoisture orexis:beliefsOf :keeper .
}
