# a_reading_already_below_predicts_no_crossing
#
# Read at 0.05, below the region already. The drift dries it further and every rung reads
# below, the same side the reading is — so nothing is bisected, and the three windows are the
# ladder's own, the first opening at the horizon.
#
# The clock stands at 2026-01-01T12:00:00Z.
@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sensed: <http://example.org/orexis/graph/sensed/keeper/> .
@prefix result: <http://example.org/orexis/graph/result/keeper/> .
@prefix predicted: <http://example.org/orexis/graph/predicted/keeper/> .

# THE VOCABULARY THE CASE IS LOADED WITH: what the graph kinds are beneath, the three side
# families, and the side classes genesis would mint for the pot's moisture from the range it
# states — 0.10 to 0.30 of saturation, the loner's zamioculcas.
GRAPH :ontology {
  :zz.moisture.above a owl:Class .
  :zz.moisture.above owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( sosa:Observation [ a owl:Restriction ; owl:hasValue :zz ; owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ; owl:hasValue :moisture ; owl:onProperty sosa:observedProperty ] [ a owl:Restriction ; owl:onProperty sosa:hasSimpleResult ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ; owl:withRestrictions ( [ xsd:minExclusive 0.3 ] ) ] ] ) ] .
  :zz.moisture.above rdfs:label "moisture above 0.30" .
  :zz.moisture.above rdfs:subClassOf sensing:AboveRegion .
  :zz.moisture.above sensing:ofProperty :moisture .
  :zz.moisture.above sensing:ofSubject :zz .
  :zz.moisture.below a owl:Class .
  :zz.moisture.below owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( sosa:Observation [ a owl:Restriction ; owl:hasValue :zz ; owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ; owl:hasValue :moisture ; owl:onProperty sosa:observedProperty ] [ a owl:Restriction ; owl:onProperty sosa:hasSimpleResult ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ; owl:withRestrictions ( [ xsd:maxExclusive 0.1 ] ) ] ] ) ] .
  :zz.moisture.below rdfs:label "moisture below 0.10" .
  :zz.moisture.below rdfs:subClassOf sensing:BelowRegion .
  :zz.moisture.below sensing:ofProperty :moisture .
  :zz.moisture.below sensing:ofSubject :zz .
  :zz.moisture.inside a owl:Class .
  :zz.moisture.inside owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( sosa:Observation [ a owl:Restriction ; owl:hasValue :zz ; owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ; owl:hasValue :moisture ; owl:onProperty sosa:observedProperty ] [ a owl:Restriction ; owl:onProperty sosa:hasSimpleResult ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ; owl:withRestrictions ( [ xsd:minInclusive 0.1 ] [ xsd:maxInclusive 0.3 ] ) ] ] ) ] .
  :zz.moisture.inside rdfs:label "moisture inside 0.10-0.30" .
  :zz.moisture.inside rdfs:subClassOf sensing:InRegion .
  :zz.moisture.inside sensing:ofProperty :moisture .
  :zz.moisture.inside sensing:ofSubject :zz .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
  sensing:AboveRegion rdfs:subClassOf sosa:Observation .
  sensing:BelowRegion rdfs:subClassOf sosa:Observation .
  sensing:InRegion rdfs:subClassOf sosa:Observation .
  sensing:ResultGraph rdfs:subClassOf orexis:BeliefGraph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :zz .
  :keeper orexis:localId "keeper" .
  :keeper sensing:polls :probe .
  :probe a sosa:Sensor .
  :probe sensing:monitors :zz .
  :probe sosa:observes :moisture .
  :zz :driesPerDay 0.03 .
  :zz a :Pot .
}

# THE DRIFT: what the pot loses while nobody waters it — the water package's Drying, in the
# case's own words, typing its prediction with every side the rate, its spread and the probe's
# noise reach. Declared as a rule the layer runs, never a lever the search takes.
GRAPH :actions {
  :Drying a sensing:Drift .
  :Drying rdfs:label "what a pot loses while nobody waters it" .
  :Drying sensing:atHorizon 18000 .
  :Drying sensing:atHorizon 3600 .
  :Drying sensing:atHorizon 86400 .
  :Drying sh:construct """PREFIX : <http://example.org/test#>
      CONSTRUCT {
          ?obs a sosa:Observation , ?side ;
               sosa:hasFeatureOfInterest ?pot ;
               sosa:observedProperty :moisture ;
               sosa:hasSimpleResult ?now ;
               sosa:resultTime ?at ;
               sosa:madeBySensor ?sensor .
      } WHERE {
          ?obs sosa:hasFeatureOfInterest ?pot ;
               sosa:observedProperty :moisture ;
               sosa:hasSimpleResult ?was .
          OPTIONAL { ?obs sosa:madeBySensor ?sensor }
          ?pot :driesPerDay ?rate .
          FILTER(?rate > 0 && $elapsed > 0)
          BIND(ROUND(($elapsed / 86400.0) * 1000000) / 1000000 AS ?days)
          BIND(?was - (?rate * ?days) AS ?fell)
          BIND(IF(?fell < 0.0, 0.0, ?fell) AS ?now)
          BIND($lands AS ?at)
          OPTIONAL { ?pot :driesPerDaySpread ?spread }
          OPTIONAL { ?sensor sensing:noise ?noise }
          BIND(((xsd:double(COALESCE(?spread, 0)) * xsd:double(?days)) + xsd:double(COALESCE(?noise, 0))) AS ?width)
          BIND(xsd:double(?now) - ?width AS ?lo)
          BIND(xsd:double(?now) + ?width AS ?hi)
          ?side sensing:ofSubject ?pot ; sensing:ofProperty :moisture ;
                owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?r .
          ?r owl:onProperty sosa:hasSimpleResult ;
             owl:someValuesFrom/owl:withRestrictions ?facets .
          OPTIONAL { ?facets rdf:rest*/rdf:first/xsd:maxExclusive ?below }
          OPTIONAL { ?facets rdf:rest*/rdf:first/xsd:minInclusive ?inLo .
                     ?facets rdf:rest*/rdf:first/xsd:maxInclusive ?inHi }
          OPTIONAL { ?facets rdf:rest*/rdf:first/xsd:minExclusive ?above }
          FILTER((BOUND(?below) && ?lo < ?below)
                 || (BOUND(?inLo) && ?hi >= ?inLo && ?lo <= ?inHi)
                 || (BOUND(?above) && ?hi > ?above))
      }""" .
}

# THE READING IN HAND, as `revise` leaves it: the node, its key and its sides in the graph of
# readings; the number, the instant and the instrument in the result graph beside it.
GRAPH sensed:zz_moisture {
  orexis:obs_zz_moisture a :zz.moisture.below .
  orexis:obs_zz_moisture a sensing:BelowRegion .
  orexis:obs_zz_moisture a sosa:Observation .
  orexis:obs_zz_moisture sosa:hasFeatureOfInterest :zz .
  orexis:obs_zz_moisture sosa:observedProperty :moisture .
}

GRAPH result:zz_moisture {
  orexis:obs_zz_moisture prov:wasGeneratedBy :keeper .
  orexis:obs_zz_moisture sosa:hasSimpleResult 0.05 .
  orexis:obs_zz_moisture sosa:madeBySensor :probe .
  orexis:obs_zz_moisture sosa:resultTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
}

GRAPH :catalogue {
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  result:zz_moisture a orexis:BeliefGraph .
  result:zz_moisture a sensing:ResultGraph .
  result:zz_moisture dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:15:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  result:zz_moisture orexis:arrivedBy orexis:Received .
  result:zz_moisture orexis:beliefsOf :keeper .
  sensed:zz_moisture a orexis:BeliefGraph .
  sensed:zz_moisture a orexis:Graph .
  sensed:zz_moisture a orexis:StateGraph .
  sensed:zz_moisture dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:15:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  sensed:zz_moisture orexis:arrivedBy orexis:Received .
  sensed:zz_moisture orexis:beliefsOf :keeper .
}
