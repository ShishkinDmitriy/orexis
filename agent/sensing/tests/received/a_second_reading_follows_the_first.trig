# a_second_reading_follows_the_first
#
# A reading of 0.25 stood from a quarter to twelve, holding until a quarter past — the next due at
# noon and a grace past it; bytes for 0.08 arrive at noon. Each reading is a percept of its own: the
# new one is named for its instant, in a graph of its own, and says the one before it is its
# `sensing:previous`; the one before is KEPT, and its period ends where the new one's begins, so a
# reader standing at noon or later is handed the new one alone (#944).
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix observed: <http://example.org/orexis/graph/observed/keeper/> .
@prefix prediction: <http://example.org/orexis/prediction#> .

GRAPH :ontology {
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:PerceptGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:PerceptGraph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :zamioculcas .
  :keeper orexis:localId "keeper" .
  :probe a sosa:Sensor .
  :probe sosa:isHostedBy :zamioculcas .
  :probe sosa:observes :moisture .
  :probe ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty [ a ssn-system:Frequency ; schema:unitCode unit:SEC ; schema:value 900 ] ] .
  :zamioculcas :driesPerDay 0.5 .
  :zamioculcas a :Pot .
  :zamioculcas ssn-system:hasOperatingRange :zamioculcas.operating .
  :zamioculcas ssn-system:hasSurvivalRange :zamioculcas.survival .
  :zamioculcas.operating a ssn-system:OperatingRange .
  :zamioculcas.operating ssn-system:inCondition [ schema:maxValue 0.3 ; schema:minValue 0.1 ; ssn:forProperty :moisture ] .
  :zamioculcas.survival a ssn-system:SurvivalRange .
  :zamioculcas.survival ssn-system:inCondition [ schema:maxValue 0.45 ; schema:minValue 0.02 ; ssn:forProperty :moisture ] .
}

GRAPH observed:probe_20260101T114500Z {
  orexis:obs_probe_20260101T114500Z a sosa:Observation .
  orexis:obs_probe_20260101T114500Z prov:wasGeneratedBy :keeper .
  orexis:obs_probe_20260101T114500Z sensing:rawResult 0.25 .
  orexis:obs_probe_20260101T114500Z sosa:madeBySensor :probe .
  orexis:obs_probe_20260101T114500Z sosa:resultTime "2026-01-01T11:45:00+00:00"^^xsd:dateTime .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  observed:probe_20260101T114500Z a orexis:Graph .
  observed:probe_20260101T114500Z a orexis:PerceptGraph .
  observed:probe_20260101T114500Z a sensing:ObservationGraph .
  observed:probe_20260101T114500Z dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:15:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T11:45:00+00:00"^^xsd:dateTime ] .
  observed:probe_20260101T114500Z orexis:arrivedBy orexis:Received .
  observed:probe_20260101T114500Z orexis:beliefsOf :keeper .
}
