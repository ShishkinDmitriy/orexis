# a_pot_and_its_probe
#
# THE WORLD SENSING IS HELD TO: one agent acting for one pot, the probe the pot hosts, the probe's
# quarter-hour frequency, and the pot's operating and survival ranges in SSN-System's words. Nothing
# about sides: those are the rules this layer registers, concluded by the deliberator. No reading:
# `received` writes those. No drift: the prediction package's world carries one.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix observed: <http://example.org/orexis/graph/observed/keeper/> .
@prefix predicted: <http://example.org/orexis/graph/predicted/keeper/> .

GRAPH :ontology {
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:BeliefGraph .
  sensing:ObservationGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:StateGraph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :zz .
  :keeper orexis:localId "keeper" .
  :probe <http://www.w3.org/ns/ssn/systems/hasOperatingRange> :probe.operating .
  :probe <http://www.w3.org/ns/ssn/systems/hasSystemCapability> [ <http://www.w3.org/ns/ssn/systems/hasSystemProperty> [ a <http://www.w3.org/ns/ssn/systems/Frequency> ; schema:unitCode unit:SEC ; schema:value 900 ] ] .
  :probe a sosa:Sensor .
  :probe sosa:isHostedBy :zz .
  :probe sosa:observes :moisture .
  :probe.operating <http://www.w3.org/ns/ssn/systems/inCondition> [ schema:maxValue 1.0 ; schema:minValue 0.0 ; ssn:forProperty :moisture ] .
  :probe.operating a <http://www.w3.org/ns/ssn/systems/OperatingRange> .
  :zz :driesPerDay 4.0 .
  :zz <http://www.w3.org/ns/ssn/systems/hasOperatingRange> :zz.operating .
  :zz <http://www.w3.org/ns/ssn/systems/hasSurvivalRange> :zz.survival .
  :zz a :Pot .
  :zz.operating <http://www.w3.org/ns/ssn/systems/inCondition> [ schema:maxValue 0.3 ; schema:minValue 0.1 ; ssn:forProperty :moisture ] .
  :zz.operating a <http://www.w3.org/ns/ssn/systems/OperatingRange> .
  :zz.survival <http://www.w3.org/ns/ssn/systems/inCondition> [ schema:maxValue 0.45 ; schema:minValue 0.02 ; ssn:forProperty :moisture ] .
  :zz.survival a <http://www.w3.org/ns/ssn/systems/SurvivalRange> .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
