# a_pot_and_its_probe
#
# THE WORLD SENSING IS HELD TO: one agent acting for one pot, the probe the pot hosts, the pot's own physics —
# four fractions a day, a fast dryer, so a reading inside its operating range meets the floor within the
# hour — the pot's operating and survival ranges in SSN-System's words, and the drift that predicts the
# number. Nothing about sides: those are the rules this layer registers, concluded by the deliberator.
# No reading: `received` writes those, and `predict` the stretches.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix observed: <http://example.org/orexis/graph/observed/keeper/> .
@prefix predicted: <http://example.org/orexis/graph/predicted/keeper/> .

GRAPH :ontology {
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:BeliefGraph .
  sensing:ObservationGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:StateGraph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :zz .
  :keeper orexis:localId "keeper" .
  :probe a sosa:Sensor .
  :probe sosa:isHostedBy :zz .
  :probe sosa:observes :moisture .
  :probe ssn-system:hasOperatingRange :probe.operating .
  :probe.operating a ssn-system:OperatingRange .
  :probe.operating ssn-system:inCondition [ schema:maxValue 1.0 ; schema:minValue 0.0 ; ssn:forProperty :moisture ] .
  :zz :driesPerDay 4.0 .
  :zz a :Pot .
  :zz ssn-system:hasOperatingRange :zz.operating .
  :zz ssn-system:hasSurvivalRange :zz.survival .
  :zz.operating a ssn-system:OperatingRange .
  :zz.operating ssn-system:inCondition [ schema:maxValue 0.3 ; schema:minValue 0.1 ; ssn:forProperty :moisture ] .
  :zz.survival a ssn-system:SurvivalRange .
  :zz.survival ssn-system:inCondition [ schema:maxValue 0.45 ; schema:minValue 0.02 ; ssn:forProperty :moisture ] .
}

GRAPH :actions {
  :Drying a sensing:Drift .
  :Drying rdfs:label "what a pot loses while nobody waters it" .
  :Drying sh:construct """PREFIX : <http://example.org/test#>
      CONSTRUCT {
          ?obs a sosa:Observation ;
               sosa:hasFeatureOfInterest ?pot ;
               sosa:observedProperty :moisture ;
               sosa:hasSimpleResult ?now ;
               sosa:resultTime ?at ;
               sosa:madeBySensor ?sensor .
      } WHERE {
          ?obs sosa:hasFeatureOfInterest ?pot ;
               sosa:observedProperty :moisture ;
               sosa:hasSimpleResult ?was .
          OPTIONAL { ?obs sosa:madeBySensor ?sensor }
          ?pot :driesPerDay ?rate .
          FILTER(?rate > 0 && $elapsed > 0)
          BIND(ROUND(($elapsed / 86400.0) * 1000000) / 1000000 AS ?days)
          BIND(?was - (?rate * ?days) AS ?fell)
          BIND(IF(?fell < 0.0, 0.0, ?fell) AS ?now)
          BIND($lands AS ?at)
      }""" .
}

GRAPH :catalogue {
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
