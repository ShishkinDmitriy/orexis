# a_bed_and_its_instruments
#
# THE WORLD A SUBJECT BELIEF IS HELD TO: one agent acting for one bed, and three instruments the bed
# hosts, each reporting every ten minutes — a probe of its soil moisture, a thermometer of its air and
# a hygrometer of its air's humidity. The bed's operating range states a condition for the soil and
# one for the air, each with the margin its instrument's noise asks for (0.0002 and 0.02, the
# greenhouse's); its survival range states one for the soil, with none. The two properties say which
# words a subject belief of them is spoken in — this test's own, standing in for climate's — and the
# humidity says none. And the vocabulary a subject belief graph is classified by, every step of it, as
# a boot's closure holds it.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

GRAPH :ontology {
  belief:RevisionGraph rdfs:subClassOf orexis:BeliefGraph .
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:SelfGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:SelfGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:BeliefGraph .
  sensing:ObservationGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:StateGraph .
  sensing:SubjectBeliefGraph rdfs:subClassOf orexis:BeliefGraph .
  sensing:SubjectBeliefGraph rdfs:subClassOf orexis:Graph .
  sensing:SubjectBeliefGraph rdfs:subClassOf orexis:StateGraph .
}

GRAPH :world {
  :AirTemperature sensing:aboveAs :Hot .
  :AirTemperature sensing:belowAs :Cold .
  :AirTemperature sensing:insideAs :Comfortable .
  :AirTemperature sensing:stateAs :air .
  :AirTemperature sensing:valueAs :temperature .
  :SoilMoisture sensing:aboveAs :Wet .
  :SoilMoisture sensing:belowAs :Dry .
  :SoilMoisture sensing:insideAs :Moist .
  :SoilMoisture sensing:stateAs :soil .
  :SoilMoisture sensing:valueAs :moisture .
  :bed a sosa:FeatureOfInterest .
  :bed ssn-system:hasOperatingRange :bed.operating .
  :bed ssn-system:hasSurvivalRange :bed.survival .
  :bed.operating a ssn-system:OperatingRange .
  :bed.operating ssn-system:inCondition [ schema:maxValue 0.6 ; schema:minValue 0.3 ; sensing:margin 0.0002 ; ssn:forProperty :SoilMoisture ] .
  :bed.operating ssn-system:inCondition [ schema:maxValue 24.0 ; schema:minValue 18.0 ; sensing:margin 0.02 ; ssn:forProperty :AirTemperature ] .
  :bed.survival a ssn-system:SurvivalRange .
  :bed.survival ssn-system:inCondition [ schema:maxValue 0.85 ; schema:minValue 0.1 ; ssn:forProperty :SoilMoisture ] .
  :hygrometer a sosa:Sensor .
  :hygrometer sosa:isHostedBy :bed .
  :hygrometer sosa:observes :AirHumidity .
  :hygrometer ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty [ a ssn-system:Frequency ; schema:unitCode unit:SEC ; schema:value 600 ] ] .
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :bed .
  :keeper orexis:localId "keeper" .
  :probe a sosa:Sensor .
  :probe sosa:isHostedBy :bed .
  :probe sosa:observes :SoilMoisture .
  :probe ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty [ a ssn-system:Frequency ; schema:unitCode unit:SEC ; schema:value 600 ] ] .
  :thermometer a sosa:Sensor .
  :thermometer sosa:isHostedBy :bed .
  :thermometer sosa:observes :AirTemperature .
  :thermometer ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty [ a ssn-system:Frequency ; schema:unitCode unit:SEC ; schema:value 600 ] ] .
}

GRAPH :self {
  :keeper a orexis:Self .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :self a orexis:BeliefGraph .
  :self a orexis:Graph .
  :self a orexis:SelfGraph .
  :self orexis:arrivedBy orexis:Asserted .
  :self orexis:beliefsOf :keeper .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
