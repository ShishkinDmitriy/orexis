@prefix : <http://example.org/orexis/sensing#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a sh:RulesGraph .    # this document is one graph, and this is what it is

#  THE RULES SENSING REGISTERS, in two layers, as SHACL 1.2 Inference Rules defines them, run by the
#  deliberator over every percept as sensing hands it in. What they conclude is the percept's revision,
#  and a percept's revision is a percept too (`sensing:ObservationGraph`, the kind sensing hands the
#  revision): handed to no reader of the mind, which
#  reads what a domain's TRANSITION makes of the percept arriving — the subject belief, held past a
#  margin by the state it replaces — and no rule here
#  (an-observation-is-a-percept-and-the-mind-reads-only-beliefs).
#
#  LAYER 0, WHAT AN OBSERVATION IS OF, AND ITS QUANTITY IN ITS PROPERTY'S UNIT. `received` writes
#  only what a sensor gave — its number (`sensing:rawResult`), who made it and when, and the percept
#  before it — and these conclude the rest: from the topology, the feature of interest (what the
#  sensor is hosted by, a sample or the subject itself) and the property (what it observes); and the
#  scaled quantity (`sensing:scaledResult`), the number as it is or, where a two-point scaling the
#  world states scales the sensor — a RESCALE, the unit changing — on the straight line through its
#  points. And whether the sensor is STUCK, from the percepts kept.
#
#  LAYER 1, ITS READING: the scaled quantity as it is or, where a two-point calibration corrects the
#  sensor — the unit staying, the instrument's error taken out — on the line through its points.
#
#  Both lines are unclamped, in doubles and rounded to six places as a decimal, measured: a decimal
#  division whose dividend is an exact zero binds nothing, and a double cast to a decimal carries
#  its binary error (1.100000000000000128) unless rounded after the cast.
#
#  THE SIDES ARE GONE (#944): which side of each of its subject's ranges a reading lay on was concluded
#  here at a third layer until nothing read it — the mind reads the subject's state in a domain's words,
#  and `tests/test_store.py` holds a text the mind reads off a reading's number.

:observation a sh:RuleSet ;
    rdfs:label "what an observation is of, its quantity, and its reading" ;
    sh:hasRule :ofRule , :asGivenRule , :scaledRule , :asScaledRule , :correctedRule .

:ofRule a sh:SPARQLRule ;
    rdfs:label "what the sensor observes, of what hosts it" ;
    sh:layer 0 ;
    sh:construct """
        CONSTRUCT { ?obs sosa:hasFeatureOfInterest ?feature ; sosa:observedProperty ?property }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:rawResult ?raw .
            ?sensor sosa:observes ?property ; sosa:isHostedBy ?feature .
        }""" .

:asGivenRule a sh:SPARQLRule ;
    rdfs:label "a number that is already a quantity in its property's unit" ;
    sh:layer 0 ;
    sh:construct """
        CONSTRUCT { ?obs sensing:scaledResult ?raw }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:rawResult ?raw .
            FILTER NOT EXISTS { ?scaling sensing:scales ?sensor }
        }""" .

:scaledRule a sh:SPARQLRule ;
    rdfs:label "a number on the line through a two-point scaling's points" ;
    sh:layer 0 ;
    sh:construct """
        CONSTRUCT { ?obs sensing:scaledResult ?value }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:rawResult ?raw .
            ?scaling a sensing:TwoPointScaling ; sensing:scales ?sensor ; sensing:point ?a , ?b .
            ?a sensing:reads ?ra ; sensing:standsFor ?qa .
            ?b sensing:reads ?rb ; sensing:standsFor ?qb .
            FILTER(?ra < ?rb)
            FILTER NOT EXISTS { ?scaling sensing:point ?c . ?c sensing:reads ?rc FILTER(?rc != ?ra && ?rc != ?rb) }
            BIND(ROUND(xsd:decimal(xsd:double(?qa) + ((xsd:double(?raw) - xsd:double(?ra)) * (xsd:double(?qb) - xsd:double(?qa)))
                                                   / (xsd:double(?rb) - xsd:double(?ra))) * 1000000) / 1000000 AS ?value)
        }""" .

:asScaledRule a sh:SPARQLRule ;
    rdfs:label "a quantity no calibration corrects" ;
    sh:layer 1 ;
    sh:construct """
        CONSTRUCT { ?obs sosa:hasSimpleResult ?scaled }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:scaledResult ?scaled .
            FILTER NOT EXISTS { ?calibration sensing:corrects ?sensor }
        }""" .

:correctedRule a sh:SPARQLRule ;
    rdfs:label "a quantity on the line through a two-point calibration's points" ;
    sh:layer 1 ;
    sh:construct """
        CONSTRUCT { ?obs sosa:hasSimpleResult ?value }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:scaledResult ?scaled .
            ?calibration a sensing:TwoPointCalibration ; sensing:corrects ?sensor ; sensing:point ?a , ?b .
            ?a sensing:reads ?ra ; sensing:standsFor ?qa .
            ?b sensing:reads ?rb ; sensing:standsFor ?qb .
            FILTER(?ra < ?rb)
            FILTER NOT EXISTS { ?calibration sensing:point ?c . ?c sensing:reads ?rc FILTER(?rc != ?ra && ?rc != ?rb) }
            BIND(ROUND(xsd:decimal(xsd:double(?qa) + ((xsd:double(?scaled) - xsd:double(?ra)) * (xsd:double(?qb) - xsd:double(?qa)))
                                                   / (xsd:double(?rb) - xsd:double(?ra))) * 1000000) / 1000000 AS ?value)
        }""" .

#  STUCK (knowledge/domain/sensing/stuck.md, #462, #944): a sensor whose last `sensing:stuckAfter`
#  readings all gave one number is stuck on it. A rule over the PERCEPTS KEPT — `received` keeps that
#  many of a sensor's and forgets the rest — concluded in the revision of the percept arriving, so it
#  holds while that percept does and the next reading, differing, finds the kept ones no longer
#  agree. The percepts before the one arriving are no testimony a revision is handed, so this rule
#  reads them where they lie, by the kind sensing keeps them in, as it reads the limit off the agent's
#  self graph — the one rule here that reaches past its arrival, and only into what this layer keeps;
#  `received` reads the same stance with the same figure, six, where none is stated. Identical is the
#  RAW number, since a clamp or a rescale can make two counts one reading, and a sensor stating no
#  frequency is never said stuck, as it is never said silent. Run once: it reads no conclusion.

:stuck a sh:RuleSet ;
    rdfs:label "whether a sensor keeps giving one number" ;
    sh:hasRule :stuckRule .

:stuckRule a sh:SPARQLRule ;
    rdfs:label "a sensor whose last stuckAfter readings all gave one number" ;
    sh:layer 0 ;
    sh:runOnce true ;
    sh:construct """
        CONSTRUCT { ?sensor sensing:stuckOn ?raw }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:rawResult ?raw .
            ?sensor ssn-system:hasSystemCapability/ssn-system:hasSystemProperty ?frequency .
            ?frequency a ssn-system:Frequency .
            {
                SELECT ?sensor (COUNT(DISTINCT ?kept) AS ?readings) (COUNT(DISTINCT ?number) AS ?numbers) WHERE {
                    GRAPH ?cat { ?cat a orexis:CatalogueGraph . ?percept a sensing:ObservationGraph }
                    GRAPH ?percept { ?kept sosa:madeBySensor ?sensor ; sensing:rawResult ?number }
                } GROUP BY ?sensor
            }
            {
                SELECT (COUNT(?stated) AS ?statements) (SAMPLE(?stated) AS ?figure) WHERE {
                    OPTIONAL {
                        GRAPH ?catalogue { ?catalogue a orexis:CatalogueGraph . ?self a orexis:SelfGraph }
                        GRAPH ?self { ?me a orexis:Self ; sensing:stuckAfter ?stated }
                    }
                }
            }
            BIND(IF(?statements = 1 && isNumeric(?figure), ?figure, 6) AS ?limit)
            FILTER(?numbers = 1 && ?readings >= ?limit)
        }""" .
