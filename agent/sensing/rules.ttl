@prefix : <http://example.org/orexis/sensing#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a sh:RulesGraph .    # this document is one graph, and this is what it is

#  THE RULES SENSING REGISTERS, in three layers, as SHACL 1.2 Inference Rules defines them, run by the
#  deliberator over every observation and every predicted observation.
#
#  LAYER 0, WHAT AN OBSERVATION IS OF, AND ITS QUANTITY IN ITS PROPERTY'S UNIT. `received` writes
#  only what a sensor gave — its number (`sensing:rawResult`), who made it and when — and these
#  conclude the rest: from the topology, the feature of interest (what the sensor is hosted by, a
#  sample or the subject itself) and the property (what it observes); and the scaled quantity
#  (`sensing:scaledResult`), the number as it is or, where a two-point scaling the world states
#  scales the sensor — a RESCALE, the unit changing — on the straight line through its points.
#
#  LAYER 1, ITS READING: the scaled quantity as it is or, where a two-point calibration corrects the
#  sensor — the unit staying, the instrument's error taken out — on the line through its points.
#
#  Both lines are unclamped, in doubles and rounded to six places as a decimal, measured: a decimal
#  division whose dividend is an exact zero binds nothing, and a double cast to a decimal carries
#  its binary error (1.100000000000000128) unless rounded after the cast.
#
#  LAYER 2, WHICH SIDE of each of its subject's ranges an observation's reading lies on — over what
#  layer 1 concluded, and over a predicted observation, which the prediction writes whole.

:observation a sh:RuleSet ;
    rdfs:label "what an observation is of, its quantity, and its reading" ;
    sh:hasRule :ofRule , :asGivenRule , :scaledRule , :asScaledRule , :correctedRule .

:ofRule a sh:SPARQLRule ;
    rdfs:label "what the sensor observes, of what hosts it" ;
    sh:layer 0 ;
    sh:construct """
        CONSTRUCT { ?obs sosa:hasFeatureOfInterest ?feature ; sosa:observedProperty ?property }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:rawResult ?raw .
            ?sensor sosa:observes ?property ; sosa:isHostedBy ?feature .
        }""" .

:asGivenRule a sh:SPARQLRule ;
    rdfs:label "a number that is already a quantity in its property's unit" ;
    sh:layer 0 ;
    sh:construct """
        CONSTRUCT { ?obs sensing:scaledResult ?raw }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:rawResult ?raw .
            FILTER NOT EXISTS { ?scaling sensing:scales ?sensor }
        }""" .

:scaledRule a sh:SPARQLRule ;
    rdfs:label "a number on the line through a two-point scaling's points" ;
    sh:layer 0 ;
    sh:construct """
        CONSTRUCT { ?obs sensing:scaledResult ?value }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:rawResult ?raw .
            ?scaling a sensing:TwoPointScaling ; sensing:scales ?sensor ; sensing:point ?a , ?b .
            ?a sensing:reads ?ra ; sensing:standsFor ?qa .
            ?b sensing:reads ?rb ; sensing:standsFor ?qb .
            FILTER(?ra < ?rb)
            FILTER NOT EXISTS { ?scaling sensing:point ?c . ?c sensing:reads ?rc FILTER(?rc != ?ra && ?rc != ?rb) }
            BIND(ROUND(xsd:decimal(xsd:double(?qa) + ((xsd:double(?raw) - xsd:double(?ra)) * (xsd:double(?qb) - xsd:double(?qa)))
                                                   / (xsd:double(?rb) - xsd:double(?ra))) * 1000000) / 1000000 AS ?value)
        }""" .

:asScaledRule a sh:SPARQLRule ;
    rdfs:label "a quantity no calibration corrects" ;
    sh:layer 1 ;
    sh:construct """
        CONSTRUCT { ?obs sosa:hasSimpleResult ?scaled }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:scaledResult ?scaled .
            FILTER NOT EXISTS { ?calibration sensing:corrects ?sensor }
        }""" .

:correctedRule a sh:SPARQLRule ;
    rdfs:label "a quantity on the line through a two-point calibration's points" ;
    sh:layer 1 ;
    sh:construct """
        CONSTRUCT { ?obs sosa:hasSimpleResult ?value }
        WHERE {
            ?obs a sosa:Observation ; sosa:madeBySensor ?sensor ; sensing:scaledResult ?scaled .
            ?calibration a sensing:TwoPointCalibration ; sensing:corrects ?sensor ; sensing:point ?a , ?b .
            ?a sensing:reads ?ra ; sensing:standsFor ?qa .
            ?b sensing:reads ?rb ; sensing:standsFor ?qb .
            FILTER(?ra < ?rb)
            FILTER NOT EXISTS { ?calibration sensing:point ?c . ?c sensing:reads ?rc FILTER(?rc != ?ra && ?rc != ?rb) }
            BIND(ROUND(xsd:decimal(xsd:double(?qa) + ((xsd:double(?scaled) - xsd:double(?ra)) * (xsd:double(?qb) - xsd:double(?qa)))
                                                   / (xsd:double(?rb) - xsd:double(?ra))) * 1000000) / 1000000 AS ?value)
        }""" .

:sides a sh:RuleSet ;
    rdfs:label "which side of each of its subject's ranges an observation is on" ;
    sh:hasRule :belowRule , :insideRule , :aboveRule .

:belowRule a sh:SPARQLRule ;
    sh:layer 2 ;
    rdfs:label "under the floor" ;
    sh:construct """
        CONSTRUCT { ?obs sensing:below ?range } WHERE {
            ?obs a sosa:Observation ; sosa:observedProperty ?property ; sosa:hasSimpleResult ?value .
            ?obs (sosa:hasFeatureOfInterest/(sosa:isSampleOf)?)|sosa:madeBySensor ?holder .
            ?holder ssn-system:hasOperatingRange|ssn-system:hasSurvivalRange ?range .
            ?range ssn-system:inCondition ?condition .
            ?condition ssn:forProperty ?property ; schema:minValue ?low .
            FILTER(?value < ?low)
        }""" .

:insideRule a sh:SPARQLRule ;
    sh:layer 2 ;
    rdfs:label "within the range, bounds included" ;
    sh:construct """
        CONSTRUCT { ?obs sensing:inside ?range } WHERE {
            ?obs a sosa:Observation ; sosa:observedProperty ?property ; sosa:hasSimpleResult ?value .
            ?obs (sosa:hasFeatureOfInterest/(sosa:isSampleOf)?)|sosa:madeBySensor ?holder .
            ?holder ssn-system:hasOperatingRange|ssn-system:hasSurvivalRange ?range .
            ?range ssn-system:inCondition ?condition .
            ?condition ssn:forProperty ?property ; schema:minValue ?low ; schema:maxValue ?high .
            FILTER(?value >= ?low && ?value <= ?high)
        }""" .

:aboveRule a sh:SPARQLRule ;
    sh:layer 2 ;
    rdfs:label "over the ceiling" ;
    sh:construct """
        CONSTRUCT { ?obs sensing:above ?range } WHERE {
            ?obs a sosa:Observation ; sosa:observedProperty ?property ; sosa:hasSimpleResult ?value .
            ?obs (sosa:hasFeatureOfInterest/(sosa:isSampleOf)?)|sosa:madeBySensor ?holder .
            ?holder ssn-system:hasOperatingRange|ssn-system:hasSurvivalRange ?range .
            ?range ssn-system:inCondition ?condition .
            ?condition ssn:forProperty ?property ; schema:maxValue ?high .
            FILTER(?value > ?high)
        }""" .
