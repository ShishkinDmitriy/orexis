@prefix orexis: <http://example.org/orexis#> .
@prefix : <http://example.org/orexis/prediction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix onboarding: <http://example.org/orexis/onboarding#> .

<> a onboarding:RequirementGraph .    # this document is one graph, and this is what it is

#  WHAT A WORLD MUST STATE OF prediction's WORDS, held by onboarding alone before anything is granted
#  (knowledge/domain/onboarding/requirement.md, #838). No agent loads this graph: its kind is
#  onboarding's, and the boot passes over it as it passes over a world's hardware.

[] a sh:NodeShape ;
    sh:targetClass :Predictor ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a predictor with no sensor of its own or no drift: it would foresee nothing" ;
        sh:select """SELECT $this WHERE { ?me orexis:plays $this
            FILTER (NOT EXISTS { ?me orexis:actsFor ?subject . ?subject schema:containedInPlace* ?host .
                                 ?sensor sosa:isHostedBy/(sosa:isSampleOf)? ?host }
                    || NOT EXISTS { ?drift a prediction:Drift }) }""" ] .
