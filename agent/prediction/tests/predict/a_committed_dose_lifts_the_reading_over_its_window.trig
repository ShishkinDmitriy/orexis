# a_committed_dose_lifts_the_reading_over_its_window
#
# A step the executor has committed to stands in the beliefs as a graph holding over its landing
# window (execution:CommittedStepGraph), and a drift reads it there: the tap the step opens lifts the
# pot's moisture by 0.15 toward an aim of 0.27 — over 600 seconds on the high trajectory, the earliest
# landing, and over 1200 on the low, the latest, which is how a late landing widens the corridor. The
# window's start and end are happenings, and nothing of this package learned the word.
#
# Read at 0.12 and drying four fractions a day, the pot alone meets the operating floor at 0.10 in 7.2
# minutes, before the first stretch opens. The window opens at 12:05 and closes at 12:25: at 12:05 both
# trajectories stand at 0.106111; by 12:25 the high has reached the aim at 12:18:25 and dried to
# 0.251690, the low has risen to 0.200556. Both dry from there, so the low trajectory crosses the
# operating floor 2172 seconds past 12:25, at 13:01:12, and the survival floor at 0.02 another 1728
# seconds on, at 13:30:00, placed to the whole second after — three stretches from a quarter past,
# the first inside its range because of the dose.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix prediction: <http://example.org/orexis/prediction#> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix predicted: <http://example.org/orexis/graph/predicted/keeper/> .
@prefix observed: <http://example.org/orexis/graph/observed/keeper/> .
@prefix committed: <http://example.org/orexis/graph/committed/keeper/> .

GRAPH :ontology {
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:PerceptGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  execution:CommittedStepGraph rdfs:subClassOf orexis:BeliefGraph .
  execution:CommittedStepGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :zamioculcas .
  :keeper orexis:localId "keeper" .
  :probe a sosa:Sensor .
  :probe sosa:isHostedBy :zamioculcas .
  :probe sosa:observes :moisture .
  :tap :waters :zamioculcas .
  :tap :risesBy 0.15 .
  :tap :aimsAt 0.27 .
  :zamioculcas :driesPerDay 4.0 .
  :zamioculcas a :Pot .
  :zamioculcas ssn-system:hasOperatingRange :zamioculcas.operating .
  :zamioculcas ssn-system:hasSurvivalRange :zamioculcas.survival .
  :zamioculcas.operating a ssn-system:OperatingRange .
  :zamioculcas.operating ssn-system:inCondition [ schema:maxValue 0.3 ; schema:minValue 0.1 ; ssn:forProperty :moisture ] .
  :zamioculcas.survival a ssn-system:SurvivalRange .
  :zamioculcas.survival ssn-system:inCondition [ schema:maxValue 0.45 ; schema:minValue 0.02 ; ssn:forProperty :moisture ] .
}

GRAPH :actions {
  :Drying a prediction:Drift .
  :Drying prediction:moves :moisture .
  :Drying prediction:rate """PREFIX : <http://example.org/test#>
      SELECT ?rate ?until WHERE {
          $feature :driesPerDay ?perDay .
          BIND(-xsd:double(?perDay) / 86400.0 AS ?rate)
          BIND(0.0 AS ?until)
      }""" .
  :Dosed a prediction:Drift .
  :Dosed prediction:moves :moisture .
  :Dosed prediction:rate """PREFIX : <http://example.org/test#>
      PREFIX execution: <http://example.org/orexis/execution#>
      SELECT ?low ?high ?until WHERE {
          ?step :tap ?tap ; execution:landsWithinS ?soon ; execution:answeredWithinS ?late .
          ?tap :waters $feature ; :risesBy ?rise ; :aimsAt ?until .
          BIND(xsd:double(?rise) / xsd:double(?soon) AS ?high)
          BIND(xsd:double(?rise) / xsd:double(?late) AS ?low)
      }""" .
}

GRAPH observed:zamioculcas_moisture {
  orexis:obs_zamioculcas_moisture a sosa:Observation .
  orexis:obs_zamioculcas_moisture prov:wasGeneratedBy :keeper .
  orexis:obs_zamioculcas_moisture sosa:hasFeatureOfInterest :zamioculcas .
  orexis:obs_zamioculcas_moisture sosa:hasSimpleResult 0.12 .
  orexis:obs_zamioculcas_moisture sosa:madeBySensor :probe .
  orexis:obs_zamioculcas_moisture sosa:observedProperty :moisture .
  orexis:obs_zamioculcas_moisture sosa:resultTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
}

GRAPH committed:plan_dose {
  :plan_dose a execution:Step .
  :plan_dose :tap :tap .
  :plan_dose execution:landsWithinS 600 .
  :plan_dose execution:answeredWithinS 1200 .
}

GRAPH :catalogue {
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :actions a orexis:DriftGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  committed:plan_dose a execution:CommittedStepGraph .
  committed:plan_dose dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:25:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:05:00+00:00"^^xsd:dateTime ] .
  committed:plan_dose orexis:arrivedBy orexis:Recorded .
  committed:plan_dose orexis:beliefsOf :keeper .
  observed:zamioculcas_moisture a orexis:Graph .
  observed:zamioculcas_moisture a orexis:PerceptGraph .
  observed:zamioculcas_moisture dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:15:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  observed:zamioculcas_moisture orexis:arrivedBy orexis:Received .
  observed:zamioculcas_moisture orexis:beliefsOf :keeper .
}
