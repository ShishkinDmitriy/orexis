# a_rule_declares_its_prefixes
#
# The construct speaks `t:`, a name neither its text nor the store's dictionary declares; the
# rule's sh:prefixes point at an ontology node whose sh:declare block binds it, as SHACL-SPARQL
# says, and the side is concluded under the test namespace.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sensed: <http://example.org/test#sensed/> .

GRAPH :ontology {
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :zz :high 0.3 .
  :zz :low 0.1 .
  :zz a :Pot .
}

GRAPH :rules {
  :below a sh:RuleSet .
  :below rdfs:label "a rule speaking a name only its sh:prefixes declare" .
  :below sh:hasRule [ a sh:SPARQLRule ; sh:construct """CONSTRUCT { ?obs t:side t:Below } WHERE {
      ?obs a t:Observation ; t:of ?s ; t:reads ?v . ?s t:low ?lo . FILTER(?v < ?lo) }""" ; sh:prefixes :vocabulary ] .
  :vocabulary sh:declare [ sh:namespace "http://example.org/test#"^^xsd:anyURI ; sh:prefix "t" ] .
}

GRAPH :sensed {
  :obs1 :of :zz .
  :obs1 :reads 0.05 .
  :obs1 a :Observation .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :rules a orexis:Graph .
  :rules a sh:RulesGraph .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :sensed orexis:arrivedBy orexis:Received .
  :sensed orexis:beliefsOf :keeper .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
