# a_state_is_replaced_where_it_stood
#
# A tick arrives, and the one transition its kind triggers counts it: the count before, 1, held in
# the state graph an earlier tick's transition wrote, is deleted there — the graph left empty, and
# forgotten with its row — and the count after, 2, is inserted into the state graph the runner
# prepares for the arriving tick, the tick's owner's and derived, holding over the tick's period. The
# tick itself, a state graph received, is read and not touched.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tick1: <http://example.org/test#tick1/> .
@prefix tick2: <http://example.org/test#tick2/> .

GRAPH :ontology {
  :TickGraph rdfs:subClassOf orexis:BeliefGraph .
  :TickGraph rdfs:subClassOf orexis:Graph .
  :TickGraph rdfs:subClassOf orexis:StateGraph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :counter a :Counter .
  :keeper a orexis:Agent .
}

GRAPH :rules {
  :countRule a belief:Transition .
  :countRule belief:delete """PREFIX : <http://example.org/test#>
      DELETE { ?c :count ?n } WHERE { ?t a :Tick . ?c a :Counter ; :count ?n }""" .
  :countRule rdfs:label "a tick counts one more than the count before" .
  :countRule sh:construct """PREFIX : <http://example.org/test#>
      CONSTRUCT { ?c :count ?next } WHERE { ?t a :Tick . ?c a :Counter . OPTIONAL { ?c :count ?n } BIND((COALESCE(?n, 0) + 1) AS ?next) }""" .
}

GRAPH :tick2 {
  :t2 a :Tick .
}

GRAPH tick1:believed {
  :counter :count 1 .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :rules a orexis:Graph .
  :rules a sh:RulesGraph .
  :tick2 a :TickGraph .
  :tick2 a orexis:BeliefGraph .
  :tick2 a orexis:Graph .
  :tick2 a orexis:StateGraph .
  :tick2 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:30:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:10:00+00:00"^^xsd:dateTime ] .
  :tick2 orexis:arrivedBy orexis:Received .
  :tick2 orexis:beliefsOf :keeper .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  tick1:believed a orexis:BeliefGraph .
  tick1:believed a orexis:Graph .
  tick1:believed a orexis:StateGraph .
  tick1:believed dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:20:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  tick1:believed orexis:arrivedBy orexis:Derived .
  tick1:believed orexis:beliefsOf :keeper .
}
