# a_reading_is_the_band_its_number_falls_in
#
# Three readings of one pot's moisture, one per zone of the range it states, and one of a
# property no band is minted for. `entail` over the graph of readings asserts on each the
# member band its number falls in and the family that band sits beneath — and nothing above
# `sosa:Observation`, which the node was typed already — and nothing at all on the fourth.
#
# The number is read from the reading's own graph here; `revise` keeps it in a graph beside
# and hands both to read.
@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sensed: <http://example.org/orexis/graph/sensed/keeper/> .
@prefix result: <http://example.org/orexis/graph/result/keeper/> .
@prefix predicted: <http://example.org/orexis/graph/predicted/keeper/> .

# THE VOCABULARY THE CASE IS LOADED WITH: what the graph kinds are beneath, the three band
# families, and the member bands genesis would mint for the pot's moisture from the range it
# states — 0.10 to 0.30 of saturation, the loner's zamioculcas.
GRAPH :ontology {
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
  orexis:band.zz.moisture.above a owl:Class .
  orexis:band.zz.moisture.above owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( sosa:Observation [ a owl:Restriction ; owl:hasValue :zz ; owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ; owl:hasValue :moisture ; owl:onProperty sosa:observedProperty ] [ a owl:Restriction ; owl:onProperty sosa:hasSimpleResult ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ; owl:withRestrictions ( [ xsd:minExclusive 0.3 ] ) ] ] ) ] .
  orexis:band.zz.moisture.above rdfs:label "moisture above 0.30" .
  orexis:band.zz.moisture.above rdfs:subClassOf sensing:AboveRegion .
  orexis:band.zz.moisture.above sensing:ofProperty :moisture .
  orexis:band.zz.moisture.above sensing:ofSubject :zz .
  orexis:band.zz.moisture.below a owl:Class .
  orexis:band.zz.moisture.below owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( sosa:Observation [ a owl:Restriction ; owl:hasValue :zz ; owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ; owl:hasValue :moisture ; owl:onProperty sosa:observedProperty ] [ a owl:Restriction ; owl:onProperty sosa:hasSimpleResult ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ; owl:withRestrictions ( [ xsd:maxExclusive 0.1 ] ) ] ] ) ] .
  orexis:band.zz.moisture.below rdfs:label "moisture below 0.10" .
  orexis:band.zz.moisture.below rdfs:subClassOf sensing:BelowRegion .
  orexis:band.zz.moisture.below sensing:ofProperty :moisture .
  orexis:band.zz.moisture.below sensing:ofSubject :zz .
  orexis:band.zz.moisture.inside a owl:Class .
  orexis:band.zz.moisture.inside owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( sosa:Observation [ a owl:Restriction ; owl:hasValue :zz ; owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ; owl:hasValue :moisture ; owl:onProperty sosa:observedProperty ] [ a owl:Restriction ; owl:onProperty sosa:hasSimpleResult ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ; owl:withRestrictions ( [ xsd:minInclusive 0.1 ] [ xsd:maxInclusive 0.3 ] ) ] ] ) ] .
  orexis:band.zz.moisture.inside rdfs:label "moisture inside 0.10-0.30" .
  orexis:band.zz.moisture.inside rdfs:subClassOf sensing:InRegion .
  orexis:band.zz.moisture.inside sensing:ofProperty :moisture .
  orexis:band.zz.moisture.inside sensing:ofSubject :zz .
  sensing:AboveRegion rdfs:subClassOf sosa:Observation .
  sensing:BelowRegion rdfs:subClassOf sosa:Observation .
  sensing:InRegion rdfs:subClassOf sosa:Observation .
  sensing:ResultGraph rdfs:subClassOf orexis:BeliefGraph .
}

GRAPH :world {
  :zz a :Pot .
}

GRAPH :sensed {
  :dry a sosa:Observation .
  :dry sosa:hasFeatureOfInterest :zz .
  :dry sosa:hasSimpleResult 0.05 .
  :dry sosa:observedProperty :moisture .
  :fine a sosa:Observation .
  :fine sosa:hasFeatureOfInterest :zz .
  :fine sosa:hasSimpleResult 0.3 .
  :fine sosa:observedProperty :moisture .
  :warm a sosa:Observation .
  :warm sosa:hasFeatureOfInterest :zz .
  :warm sosa:hasSimpleResult 22 .
  :warm sosa:observedProperty :warmth .
  :wet a sosa:Observation .
  :wet sosa:hasFeatureOfInterest :zz .
  :wet sosa:hasSimpleResult 0.31 .
  :wet sosa:observedProperty :moisture .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :sensed orexis:arrivedBy orexis:Received .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
