@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rules for the Actuation module.

ag:ActuatingAgentShape a sh:NodeShape ;
    rdfs:comment "An agent that actuates must own the hardware it drives. Winning a voucher is not this capability — redeeming one is." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this <http://example.org/agora#hasCapability>
                                       <http://example.org/agora#Actuation> }
        """ ] ;
    sh:property [ sh:path ag:hasActuator ; sh:minCount 1 ; sh:class ag:Actuator ;
                  sh:message "an agent that actuates must own at least one actuator" ] .

ag:ActuatorShape a sh:NodeShape ;
    rdfs:comment "An actuator delivers to exactly one subject, states where it takes its commands, and carries its own calibration and hard cap — so dosing is a fact about the device, not a constant in code." ;
    sh:targetClass ag:Actuator ;
    sh:property [ sh:path ag:actuates ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ag:commandTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ag:mlPerSecond ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path ag:maxDoseMl ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ;
                  sh:message "an actuator must cap its own dose, whatever the voucher says" ] .
