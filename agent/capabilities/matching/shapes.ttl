@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ag:HostStatesHowItMatchesShape a sh:NodeShape ;
    rdfs:comment "A host must say how it matches. Without it no matching capability is derived, `agent.provider` finds nobody, and the failure arrives at the END of a round — bids collected, deadline passed, nothing to allocate them with, and every bidder waiting on a voucher that will not come. That is expensive and silent, and it is exactly what a world can be held to before anything starts. Targeted at whoever hosts rather than at ag:Agent, because an agent that hosts nothing has no auction to state terms for." ;
    sh:targetSubjectsOf ag:hosts ;
    sh:property [ sh:path ag:matchesBy ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class ag:MatchingCapability ;
                  sh:message "a host must state how it matches bids — one ag:matchesBy naming a matching capability" ] .

ag:OnlyAHostMatchesShape a sh:NodeShape ;
    rdfs:comment "The mirror: stating how you would run an auction you cannot convene is an authoring slip, not a choice. The derivation already ignores it — it is guarded on ag:hosts — so without this the statement would sit in the world doing nothing, which is the shape of a fact somebody will later believe." ;
    sh:targetSubjectsOf ag:matchesBy ;
    sh:property [ sh:path ag:hosts ; sh:minCount 1 ; sh:class ag:Market ;
                  sh:message "only a host states how it matches — this agent hosts no market" ] .
