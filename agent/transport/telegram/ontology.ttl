@prefix orexis: <http://example.org/orexis#> .
@prefix speech: <http://example.org/orexis/speech#> .
@prefix telegram: <http://example.org/orexis/telegram#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<> a orexis:OntologyGraph .    # this document is one graph, and this is what it is

#  OREXIS TELEGRAM TRANSPORT. Its words are the channel and how it is reached: a chat, the bot an agent reaches it
#  through, and the user a person writes as. Which row reads a chat is what points at it — the channel of a
#  `speech:Chat` is a person's prose, translation's — and the member knows nothing of what the words mean.

telegram:Chat a owl:Class ; rdfs:label "Telegram chat" ;
    rdfs:comment "A chat on Telegram - one with a person, or a group - named by the `telegram:chatId` the Bot API gives it. One chat may be reached through several bots, one per agent in it." .

telegram:chatId a owl:DatatypeProperty ; rdfs:domain telegram:Chat ; rdfs:label "chat id" ;
    rdfs:comment "The id the Bot API names a chat by, a number, negative for a group: read from `getUpdates` once someone has written in it. A person's own, so a world states it in a document under `secrets/` where it is." .

telegram:Bot a owl:Class ; rdfs:label "Telegram bot" ;
    rdfs:comment "An agent's account on Telegram, the user agent it speaks through there. Where the Bot API answers is its `schema:url`, a deployment fact told to the agent as `TELEGRAM_URL`; its token is the one secret, `TELEGRAM_BOT_TOKEN` in `secrets/telegram-<agent>.env`, never a graph." .

telegram:hasBot a owl:ObjectProperty ; rdfs:range telegram:Bot ; rdfs:label "has bot" ;
    rdfs:comment "The bot an agent speaks through on Telegram: the agent's own, so in a group with several agents each speaks in its own name." .

telegram:userId a owl:DatatypeProperty ; rdfs:label "user id" ;
    rdfs:comment "The id the Bot API gives a person who writes, which tells two people in one group apart; a person's own, stated under `secrets/` where it is. A chat with one person needs none." .

#  WHAT THE MEMBER DOES OVER A STRETCH OF TIME, a `prov:Activity`, and its trigger: the agent's own words translation
#  kept for a channel, speech's event, which the member - above speech - puts beneath it
#  (knowledge/domain/kernel/policy.md).

telegram:Trigger a owl:Class ; rdfs:subClassOf orexis:Event ; rdfs:label "Trigger" ;
    rdfs:comment "The Telegram transport's trigger, abstract: an event beneath it is beneath the one trigger below." .

telegram:Carrying a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Carrying" ;
    rdfs:comment "Sending the agent's own words a prose graph keeps on their channel, where the Telegram member carries it, as a reply where the words name one and the carrier threads it." .

telegram:CarryingTrigger a owl:Class ; rdfs:subClassOf telegram:Trigger ; rdfs:label "Carrying trigger" ;
    rdfs:comment "What starts a carrying: speech's `speech:ProseKept`, beneath it here, naming the prose graph whose words it carries where they are the agent's own (`speech:kept`), and `speech:WritingAnnounced`, naming the channel the agent says it is writing on (`speech:channel`). The policy judges by the graph's provenance: a person's words it kept itself are translation's." .

speech:ProseKept rdfs:subClassOf telegram:CarryingTrigger .
speech:WritingAnnounced rdfs:subClassOf telegram:CarryingTrigger .
