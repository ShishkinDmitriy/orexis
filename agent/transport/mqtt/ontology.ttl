@prefix orexis: <http://example.org/orexis#> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mqtt: <http://example.org/orexis/mqtt#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<> a orexis:OntologyGraph .    # this document is one graph, and this is what it is

#  OREXIS MQTT TRANSPORT, AGENT 0.2.0.
#  The MQTT transport of Agent 0.2.0 declares no word of the bus of its own, only its trigger: it speaks MQTT4SSN, the ontology
#  that extends SSN and SOSA with the MQTT protocol in the OASIS specification's terms, and these
#  are the terms it reads. A sensor observesTopic the Topic it publishes on,
#  a board that takes commands listensToTopic another, a TopicFilter matchesTopic a Topic and
#  carries its hasFilterPattern — the one place a topic's name is said, since MQTT4SSN names a
#  topic through the filters that match it and a topic name is itself a valid filter — and a
#  Client, board or agent, isConnectedToBroker a Broker. The broker's address is a deployment fact,
#  stated in a graph of a kind no agent loads, and is never read off the world. The adoption is by prefix: this file names MQTT4SSN's namespace
#  and speaks its words, and the vendored copy the tests read is
#  tests/fixtures/vocabularies/mqtt4ssn.ttl.
#
#  A TRANSPORT IS NO ROLE, so it declares none: it is loaded where a loaded role needs bytes and the
#  society wires a bus (agent/runtime.py, `TRANSPORTS`). What it ships is the one need a role states
#  in this transport's words — a SPEAKER HEARS ON A TOPIC IT LISTENS TO — since speech, beneath the
#  transport, speaks none of them; `orexis-onboard` refuses a speaker whose world names no topic it
#  listens to, as it refuses a topic an agent listens to that no speaker hears
#  (a-package-is-loaded-only-for-a-role-the-agent-is-declared-in).

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix speech: <http://example.org/orexis/speech#> .

#  WHAT THE MEMBER DOES OVER A STRETCH OF TIME, a `prov:Activity`, and its trigger: the agent's own words translation
#  kept for a channel, speech's event, which the member - above speech - puts beneath it
#  (knowledge/domain/kernel/policy.md).

mqtt:Trigger a owl:Class ; rdfs:subClassOf orexis:Event ; rdfs:label "Trigger" ;
    rdfs:comment "The MQTT transport's trigger, abstract: an event beneath it is beneath the one trigger below." .

mqtt:Carrying a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Carrying" ;
    rdfs:comment "Sending the agent's own words a prose graph keeps on their channel, where the MQTT member carries it, as a reply where the words name one and the carrier threads it." .

mqtt:CarryingTrigger a owl:Class ; rdfs:subClassOf mqtt:Trigger ; rdfs:label "Carrying trigger" ;
    rdfs:comment "What starts a carrying: speech's `speech:ProseKept`, beneath it here, naming the prose graph whose words it carries where they are the agent's own (`speech:kept`). The policy judges by the graph's provenance: a person's words it kept itself are translation's." .

speech:ProseKept rdfs:subClassOf mqtt:CarryingTrigger .

#  AND A DOCUMENT THE AGENT SAID, speech's `speech:Said`, which the member - above speech - puts beneath its telling
#  trigger, since a peer is reached over the bus.

mqtt:Telling a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Telling" ;
    rdfs:comment "Publishing a document the agent said to each agent it is to that listens on a topic of the bus, the document read back from the store as it was said." .

mqtt:TellingTrigger a owl:Class ; rdfs:subClassOf mqtt:Trigger ; rdfs:label "Telling trigger" ;
    rdfs:comment "What starts a telling: speech's `speech:Said`, beneath it here, naming each statement of the document (`speech:statement`) and each agent it is to (`speech:to`). The policy tells it to each that listens on the bus, and passes over a person in silence." .

speech:Said rdfs:subClassOf mqtt:TellingTrigger .

#  AND A STEP'S COMMANDS, execution's `execution:Commanded`, which the member - above execution, as it is above every
#  package it carries bytes for - puts beneath its actuating trigger.

@prefix execution: <http://example.org/orexis/execution#> .

mqtt:Actuating a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Actuating" ;
    rdfs:comment "Publishing each command a command graph keeps on the topic its actuator listens to, where the MQTT member reaches the actuator; not retained, since a command is an act." .

mqtt:ActuatingTrigger a owl:Class ; rdfs:subClassOf mqtt:Trigger ; rdfs:label "Actuating trigger" ;
    rdfs:comment "What starts an actuating: execution's `execution:Commanded`, beneath it here, naming the command graph a step's order kept (`execution:commands`). The policy sends each command whose actuator the member reaches, and passes over the rest." .

execution:Commanded rdfs:subClassOf mqtt:ActuatingTrigger .
