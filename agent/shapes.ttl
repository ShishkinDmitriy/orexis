@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix orexis:   <http://example.org/orexis#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Rules for the society kernel. Each ontology module ships its own shapes file next to it;
# together they are the constitution as code. Validated with `orexis-validate`.

orexis:AgentShape a sh:NodeShape ;
    rdfs:comment "Every agent is named and does at least one thing. An agent with no capability is a process with nothing to run." ;
    sh:targetClass orexis:Agent ;
    sh:property [ sh:path orexis:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "an agent must state the id it is known by" ] ;
    sh:property [ sh:path orexis:hasCapability ; sh:minCount 1 ; sh:class orexis:Capability ;
                  sh:message "an agent must compose at least one capability" ] .

orexis:WorldShape a sh:NodeShape ;
    rdfs:comment "The world is versioned, so every fact recorded under it can say which world it was recorded in." ;
    sh:targetClass orexis:World ;
    sh:property [ sh:path orexis:currentVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class orexis:WorldVersion ] .

orexis:WorldVersionShape a sh:NodeShape ;
    rdfs:comment "A version is one whole number. It is what an observation stamps itself with, so a world whose version is missing or doubled makes every reading taken under it unattributable — and the number is the only content this node has." ;
    sh:targetClass orexis:WorldVersion ;
    sh:property [ sh:path orexis:versionNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

orexis:OwnedGraphShape a sh:NodeShape ;
    rdfs:comment "A graph that names an owner names exactly one agent — the write boundary. Targeted on the property since orexis:BeliefsGraph retired: presence is guaranteed by the rule that mints the row, and a class existing only to be a shape's target is the class this replaced." ;
    sh:targetSubjectsOf orexis:beliefsOf ;
    sh:property [ sh:path orexis:beliefsOf ; sh:maxCount 1 ; sh:class orexis:Agent ] .

#################  Devices that are not there  #################################################
#
# These are the ESP32's rules, not RDF's. They are here because a world states its wiring and
# `orexis-validate` is the last moment anyone reads it before a board is flashed and buried in a
# pot. Each one has cost somebody an afternoon at least once.
#
# SPARQL constraints spell IRIs out in full: this runs on pyshacl, and a prefix that is declared
# in one file and used in another is exactly the trap `store.PREFIXES` exists to catch elsewhere.

orexis:PublicGraphShape a sh:NodeShape ;
    rdfs:comment "Every public graph must say where it came from: read from files (prov:wasDerivedFrom) or computed by something (prov:wasGeneratedBy), one or the other. Public knowledge is several graphs and the difference between them decides whether a fact may be acted on, amended or revised — so a graph that cannot account for itself makes that question unanswerable for everything inside it. Stated in PROV-O because `prov:` is already how an observation records its author; nothing here is ours. Note what this shape CANNOT catch: a graph nobody described at all is not a prov:Entity and so is not targeted — silence is caught by tests/test_provenance.py, which walks the public set rather than waiting to be told about it." ;
    sh:targetClass prov:Entity ;
    sh:or (
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ]
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ]
    ) ;
    sh:message "a public graph must record what it was derived from or what generated it — see orexis/provenance.py" .

#  `orexis:SimulatedDeviceShape` WAS HERE: "a stand-in must be reachable like a real device" — on
#  a bus, or sharing a reading topic. It left as the transport's, being a sentence in the
#  transport's words, and is `sim:StandInReachableShape` now: the rule is meaningless without
#  stand-ins, so it is filed where deleting the package deletes it
#  (the-kernel-has-no-mailbox, then a-shape-belongs-to-the-vocabulary-it-checks).
#  Its first half, "one device, one stand-in", is kernel structure and stays:

#################  An effect rule accounts for its own timing  #################
#
#  The ontology says a rule that omitted these would be claiming immediacy by silence, and this
#  is what makes that true rather than aspirational. Targeted at `sh:SPARQLRule`, so a package
#  shipping a new `effects.ttl` is held to it without anything here naming that package — the
#  same mechanic as every other contribution: the loader finds the file, the shapes hold it.
#
#  A VIOLATION and not a warning. An effect nobody can wait for is worse than an effect nobody
#  stated: a planner reads the rule, commits to the act, and then has no answer to "has it
#  landed yet" — which is the flooding failure with a plan wrapped around it.

#  `orexis:DeviceShape`, `orexis:SimulatedDeviceShape` and `orexis:DeviceModelShape` WERE HERE and are
#  `packages/orexis-part-device/shapes.ttl`'s: what a physical node must state, and what a stand-in
#  must compute, are the substrate's rules (the-substrate-is-not-the-minds).

orexis:EffectRuleAccountsForItsTimingShape a sh:NodeShape ;
    rdfs:comment "What a rule must say beyond what it does: when the world change completes, and by which route anyone would learn that it had." ;
    sh:targetClass sh:SPARQLRule ;
    sh:property [ sh:path orexis:landsAfter ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ;
                  sh:message "an effect must say when it lands — a SELECT yielding ?seconds, and zero is a real answer for an act that changes nothing about the world" ] .


#################  Keeping commitments  #################

orexis:KeeperShape a sh:NodeShape ;
    rdfs:comment """An agent that advances somebody's interest must say how patient it is — the patience is the whole of what makes a commitment mean something, and its bounds are constitutional: below the floor the agent re-decides constantly and has retired the point of committing, above the ceiling it will honour a dead commitment for a day.

TARGETED ON THE STAKE — a want this agent holds that is not merely about knowing — and said in the kernel's own words: `orexis:holds` a `orexis:Desire` whose violation is not `orexis:Stale`. It used to be said as "acts for a subject that states what it needs", which is the stake's PREMISE in sensing's vocabulary (`ssn-system:hasOperatingRange`); the want itself is the kernel's structure, and the want is what obliges a patience — see the-stake-is-sensings-want. The narrowing is deliberate. This was `intention:KeeperShape`, scoped by `orexis:hasCapability intention:Keeping`, and that grant's premise was a stake AND a lever. The lever half cannot be said here without the kernel naming `market:bidsIn`, `actuation:hasActuator` and `sensing:polls` — three packages the kernel would then depend on, which is the layering this whole arrangement exists to keep one-way. A lever is an INSTANCE anyway, the `via` of a menu row derived from each package's own affordances.rq, so there is no term to target on even if the dependency were acceptable.

READ THAT AS THE RULE AND NOT AS THIS SHAPE'S SPECIAL PLEADING. The kernel names no package's word, in RDF as in Python, because a package is optional and the core depends on none of them. (The simulated-actuator shape that used to target `actuation:actuates` from here is actuation's now, and the desire warning that joined through two sensing terms is sensing's — `sensing:BeyondSurvivalShape`.) See decisions/the-kernel-names-no-package-word.md, which measures all nine and puts them in the order they should go.

AND THERE IS A SECOND REASON, stronger because it would forbid the lever half even for somebody who rejected the rule. Targeting the three predicates would ENUMERATE AN OPEN SET: every future package that grants a lever would have to be added here by hand, and one added without that edit would silently take its agents out of the patience requirement — an obligation removed with no engine anywhere to say so.

What that costs: an agent with a stake and no lever is required to state a patience it never spends. No world has one — the case is hypothetical in the record that drew the premise — and if one appears it carries a number it does not use. Cheap, because `agent/keeper.py` reads the patience lazily: an agent with nothing to commit about never asks for it, and one that reaches a commitment without it raises and names the term. What this shape buys over that backstop is the MOMENT — `orexis-validate` refuses the world, instead of an agent raising at its first commitment in production.""" ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://example.org/orexis#holds> ?want .
                ?want a <http://example.org/orexis#Desire> .
                FILTER NOT EXISTS { ?want <http://example.org/orexis#violationIs>
                                          <http://example.org/orexis#Stale> }
            }
        """ ] ;
    sh:property [ sh:path orexis:patienceS ;
                  sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 10 ; sh:maxInclusive 86400 ;
                  sh:message "an agent with a stake must state its patience, within the constitutional bounds the kernel declares" ] .


orexis:DesireShape a sh:NodeShape ;
    rdfs:comment """What a deduced shape must be to be readable — a shape ABOUT shapes, which is the seam a-desire-is-a-shape names: SHACL has no containment operator, so anything said about what an agent pursues is said by treating its shapes as the RDF they are.

Every figure here was computed, so this is arithmetic rather than authorship — but a check over derived data is worth exactly as much as one over authored data when the reader is code that will divide by the width.""" ;
    #  Both roads to a held shape, since the desire was reified: a DESIRE's met-test hangs one
    #  `orexis:metWhen` hop off the node the agent holds, while the envelope — and an asserted root
    #  desire in the old bare form — is still held directly. A target that knew only the second
    #  would have gone quietly blind to every deduced want the day the hop landed.
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                { ?agent <http://example.org/orexis#holds> ?held .
                  ?held <http://example.org/orexis#metWhen> ?this }
                UNION
                { ?agent <http://example.org/orexis#holds> ?this .
                  ?this a <http://www.w3.org/ns/shacl#NodeShape> . }
            }
        """ ] ;
    sh:property [ sh:path sh:targetNode ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "a deduced shape must say whose state it is about" ] ;
    #  WHERE THE ENGINE WILL READ IT, which differs by constraint kind and was measured both
    #  ways round on pySHACL 0.40.1. A core `sh:property` constraint takes its severity from
    #  the property shape and ignores the node shape's; a `sh:sparql` constraint does the
    #  reverse. So this accepts either place — the original rule (never let the force drift up
    #  to the node shape) held for the declarative wants it was written for, and is exactly
    #  wrong for the SPARQL one, whose severity is ignored anywhere else.
    #
    #  What it still refuses is a deduced shape carrying no force at all, which is the failure
    #  it exists for: an unmet want reported as a violation refuses the boot of an agent whose
    #  pot is dry.
    sh:property [ sh:path [ sh:alternativePath (
                      ( [ sh:alternativePath ( sh:property sh:sparql ) ] sh:severity )
                      sh:severity ) ] ;
                  sh:minCount 1 ;
                  sh:message "a deduced shape must carry its FORCE on the property shape that produces the result — above it, every unmet want reports as a violation and an agent whose pot is dry refuses to boot" ] .

    #  The region-inside-envelope check and "a deduced shape says which property it is
    #  about" WERE HERE and are `sensing:DeducedRegionShape`'s: both are sentences about a
    #  property and its ranges, and the kernel checks only what a met-test is — whose state,
    #  and with what force (the-stake-is-sensings-want).

# The first consumer of the gap, and deliberately a WARNING. An observation outside the
# survival envelope is not an invalid belief — it is an emergency, and an agent must be allowed
# to start precisely so it can do something about it; a violation here would keep a thirsty
# agent from ever bidding for water. `agent.validate.conforms` decides the verdict on
# violations alone and prints everything else, which is exactly the channel "legal but worth a
# second look" needs. The world gate sees no observations (a fresh world has none), so this
# speaks only where it can be true: at an agent's own boot, over its own sensed graph.
#
# Only the envelope, not the region. Outside the region is the ORDINARY working state of this
# whole society — being dry is why markets exist — and warning on it would teach everyone to
# ignore the channel. Outside what the subject SURVIVES is rare, actionable, and exactly what a
# person glancing at a boot log should see.

# What is NOT here: a shape refusing a hand-authored desire. It was written and removed, because
# it would have been decoration — the derivation mints blank nodes and so could a sovereign, so
# nothing about the triple distinguishes the two, and a shape cannot see which graph a fact came
# from (validation runs over a flattened union). The prohibition is real and enforced elsewhere:
# `refresh_public` clears every write target before the rules run, so a region written into a
# world file is discarded on the next start rather than merely disapproved of. A rule that
# enforces nothing is worse than an absence, because it is still cited.
