@prefix mqtt: <http://example.org/orexis/mqtt#> .
@prefix actuation: <http://example.org/orexis/actuation#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/orexis#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Rules for the society kernel. Each ontology module ships its own shapes file next to it;
# together they are the constitution as code. Validated with `orexis-validate`.

ag:AgentShape a sh:NodeShape ;
    rdfs:comment "Every agent is named and does at least one thing. An agent with no capability is a process with nothing to run." ;
    sh:targetClass ag:Agent ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "an agent must state the id it is known by" ] ;
    sh:property [ sh:path ag:hasCapability ; sh:minCount 1 ; sh:class ag:Capability ;
                  sh:message "an agent must compose at least one capability" ] .

ag:DeviceShape a sh:NodeShape ;
    rdfs:comment "A device is reachable: it states where it is on the wire, so nothing has to guess its address from a naming convention." ;
    sh:targetClass ag:Device ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ag:WorldShape a sh:NodeShape ;
    rdfs:comment "The world is versioned, so every fact recorded under it can say which world it was recorded in." ;
    sh:targetClass ag:World ;
    sh:property [ sh:path ag:currentVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ag:WorldVersion ] .

ag:WorldVersionShape a sh:NodeShape ;
    sh:targetClass ag:WorldVersion ;
    sh:property [ sh:path ag:versionNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

ag:OwnedGraphShape a sh:NodeShape ;
    rdfs:comment "A graph that names an owner names exactly one agent — the write boundary. Targeted on the property since ag:BeliefsGraph retired: presence is guaranteed by the rule that mints the row, and a class existing only to be a shape's target is the class this replaced." ;
    sh:targetSubjectsOf ag:beliefsOf ;
    sh:property [ sh:path ag:beliefsOf ; sh:maxCount 1 ; sh:class ag:Agent ] .

#################  Devices that are not there  #################################################
#
# These are the ESP32's rules, not RDF's. They are here because a world states its wiring and
# `orexis-validate` is the last moment anyone reads it before a board is flashed and buried in a
# pot. Each one has cost somebody an afternoon at least once.
#
# SPARQL constraints spell IRIs out in full: this runs on pyshacl, and a prefix that is declared
# in one file and used in another is exactly the trap `store.PREFIXES` exists to catch elsewhere.

ag:PublicGraphShape a sh:NodeShape ;
    rdfs:comment "Every public graph must say where it came from: read from files (prov:wasDerivedFrom) or computed by something (prov:wasGeneratedBy), one or the other. Public knowledge is several graphs and the difference between them decides whether a fact may be acted on, amended or revised — so a graph that cannot account for itself makes that question unanswerable for everything inside it. Stated in PROV-O because `prov:` is already how an observation records its author; nothing here is ours. Note what this shape CANNOT catch: a graph nobody described at all is not a prov:Entity and so is not targeted — silence is caught by tests/test_provenance.py, which walks the public set rather than waiting to be told about it." ;
    sh:targetClass prov:Entity ;
    sh:or (
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ]
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ]
    ) ;
    sh:message "a public graph must record what it was derived from or what generated it — see orexis/provenance.py" .

ag:SimulatedDeviceShape a sh:NodeShape ;
    rdfs:comment """A device that is stood in for must still be reachable like a real one, or the failure is a sensor that is simply, permanently silent — which reads exactly like hardware that is not there. Which it is not.

What makes it reachable is no longer only its own credential. A KY-015 reports two properties down ONE line, and `world/sensing` states that shape already: `ag:air_temp_fern` has no `mqtt:onBus` at all, because a peripheral sharing its board's connection must not mint a principal for a client that never connects. So the test is REACHABILITY rather than ownership — on a bus, or sharing the reading topic of something that is. This shape used to demand the credential, and demanding it of a simulated multi-property board would have forced exactly the second principal the hardware world refuses.""" ;
    sh:targetSubjectsOf ag:simulatedBy ;
    sh:property [ sh:path ag:simulatedBy ; sh:maxCount 1 ;
                  sh:message "one device, one stand-in" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a simulated device must be reachable: on a bus of its own, or sharing the reading topic of a device that is — otherwise nothing would ever publish for it" ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this <http://example.org/orexis/mqtt#onBus> ?bus }
                FILTER NOT EXISTS {
                    $this <http://example.org/orexis/mqtt#readingTopic> ?topic .
                    ?peer <http://example.org/orexis/mqtt#readingTopic> ?topic ;
                          <http://example.org/orexis/mqtt#onBus> ?peerBus .
                }
            }""" ] .

ag:SimulatedActuatorShape a sh:NodeShape ;
    rdfs:comment "A stood-in actuator must say where it reports. Water reaching soil is physics, and physics has no wire — so between containers the only way a simulated sensor can learn that water actually flowed is a message from the valve that flowed it. Without a status topic the stand-in valve would open into nowhere: the command would be verified, the dose computed, and the soil would stay dry forever." ;
    sh:targetSubjectsOf actuation:actuates ;
    sh:property [ sh:path mqtt:statusTopic ; sh:maxCount 1 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a simulated actuator must state mqtt:statusTopic — its stand-in reports there, and a simulated sensor waters only on what it reports" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://example.org/orexis#simulatedBy> ?model .
                FILTER NOT EXISTS { $this <http://example.org/orexis/mqtt#statusTopic> ?t }
            }""" ] .

ag:DeviceModelShape a sh:NodeShape ;
    rdfs:comment """What the stand-in computes between readings. Optional individually — a modelled valve has no dry rate — but each must be a number if stated at all, because the simulator reads them without a graph to check them against.

An initial value used to be held to 0..1, on the reasoning that it is a fraction of the observed property. That was true of every value this project had and false of sensing: a KY-015 reports degrees Celsius, and 21.4 is not a fraction of anything. It is held to the model's OWN range now, which catches the slip the old rule was written for — 45 where 0.45 was meant, in a model that says it runs 0..1 — and catches it in a thermometer too, where the old rule could not look.""" ;
    sh:targetClass ag:DeviceModel ;
    sh:property [ sh:path ag:modelLosesPerDay ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelMinValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelMaxValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelInitialValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelTickSeconds ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "an initial value must lie inside the range this model states — 45 where 0.45 was meant would clamp and read as a permanently soaking pot" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://example.org/orexis#modelInitialValue> ?initial .
                OPTIONAL { $this <http://example.org/orexis#modelMinValue> ?min }
                OPTIONAL { $this <http://example.org/orexis#modelMaxValue> ?max }
                OPTIONAL {
                    ?d <http://example.org/orexis#simulatedBy> $this ;
                       <http://example.org/orexis/sensing#monitors> ?subject .
                    ?subject <http://example.org/orexis#modelMaxValue> ?subjectMax
                }
                BIND(COALESCE(?max, ?subjectMax, 1.0) AS ?high)
                BIND(COALESCE(?min, 0.0) AS ?low)
                FILTER(?initial < ?low || ?initial > ?high)
            }""" ] .

#################  An effect rule accounts for its own timing  #################
#
#  The ontology says a rule that omitted these would be claiming immediacy by silence, and this
#  is what makes that true rather than aspirational. Targeted at `sh:SPARQLRule`, so a package
#  shipping a new `effects.ttl` is held to it without anything here naming that package — the
#  same mechanic as every other contribution: the loader finds the file, the shapes hold it.
#
#  A VIOLATION and not a warning. An effect nobody can wait for is worse than an effect nobody
#  stated: a planner reads the rule, commits to the act, and then has no answer to "has it
#  landed yet" — which is the flooding failure with a plan wrapped around it.

ag:EffectRuleAccountsForItsTimingShape a sh:NodeShape ;
    rdfs:comment "What a rule must say beyond what it does: when the world change completes, and by which route anyone would learn that it had." ;
    sh:targetClass sh:SPARQLRule ;
    sh:property [ sh:path ag:landsAfter ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ;
                  sh:message "an effect must say when it lands — a SELECT yielding ?seconds, and zero is a real answer for an act that changes nothing about the world" ] ;
    sh:property [ sh:path ag:confirmedBy ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class ag:ConfirmationRoute ;
                  sh:message "an effect must say how it would be confirmed — by construction, by report, by observation, or not at all; silence would leave a planner waiting for a message nobody will send" ] .


#################  Keeping commitments  #################

ag:KeeperShape a sh:NodeShape ;
    rdfs:comment """An agent that advances somebody's interest must say how patient it is — the patience is the whole of what makes a commitment mean something, and its bounds are constitutional: below the floor the agent re-decides constantly and has retired the point of committing, above the ceiling it will honour a dead commitment for a day.

TARGETED ON THE STAKE, and the narrowing is deliberate. This was `intention:KeeperShape`, scoped by `ag:hasCapability intention:Keeping`, and that grant's premise was a stake AND a lever. The lever half cannot be said here without the kernel naming `market:bidsIn`, `actuation:hasActuator` and `sensing:polls` — three packages the kernel would then depend on, which is the layering this whole arrangement exists to keep one-way. A lever is an INSTANCE anyway, the `via` of a menu row derived from each package's own affordances.rq, so there is no term to target on even if the dependency were acceptable.

What that costs: an agent with a stake and no lever would now be required to state a patience it never spends. No world has one — the case is hypothetical in the record that drew the premise — and if one appears it carries a number it does not use, which is cheaper than a kernel that breaks when a package is removed.""" ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://example.org/orexis#actsFor> ?subject .
                ?subject <http://www.w3.org/ns/ssn/systems/hasOperatingRange>/<http://www.w3.org/ns/ssn/systems/inCondition> ?condition .
                ?condition <http://www.w3.org/ns/ssn/forProperty> ?property ;
                           <https://schema.org/minValue> ?min ;
                           <https://schema.org/maxValue> ?max .
            }
        """ ] ;
    sh:property [ sh:path ag:patienceS ;
                  sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 10 ; sh:maxInclusive 86400 ;
                  sh:message "an agent with a stake must state its patience, within the constitutional bounds the kernel declares" ] .


#################  What an agent wants  #################
#
#  Was `packages/capability/desire/shapes.ttl`. The two capability-scoped targets are
#  scoped on the STAKE now — `ag:actsFor` a subject that states what it needs — for the
#  reason `ag:KeeperShape` above records: the grant is gone, and the fact it rested on is
#  sayable in the kernel's own words where the lever half was not.

ag:DesirerShape a sh:NodeShape ;
    rdfs:comment """An agent granted the capability must end up with at least one region. The two are derived from very nearly the same premise and can still come apart: the grant asks only that the subject state a range, and the deduction additionally asks that every range applying to a property AGREE. A plant whose pot says 0.45-0.65 in a world whose instrument says 0.10-0.30 produces an empty intersection, no region, and — without this shape — an agent that starts, holds the capability, and quietly has no opinion about anything.

That failure is the one this whole design is most exposed to, because its symptom is silence: no band on any announcement, the slow cadence forever, and a market that never hears that anyone is in trouble. Refusing to start is loud, and the report names the agent.""" ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://example.org/orexis#actsFor> ?subject .
                ?subject <http://www.w3.org/ns/ssn/systems/hasOperatingRange>/<http://www.w3.org/ns/ssn/systems/inCondition> ?condition .
                ?condition <http://www.w3.org/ns/ssn/forProperty> ?property ;
                           <https://schema.org/minValue> ?min ;
                           <https://schema.org/maxValue> ?max .
            }
        """ ] ;
    sh:property [ sh:path ag:holds ; sh:minCount 1 ;
                  sh:message "this agent acts for a subject that states what it needs, but no region survived intersecting those ranges — check that every range stated for a property actually overlaps" ] .

ag:DesireShape a sh:NodeShape ;
    rdfs:comment """What a deduced shape must be to be readable — a shape ABOUT shapes, which is the seam a-desire-is-a-shape names: SHACL has no containment operator, so anything said about what an agent pursues is said by treating its shapes as the RDF they are.

Every figure here was computed, so this is arithmetic rather than authorship — but a check over derived data is worth exactly as much as one over authored data when the reader is code that will divide by the width.""" ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?agent <http://example.org/orexis#holds> ?this .
                ?this a <http://www.w3.org/ns/shacl#NodeShape> .
            }
        """ ] ;
    sh:property [ sh:path <http://www.w3.org/ns/ssn/forProperty> ;
                  sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "a deduced shape must say which property it is about" ] ;
    sh:property [ sh:path sh:targetNode ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "a deduced shape must say whose state it is about" ] ;
    #  WHERE THE ENGINE WILL READ IT, which differs by constraint kind and was measured both
    #  ways round on pySHACL 0.40.1. A core `sh:property` constraint takes its severity from
    #  the property shape and ignores the node shape's; a `sh:sparql` constraint does the
    #  reverse. So this accepts either place — the original rule (never let the force drift up
    #  to the node shape) held for the declarative wants it was written for, and is exactly
    #  wrong for the SPARQL one, whose severity is ignored anywhere else.
    #
    #  What it still refuses is a deduced shape carrying no force at all, which is the failure
    #  it exists for: an unmet want reported as a violation refuses the boot of an agent whose
    #  pot is dry.
    sh:property [ sh:path [ sh:alternativePath (
                      ( [ sh:alternativePath ( sh:property sh:sparql ) ] sh:severity )
                      sh:severity ) ] ;
                  sh:minCount 1 ;
                  sh:message "a deduced shape must carry its FORCE on the property shape that produces the result — above it, every unmet want reports as a violation and an agent whose pot is dry refuses to boot" ] ;

    # The envelope has to be OUTSIDE the region, on both sides, or the arithmetic that scales
    # urgency by it produces a negative denominator and an agent that is most relaxed exactly
    # where it is closest to dying. Nothing authored can cause this directly — both figures are
    # intersections — but a world whose survival range is narrower than its operating range can,
    # and `water:RangesAgreeShape` only checks that pairing per plant. This checks it after
    # everything that applies has been folded together, which is where a rig assembled from two
    # correct halves can still be wrong.
    #
    # Every optional bound is guarded with BOUND rather than compared directly, and it is not
    # defensive typing. `?low < ?floor` on an unbound `?floor` is an ERROR, and SPARQL's `||`
    # propagates an error unless some other operand is true — so a region with no envelope made
    # the whole filter error, the row vanish, and the `?low > ?high` case it was also supposed to
    # catch go unreported. The shape would have been green on exactly the world it was written
    # for.
    #
    # Both edges are read off the SIDE shapes since #242: the floor is what the Below shape
    # refuses to see a reading under, the ceiling what the Above shape refuses to see one over.
    # `sh:maxExclusive ?low` still means the region is inclusive of ?low — a reading strictly
    # below it is the violation — so the arithmetic below is untouched by the split.
    sh:sparql [
        sh:message "a region lies outside the envelope it is supposed to sit inside — the survival range stated for this property is narrower than the operating range, once every source is intersected" ;
        sh:select """
            SELECT $this ?low ?high WHERE {
                $this <http://www.w3.org/ns/ssn/forProperty> ?property ;
                      <http://www.w3.org/ns/shacl#property> ?below , ?above .
                ?below <http://www.w3.org/ns/shacl#severity>
                       <http://example.org/orexis#ShouldBecome> ;
                       <http://example.org/orexis#violationIs> <http://example.org/orexis#Below> ;
                       <http://www.w3.org/ns/shacl#qualifiedValueShape>/<http://www.w3.org/ns/shacl#property>/<http://www.w3.org/ns/shacl#maxExclusive> ?low .
                ?above <http://www.w3.org/ns/shacl#severity>
                       <http://example.org/orexis#ShouldBecome> ;
                       <http://example.org/orexis#violationIs> <http://example.org/orexis#Above> ;
                       <http://www.w3.org/ns/shacl#qualifiedValueShape>/<http://www.w3.org/ns/shacl#property>/<http://www.w3.org/ns/shacl#minExclusive> ?high .
                OPTIONAL {
                    ?agent <http://example.org/orexis#holds> $this , ?envelope .
                    ?envelope <http://www.w3.org/ns/ssn/forProperty> ?property ;
                              <http://www.w3.org/ns/shacl#property> ?underFloor , ?overCeiling .
                    ?underFloor <http://www.w3.org/ns/shacl#severity>
                                <http://www.w3.org/ns/shacl#Warning> ;
                                <http://example.org/orexis#violationIs> <http://example.org/orexis#Below> ;
                                <http://www.w3.org/ns/shacl#qualifiedValueShape>/<http://www.w3.org/ns/shacl#property>/<http://www.w3.org/ns/shacl#maxExclusive> ?floor .
                    ?overCeiling <http://www.w3.org/ns/shacl#severity>
                                 <http://www.w3.org/ns/shacl#Warning> ;
                                 <http://example.org/orexis#violationIs> <http://example.org/orexis#Above> ;
                                 <http://www.w3.org/ns/shacl#qualifiedValueShape>/<http://www.w3.org/ns/shacl#property>/<http://www.w3.org/ns/shacl#minExclusive> ?ceiling }
                FILTER(   ?low > ?high
                       || (BOUND(?floor)   && ?low  < ?floor)
                       || (BOUND(?ceiling) && ?high > ?ceiling))
            }""" ] .

# The aim answers to the region, and both halves of that sentence are checked here rather than
# in any domain: which properties may be aimed at and where the aim may sit are desire's
# arithmetic, true of a thermostat exactly as of a pot. What a DOMAIN checks is different in
# kind — that a bidder holds an aim in the property its bids are priced in — and stays in the
# domain's shapes, because only the domain knows a bid exists.
#
# Targeted through what POINTS at an aim, not by class: an aim is written inline as
# `ag:aims [ ... ]` and nobody types `a ag:Aim` on a node they are already describing —
# the same lesson review's mandate shape records.
ag:AimShape a sh:NodeShape ;
    rdfs:comment """An aim is one property and one value, and the value sits inside the shape the agent is held to for that property. The checks span a PUBLIC shape and a PRIVATE aim, which meet only inside the agent at boot — nothing outside it ever sees the number.\n\nThis is the containment check a-desire-is-a-shape names as a seam: SHACL has no operator for "this shape is inside that one", so the bound is read out of the deduced shape as the ordinary RDF it is. SHACL, validated by a query over SHACL — mind-bending to read, and the price of having one language for what a graph should look like instead of two.""" ;
    sh:targetSubjectsOf ag:aims ;
    sh:property [ sh:path ( ag:aims <http://www.w3.org/ns/ssn/forProperty> ) ;
                  sh:minCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "an aim must say which property it is a pick FOR" ] ;
    sh:property [ sh:path ( ag:aims <https://schema.org/value> ) ;
                  sh:minCount 1 ; sh:datatype xsd:decimal ;
                  sh:message "an aim must carry one decimal value" ] ;
    sh:sparql [
        sh:message "an aim names a property this agent holds no region in — a pick with nothing to pick inside is a number with nothing behind it" ;
        sh:select """
            SELECT $this ?property WHERE {
                $this <http://example.org/orexis#aims> ?aim .
                ?aim <http://www.w3.org/ns/ssn/forProperty> ?property .
                FILTER NOT EXISTS {
                    $this <http://example.org/orexis#holds> ?shape .
                    ?shape <http://www.w3.org/ns/ssn/forProperty> ?property .
                }
            }""" ] ;
    sh:sparql [
        sh:message "the aim sits outside the region this agent deduced for that property — a desire is a pick within a range, not a number of its own" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this <http://example.org/orexis#aims> ?aim .
                ?aim <http://www.w3.org/ns/ssn/forProperty> ?property ;
                     <https://schema.org/value> ?value .
                $this <http://example.org/orexis#holds> ?shape .
                ?shape <http://www.w3.org/ns/ssn/forProperty> ?property ;
                       <http://www.w3.org/ns/shacl#property> ?below , ?above .
                ?below <http://www.w3.org/ns/shacl#severity>
                       <http://example.org/orexis#ShouldBecome> ;
                       <http://example.org/orexis#violationIs> <http://example.org/orexis#Below> ;
                       <http://www.w3.org/ns/shacl#qualifiedValueShape>/<http://www.w3.org/ns/shacl#property>/<http://www.w3.org/ns/shacl#maxExclusive> ?low .
                ?above <http://www.w3.org/ns/shacl#severity>
                       <http://example.org/orexis#ShouldBecome> ;
                       <http://example.org/orexis#violationIs> <http://example.org/orexis#Above> ;
                       <http://www.w3.org/ns/shacl#qualifiedValueShape>/<http://www.w3.org/ns/shacl#property>/<http://www.w3.org/ns/shacl#minExclusive> ?high .
                FILTER(?value < ?low || ?value > ?high)
            }""" ] ;
    sh:sparql [
        sh:message "two aims for one property — an agent steering one property toward two points is not steering" ;
        sh:select """
            SELECT $this ?property WHERE {
                $this <http://example.org/orexis#aims> ?one , ?other .
                ?one   <http://www.w3.org/ns/ssn/forProperty> ?property .
                ?other <http://www.w3.org/ns/ssn/forProperty> ?property .
                FILTER(?one != ?other)
            }""" ] .

# The first consumer of the gap, and deliberately a WARNING. An observation outside the
# survival envelope is not an invalid belief — it is an emergency, and an agent must be allowed
# to start precisely so it can do something about it; a violation here would keep a thirsty
# agent from ever bidding for water. `agent.validate.conforms` decides the verdict on
# violations alone and prints everything else, which is exactly the channel "legal but worth a
# second look" needs. The world gate sees no observations (a fresh world has none), so this
# speaks only where it can be true: at an agent's own boot, over its own sensed graph.
#
# Only the envelope, not the region. Outside the region is the ORDINARY working state of this
# whole society — being dry is why markets exist — and warning on it would teach everyone to
# ignore the channel. Outside what the subject SURVIVES is rare, actionable, and exactly what a
# person glancing at a boot log should see.
ag:BeyondSurvivalShape a sh:NodeShape ;
    rdfs:comment "The last reading of a property this agent has a desire in lies outside what its subject survives. Not a refusal: the agent starts, and the report says why it had better hurry. |gap| = 1 in the package's gap.rq is this same fact as a number." ;
    sh:severity sh:Warning ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://example.org/orexis#actsFor> ?subject .
                ?subject <http://www.w3.org/ns/ssn/systems/hasOperatingRange>/<http://www.w3.org/ns/ssn/systems/inCondition> ?condition .
                ?condition <http://www.w3.org/ns/ssn/forProperty> ?property ;
                           <https://schema.org/minValue> ?min ;
                           <https://schema.org/maxValue> ?max .
            }
        """ ] ;
    #  The hand-written "a reading sits outside the survival envelope" check was HERE and is gone.
    #  The deduction emits that shape now — targeting the subject, at sh:Warning, saying the
    #  same sentence in the language the checker already speaks. Two statements of one rule is
    #  one too many, and the surviving one is the one an agent can also steer by.
    
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "a desire in a property this agent polls no sensor for — the region is real, and the agent will never see a reading to hold it to" ;
        sh:select """
            SELECT $this ?property WHERE {
                $this <http://example.org/orexis#actsFor> ?subject ;
                      <http://example.org/orexis#holds> ?region .
                ?region <http://www.w3.org/ns/ssn/forProperty> ?property .
                FILTER NOT EXISTS {
                    $this <http://example.org/orexis/sensing#polls> ?sensor .
                    ?sensor <http://example.org/orexis/sensing#monitors> ?subject ;
                            <http://www.w3.org/ns/sosa/observes> ?property .
                }
            }""" ] .

# What is NOT here: a shape refusing a hand-authored desire. It was written and removed, because
# it would have been decoration — the derivation mints blank nodes and so could a sovereign, so
# nothing about the triple distinguishes the two, and a shape cannot see which graph a fact came
# from (validation runs over a flattened union). The prohibition is real and enforced elsewhere:
# `refresh_public` clears every write target before the rules run, so a region written into a
# world file is discarded on the next start rather than merely disapproved of. A rule that
# enforces nothing is worse than an absence, because it is still cited.
