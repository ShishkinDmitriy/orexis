@prefix : <http://example.org/orexis/world/viewing#> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix telegram: <http://example.org/orexis/telegram#> .

<> a orexis:SocietyGraph .    # this document is one graph, and this is what it is

#  THE SOCIETY'S WIRING: two agents, the seeker and the keeper — who goes by Kim — each speaking on Telegram through a
#  bot of its own;
#  the seeker on the bus as well, where it chats with Boris through his phone; and the people, by the names they go
#  by and, where they write in a group, the Telegram user they write as. The filters are asserted here, as a test
#  world's are, where `orexis-onboard` would derive them.

:broker a mqtt4ssn:Broker .

:seeker a orexis:Agent , mqtt4ssn:Client ;
    orexis:localId "seeker" ;
    mqtt4ssn:hasClientID "seeker" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    telegram:hasBot :seeker_bot .
:keeper a orexis:Agent ;
    orexis:localId "keeper" ;
    schema:name "Kim" ;
    telegram:hasBot :keeper_bot .
:seeker_bot a telegram:Bot .
:keeper_bot a telegram:Bot .

:anna a schema:Person ; schema:name "Anna" ; telegram:userId "111" .
:boris a schema:Person ; schema:name "Boris" .
:clara a schema:Person ; schema:name "Clara" ; telegram:userId "222" .

:boris_phone a mqtt4ssn:Client ;
    mqtt4ssn:hasClientID "boris_phone" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    prov:actedOnBehalfOf :boris .
:boris_topic a mqtt4ssn:Topic .
:boris_topic_filter a mqtt4ssn:TopicFilter ; mqtt4ssn:matchesTopic :boris_topic ; mqtt4ssn:hasFilterPattern "chats/seeker_and_boris" .
