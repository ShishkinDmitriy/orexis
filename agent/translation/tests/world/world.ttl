@prefix : <http://example.org/orexis/world/viewing#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:WorldGraph .    # this document is one graph, and this is what it is

#  THE TRANSLATOR'S WORLD: a seeker after a flat, and two listings a realtor may offer to show. The
#  words are the world's own, as a test world's may be: a viewing offered of a listing, an application for
#  one refused, and the hours a viewing is asked for, each a property a person may state or be told
#  (speech.ttl says in which chat).

:Listing a owl:Class ; rdfs:label "a flat on offer" .

:viewingAt a owl:DatatypeProperty ; rdfs:domain :Listing ; rdfs:range xsd:dateTime ;
    rdfs:label "viewing offered at" ; rdfs:comment "When a viewing of the listing is offered." .
:refused a owl:DatatypeProperty ; rdfs:domain :Listing ; rdfs:range xsd:boolean ;
    rdfs:label "application refused" ; rdfs:comment "Whether the application for the listing was refused." .
:viewingAsked a owl:DatatypeProperty ; rdfs:domain :Listing ; rdfs:range xsd:string ;
    rdfs:label "viewing asked for" ; rdfs:comment "The hours the seeker can come to view the listing." .

:flat_12 a :Listing ; rdfs:label "the two-room flat on Kastanienallee" .
:flat_7 a :Listing ; rdfs:label "the studio on Rigaer Straße" .
