@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ag:SimulatedActuatorShape a sh:NodeShape ;
    rdfs:comment "A device that is not there still states its calibration and its hard cap. It has to: the dose is computed and bounded exactly as a real one, and a simulation that dosed differently would be modelling a different piece of hardware — which would make it useless for deciding whether the real one is wired correctly." ;
    sh:targetClass ag:SimulatedActuator ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ag:actuates ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ag:commandTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "a simulated actuator announces its dose, so a modelled subject can respond to it" ] ;
    sh:property [ sh:path ag:mlPerSecond ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path ag:maxDoseMl ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] .
