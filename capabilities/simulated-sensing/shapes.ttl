@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rules for perceiving by model. The freshness rule is inherited from the perception family —
# it targets anything that perceives, and this is a kind of that — so only what is peculiar to
# a model is stated here.

ag:SimulatedSensingAgentShape a sh:NodeShape ;
    rdfs:comment "An agent reading a model still decides how often to look, and the same constitutional bounds apply: nobody may watch so fast that the model is meaningless, or so slowly that they are blind. It is asked for the same two figures as a subscribing agent, and for the same reason — but they govern its OWN loop, since there is no device to instruct." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this <http://example.org/agora#hasCapability>
                                       <http://example.org/agora#SimulatedSensing> }
        """ ] ;
    sh:property [ sh:path ag:fastSleepS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minInclusive 10 ; sh:maxInclusive 900 ;
                  sh:lessThanOrEquals ag:slowSleepS ;
                  sh:message "the fast interval must be within the constitutional bounds and no slower than the slow one" ] ;
    sh:property [ sh:path ag:slowSleepS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minInclusive 10 ; sh:maxInclusive 900 ] .

ag:ModelledSubjectShape a sh:NodeShape ;
    rdfs:comment "A model must say how the world moves, or it does not move: an unstated dry rate is a subject that never changes, which is a simulation of nothing. The tick is how fast that happens in wall-clock time." ;
    sh:targetClass ag:ModelledSubject ;
    sh:property [ sh:path ag:modelledDryRate ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minInclusive 0 ;
                  sh:message "a modelled subject must state how fast it changes on its own" ] ;
    sh:property [ sh:path ag:modelledTickSeconds ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path ag:modelledInitialValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:minInclusive 0 ; sh:maxInclusive 1 ] .
