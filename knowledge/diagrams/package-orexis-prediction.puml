@startuml package-orexis-prediction
!pragma layout smetana
title orexis-prediction — every struct, enum and trait in src/, by module\ngenerated by tools/class-diagrams.py · ~*~-~- held by value · o~-~- shared · ..|> implements
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11
skinparam packageStyle rectangle
hide empty members
left to right direction

package "foresee" {
  class "Flow" as orexis_prediction__foresee__Flow << (S,#A8D8EA) struct >> {
    {field} -flow : String
    {field} -rate : String
  }
  class "Foresight" as orexis_prediction__foresee__Foresight << (S,#A8D8EA) struct >> {
    {field} -origin : DateTime
    {field} +keys : Vec<Key>
    {field} -t : Option<f64>
    {field} -held_s : f64
  }
  class "Key" as orexis_prediction__foresee__Key << (S,#A8D8EA) struct >> {
    {field} +sensor : String
    {field} +feature : String
    {field} +property : String
    {field} -taken : f64
    {field} -horizon : f64
    {field} -ranges : Vec<(f64, f64)>
    {field} -flows : Vec<Flow>
    {field} +laid : bool
    {field} +lo : f64
    {field} +hi : f64
    {field} -knots : Vec<Knot>
  }
}
package "predictor" {
  class "Predictor" as orexis_prediction__predictor__Predictor << (S,#A8D8EA) struct >> {
    {field} +horizon_s : f64
    {field} +rate_held_s : f64
  }
}


orexis_prediction__foresee__Key *-- "*" orexis_prediction__foresee__Flow : flows
orexis_prediction__foresee__Foresight *-- "*" orexis_prediction__foresee__Key : keys
@enduml
