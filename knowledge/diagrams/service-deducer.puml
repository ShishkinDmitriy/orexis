@startuml service-deducer
title Deducer — what it reads and writes

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 14
skinparam ArrowFontSize 10
skinparam database {
  BackgroundColor #E8F1F8
  BorderColor #5B8DB8
}
skinparam folder {
  BackgroundColor #FFFFFF
  BorderColor #8FB4D0
  FontSize 11
}
skinparam component {
  BackgroundColor #EAF5EA
  BorderColor #5E9E5E
}


database "Beliefs · repository" as BEL {
  folder "orexis:PickRecordGraph" as P
  folder "market:ObligationsGraph" as O
  folder "orexis:WorldGraph" as W
}

database "Desires · repository" as DES {
  folder "asserted · no graph class" as DA
  folder "derived · no graph class" as DD
}

component "Deducer\nruns desire derivation" as DB


P ..> DB : reads
O ..> DB : reads
W ..> DB : reads
DA ..> DB : reads
DB --> DD : writes

@enduml
