@startuml service-executor
title Executor — what it reads and writes

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 14
skinparam ArrowFontSize 10
skinparam database {
  BackgroundColor #E8F1F8
  BorderColor #5B8DB8
}
skinparam folder {
  BackgroundColor #FFFFFF
  BorderColor #8FB4D0
  FontSize 11
}
skinparam component {
  BackgroundColor #EAF5EA
  BorderColor #5E9E5E
}


database "Beliefs · repository" as BEL {
  folder "orexis:ActionGraph" as A
}

database "Desires · repository" as DES {
  folder "no graph class" as X
}

component "Execution\nruns plan, commit, take" as EX


A ..> EX : reads
X ..> EX : reads

@enduml
