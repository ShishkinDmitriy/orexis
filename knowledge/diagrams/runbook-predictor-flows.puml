@startuml runbook-predictor-flows
title A predictor — flows integrated from each ground

skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 14
skinparam ArrowFontSize 10
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #8FB4D0
}
skinparam frame {
  BackgroundColor #F4F8FB
  BorderColor #5B8DB8
}

rectangle "latest observation\nsoil 0.36" as OBS
rectangle "climate:Drying\nreads climate:driesPerDay" as D1
rectangle "climate:Raining\nreads climate:wetsPerMm\nand the rain forecast" as D2
rectangle "actuation:Dosed\nreads a committed dose" as D3
rectangle "sum of the flows' rates\nper key, from the ground standing" as SUM
rectangle "the next knot\na crossing, or the hour's end" as BANDS
rectangle "a ground laid there\n0.04 a day: Dry in a day and a half" as G
rectangle "planning\na want for that instant" as P #EAF5EA

OBS --> SUM
D1 --> SUM
D2 --> SUM
D3 --> SUM
SUM --> BANDS
BANDS --> G
G --> SUM : integrated on from here
G --> P
@enduml
