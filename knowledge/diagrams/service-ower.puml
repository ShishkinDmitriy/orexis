@startuml service-ower
title Ower — what it reads and writes

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 14
skinparam ArrowFontSize 10
skinparam database {
  BackgroundColor #E8F1F8
  BorderColor #5B8DB8
}
skinparam folder {
  BackgroundColor #FFFFFF
  BorderColor #8FB4D0
  FontSize 11
}
skinparam component {
  BackgroundColor #EAF5EA
  BorderColor #5E9E5E
}


database "Beliefs · repository" as BEL {
  folder "market:ObligationsGraph" as O
  folder "orexis:WorldGraph\nwho the counterparty is" as W
}

component "Ower\nruns debt keeping" as OW


O ..> OW : reads
W ..> OW : reads
OW --> O : writes

@enduml
