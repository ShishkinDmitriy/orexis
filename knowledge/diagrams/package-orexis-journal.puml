@startuml package-orexis-journal
!pragma layout smetana
title orexis-journal — every struct, enum and trait in src/, by module\ngenerated by tools/class-diagrams.py · ~*~-~- held by value · o~-~- shared · ..|> implements
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11
skinparam packageStyle rectangle
hide empty members
left to right direction

package "activities" {
