  }
  class "Traced" as orexis_journal__recorder__Traced << (S,#A8D8EA) struct >> {
    {field} .0 : Arc<Journal>
  }
}


orexis_journal__activities__Keeper o-- "1" orexis_journal__journal__Journal : journal
orexis_journal__activities__Keeper *-- "*" orexis_journal__activities__Open : open
orexis_journal__recorder__Keeps o-- "0..1" orexis_journal__journal__Journal : journal
