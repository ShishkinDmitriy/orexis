    {field} +journal : Option<Arc<Journal>>
  }
  class "Recorder" as orexis_journal__recorder__Recorder << (S,#A8D8EA) struct >> {
    {field} +window_s : f64
    {field} +incident_from : log::Level
    {field} +incidents : std::collections::BTreeSet<String>
    {field} +served_at : Option<u16>
