    {field} -journal : Arc<Journal>
    {field} -open : HashMap<NamedNode, Open>
    {field} -recent : HashMap<NamedNode, (NamedNode, Option<&'static str>, DateTime)>
    {field} -order : std::collections::VecDeque<NamedNode>
  }
  class "Open" as orexis_journal__activities__Open << (S,#A8D8EA) struct >> {
    {field} -activity : NamedNode
    {field} -kind : &'static str
    {field} -triggers : Vec<NamedNode>
    {field} -began : DateTime
    {field} -parent : Option<NamedNode>
    {field} -generated : Vec<(NamedNode, Option<&'static str>, DateTime)>
    {field} -lasting : bool
  }
}
package "events" {
  class "History" as orexis_journal__events__History << (S,#A8D8EA) struct >> {
  }
}
package "journal" {
  class "Entry" as orexis_journal__journal__Entry << (S,#A8D8EA) struct >> {
    {field} +node : NamedNode
    {field} +quads : Vec<Quad>
    {field} +needed : bool
  }
  class "Journal" as orexis_journal__journal__Journal << (S,#A8D8EA) struct >> {
    {field} +store : Engine
    {field} -window : f64
    {field} -now : Now
    {field} -swept : Mutex<Option<DateTime>>
    {field} -changed : AtomicBool
    {field} +incident : tokio::sync::Notify
    {field} +incident_level : log::Level
    {field} +incidents : BTreeSet<String>
    {field} -archive : std::sync::OnceLock<Engine>
  }
}
package "recorder" {
