@startuml service-planner
title Planner — what it reads and writes

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 14
skinparam ArrowFontSize 10
skinparam database {
  BackgroundColor #E8F1F8
  BorderColor #5B8DB8
}
skinparam folder {
  BackgroundColor #FFFFFF
  BorderColor #8FB4D0
  FontSize 11
}
skinparam component {
  BackgroundColor #EAF5EA
  BorderColor #5E9E5E
}


database "Beliefs · repository" as BEL {
  folder "orexis:ActionGraph" as A
  folder "orexis:WorldGraph" as W
  folder "orexis:StateGraph" as S
  folder "orexis:PickRecordGraph" as P
  folder "market:ObligationsGraph" as O
  folder "deliberation:DeliberationGraph" as D
}

database "Desires · repository" as DES {
  folder "no graph class" as X
}

database "Imaginarium · repository" as IMG {
  folder "orexis:PossibleGraph" as V
}

component "Planner\nruns Planning" as PL


A ..> PL : reads
W ..> PL : reads
S ..> PL : reads
P ..> PL : reads
O ..> PL : reads
X ..> PL : reads
V ..> PL : reads
PL --> V : writes
PL --> D : writes

@enduml
