@startuml agent-structure
title What an agent SHOULD have\nsix modalities · one repository each · services beside them\nblue = repository (passive) · green = service (logic) · pink = the delta from today

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 14
skinparam ArrowFontSize 10
skinparam ArrowColor #6B7A88
skinparam database {
  BackgroundColor #E8F1F8
  BorderColor #5B8DB8
}
skinparam folder {
  BackgroundColor #FFFFFF
  BorderColor #8FB4D0
  FontSize 11
}
skinparam component {
  BackgroundColor #EAF5EA
  BorderColor #5E9E5E
}

database "**Beliefs** · what IS\nvolume · reset by rebirth only" as BEL {
  folder "graph/ontology + /entailed" as g1
  folder "graph/world + /derived + /entailed" as g2
  folder "graph/sensed" as g4
  folder "graph/provenance\nwhich FILES each public graph came from" as g6
  folder "graph/classification\nwhat this agent's own graphs ARE" as g7
  folder "graph/picks/{agent} · the picks" as g8
  folder "graph/obligations/{agent} · LIVE debts" as g9
  folder "graph/instruments · sensing's" as p1 #FFFCF2
  folder "graph/evidence/{agent} · review's\na derived view, so it stays" as p2 #FFFCF2
  folder "graph/summaries/{agent} · review's\nrunning totals = current state" as p4 #FFFCF2
}

database "**Menu** · what I COULD do\nmemory · rebuilt from premises" as MEN #FFF4F4 {
  folder "graph/actions — the TEMPLATES\nprecondition · effect · taker\nMOVES OUT OF beliefs" as g3 #FDE8E8
}

database "**Desires** · what I PURSUE\nmemory · read-only to the runtime" as DES {
  folder "graph/desire/asserted" as d1
  folder "graph/desire/derived" as d2
}

database "**Intentions** · what I am DOING\nvolume · STANDING rows only" as INT {
  folder "graph/intentions/{agent}" as i1
}

database "**History** · what I DID\nvolume RING · append-only · #311" as HIS #FFF4F4 {
  folder "resolved intentions\nMOVE OUT OF intentions" as h1 #FDE8E8
  folder "discharged obligations\nMOVE OUT OF beliefs" as h2 #FDE8E8
  folder "graph/revisions/{agent}\nMOVES OUT OF beliefs" as h3 #FDE8E8
}

database "**Imaginarium** · hypothesised\nmemory, per pass · the planner holds it\nreached(parent, path, added, retracted)" as IMG {
  folder "one graph per SEARCH NODE\nnever mutated — a world is a value" as m1
}

component "menu build\nmenu_of() · rows NEVER stored" as MB #FDE8E8
component "planner" as PL
component "deliberator" as DEL
component "execution\nplan · commit · take" as EX
component "keeper" as KE
component "owing" as OW
component "revision\nthe seam" as RV
component "desires build\n_Derivation — lives INSIDE the repo" as DB #FDE8E8
component "inference" as INF
component "upkeep\ncompaction — talks to Store" as UP
component "sensing" as SEN #FBF3DC
component "review" as RVW #FBF3DC

