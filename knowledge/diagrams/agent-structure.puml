@startuml agent-structure
!pragma layout smetana
title Agent 0.2.0 — each package's services and the graph kinds it declares\nblue = a graph kind (passive) · cream = sensing's and speech's, handed to no reader of the mind · green = a service (logic)\nsolid = writes · dotted = reads · every graph is named by its kind alone, and the catalogue says what each one is

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 14
skinparam ArrowFontSize 10
skinparam ArrowColor #6B7A88
skinparam folder {
  BackgroundColor #E8F1F8
  BorderColor #5B8DB8
  FontSize 11
}
skinparam component {
  BackgroundColor #EAF5EA
  BorderColor #5E9E5E
}
skinparam frame {
  BorderColor #9AA5B1
  FontSize 12
}

frame "transport" {
  component "MQTT · HTTP member" as TR
}

frame "sensing" {
  component "received · missed\nruns revision over its observations" as SEN
  folder "sensing:ObservationGraph\none per reading · linked by sensing:previous" as obs #FFFCF2
  folder "sensing:ForecastGraph" as fc
}

frame "speech" {
  component "heard · said · extract" as SP
  folder "speech:StatementGraph\nwhat was said, heard or said\nhanded to no reader of the mind" as utt #FFFCF2
}

frame "belief" {
  component "deliberator\nrevise · trigger" as DEL
  folder "belief:RevisionGraph\nwhat the rules concluded of a source,\nof the kind its runner hands" as rev
  folder "sh:RulesGraph\nthe rules a package or a domain ships" as rules
}

frame "kernel" {
  component "runtime\nboot · genesis · a pass" as RT
  folder "orexis:CatalogueGraph\nwhat every graph IS, itself included" as cat
  folder "orexis:OntologyGraph · orexis:WorldGraph\norexis:SocietyGraph · common beliefs,\nthe world's documents" as pub
  folder "orexis:ActionGraph · orexis:DriftGraph\nwhat the agent reads to act, no belief" as acts
  folder "orexis:SelfGraph\nwho I am · my roles · my stances" as self
  folder "orexis:BeliefGraph\nthe agent's own state · the subject beliefs\na silence · what is extracted of a statement" as st
  folder "orexis:PredictionGraph\na diff over a period" as pr
  folder "orexis:PlanGraph\na plan published, adopted by reference" as plan
  folder "orexis:RecordGraph\nworth believing over its period" as rec
}

frame "prediction" {
  component "predict" as PRE
}

frame "planning" {
  component "Planner\nderive_wants · lay_ground · take · publish_plan" as PL
  folder "planning:DesireGraph · planning:ShapesGraph\nplanning:ConstraintGraph · planning:DerivationGraph\nauthored · no belief" as des
  folder "planning:WantGraph\none-shot · what a desire read unmet" as want
  folder "planning:ScopeGraph\nthe scopes, written at boot" as scope
  folder "planning:GroundGraph · planning:PossibleGraph\nplanning:PlanGraph · the imaginarium's" as img
  folder "planning:ChangeableGraph\nwhat a search can change, cut out of a belief graph" as cut
}

frame "execution" {
  component "Executor\ntick · drain · command" as EX
  folder "execution:IntentionGraph\nthe plans adopted" as int
  folder "execution:CommittedStepGraph\na step adopted, over its landing window" as cs
  folder "execution:AddsGraph · execution:RetractsGraph\nwhat a published step predicts" as diff
}

' ───────────────────────── who writes what ─────────────────────────

RT  --> cat
RT  --> pub
RT  --> acts
RT  --> self
RT  --> des
RT  --> rules
TR  --> SEN : bytes
TR  --> SP : a document
SEN --> obs
SEN --> fc
SEN --> st : silentSince
SEN --> DEL : revise · trigger
DEL --> rev
DEL --> st : a transition
SP  --> utt
SP  --> st : what an extraction concludes
PRE --> pr
PL  --> scope
PL  --> want
PL  --> img
PL  --> cut
PL  --> plan
PL  --> diff
EX  --> int
EX  --> cs
EX  --> TR : a command

' ───────────────────────── who reads what ─────────────────────────

obs ..> PRE : the reading in hand
obs ..> EX : a command's number
cs  ..> PRE
st  ..> PL
pr  ..> PL
rec ..> PL
plan ..> EX
rules ..> DEL
acts ..> PL
acts ..> PRE : drifts

note as N1
  **The mind reads only beliefs.** An observation is sensing's:
  no sensing, no observations. Sensing runs belief's machinery
  over each one, and what the domain's transitions conclude
  lands in the agent's state as a subject belief in the
  domain's words. Only the boundary reads the number:
  prediction, and a command sizing a step.
  ----
  **The imaginarium is planning's**, one per scope, in memory:
  the grounds, the possible worlds and a pass's plan. An
  observation never crosses into it; a pass's plan crosses
  back out once, published for the executor to adopt.
  ----
  **Not drawn:** every reader of the common beliefs, the metrics
  and history each package emits as events, and the market's
  kinds (`domains/market/`), beneath `orexis:BeliefGraph`.
end note
@enduml
