@startuml package-orexis-metrics
!pragma layout smetana
title orexis-metrics — every struct, enum and trait in src/, by module\ngenerated by tools/class-diagrams.py · ~*~-~- held by value · o~-~- shared · ..|> implements
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11
skinparam packageStyle rectangle
hide empty members
left to right direction

package "meter" {
  class "Meter" as orexis_metrics__meter__Meter << (S,#A8D8EA) struct >> {
    {field} +written_to : Option<String>
    {field} +window_s : f64
    {field} +window : Option<Arc<Mutex<Window>>>
  }
}
package "window" {
  class "Tally" as orexis_metrics__window__Tally << (S,#A8D8EA) struct >> {
    {field} -count : i64
    {field} -flags : Vec<(String, i64)>
    {field} -values : Vec<(String, (i64, f64, f64))>
  }
  class "Window" as orexis_metrics__window__Window << (S,#A8D8EA) struct >> {
    {field} +sink : Sink
    {field} +interval_s : f64
    {field} -who : Vec<(String, String)>
    {field} -tallies : BTreeMap<Key, Tally>
    {field} -levels : BTreeMap<Key, BTreeMap<String, Field>>
    {field} -opened : f64
    {field} +monotonic : Box<dyn Fn() -> f64 + Send + Sync>
    {field} +wall : Box<dyn Fn() -> DateTime + Send + Sync>
  }
}

package "orexis" #EEEEEE {
  enum "Field" as orexis__events__Field << (E,#F6D6A8) enum >>
  class "Sink" as orexis__series__Sink << (S,#A8D8EA) struct >>
}

orexis_metrics__meter__Meter o-- "0..1" orexis_metrics__window__Window : window
orexis_metrics__window__Window *-- "1" orexis__series__Sink : sink
orexis_metrics__window__Window *-- "*" orexis_metrics__window__Tally : tallies
orexis_metrics__window__Window *-- "*" orexis__events__Field : levels
@enduml
