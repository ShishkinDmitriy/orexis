# a_chat_on_telegram
#
# THE WORLD THE TELEGRAM TRANSPORT IS HELD TO: the keeper, speaking through a bot of its own, in a chat with Anna that
# the Bot API names 4242 and in a group, -100, with her and a peer; Anna writing as Telegram user 111.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix speech: <http://example.org/orexis/speech#> .
@prefix telegram: <http://example.org/orexis/telegram#> .
@prefix schema: <https://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

GRAPH :ontology {
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:SelfGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:SelfGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :ontology.metadata {
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology.metadata a orexis:MetadataGraph .
  :ontology.metadata orexis:metadataOf :ontology .
}

GRAPH :world {
  :anna a schema:Person .
  :anna schema:name "Anna" .
  :anna telegram:userId "111" .
  :anna_telegram a telegram:Chat .
  :anna_telegram telegram:chatId "4242" .
  :household a speech:Chat .
  :household speech:channel :household_telegram .
  :household speech:participant :anna .
  :household speech:participant :keeper .
  :household speech:participant :peer .
  :household_telegram a telegram:Chat .
  :household_telegram telegram:chatId "-100" .
  :keeper a orexis:Agent .
  :keeper orexis:localId "keeper" .
  :keeper telegram:hasBot :keeper_bot .
  :keeper_and_anna a speech:Chat .
  :keeper_and_anna speech:channel :anna_telegram .
  :keeper_and_anna speech:participant :anna .
  :keeper_and_anna speech:participant :keeper .
  :keeper_bot a telegram:Bot .
  :peer a orexis:Agent .
  :peer orexis:localId "peer" .
  :peer telegram:hasBot :peer_bot .
  :peer_bot a telegram:Bot .
}

GRAPH :world.metadata {
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
  :world.metadata a orexis:MetadataGraph .
  :world.metadata orexis:metadataOf :world .
}

GRAPH :catalogue {
}

GRAPH :self.metadata {
  :self a orexis:BeliefGraph .
  :self a orexis:Graph .
  :self a orexis:SelfGraph .
  :self orexis:arrivedBy orexis:Asserted .
  :self orexis:ownedBy :keeper .
  :self.metadata a orexis:MetadataGraph .
  :self.metadata orexis:metadataOf :self .
}
