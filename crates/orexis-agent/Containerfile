# THE BINARY'S IMAGE, one per agent whose every package is ported: the binary built with the features its roles
# load, the tree's documents it boots from, and nothing else — no interpreter, no package manager, no shell
# (knowledge/decisions/the-agent-moves-to-rust-one-package-at-a-time.md). `orexis-compose` writes each such service's
# build with its features; the world is mounted read-only beside the domains, as for the Python image.
#
#   cd world/<name> && podman compose build
#
# THE COPY LIST IS THE BOUNDARY here as in the root Containerfile: `onboarding/` is absent because it is not named
# below, and tests/test_layout.py holds this file to that as well.

# ── the binary ──────────────────────────────────────────────────────────────────────────────────
# RocksDB, the volume's store, is C++ bound through bindgen, so the build stage carries a C++ compiler and libclang.
FROM docker.io/library/rust:1-slim-bookworm AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends clang libclang-dev g++ make \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Cargo.toml Cargo.toml
COPY Cargo.lock Cargo.lock
COPY crates/ crates/
ARG FEATURES=""
RUN --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --locked -p orexis-agent --no-default-features --features "volume,${FEATURES}" \
 && cp target/release/orexis-agent /orexis-agent

# What the boot reads of the tree: each package's vocabulary and documents, beside the kernel's, and no code.
RUN mkdir -p /out/crates /out/state /out/journal \
 && cd crates && find . -path '*/tests' -prune -o \( -name '*.ttl' -o -name '*.trig' \) -print \
    | tar -cf - -T - | tar -xf - -C /out/crates \
 && chown -R 10001:10001 /out/state /out/journal

# ── the image ───────────────────────────────────────────────────────────────────────────────────
# glibc and libstdc++, which RocksDB links, and nothing to run but the binary.
FROM gcr.io/distroless/cc-debian12

WORKDIR /app
COPY --from=build /orexis-agent /usr/local/bin/orexis-agent
COPY --from=build /out/crates /app/crates
# its volumes' mount points, the agent's own, so a volume created on them is the agent's to write
COPY --from=build /out/state /app/state
COPY --from=build /out/journal /app/journal
COPY domains/ /app/domains/
ENV OREXIS_TREE=/app/crates

# An agent runs as nobody in particular, the same uid the Python image runs as, so a volume it lived in stays its own.
USER 10001:10001

# No default command: the compose file says which agent this container is.
