@prefix actuation: <http://example.org/orexis/actuation#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix speech: <http://example.org/orexis/speech#> .
@prefix onboarding: <http://example.org/orexis/onboarding#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<> a onboarding:RequirementGraph .    # this document is one graph, and this is what it is

#  WHAT A WORLD MUST STATE OF the MQTT transport's WORDS, held by onboarding alone before anything is granted
#  (knowledge/domain/onboarding/requirement.md, #838). No agent loads this graph: its kind is
#  onboarding's, and the boot passes over it as it passes over a world's hardware.

[] a sh:NodeShape ;
    sh:targetClass speech:Speaker ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a speaker listens to no topic and is in no chat: no peer's document would reach it" ;
        sh:select """SELECT $this WHERE { ?me orexis:plays $this FILTER NOT EXISTS { ?me mqtt4ssn:listensToTopic ?topic }
  FILTER NOT EXISTS { ?chat speech:participant ?me } }""" ] ,
    [ a sh:SPARQLConstraint ;
        sh:message "a speaker connected to no broker and in no chat: what is said to it is carried by none" ;
        sh:select """SELECT $this WHERE { ?me orexis:plays $this FILTER NOT EXISTS { ?me mqtt4ssn:isConnectedToBroker ?broker }
  FILTER NOT EXISTS { ?chat speech:participant ?me } }""" ] .


#  AN OBSERVER WHOSE SENSOR'S BOARD TAKES COMMANDS OPERATES IT: sensing says when the sensor's reading is due, and only
#  the operator tells the board to sense, so an observer playing none would let a board that waits to be told go quiet.
[] a sh:NodeShape ;
    sh:targetClass sensing:Observer ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "an observer attends a sensor whose board listens for commands and the agent plays no actuation:Operator, so nothing would tell the board to sense" ;
        sh:select """SELECT $this WHERE { ?me orexis:plays $this . $this sensing:attends/sensing:sensor ?sensor .
  ?board ssn:hasSubSystem ?sensor ; mqtt4ssn:listensToTopic ?topic .
  FILTER NOT EXISTS { ?me orexis:plays ?role . ?role a actuation:Operator } }""" ] .
