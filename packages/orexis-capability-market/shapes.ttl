@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix orexis:   <http://example.org/orexis#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix market: <http://example.org/orexis/market#> .

# Rules for the Market module. Bidding and Hosting are separate capabilities with separate
# rules, so an agent that only bids is never asked for a reserve price.

market:BiddingAgentShape a sh:NodeShape ;
    rdfs:comment "An agent that bids must have a venue to bid in and a wallet to bid with. What it will PAY is domain-specific and checked by the domain's shapes." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this <http://example.org/orexis#hasCapability>
                                       <http://example.org/orexis/market#Bidding> }
        """ ] ;
    sh:property [ sh:path market:bidsIn ; sh:minCount 1 ; sh:class market:Market ;
                  sh:message "a bidder must participate in a market" ] ;
    sh:property [ sh:path market:hasEndowment ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minInclusive 0 ;
                  sh:message "a bidder must have an opening balance" ] .

market:HostingAgentShape a sh:NodeShape ;
    rdfs:comment "A host must run a venue and state its terms: what it puts up, the floor it will not sell below, how long it waits for bids, and how often it will open a round at all." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this <http://example.org/orexis#hasCapability>
                                       <http://example.org/orexis/market#Hosting> }
        """ ] ;
    sh:property [ sh:path market:hosts ; sh:minCount 1 ; sh:class market:Market ] ;
    sh:property [ sh:path market:offerQuantityL ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path market:reservePricePerL ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path market:bidWindowS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minExclusive 0 ;
                  sh:message "a host must say how long it waits for bids, or a round never closes" ] ;
    sh:property [ sh:path market:roundCooldownS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minInclusive 0 ] .

market:MarketShape a sh:NodeShape ;
    rdfs:comment "A market states all FOUR of its channels — offer, bid, claim, redeem; a venue you cannot answer on is not a venue. It said three until #275's sweep: the redeem channel arrived with the presentation and the count did not follow, which is a comment describing a shape one constraint smaller than the one underneath it." ;
    sh:targetClass market:Market ;
    sh:property [ sh:path market:marketFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path market:offerTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path market:bidTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path market:claimTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path market:redeemTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "a market states where a holder presents its claim — without it a claim is paper nobody can spend" ] ;
    #  Belt and braces, and the braces are the derivation: a source stating no window derives
    #  no venue, so this fires only for a venue somebody authored BY HAND — which a world may
    #  still do. Positive because a window of zero is a claim that expires before the wire
    #  carries it, and there is no reading of "held for no time" that a buyer could act on.
    sh:property [ sh:path market:redeemWindowS ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minExclusive 0 ;
                  sh:message "a market that takes presentations states how long it holds a winner's claim — a deadline is what makes a debt urgent rather than eternal, and what stops a host keeping paper for ever" ] .

market:HostStatesHowItMatchesShape a sh:NodeShape ;
    rdfs:comment "A host must say how it matches. Without it no matching capability is derived, `agent.provider` finds nobody, and the failure arrives at the END of a round — bids collected, deadline passed, nothing to allocate them with, and every bidder waiting on a claim that will not come. That is expensive and silent, and it is exactly what a world can be held to before anything starts. Targeted at whoever hosts rather than at orexis:Agent, because an agent that hosts nothing has no auction to state terms for." ;
    sh:targetSubjectsOf market:hosts ;
    sh:property [ sh:path market:matchesBy ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class market:BidMatchingCapability ;
                  sh:message "a host must state how it matches bids — one market:matchesBy naming a matching capability" ] .

market:OnlyAHostMatchesShape a sh:NodeShape ;
    rdfs:comment "The mirror: stating how you would run an auction you cannot convene is an authoring slip, not a choice. The derivation already ignores it — it is guarded on market:hosts — so without this the statement would sit in the world doing nothing, which is the shape of a fact somebody will later believe." ;
    sh:targetSubjectsOf market:matchesBy ;
    sh:property [ sh:path market:hosts ; sh:minCount 1 ; sh:class market:Market ;
                  sh:message "only a host states how it matches — this agent hosts no market" ] .

market:DenominationSaysItsDirectionShape a sh:NodeShape ;
    rdfs:comment "A valuation term that says WHAT bids are priced in must also say WHICH WAY winning moves it. Half the claim is not a smaller claim — a reflex handed the denomination alone falls back to a hardcoded sign, and a model handed it cannot act at all: 'there is a market for water' does not say whether bidding helps a dry pot or a soaked one. Only where a denomination exists: a market for something no instrument measures stays expressible, exactly as market:aboutProperty's own comment promises. This targets the T-BOX — the domain package's own statement — so it fires at the world gate for whoever ratifies a domain, not against any agent's beliefs." ;
    sh:targetSubjectsOf market:aboutProperty ;
    sh:property [ sh:path market:direction ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class market:Direction ;
                  sh:message "a denominated valuation must state its direction — which way applying the lot moves the property its bids are priced in" ] .
