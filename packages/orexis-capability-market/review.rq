#  Review's rule for a bidder (#518): the belief revision function, in SPARQL.
#
#  Every answered lot leaves a residual in the evidence graph — the reading its step
#  predicted, the reading the world showed at the verdict, and where the property stood
#  before. Two things can be wrong with a prediction, and they leave different marks:
#
#  - the residuals LEAN one way: the property keeps moving a different distance than the
#    rule promised, in proportion — the CONVERSION is wrong by that ratio. Predicted
#    movement is litres over the conversion held, actual movement is litres over the true
#    one, so the true conversion is the held one times promised over moved. Proposed inside
#    the term's range, and only where the lean exceeds the tolerance, since inside it the
#    world already counts as answering;
#  - the residuals SCATTER: they land on both sides, further than the tolerance admits (or
#    much nearer than it) — the TOLERANCE is what is wrong, and it is re-picked to the widest
#    relative miss with a quarter of slack, inside its bounds.
#
#  A rule with too few residuals says nothing: `review:residualWindow` is the society's
#  count, and one surprising dose is noise where three are a model. Nothing here names an
#  agent or a graph of one: `$me`, `$evidence` and `$beliefs` are the reviewer's substitutions.
#  The ratios are cast to xsd:double first: a ZERO decimal numerator divided by a decimal binds
#  nothing in this engine (measured, pinned in tests/test_desires.py), and a residual of exactly
#  zero is the ordinary case of a dose landing where it was promised.
#  The residual is on whichever step of Acquiring's method carried the prediction (#523).
SELECT ?term ?value WHERE {
  {
    { SELECT (AVG(?o - ?b) AS ?moved) (AVG(?p - ?b) AS ?promised) (COUNT(?r) AS ?n) WHERE {
        GRAPH <$evidence> { ?r a review:Residual ; review:ofAction ?step ;
                               review:predicted ?p ; review:observed ?o ; review:baseline ?b .
        VALUES ?step { market:Acquiring market:Tendering market:Presenting } } } }
    GRAPH ?g { review:ReviewCapability review:residualWindow ?window }
    $me market:bidsIn ?m . ?m market:marketFor ?src . ?src market:supplies ?good .
    ?term market:ofGood ?good ; market:aboutProperty ?about .
    GRAPH <$beliefs> { $me ?term ?conversion }
    OPTIONAL { GRAPH <$beliefs> { $me market:tolerance ?mine } }
    GRAPH ?g2 { market:Bidding market:tolerance ?default }
    GRAPH <$evidence> { ?rg a review:Range ; review:onTerm ?term ;
                           review:notBelow ?floor ; review:notAbove ?ceiling }
    BIND(COALESCE(?mine, ?default) AS ?tol)
    FILTER(?n >= ?window && ?promised != 0 && ?moved * ?promised > 0)
    FILTER(xsd:double(ABS(?moved - ?promised)) / ABS(?promised) > ?tol)
    BIND(xsd:double(?conversion * ?promised) / ?moved AS ?fixed)
    BIND(IF(?fixed < ?floor, ?floor, IF(?fixed > ?ceiling, ?ceiling, ?fixed)) AS ?value)
  } UNION {
    { SELECT (MAX(xsd:double(ABS(?o - ?p)) / ABS(?p - ?b)) AS ?spread) (COUNT(?r) AS ?n) WHERE {
        GRAPH <$evidence> { ?r a review:Residual ; review:ofAction ?step ;
                               review:predicted ?p ; review:observed ?o ; review:baseline ?b .
        VALUES ?step { market:Acquiring market:Tendering market:Presenting } }
        FILTER(?p != ?b) } }
    GRAPH ?g { review:ReviewCapability review:residualWindow ?window }
    OPTIONAL { GRAPH <$beliefs> { $me market:tolerance ?mine } }
    GRAPH ?g2 { market:Bidding market:tolerance ?default }
    GRAPH <$evidence> { ?rg a review:Range ; review:onTerm market:tolerance ;
                           review:notBelow ?floor ; review:notAbove ?ceiling }
    BIND(COALESCE(?mine, ?default) AS ?tol)
    FILTER(?n >= ?window && (?spread > ?tol || ?spread < ?tol / 2))
    BIND(market:tolerance AS ?term)
    BIND(?spread * 1.25 AS ?wanted)
    BIND(IF(?wanted < ?floor, ?floor, IF(?wanted > ?ceiling, ?ceiling, ?wanted)) AS ?value)
  }
}
