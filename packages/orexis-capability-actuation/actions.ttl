@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orexis:        <http://example.org/orexis#> .
@prefix sosa:      <http://www.w3.org/ns/sosa/> .
@prefix market:    <http://example.org/orexis/market#> .
@prefix actuation: <http://example.org/orexis/actuation#> .

#  THE ACTIONS THIS PACKAGE BRINGS — one node each, and the whole of one (knowledge/domain/action.md):
#    orexis:available  its PRECONDITION — a SELECT over the world binding ?property ?via ?direction,
#                  and ?for_agent where the row is a duty owed to someone; `$me` and
#                  `$properties` substituted by the collector, prefixes prepended by the store;
#    sh:construct  its EFFECT, with orexis:retracts, orexis:landsAfter and orexis:confirmedBy beside it;
#    (who carries it out is the code's to say: `@contributes(<this action>)` on its module.)
#  Precondition, effect and taker were three files and a fourth surface; a STRIPS operator is one
#  thing, and an author adds a way of acting by adding a node here and a `take()` to a module.

#################  What a DOSE makes true  #################
#
#  The lever that justified a CONSTRUCT over add/delete patterns, and it is worth being exact
#  about why. Opening a valve ADDS NO TRIPLE. Nothing in the graph becomes true the moment the
#  water leaves; what changes is a reading a LATER observation reports.
#
#  WHAT IT REPORTS IS A BAND (#579, deliberation-is-on-triples-and-a-number-is-not-special).
#  This rule used to predict the NUMBER — `litres / conversion` from where the property stood —
#  which put a sizing on the search's path and a number in every possible world. A dose reaches
#  the region: the reading is then a `sensing:InRegion` of this subject's property, and that is
#  the whole of what the search plans on and the keeper holds the world to. How much to pour to
#  get there is progression's, sized by `dose_for` from the reading in hand when the step is
#  taken — the conversion is read there, and revised there on the residuals. A dose that could
#  not reach the region (a vessel nearly empty) reaches it anyway as far as this rule can say;
#  the world answers otherwise, and the next pass plans the next dose.
#
#  The chain is still walked, and it belongs here for the same reason it always did: a rule
#  states its own premises, which is what makes it a rule rather than a fragment somebody has
#  to assemble.

actuation:Dosing
    a orexis:Action ;

    #  AVAILABLE where BOTH chains end at $me (#190, the ladder's second rung): the LEVER chain —
    #  an actuator I hold, plumbed to my own subject — and the RESOURCE chain — it draws from a
    #  source that is MINE (market:offeredBy, entailed) AND that no market offers as its lot. The
    #  NOT EXISTS is the rule that keeps the rung honest: the market is about the resource, not
    #  the lever, so a pot-local pump on the shared barrel yields Acquire and only Acquire.
    orexis:available """
        SELECT DISTINCT ?want ?about ?via ?direction WHERE {
          VALUES (?want ?about) { $wants }
          $me orexis:actsFor ?subject .
          $me actuation:hasActuator ?via .
          ?via actuation:actuates ?subject ;
               actuation:drawsFrom ?source .
          ?source market:offeredBy $me .
          FILTER NOT EXISTS { ?venue market:marketFor ?source }
          ?source market:supplies ?good .
          ?valuation market:ofGood ?good ;
                     market:aboutProperty ?about ;
                     market:direction ?direction .
        }""" ;

    rdfs:label "what a dose makes true" ;

    sh:construct """
        CONSTRUCT {
            ?obs a sosa:Observation , ?band ;
                 sosa:hasFeatureOfInterest $subject ;
                 sosa:observedProperty $about ;
                 sosa:resultTime ?now .
        } WHERE {
            $me orexis:actsFor $subject ; actuation:hasActuator ?lever .
            ?lever actuation:actuates $subject ; actuation:drawsFrom ?source .
            ?source market:offeredBy $me ; market:supplies ?good .
            ?term market:ofGood ?good ; market:aboutProperty $about .
            GRAPH $picks { $me ?term ?conversion }
            FILTER(?conversion > 0)
            #  THE BAND A DOSE REACHES: in the region, of this subject's property — the member genesis
            #  minted from the range the subject states — from below it or from inside it.
            #  From ABOVE it, more water helps nothing: the reading stays in the family it is
            #  in, which is the same world as before and pruned as one. Where the property
            #  stands is read by this rule from the world it is asked about, so the step's
            #  precondition carries it — the band the reading is in, never a number; optional,
            #  since a dose may be planned before any reading exists.
            #  The wetness test sits INSIDE the standing reading's pattern: outside it, an
            #  unbound ?standing would join freely with any reading above its region.
            #  A READING MUST STAND, and the requirement is load-bearing rather than
            #  defensive. Where the property has never been read, this rule yielding a
            #  reading would FABRICATE one — and a world that knows where the pot is scores
            #  better than one that does not, so a content plant would buy water to find out
            #  how wet it is (#137, the guard the zero-size filter used to carry). Requiring
            #  the reading leaves such a world untouched and the step discarded as somewhere
            #  already seen, which is the path every other "this does not help" arrives by;
            #  a look comes first, as it always did.
             ?standing sosa:hasFeatureOfInterest $subject ;
                             sosa:observedProperty $about .
                           OPTIONAL { ?standing a ?tooWet .
                                      FILTER(?tooWet = sensing:AboveRegion) } 
            BIND(IF(BOUND(?tooWet), sensing:AboveRegion, sensing:InRegion) AS ?family)
            ?band rdfs:subClassOf ?family ;
                  sensing:ofSubject $subject ; sensing:ofProperty $about .
            BIND(BNODE() AS ?obs)
            #  STAMPED WHEN THIS ACT'S CHANGE COMPLETES (#588), not when the plan was made:
            #  a reading this construct predicts exists at the instant the act lands, and
            #  `$lands` is that instant — the node's own plus this act's `orexis:landsAfter`.
            BIND($lands AS ?now)
        }""" ;

    #  WHEN IT LANDS, from the same premises and by the same argument as the magnitude above.
    #  `min(litres, the device's cap) / its calibration` is the open-seconds — the identical
    #  arithmetic `command_for` puts on the wire — and it is here because a deadline computed
    #  somewhere else is a second claim about when the world should have answered. An agent
    #  holding two of those plans against one timeline and verifies against another, and the
    #  disagreement arrives as a false UNMET that looks like a device lying.
    #
    #  A QUERY and not a number because the duration is a function of the act: a two-litre dose
    #  holds the valve open longer than a half-litre one. The cap is the device's own, so a
    #  request past what it will pour is timed at what it will actually do.
    #  NOT joined through `orexis:actsFor`, where the construct above is. How long a valve stays
    #  open is a fact about the VALVE — the device's cap and its calibration — and a host
    #  dosing a buyer's pot needs it exactly as much as an agent dosing its own. Written with
    #  the stake join first and caught on the bench: every market dose fell back, so the
    #  single source held only for self-doses, which is the half that needed it least.
    #  ASKED WITH A SIZE AND ASKED WITHOUT ONE, and the difference is who is asking. The
    #  KEEPER asks when the step is taken, with the litres the actor sized from the reading in
    #  hand, and gets how long the valve will actually be open. The SEARCH asks about an act
    #  nobody has sized — `$litres` is bound at nothing since #579, deliberately, because how
    #  much to pour is progression's — and used to get nought seconds, so a dose landed
    #  instantly in every imagined world and a Within want's room refused nothing (#595).
    #
    #  UNSIZED, IT ANSWERS THE CEILING: the longest this valve can be open, whatever the actor
    #  decides to pour. An over-estimate is the SAFE direction for a deadline — it refuses a
    #  plan that might be late, where an under-estimate accepts one that will be — and it is
    #  the opposite of the direction an admissible cost estimate must take, which is why this
    #  is stated here rather than assumed by the kernel. The honest full answer is a RANGE,
    #  nothing to the ceiling ([#596](https://github.com/ShishkinDmitriy/orexis/issues/596)); the other end has no consumer yet and is not
    #  invented here.
    orexis:landsAfter """
        SELECT ?seconds WHERE {
            $me actuation:hasActuator ?lever .
            ?lever actuation:actuates $subject ;
                   actuation:maxDoseMl ?cap ;
                   actuation:mlPerSecond ?rate .
            FILTER(?rate > 0)
            BIND(IF($litres > 0, $litres * 1000, ?cap) AS ?asked)
            BIND(IF(?asked < ?cap, ?asked, ?cap) AS ?ml)
            BIND(?ml / ?rate AS ?seconds)
        }""" ;

    #  BY OBSERVATION, and that is about the EFFECT rather than about the act. The valve also
    #  reports that it opened, which is a different question answered on a different channel:
    #  a report says the dose happened, a reading says it helped. The rule states what makes
    #  its own predicted triple knowable, and only a later reading can do that.

    #  The reading it replaces. Not optional: `sensed_writer` upserts one node per (subject,
    #  property), so a predicted reading that left the old one standing would put two readings
    #  on one node — and a shape asking whether ANY reading of the property is below the region
    #  would answer about the one the dose just superseded, which is how a planner comes to
    #  reject the plan that works.
    orexis:retracts """
        CONSTRUCT { ?obs ?p ?o } WHERE {
            
                ?obs sosa:hasFeatureOfInterest $subject ;
                     sosa:observedProperty $about ;
                     ?p ?o .
        }""" .
