@prefix mqtt: <http://example.org/agora/mqtt#> .
@prefix actuation: <http://example.org/agora/actuation#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Rules for the society kernel. Each ontology module ships its own shapes file next to it;
# together they are the constitution as code. Validated with `agora-validate`.

ag:AgentShape a sh:NodeShape ;
    rdfs:comment "Every agent is named and does at least one thing. An agent with no capability is a process with nothing to run." ;
    sh:targetClass ag:Agent ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "an agent must state the id it is known by" ] ;
    sh:property [ sh:path ag:hasCapability ; sh:minCount 1 ; sh:class ag:Capability ;
                  sh:message "an agent must compose at least one capability" ] .

ag:DeviceShape a sh:NodeShape ;
    rdfs:comment "A device is reachable: it states where it is on the wire, so nothing has to guess its address from a naming convention." ;
    sh:targetClass ag:Device ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ag:WorldShape a sh:NodeShape ;
    rdfs:comment "The world is versioned, so every fact recorded under it can say which world it was recorded in." ;
    sh:targetClass ag:World ;
    sh:property [ sh:path ag:currentVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ag:WorldVersion ] .

ag:WorldVersionShape a sh:NodeShape ;
    sh:targetClass ag:WorldVersion ;
    sh:property [ sh:path ag:versionNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

ag:BeliefsGraphShape a sh:NodeShape ;
    rdfs:comment "A beliefs graph belongs to exactly one agent — that is the write boundary." ;
    sh:targetClass ag:BeliefsGraph ;
    sh:property [ sh:path ag:beliefsOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ag:Agent ] .

#################  Devices that are not there  #################################################
#
# These are the ESP32's rules, not RDF's. They are here because a world states its wiring and
# `agora-validate` is the last moment anyone reads it before a board is flashed and buried in a
# pot. Each one has cost somebody an afternoon at least once.
#
# SPARQL constraints spell IRIs out in full: this runs on pyshacl, and a prefix that is declared
# in one file and used in another is exactly the trap `store.PREFIXES` exists to catch elsewhere.

ag:PublicGraphShape a sh:NodeShape ;
    rdfs:comment "Every public graph must say where it came from: read from files (prov:wasDerivedFrom) or computed by something (prov:wasGeneratedBy), one or the other. Public knowledge is several graphs and the difference between them decides whether a fact may be acted on, amended or revised — so a graph that cannot account for itself makes that question unanswerable for everything inside it. Stated in PROV-O because `prov:` is already how an observation records its author; nothing here is ours. Note what this shape CANNOT catch: a graph nobody described at all is not a prov:Entity and so is not targeted — silence is caught by tests/test_provenance.py, which walks the public set rather than waiting to be told about it." ;
    sh:targetClass prov:Entity ;
    sh:or (
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ]
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ]
    ) ;
    sh:message "a public graph must record what it was derived from or what generated it — see agora/provenance.py" .

ag:SimulatedDeviceShape a sh:NodeShape ;
    rdfs:comment """A device that is stood in for must still be reachable like a real one, or the failure is a sensor that is simply, permanently silent — which reads exactly like hardware that is not there. Which it is not.

What makes it reachable is no longer only its own credential. A KY-015 reports two properties down ONE line, and `world/sensing` states that shape already: `ag:air_temp_fern` has no `mqtt:onBus` at all, because a peripheral sharing its board's connection must not mint a principal for a client that never connects. So the test is REACHABILITY rather than ownership — on a bus, or sharing the reading topic of something that is. This shape used to demand the credential, and demanding it of a simulated multi-property board would have forced exactly the second principal the hardware world refuses.""" ;
    sh:targetSubjectsOf ag:simulatedBy ;
    sh:property [ sh:path ag:simulatedBy ; sh:maxCount 1 ;
                  sh:message "one device, one stand-in" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a simulated device must be reachable: on a bus of its own, or sharing the reading topic of a device that is — otherwise nothing would ever publish for it" ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this <http://example.org/agora/mqtt#onBus> ?bus }
                FILTER NOT EXISTS {
                    $this <http://example.org/agora/mqtt#readingTopic> ?topic .
                    ?peer <http://example.org/agora/mqtt#readingTopic> ?topic ;
                          <http://example.org/agora/mqtt#onBus> ?peerBus .
                }
            }""" ] .

ag:SimulatedActuatorShape a sh:NodeShape ;
    rdfs:comment "A stood-in actuator must say where it reports. Water reaching soil is physics, and physics has no wire — so between containers the only way a simulated sensor can learn that water actually flowed is a message from the valve that flowed it. Without a status topic the stand-in valve would open into nowhere: the command would be verified, the dose computed, and the soil would stay dry forever." ;
    sh:targetSubjectsOf actuation:actuates ;
    sh:property [ sh:path mqtt:statusTopic ; sh:maxCount 1 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a simulated actuator must state mqtt:statusTopic — its stand-in reports there, and a simulated sensor waters only on what it reports" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://example.org/agora#simulatedBy> ?model .
                FILTER NOT EXISTS { $this <http://example.org/agora/mqtt#statusTopic> ?t }
            }""" ] .

ag:DeviceModelShape a sh:NodeShape ;
    rdfs:comment """What the stand-in computes between readings. Optional individually — a modelled valve has no dry rate — but each must be a number if stated at all, because the simulator reads them without a graph to check them against.

An initial value used to be held to 0..1, on the reasoning that it is a fraction of the observed property. That was true of every value this project had and false of sensing: a KY-015 reports degrees Celsius, and 21.4 is not a fraction of anything. It is held to the model's OWN range now, which catches the slip the old rule was written for — 45 where 0.45 was meant, in a model that says it runs 0..1 — and catches it in a thermometer too, where the old rule could not look.""" ;
    sh:targetClass ag:DeviceModel ;
    sh:property [ sh:path ag:modelLosesPerDay ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelMinValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelMaxValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelInitialValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelTickSeconds ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "an initial value must lie inside the range this model states — 45 where 0.45 was meant would clamp and read as a permanently soaking pot" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://example.org/agora#modelInitialValue> ?initial .
                OPTIONAL { $this <http://example.org/agora#modelMinValue> ?min }
                OPTIONAL { $this <http://example.org/agora#modelMaxValue> ?max }
                OPTIONAL {
                    ?d <http://example.org/agora#simulatedBy> $this ;
                       <http://example.org/agora/sensing#monitors> ?subject .
                    ?subject <http://example.org/agora#modelMaxValue> ?subjectMax
                }
                BIND(COALESCE(?max, ?subjectMax, 1.0) AS ?high)
                BIND(COALESCE(?min, 0.0) AS ?low)
                FILTER(?initial < ?low || ?initial > ?high)
            }""" ] .

#################  An effect rule accounts for its own timing  #################
#
#  The ontology says a rule that omitted these would be claiming immediacy by silence, and this
#  is what makes that true rather than aspirational. Targeted at `sh:SPARQLRule`, so a package
#  shipping a new `effects.ttl` is held to it without anything here naming that package — the
#  same mechanic as every other contribution: the loader finds the file, the shapes hold it.
#
#  A VIOLATION and not a warning. An effect nobody can wait for is worse than an effect nobody
#  stated: a planner reads the rule, commits to the act, and then has no answer to "has it
#  landed yet" — which is the flooding failure with a plan wrapped around it.

ag:EffectRuleAccountsForItsTimingShape a sh:NodeShape ;
    rdfs:comment "What a rule must say beyond what it does: when the world change completes, and by which route anyone would learn that it had." ;
    sh:targetClass sh:SPARQLRule ;
    sh:property [ sh:path ag:landsAfter ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ;
                  sh:message "an effect must say when it lands — a SELECT yielding ?seconds, and zero is a real answer for an act that changes nothing about the world" ] ;
    sh:property [ sh:path ag:confirmedBy ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class ag:ConfirmationRoute ;
                  sh:message "an effect must say how it would be confirmed — by construction, by report, by observation, or not at all; silence would leave a planner waiting for a message nobody will send" ] .
