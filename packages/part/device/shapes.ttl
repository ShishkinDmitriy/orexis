@prefix device: <http://example.org/orexis/device#> .
@prefix ag:   <http://example.org/orexis#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mqtt: <http://example.org/orexis/mqtt#> .
@prefix sensing: <http://example.org/orexis/sensing#> .

#  What a physical node must state, and what a stand-in must compute. Were the kernel's, and a
#  BDI kernel has no rules about pins (the-substrate-is-not-the-minds).

device:DeviceShape a sh:NodeShape ;
    rdfs:comment "A device is reachable: it states where it is on the wire, so nothing has to guess its address from a naming convention." ;
    sh:targetClass device:Device ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

device:SimulatedDeviceShape a sh:NodeShape ;
    rdfs:comment "One device, one stand-in. What makes a stand-in REACHABLE is the transport's to say, and it says so in its own shapes." ;
    sh:targetSubjectsOf device:simulatedBy ;
    sh:property [ sh:path device:simulatedBy ; sh:maxCount 1 ;
                  sh:message "one device, one stand-in" ] .

device:DeviceModelShape a sh:NodeShape ;
    rdfs:comment """What the stand-in computes between readings. Optional individually — a modelled valve has no dry rate — but each must be a number if stated at all, because the simulator reads them without a graph to check them against.

An initial value used to be held to 0..1, on the reasoning that it is a fraction of the observed property. That was true of every value this project had and false of sensing: a KY-015 reports degrees Celsius, and 21.4 is not a fraction of anything. It is held to the model's OWN range now, which catches the slip the old rule was written for — 45 where 0.45 was meant, in a model that says it runs 0..1 — and catches it in a thermometer too, where the old rule could not look.""" ;
    sh:targetClass device:DeviceModel ;
    sh:property [ sh:path device:modelLosesPerDay ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path device:modelMinValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path device:modelMaxValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path device:modelInitialValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path device:modelTickSeconds ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "an initial value must lie inside the range this model states — 45 where 0.45 was meant would clamp and read as a permanently soaking pot" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://example.org/orexis/device#modelInitialValue> ?initial .
                OPTIONAL { $this <http://example.org/orexis/device#modelMinValue> ?min }
                OPTIONAL { $this <http://example.org/orexis/device#modelMaxValue> ?max }
                OPTIONAL {
                    ?d <http://example.org/orexis/device#simulatedBy> $this ;
                       <http://example.org/orexis/sensing#monitors> ?subject .
                    ?subject <http://example.org/orexis/device#modelMaxValue> ?subjectMax
                }
                BIND(COALESCE(?max, ?subjectMax, 1.0) AS ?high)
                BIND(COALESCE(?min, 0.0) AS ?low)
                FILTER(?initial < ?low || ?initial > ?high)
            }""" ] .
