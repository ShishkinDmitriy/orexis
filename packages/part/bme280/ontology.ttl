@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix ag:   <http://example.org/agora#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix bme280: <http://example.org/agora/bme280#> .
@prefix i2c:  <http://example.org/agora/i2c#> .
@prefix mc:   <http://example.org/agora/microcontroller#> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

<http://example.org/agora/bme280> a owl:Ontology ;
    rdfs:label "BME280 environmental sensor" ;
    rdfs:comment """The outdoor-worthy air sensor, added the day the terrace was proposed and the DHT11's own ontology answered why it could not go: a MeasurementRange of 0-50 degrees and 20-90 percent is a part that cannot even report a frost or a fog, and the figures were already in the graph waiting for #111 to check them against a deployment. This part's figures are a different animal: the whole outdoor envelope, from a manufacturer that specifies it.

Structured exactly as the DHT11 package — the worked example this repository says to copy — one part class, sub-sensors named for what they are, datasheet facts on the class reaching every unit by entailment. Three sub-sensors, because this frame answers one burst read with three values taken together: a message is a measurement, exactly as the DHT's two-value frame taught.""" .

bme280:Bme280 a owl:Class ;
    mc:modelName "Bosch BME280 (GY-BME280 breakout)" ; rdfs:subClassOf mc:Peripheral ;
    rdfs:label "BME280" ;
    rdfs:comment "Four legs on the common breakout: I2C data and clock, power and ground. The BARE part is 1.71-3.6V and not 5V-tolerant — the inverse of the DHT11's trap, which survives 5V and then presents it to a pin that cannot take it; most purple GY-BME280 breakouts carry a regulator and level shifting that forgive the mistake, and 'most' is not a datasheet word, so wire it for 3.3V and owe nobody an apology. I2C address 0x76 or 0x77 by the SDO strap, which matters the day two share a bus. No wokwi:part mapping yet, deliberately: the drawing generator will refuse to draw a world carrying one, which is the loud version of not having checked what wokwi calls it." .

#################  What it is made of  #################
#
# Three sensors under one frame, ssn:hasSubSystem someValuesFrom as the DHT11 explains at
# length: the world names each unit's three, this says what they must be.

bme280:TemperatureSensor a owl:Class ; rdfs:subClassOf sosa:Sensor , ssn:System ;
    rdfs:label "BME280 temperature sensor" ;
    rdfs:comment "Measured primarily to compensate the other two — Bosch's own note — and honest ambient temperature all the same, with the caveat that the die self-heats a little when oversampling hard." .

bme280:HumiditySensor a owl:Class ; rdfs:subClassOf sosa:Sensor , ssn:System ;
    rdfs:label "BME280 humidity sensor" ;
    rdfs:comment "The full 0-100 percent span the DHT11 lacks, non-condensing. Long exposure to saturation drifts it and Bosch documents a reconditioning bake — outdoors, in a shield, that is a maintenance fact worth knowing before winter." .

bme280:PressureSensor a owl:Class ; rdfs:subClassOf sosa:Sensor , ssn:System ;
    rdfs:label "BME280 pressure sensor" ;
    rdfs:comment "The third value in the same frame. No world observes pressure yet and no domain property names it — stated here because the part reports it whether or not anyone listens, and the day a domain wants weather, the channel is waiting." .

bme280:Bme280 rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ssn:hasSubSystem ; owl:someValuesFrom bme280:TemperatureSensor ] ,
    [ a owl:Restriction ; owl:onProperty ssn:hasSubSystem ; owl:someValuesFrom bme280:HumiditySensor ] ,
    [ a owl:Restriction ; owl:onProperty ssn:hasSubSystem ; owl:someValuesFrom bme280:PressureSensor ] .

#################  Legs  #################
#
# Stated per UNIT in a world's hardware, as every part's are (`mc:hasPin` with i2c:DataPinRole,
# i2c:ClockPinRole, mc:PowerPinRole, mc:GroundPinRole) — the class only says what they mean,
# through the roles the i2c bus package already declares. The wokwi:pin drawing mapping joins
# the day the part is drawn; see the class comment for why its absence is deliberate.

#################  What it can honour  #################
#
# Datasheet: Bosch BST-BME280-DS002. On the class, reaching units by entailment (rule 5), as
# what-is-true-of-a-part-is-true-of-every-one-of-them requires. The sampling floor is stated
# well under the society's own ten seconds, like the DHT11's two — it binds nothing today and
# says so honestly.

bme280:Bme280 rdfs:seeAlso <https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bme280-ds002.pdf> .

bme280:Bme280 rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ssn-system:hasSystemCapability ;
    owl:hasValue bme280:ForcedModeCapability ] .

bme280:ForcedModeCapability a ssn-system:SystemCapability ;
    rdfs:label "BME280 sampling capability, forced mode" ;
    ssn-system:inCondition [ a ssn-system:Condition ; rdfs:label "forced mode, full oversampling" ] ;
    ssn-system:hasSystemProperty [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 1 ; schema:unitCode unit:SEC ] .

bme280:TemperatureSensor rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ssn-system:hasSystemCapability ;
      owl:hasValue bme280:TemperatureSensorCapability ] .

bme280:TemperatureSensorCapability a ssn-system:SystemCapability ;
    rdfs:label "BME280 temperature sensor capability" ;
    ssn-system:inCondition [ a ssn-system:Condition ; rdfs:label "continuous operation" ] ;
    ssn-system:hasSystemProperty
        [ a ssn-system:MeasurementRange , schema:PropertyValue ;
          schema:minValue -40 ; schema:maxValue 85 ; schema:unitCode unit:DEG_C ] ,
        [ a ssn-system:Accuracy , schema:PropertyValue ;
          schema:minValue -1.0 ; schema:maxValue 1.0 ; schema:unitCode unit:DEG_C ] ,
        [ a ssn-system:Resolution , schema:PropertyValue ;
          schema:value 0.01 ; schema:unitCode unit:DEG_C ] .

bme280:HumiditySensor rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ssn-system:hasSystemCapability ;
      owl:hasValue bme280:HumiditySensorCapability ] .

bme280:HumiditySensorCapability a ssn-system:SystemCapability ;
    rdfs:label "BME280 humidity sensor capability" ;
    ssn-system:inCondition [ a ssn-system:Condition ; rdfs:label "continuous operation, non-condensing" ] ;
    ssn-system:hasSystemProperty
        [ a ssn-system:MeasurementRange , schema:PropertyValue ;
          schema:minValue 0 ; schema:maxValue 100 ; schema:unitCode unit:PERCENT ] ,
        [ a ssn-system:Accuracy , schema:PropertyValue ;
          schema:minValue -3 ; schema:maxValue 3 ; schema:unitCode unit:PERCENT ] ,
        [ a ssn-system:Resolution , schema:PropertyValue ;
          schema:value 0.008 ; schema:unitCode unit:PERCENT ] .

bme280:PressureSensor rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ssn-system:hasSystemCapability ;
      owl:hasValue bme280:PressureSensorCapability ] .

bme280:PressureSensorCapability a ssn-system:SystemCapability ;
    rdfs:label "BME280 pressure sensor capability" ;
    ssn-system:inCondition [ a ssn-system:Condition ; rdfs:label "continuous operation" ] ;
    ssn-system:hasSystemProperty
        [ a ssn-system:MeasurementRange , schema:PropertyValue ;
          schema:minValue 300 ; schema:maxValue 1100 ; schema:unitCode unit:HectoPA ] ,
        [ a ssn-system:Accuracy , schema:PropertyValue ;
          schema:minValue -1.0 ; schema:maxValue 1.0 ; schema:unitCode unit:HectoPA ] ,
        [ a ssn-system:Resolution , schema:PropertyValue ;
          schema:value 0.0018 ; schema:unitCode unit:HectoPA ] .
