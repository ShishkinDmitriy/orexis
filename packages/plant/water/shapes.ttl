@prefix water: <http://example.org/agora/water#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rules for the water domain. These check what a bid MEANS here: an agent bidding for water
# must hold a coherent valuation. Swap the domain module and these go with it.

water:WaterBidderShape a sh:NodeShape ;
    rdfs:comment "A bidder for water values it by its deficit below a target, so it needs a target, a pot size, and a ceiling price. It no longer needs a band: judging a reading is desire's, deduced from the range the plant states, and a bidder restating those edges privately was keeping a second copy of a public fact." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://example.org/agora#hasCapability> <http://example.org/agora/market#Bidding> .
                ?this <http://example.org/agora#actsFor>       ?plant .
                ?plant a <http://example.org/agora/water#Plant> .
            }
        """ ] ;
    sh:property [ sh:path water:hasTarget ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path water:litresPerFraction ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path water:maxValuePerL ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    # The target has to answer to the agent's own region. A target is a PICK, and this is what
    # it picks inside.
    #
    # It used to read the plant's operating range directly and re-do the join every time. It now
    # asks the ONE region the agent actually holds, which is that range intersected with every
    # other that applies — so a rig whose instrument narrows what can be witnessed narrows what
    # may be aimed at, with nothing here changing. That is the point of the deduction being
    # materialised rather than recomputed by each reader: the shape and the module now agree by
    # construction instead of by two authors remembering the same join.
    #
    # Matched on the PROPERTY the desire is about, not on the first region found. An agent that
    # holds a temperature region as well must not have its moisture target checked against it —
    # the same mistake `_is_mine` exists to prevent in the module, arriving here by another door.
    #
    # This spans the PUBLIC region and a PRIVATE target, and that is the point: it can only run
    # where both are visible, which is inside the agent at boot. `validate_agent` flattens every
    # public graph plus this agent's beliefs. Nothing outside the agent ever sees the target.
    sh:sparql [
        sh:message "the target sits outside the region this agent deduced for that property — a desire is a pick within a range, not a number of its own" ;
        sh:select """
            SELECT $this ?target WHERE {
                $this <http://example.org/agora/water#hasTarget> ?target .
                <http://example.org/agora/water#hasTarget>
                      <http://example.org/agora/market#aboutProperty> ?property .
                $this <http://example.org/agora/desire#desires> ?region .
                ?region <http://www.w3.org/ns/ssn/forProperty> ?property ;
                        <https://schema.org/minValue> ?low ;
                        <https://schema.org/maxValue> ?high .
                FILTER(?target < ?low || ?target > ?high)
            }""" ] .

water:PlantShape a sh:NodeShape ;
    rdfs:comment "A plant is drawn from a source and states its physics. It holds no desire — that belongs to its agent." ;
    sh:targetClass water:Plant ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path water:servedBy ; sh:minCount 1 ; sh:class water:WaterSource ] ;
    sh:property [ sh:path water:litresPerFraction ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path water:hasTarget ; sh:maxCount 0 ;
                  sh:message "a plant holds no desire — the target belongs to its agent's beliefs" ] ;

    # What it MAY state is the range it needs, which is not a desire but a fact about the plant.
    # Optional, because a world may run without one; structured, because a range nobody can read
    # is worse than none. Each condition says which property it is about and both its ends.
    sh:property [ sh:path ( <http://www.w3.org/ns/ssn/systems/hasOperatingRange>
                            <http://www.w3.org/ns/ssn/systems/inCondition> ) ;
                  sh:node [ a sh:NodeShape ;
                      sh:property [ sh:path <http://www.w3.org/ns/ssn/forProperty> ;
                                    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                                    sh:message "a condition must say which property it is a range OF" ] ;
                      sh:property [ sh:path <https://schema.org/minValue> ; sh:minCount 1 ; sh:maxCount 1 ;
                                    sh:datatype xsd:decimal ] ;
                      sh:property [ sh:path <https://schema.org/maxValue> ; sh:minCount 1 ; sh:maxCount 1 ;
                                    sh:datatype xsd:decimal ] ] ] .

# Two ranges are only meaningful together, so this is what makes the pair coherent: a plant
# cannot thrive somewhere it would not survive. General to plants rather than stated per species,
# because it is arithmetic and not horticulture — a species package states two ranges and this
# refuses the pair if one has been fat-fingered.
#
# Per PROPERTY, matched through ssn:forProperty, for the same reason the target check is: a
# moisture operating range must sit inside the moisture survival range and has nothing to say
# about the temperature one.
water:RangesAgreeShape a sh:NodeShape ;
    rdfs:comment "An operating range that leaves the survival range is a contradiction in the species description, and the direction it usually goes is the dangerous one: a ceiling raised in the operating range without raising the one that says where rot starts. Both come from the same package, so nothing external can cause this — which is exactly why it is worth a cheap check rather than a careful reader." ;
    sh:targetClass water:Plant ;
    sh:sparql [
        sh:message "an operating range for a property lies outside the survival range for that same property — a plant cannot thrive where it would not survive" ;
        sh:select """
            SELECT $this ?low ?high WHERE {
                $this <http://www.w3.org/ns/ssn/systems/hasOperatingRange> ?operating ;
                      <http://www.w3.org/ns/ssn/systems/hasSurvivalRange>  ?survival .
                ?operating <http://www.w3.org/ns/ssn/systems/inCondition> ?wants .
                ?survival  <http://www.w3.org/ns/ssn/systems/inCondition> ?tolerates .
                ?wants     <http://www.w3.org/ns/ssn/forProperty> ?property ;
                           <https://schema.org/minValue> ?low ;
                           <https://schema.org/maxValue> ?high .
                ?tolerates <http://www.w3.org/ns/ssn/forProperty> ?property ;
                           <https://schema.org/minValue> ?floor ;
                           <https://schema.org/maxValue> ?ceiling .
                FILTER(?low < ?floor || ?high > ?ceiling)
            }""" ] .

water:WaterSourceShape a sh:NodeShape ;
    rdfs:comment "Every source has a supplier and a physical ceiling — the constitution's allocation limit." ;
    sh:targetClass water:WaterSource ;
    sh:property [ sh:path water:suppliedBy ; sh:minCount 1 ; sh:class ag:Agent ] ;
    sh:property [ sh:path water:capacityL ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] .
