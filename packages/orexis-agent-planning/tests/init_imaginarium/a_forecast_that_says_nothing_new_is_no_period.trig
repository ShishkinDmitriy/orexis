# a_forecast_that_says_nothing_new_is_no_period
#
# TWO FORECASTS AND ONE NEW GROUND. `:dip` applies at 12:30 and restates what the readings
# already say; `:refill` applies at 13:00 and changes the level. Three boundaries in the
# store, and the fill lays TWO grounds: the present, open until 13:00, and the refilled one
# after it. The middle instant is not a period, because nothing a met-test could read moved
# there and so nothing it could answer differs.
#
# A PREDICTION IS AN ACTION NOBODY TAKES. It carries `sh:construct` for what it makes true and
# `orexis:retracts` for what it takes away, like any other, and its graph's PERIOD says when it
# applies rather than a precondition saying whether it may. That is what lets a forecast
# REPLACE a reading: as a state it was merely handed alongside, so a shape holding over every
# value still saw the stale one, and a tank low now with a forecast refilling it read unmet
# for ever.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH :ontology {
  orexis:StateGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :tank1 a :Tank .
}

GRAPH :sensed {
  :tank1 :level 5 .
}

#  SAYS WHAT THE PRESENT SAYS — so the ground it would make hashes the same, and is dropped.
GRAPH :dip {
  :dip_rule a orexis:Action ;
    sh:construct """CONSTRUCT { <http://example.org/test#tank1> <http://example.org/test#level> 5 }
      WHERE {}""" ;
    orexis:retracts """CONSTRUCT { <http://example.org/test#tank1> <http://example.org/test#level> ?l }
      WHERE { GRAPH $state { <http://example.org/test#tank1> <http://example.org/test#level> ?l } }""" .
}

#  AND THIS ONE REFILLS IT, retracting the reading it supersedes.
GRAPH :refill {
  :refill_rule a orexis:Action ;
    sh:construct """CONSTRUCT { <http://example.org/test#tank1> <http://example.org/test#level> 20 }
      WHERE {}""" ;
    orexis:retracts """CONSTRUCT { <http://example.org/test#tank1> <http://example.org/test#level> ?l }
      WHERE { GRAPH $state { <http://example.org/test#tank1> <http://example.org/test#level> ?l } }""" .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :sensed orexis:beliefsOf :keeper .
  :dip a orexis:Graph .
  :dip a orexis:PredictionGraph .
  :dip orexis:beliefsOf :keeper .
  :dip dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T12:30:00+00:00"^^xsd:dateTime ] .
  :refill a orexis:Graph .
  :refill a orexis:PredictionGraph .
  :refill orexis:beliefsOf :keeper .
  :refill dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T13:00:00+00:00"^^xsd:dateTime ] .
}
