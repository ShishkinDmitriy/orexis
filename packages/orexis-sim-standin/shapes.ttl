@prefix sim:  <http://example.org/orexis/sim#> .
@prefix orexis:   <http://example.org/orexis#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mqtt: <http://example.org/orexis/mqtt#> .
@prefix actuation: <http://example.org/orexis/actuation#> .

#  What a stand-in must state, and what its physics must be. A BDI kernel has no rules about
#  either (the-substrate-is-not-the-minds), and neither has a package about pins: what is stood
#  in for is a ROLE, so these target the mark and never a physical class.

sim:StandInShape a sh:NodeShape ;
    rdfs:comment "One system, one stand-in. Its NAME on the wire is required by whatever role it plays — a sensor states one because the dashboards are drawn from it, an actuator because the ACL is — so nothing about it is asked twice here. What makes a stand-in REACHABLE is the transport's to say, and it says so in its own shapes." ;
    sh:targetSubjectsOf sim:simulatedBy ;
    sh:property [ sh:path sim:simulatedBy ; sh:maxCount 1 ;
                  sh:message "one system, one stand-in" ] .

sim:ModelShape a sh:NodeShape ;
    rdfs:comment """What the stand-in computes between readings. Optional individually — a modelled valve has no dry rate — but each must be a number if stated at all, because the simulator reads them without a graph to check them against.

An initial value used to be held to 0..1, on the reasoning that it is a fraction of the observed property. That was true of every value this project had and false of sensing: a KY-015 reports degrees Celsius, and 21.4 is not a fraction of anything. It is held to the model's OWN range now, which catches the slip the old rule was written for — 45 where 0.45 was meant, in a model that says it runs 0..1 — and catches it in a thermometer too, where the old rule could not look.""" ;
    sh:targetClass sim:Model ;
    sh:property [ sh:path sim:losesPerDay ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path sim:minValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path sim:maxValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path sim:initialValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path sim:tickSeconds ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "an initial value must lie inside the range this model states — 45 where 0.45 was meant would clamp and read as a permanently soaking pot" ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT $this WHERE {
                $this sim:initialValue ?initial .
                OPTIONAL { $this sim:minValue ?min }
                OPTIONAL { $this sim:maxValue ?max }
                OPTIONAL {
                    ?d sim:simulatedBy $this ;
                       sensing:monitors ?subject .
                    ?subject sim:maxValue ?subjectMax
                }
                BIND(COALESCE(?max, ?subjectMax, 1.0) AS ?high)
                BIND(COALESCE(?min, 0.0) AS ?low)
                FILTER(?initial < ?low || ?initial > ?high)
            }""" ] .


#  The two invariants a SIMULATED world holds that a real one does not need, both spelled in the
#  one transport there is. They lived in `packages/orexis-transport-mqtt/` until the sovereign asked
#  why a transport was holding the simulation's rules, and the answer was that it should not:
#  deleting mqtt would delete these, and a stand-in that reports nowhere would stop being
#  refused by anything — the simulation losing a guarantee because a transport was replaced.
#  See a-shape-belongs-to-the-vocabulary-it-checks, which this amends.
sim:StandInReachableShape a sh:NodeShape ;
    rdfs:comment """A device that is stood in for must still be reachable like a real one, or the failure is a sensor that is simply, permanently silent — which reads exactly like hardware that is not there. Which it is not.

What makes it reachable is no longer only its own credential. A KY-015 reports two properties down ONE line, and `world/sensing` states that shape already: `orexis:air_temp_fern` has no `mqtt:onBus` at all, because a peripheral sharing its board's connection must not mint a principal for a client that never connects. So the test is REACHABILITY rather than ownership — on a bus, or sharing the reading topic of something that is. This shape used to demand the credential, and demanding it of a simulated multi-property board would have forced exactly the second principal the hardware world refuses.""" ;
    sh:targetSubjectsOf sim:simulatedBy ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a simulated device must be reachable: on a bus of its own, or sharing the reading topic of a device that is — otherwise nothing would ever publish for it" ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this mqtt:onBus ?bus }
                FILTER NOT EXISTS {
                    $this mqtt:readingTopic ?topic .
                    ?peer mqtt:readingTopic ?topic ;
                          mqtt:onBus ?peerBus .
                }
            }""" ] .


#  Names actuation AND the transport, and here that is the honest thing rather than a leak: a
#  package about pretending to be an X reachable over a Y has both words in its subject. The day
#  a second transport exists, this is one of the two shapes that needs the neutral word, and it
#  is findable because it is filed under the reason it exists.
sim:StandInReportsShape a sh:NodeShape ;
    rdfs:comment "A stood-in actuator must say where it reports. Water reaching soil is physics, and physics has no wire — so between containers the only way a simulated sensor can learn that water actually flowed is a message from the valve that flowed it. Without a status topic the stand-in valve would open into nowhere: the command would be verified, the dose computed, and the soil would stay dry forever." ;
    sh:targetSubjectsOf actuation:actuates ;
    sh:property [ sh:path mqtt:statusTopic ; sh:maxCount 1 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a simulated actuator must state mqtt:statusTopic — its stand-in reports there, and a simulated sensor waters only on what it reports" ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT $this WHERE {
                $this sim:simulatedBy ?model .
                FILTER NOT EXISTS { $this mqtt:statusTopic ?t }
            }""" ] .
