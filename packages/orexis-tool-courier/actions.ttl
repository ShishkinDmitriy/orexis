@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#  Three actions, and the ROW is the ground instance in each — one per (mover, target) the
#  state makes legal, exactly as hanoi's one Move does. Each declares what it takes in this
#  package's own words; the kernel holds the row to that list and reads none of it.

#################  DRIVING  #################

courier:Drive a orexis:Action ;
    orexis:takes courier:van, courier:to ;
    rdfs:label "drive the van to a neighbouring cell" ;
    rdfs:comment "Neighbouring is WORKED OUT, not declared: |dx| + |dy| = 1 over the cells' own coordinates. A world therefore authors a grid by stating where its cells are and nothing about how they connect, and the same coordinates are what a distance heuristic reads." ;
    orexis:available """
        SELECT ?van ?to WHERE {
             ?van courier:at ?here .
            ?van a courier:Van .
            ?here courier:x ?hx ; courier:y ?hy .
            ?to a courier:Cell ; courier:x ?ax ; courier:y ?ay .
            FILTER(ABS(?ax - ?hx) + ABS(?ay - ?hy) = 1)
        }""" ;
    orexis:costs """
        SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    orexis:retracts """
        CONSTRUCT { $van courier:at ?old } WHERE {
             $van courier:at ?old . }""" ;
    sh:construct """
        CONSTRUCT { $van courier:at $to } WHERE { }""" .

#################  PICKING UP — the first effect here that DELETES  #################

courier:Pick a orexis:Action ;
    orexis:takes courier:parcel, courier:van ;
    rdfs:label "load a parcel standing where the van stands" ;
    rdfs:comment """The retraction removes where the parcel WAS and the construct puts it aboard — a different subject-predicate pair, so nothing replaces the fact that goes. Every other effect in this repository is an upsert: it removes the observation node its own construct immediately re-creates, or the peg a disk was on while stating the peg it is on now. This one removes `courier:at` outright, which is what a delete list means in a classical planner and what nothing here had exercised.""" ;
    orexis:available """
        SELECT ?parcel ?van WHERE {
             ?van courier:at ?cell . ?parcel courier:at ?cell .
            ?parcel a courier:Parcel .
            ?van a courier:Van .
        }""" ;
    orexis:costs """
        SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    orexis:retracts """
        CONSTRUCT { $parcel courier:at ?cell } WHERE {
             $parcel courier:at ?cell . }""" ;
    sh:construct """
        CONSTRUCT { $parcel courier:carriedBy $van } WHERE { }""" .

#################  PUTTING DOWN  #################

courier:Drop a orexis:Action ;
    orexis:takes courier:parcel, courier:to ;
    rdfs:label "set a carried parcel down where the van stands" ;
    rdfs:comment "The mirror of the pick, and the reason the pair is safe: a parcel is at a cell OR aboard, so the two effects between them keep that true without either needing to know about the other." ;
    orexis:available """
        SELECT ?parcel ?to WHERE {
             ?parcel courier:carriedBy ?van . ?van courier:at ?to .
            ?parcel a courier:Parcel .
        }""" ;
    orexis:costs """
        SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    orexis:retracts """
        CONSTRUCT { $parcel courier:carriedBy ?van } WHERE {
             $parcel courier:carriedBy ?van . }""" ;
    sh:construct """
        CONSTRUCT { $parcel courier:at $to } WHERE { }""" .
