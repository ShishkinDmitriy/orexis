@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ag:        <http://example.org/orexis#> .
@prefix sosa:      <http://www.w3.org/ns/sosa/> .
@prefix market:    <http://example.org/orexis/market#> .
@prefix actuation: <http://example.org/orexis/actuation#> .

#################  What a DOSE makes true  #################
#
#  The lever that justified a CONSTRUCT over add/delete patterns, and it is worth being exact
#  about why. Opening a valve ADDS NO TRIPLE. Nothing in the graph becomes true the moment the
#  water leaves; what changes is a number that a LATER observation reports. A template of
#  concrete triples cannot say that without predicting the number, and predicting the number is
#  precisely what a CONSTRUCT can do.
#
#  THE NUMBER HAS ONE SOURCE, and this file is it. `litres / conversion` was computed in Python
#  in two places already — the bidder sizing its expectation and the actuator sizing its own
#  self-dose — before anything asked what a dose would DO. A third copy here would have been the
#  worst of it: an agent that plans against one future and verifies against another reports
#  false UNMET verdicts, which is the false-knowledge bug arriving from the planning side, and
#  it would look like a device lying rather than like arithmetic disagreeing with itself. So the
#  actuator no longer computes its expectation: it runs this rule and subtracts. See
#  `ActuationModule._expected_delta`.
#
#  The conversion is the agent's OWN belief, keyed by the term the venue tie names — the copy an
#  agent that learned would revise, and the copy it would lose money by being wrong about. The
#  premise walk below is the one `_conversion_for` walks, and it belongs here for the same
#  reason the arithmetic does: a rule states its own premises, which is what makes it a rule
#  rather than a fragment somebody has to assemble.

actuation:ActuateEffect
    a sh:SPARQLRule ;
    ag:effectOf ag:Actuate ;
    rdfs:label "what a dose makes true" ;

    #  The node-level half: an agent with no actuator can never dose, whatever it is asked
    #  about. Which valve, and whether it reaches THIS subject, is the affordance row's walk —
    #  a shape validates a focus node and has no arguments to be told a property with.
    sh:condition actuation:HoldsAnActuatorShape ;

    #  `$litres` is the dose and `$value` is where the property stands NOW. Both are given,
    #  and the base being a parameter rather than a store lookup is a correction the runtime
    #  forced: an actuator decides on the reading it was just handed, which has not been
    #  persisted yet at the moment it decides — a rule that read the sensed graph for its base
    #  predicted from the PREVIOUS reading, or from nothing at all on the first one. It is also
    #  the right shape for a planner, which holds a value from the world it is simulating and
    #  not from the one that happens to be stored. What remains read is the conversion, which
    #  is a belief and genuinely the agent's.
    #
    #  So the rule is a function of (value, litres, conversion), and that function is THE
    #  arithmetic — the one this file exists to keep in a single place.
    sh:construct """
        CONSTRUCT {
            ?obs a sosa:Observation ;
                 sosa:hasFeatureOfInterest $subject ;
                 sosa:observedProperty $property ;
                 sosa:resultTime ?now ;
                 sosa:hasSimpleResult ?predicted .
        } WHERE {
            $me ag:actsFor $subject ; actuation:hasActuator ?lever .
            ?lever actuation:actuates $subject ; actuation:drawsFrom ?source .
            ?source market:offeredBy $me ; market:supplies ?good .
            ?term market:ofGood ?good ; market:aboutProperty $property .
            GRAPH $beliefs { $me ?term ?conversion }
            FILTER(?conversion > 0)
            BIND($value + ($litres / ?conversion) AS ?predicted)
            BIND(BNODE() AS ?obs)
            BIND(NOW() AS ?now)
        }""" ;

    #  WHEN IT LANDS, from the same premises and by the same argument as the magnitude above.
    #  `min(litres, the device's cap) / its calibration` is the open-seconds — the identical
    #  arithmetic `command_for` puts on the wire — and it is here because a deadline computed
    #  somewhere else is a second claim about when the world should have answered. An agent
    #  holding two of those plans against one timeline and verifies against another, and the
    #  disagreement arrives as a false UNMET that looks like a device lying.
    #
    #  A QUERY and not a number because the duration is a function of the act: a two-litre dose
    #  holds the valve open longer than a half-litre one. The cap is the device's own, so a
    #  request past what it will pour is timed at what it will actually do.
    #  NOT joined through `ag:actsFor`, where the construct above is. How long a valve stays
    #  open is a fact about the VALVE — the device's cap and its calibration — and a host
    #  dosing a buyer's pot needs it exactly as much as an agent dosing its own. Written with
    #  the stake join first and caught on the bench: every market dose fell back, so the
    #  single source held only for self-doses, which is the half that needed it least.
    ag:landsAfter """
        SELECT ?seconds WHERE {
            $me actuation:hasActuator ?lever .
            ?lever actuation:actuates $subject ;
                   actuation:maxDoseMl ?cap ;
                   actuation:mlPerSecond ?rate .
            FILTER(?rate > 0)
            BIND(IF($litres * 1000 < ?cap, $litres * 1000, ?cap) AS ?ml)
            BIND(?ml / ?rate AS ?seconds)
        }""" ;

    #  BY OBSERVATION, and that is about the EFFECT rather than about the act. The valve also
    #  reports that it opened, which is a different question answered on a different channel:
    #  a report says the dose happened, a reading says it helped. The rule states what makes
    #  its own predicted triple knowable, and only a later reading can do that.
    ag:confirmedBy ag:ByObservation ;

    #  The reading it replaces. Not optional: `sensed_writer` upserts one node per (subject,
    #  property), so a predicted reading that left the old one standing would put two results on
    #  one node — and a shape asking whether ANY reading sits past an edge would answer about
    #  the one the dose just superseded, which is how a planner comes to reject the plan that
    #  works.
    ag:retracts """
        CONSTRUCT { ?obs ?p ?o } WHERE {
            GRAPH $sensed {
                ?obs sosa:hasFeatureOfInterest $subject ;
                     sosa:observedProperty $property ;
                     ?p ?o
            }
        }""" .

actuation:HoldsAnActuatorShape
    a sh:NodeShape ;
    rdfs:comment "An agent that holds no actuator cannot dose anything, which is the part of Actuate's precondition that is a fact about the agent rather than about a property. The rest is the affordance row's." ;
    sh:property [
        sh:path actuation:hasActuator ;
        sh:minCount 1 ;
        sh:message "this agent holds no actuator, so dosing is not among its means" ] .
