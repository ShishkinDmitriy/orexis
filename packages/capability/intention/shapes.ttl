@prefix intention: <http://example.org/agora/intention#> .
@prefix ag:   <http://example.org/agora#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rules for keeping intentions. Deliberately thin: the LEDGER is private and written only by
# the module, so shaping its rows would be validating our own output — the tests hold that. What
# IS validated is the one authored fact, the commitment policy, because it is the piece a
# beliefs file can get wrong.

intention:KeeperShape a sh:NodeShape ;
    rdfs:comment "An agent that keeps commitments must say how patient it is — the patience is the whole of what makes a commitment mean something, and its bounds are constitutional: below the floor the agent re-decides constantly and has retired the point of committing, above the ceiling it will honour a dead commitment for a day." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://example.org/agora#hasCapability>
                      <http://example.org/agora/intention#Keeping> .
            }
        """ ] ;
    sh:property [ sh:path intention:patienceS ;
                  sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 10 ; sh:maxInclusive 86400 ;
                  sh:message "a keeper of commitments must state its patience, within the constitutional bounds the family declares" ] .
