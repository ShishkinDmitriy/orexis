# The whole store after `scoping_actions` ran on two_properties_one_lever.trig, in the case's own order:
# `diff two_properties_one_lever.trig two_properties_one_lever.snapshot.trig` is what `scoping_actions` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# two_properties_one_lever
#
# One lever writes both properties, so the two are one scope and the lever is in it: a want
# about a tank low and cold is one want, planned in one cone.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .

GRAPH :actions {
  :fix a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . ?t :temperature ?x . } WHERE { ?t a :Tank }""" .
}

# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH graph:classification {
  scopes:keeper a deliberation:ScopeGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
}

GRAPH graph:ontology {
  :actions a orexis:PublicGraph .
  :world a orexis:PublicGraph .
  deliberation:JudgmentGraph rdfs:subClassOf orexis:WorkingGraph .
  deliberation:ScopeGraph rdfs:subClassOf orexis:WorkingGraph .
  graph:ontology a orexis:PublicGraph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}

GRAPH scopes:keeper {
  :fix deliberation:inScope :keeper.scope.1 .
  :keeper.scope.1 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.1 .
}
