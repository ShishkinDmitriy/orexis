# two_levers_that_take_different_time
#
# AN ACTION TAKES TIME, and a possible world is a set of facts AT AN INSTANT. Two levers reach
# the same want and neither is better on both axes: a pour is quick and dear, a trickle is slow
# and cheap. The first iteration forks two worlds from the same parent, differing in what the
# tank reads AND in when the world is.
#
# WHAT THE ROWS SAY. Each step carries `deliberation:takes`, its action's own
# `orexis:landsAfter` evaluated where it is taken — the only place that number survives the
# pass. Each world carries `deliberation:atInstant`, the pass's clock plus every landing on the
# path to it. The instant is WRITTEN and not derived, which is forced rather than chosen: this
# engine binds nothing for duration arithmetic, so no query can add a path's seconds to a clock.
#
# TIME AND COST ARE DIFFERENT AXES and this case is built so they disagree. The search orders by
# what a path SPENDS, so the cheap slow trickle is preferred to the dear quick pour, and the
# world it reaches stands ten minutes later than the other. A search that confused the two would
# pick the pour and this snapshot would say so.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix progression: <http://example.org/orexis/progression#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix possible: <http://example.org/orexis/graph/possible/> .
@prefix plan: <http://example.org/orexis/graph/plan/> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .


GRAPH :ontology {
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :dripper a :Dripper .
  :keeper progression:patienceS 300 .
  :pump a :Pump .
  :tank1 a :Tank .
}

GRAPH :actions {
  :Pouring a orexis:Action .
  :Pouring orexis:available """SELECT ?through ?about WHERE {
        ?through a <http://example.org/test#Pump> .
        BIND(<http://example.org/test#level> AS ?about) }""" .
  :Pouring orexis:costs "SELECT ?cost WHERE { BIND(9.0 AS ?cost) }" .
  :Pouring orexis:landsAfter "SELECT ?seconds WHERE { BIND(30 AS ?seconds) }" .
  :Pouring orexis:retracts """CONSTRUCT { ?t <http://example.org/test#level> ?was }
        WHERE { ?t a <http://example.org/test#Tank> ; <http://example.org/test#level> ?was }""" .
  :Pouring rdfs:label "fill the tank from the pump — quick, and dear" .
  :Pouring orexis:takes :through .
  :Pouring orexis:takes orexis:about .
  :Pouring sh:construct """CONSTRUCT { ?t <http://example.org/test#level> 20 }
        WHERE { ?t a <http://example.org/test#Tank> }""" .
  :Trickling a orexis:Action .
  :Trickling orexis:available """SELECT ?through ?about WHERE {
        ?through a <http://example.org/test#Dripper> .
        BIND(<http://example.org/test#level> AS ?about) }""" .
  :Trickling orexis:costs "SELECT ?cost WHERE { BIND(1.0 AS ?cost) }" .
  :Trickling orexis:landsAfter "SELECT ?seconds WHERE { BIND(600 AS ?seconds) }" .
  :Trickling orexis:retracts """CONSTRUCT { ?t <http://example.org/test#level> ?was }
        WHERE { ?t a <http://example.org/test#Tank> ; <http://example.org/test#level> ?was }""" .
  :Trickling rdfs:label "let the dripper bring it just inside — slow, and cheap" .
  :Trickling orexis:takes :through .
  :Trickling orexis:takes orexis:about .
  :Trickling sh:construct """CONSTRUCT { ?t <http://example.org/test#level> 12 }
        WHERE { ?t a <http://example.org/test#Tank> }""" .
}

GRAPH graph:sensed {
  :tank1 :level 5 .
}

GRAPH :desires {
  :in_range a orexis:Desire .
  :in_range orexis:about :level .
  :in_range orexis:metWhen :in_range.shape .
  :in_range rdfs:label "every tank in range" .
  :in_range.shape a sh:NodeShape .
  :in_range.shape sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range.shape sh:targetClass :Tank .
  :keeper orexis:holds :in_range .
}

GRAPH pursued:in_range.pursued.tank1 {
  :in_range.pursued.tank1 a orexis:Want .
  :in_range.pursued.tank1 orexis:about :level .
  :in_range.pursued.tank1 orexis:metWhen :in_range.pursued.tank1.met .
  :in_range.pursued.tank1 prov:wasDerivedFrom :in_range .
  :in_range.pursued.tank1 rdfs:label "pursued: every tank in range" .
  :in_range.pursued.tank1.met a sh:NodeShape .
  :in_range.pursued.tank1.met sh:property [ sh:minInclusive 10 ; sh:path :level ] .
  :in_range.pursued.tank1.met sh:targetNode :tank1 .
  :keeper orexis:holds :in_range.pursued.tank1 .
}

GRAPH :scopes {
  :Pouring deliberation:inScope :keeper.scope.1 .
  :Trickling deliberation:inScope :keeper.scope.1 .
  :keeper.scope.1 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  graph:sensed a orexis:BeliefGraph .
  graph:sensed a orexis:Graph .
  graph:sensed a orexis:StateGraph .
  pursued:in_range.pursued.tank1 a deliberation:PursuedGraph .
  pursued:in_range.pursued.tank1 a orexis:Graph .
  pursued:in_range.pursued.tank1 a orexis:WantGraph .
  pursued:in_range.pursued.tank1 orexis:arrivedBy orexis:Recorded .
  pursued:in_range.pursued.tank1 orexis:beliefsOf :keeper .
}
