#  The plan it decided on.
GRAPH plan:every_disk_home {
  :every_disk_home.plan a deliberation:Plan .
  :every_disk_home.plan deliberation:forWant :every_disk_home .
  :every_disk_home.plan deliberation:step :every_disk_home.plan.0 .
  :every_disk_home.plan deliberation:takes 0.0 .
  :every_disk_home.plan deliberation:verdict "exhausted" .
  :every_disk_home.plan progression:by :every_disk_home.plan.0 .
  :every_disk_home.plan.0 a progression:Step .
  :every_disk_home.plan.0 deliberation:of graph:sensed..Move-disk_1-PegC .
  :every_disk_home.plan.0 hanoi:disk :disk_1 .
  :every_disk_home.plan.0 hanoi:onto hanoi:PegC .
  :every_disk_home.plan.0 progression:fills hanoi:Move .
  :every_disk_home.plan.0 progression:precondition "[[\"http://example.org/orexis/hanoi#PegC\", \"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\", \"http://example.org/orexis/hanoi#Peg\"], [\"http://example.org/test#disk_1\", \"http://example.org/orexis/hanoi#on\", \"http://example.org/test#disk_2\"], [\"http://example.org/test#disk_1\", \"http://example.org/orexis/hanoi#size\", 1.0]]" .
  :every_disk_home.plan.0 progression:predicts "{\"adds\": [[\"http://example.org/test#disk_1\", \"http://example.org/orexis/hanoi#on\", \"http://example.org/orexis/hanoi#PegC\"]], \"retracts\": [[\"http://example.org/test#disk_1\", \"http://example.org/orexis/hanoi#on\", \"http://example.org/test#disk_2\"]]}" .
