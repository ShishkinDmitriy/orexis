# Every world `a_budget_that_stops_the_search.trig` forked, in the order the search made them — 4 of them.
# Regenerated by `pytest packages/orexis-agent-deliberation/tests --update-snapshots`; review the diff, it is the claim.

# a_budget_that_stops_the_search
#
# A PASS STOPPED WITH ITS FRONTIER OPEN, which is the state resumption is about and which no
# other case shows: every case beside this one runs until it has an answer.
#
# The sovereign's budget is four worlds — `deliberation:budgetWorlds`, in the pick record, read
# the way every pick is. Two disks need more than four to solve, so the pass ends EXHAUSTED
# with worlds still waiting, and `<case>.worlds.trig` beside this file is what it left.
#
# WHAT TO READ IN THE SNAPSHOT. Each world carries what is true of it whoever asks — where it
# came from, what the path spent, when it is. Each weighing carries what is true of it FOR THIS
# WANT: how far the want still is (`remaining`), what its measure reads (`wouldReach`), and —
# the point of this case — `deliberation:open`, which is the frontier. The worlds whose weighing
# says open are exactly where a resumed pass would carry on, in the order spent-plus-remaining
# puts them. Nothing else has to be carried over for it to do so.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix progression: <http://example.org/orexis/progression#> .
@prefix hanoi: <http://example.org/orexis/hanoi#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix graph: <http://example.org/orexis/graph/> .
#  Where a forked world lands. Nothing in the case says this graph; the imaginarium
#  names each world it makes, and the prefix is here so `<case>.worlds.trig` reads.
@prefix possible: <http://example.org/orexis/graph/possible/> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix picks: <http://example.org/orexis/graph/picks/> .



#  1. from sensed
GRAPH possible:Move-disk_1-PegB {
  :disk_1 hanoi:on hanoi:PegB .
  :disk_2 hanoi:on hanoi:PegA .
}

#  2. from sensed
GRAPH possible:Move-disk_1-PegC {
  :disk_1 hanoi:on hanoi:PegC .
  :disk_2 hanoi:on hanoi:PegA .
}

#  3. from Move-disk_1-PegC
GRAPH possible:Move-disk_1-PegC.Move-disk_1-PegA {
  :disk_1 hanoi:on :disk_2 .
  :disk_2 hanoi:on hanoi:PegA .
}

#  4. from Move-disk_1-PegC
GRAPH possible:Move-disk_1-PegC.Move-disk_1-PegB {
  :disk_1 hanoi:on hanoi:PegB .
  :disk_2 hanoi:on hanoi:PegA .
}

#  What the pass knows about every world it made.
GRAPH graph:pass {
  graph:sensed a deliberation:PossibleWorld ;
      deliberation:atDepth 0 ;
      deliberation:atInstant "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      deliberation:minted 0 ;
      deliberation:signature "bb7208bc9b5d7c04" ;
      deliberation:spent 0.0 ;
      deliberation:takes 0.0 ;
      deliberation:weighed graph:sensed.for.every_disk_home .
  graph:sensed.for.every_disk_home a deliberation:Weighing ;
      deliberation:expanded true ;
      deliberation:forWant :every_disk_home ;
      deliberation:remaining 2.0 ;
      deliberation:wouldReach 1.0 .
  possible:Move-disk_1-PegB a deliberation:PossibleWorld ;
      deliberation:atDepth 1 ;
      deliberation:atInstant "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      deliberation:fails :every_disk_home ;
      deliberation:from graph:sensed ;
      deliberation:minted 1 ;
      deliberation:signature "0deedbaa40d7cc37" ;
      deliberation:spent 1.0 ;
      deliberation:takes 0.0 ;
      deliberation:weighed possible:Move-disk_1-PegB.for.every_disk_home ;
      progression:by possible:Move-disk_1-PegB.step .
  possible:Move-disk_1-PegB.for.every_disk_home a deliberation:Weighing ;
      deliberation:forWant :every_disk_home ;
      deliberation:open true ;
      deliberation:remaining 2.0 ;
      deliberation:wouldReach 1.0 .
  possible:Move-disk_1-PegB.step a progression:Step ;
      orexis:about hanoi:PegB ;
      progression:fills hanoi:Move ;
      progression:through :disk_1 .
  possible:Move-disk_1-PegC a deliberation:PossibleWorld ;
      deliberation:atDepth 1 ;
      deliberation:atInstant "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      deliberation:fails :every_disk_home ;
      deliberation:from graph:sensed ;
      deliberation:lawful true ;
      deliberation:minted 2 ;
      deliberation:signature "426192855af0ca99" ;
      deliberation:spent 1.0 ;
      deliberation:takes 0.0 ;
      deliberation:weighed possible:Move-disk_1-PegC.for.every_disk_home ;
      progression:by possible:Move-disk_1-PegC.step .
  possible:Move-disk_1-PegC.Move-disk_1-PegA a deliberation:PossibleWorld ;
      deliberation:atDepth 2 ;
      deliberation:atInstant "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      deliberation:fails :every_disk_home ;
      deliberation:from possible:Move-disk_1-PegC ;
      deliberation:minted 3 ;
      deliberation:signature "bb7208bc9b5d7c04" ;
      deliberation:spent 2.0 ;
      deliberation:takes 0.0 ;
      deliberation:weighed possible:Move-disk_1-PegC.Move-disk_1-PegA.for.every_disk_home ;
      progression:by possible:Move-disk_1-PegC.Move-disk_1-PegA.step .
  possible:Move-disk_1-PegC.Move-disk_1-PegA.for.every_disk_home a deliberation:Weighing ;
      deliberation:forWant :every_disk_home ;
      deliberation:remaining 2.0 ;
      deliberation:wouldReach 1.0 .
  possible:Move-disk_1-PegC.Move-disk_1-PegA.step a progression:Step ;
      orexis:about hanoi:PegA ;
      progression:fills hanoi:Move ;
      progression:through :disk_1 .
  possible:Move-disk_1-PegC.Move-disk_1-PegB a deliberation:PossibleWorld ;
      deliberation:atDepth 2 ;
      deliberation:atInstant "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      deliberation:fails :every_disk_home ;
      deliberation:from possible:Move-disk_1-PegC ;
      deliberation:minted 4 ;
      deliberation:signature "0deedbaa40d7cc37" ;
      deliberation:spent 2.0 ;
      deliberation:takes 0.0 ;
      deliberation:weighed possible:Move-disk_1-PegC.Move-disk_1-PegB.for.every_disk_home ;
      progression:by possible:Move-disk_1-PegC.Move-disk_1-PegB.step .
  possible:Move-disk_1-PegC.Move-disk_1-PegB.for.every_disk_home a deliberation:Weighing ;
      deliberation:forWant :every_disk_home ;
      deliberation:remaining 2.0 ;
      deliberation:wouldReach 1.0 .
  possible:Move-disk_1-PegC.Move-disk_1-PegB.step a progression:Step ;
      orexis:about hanoi:PegB ;
      progression:fills hanoi:Move ;
      progression:through :disk_1 .
  possible:Move-disk_1-PegC.for.every_disk_home a deliberation:Weighing ;
      deliberation:expanded true ;
      deliberation:forWant :every_disk_home ;
      deliberation:remaining 1.0 ;
      deliberation:wouldReach 1.0 .
  possible:Move-disk_1-PegC.step a progression:Step ;
      orexis:about hanoi:PegC ;
      progression:fills hanoi:Move ;
      progression:through :disk_1 .
}
