# Every world `two_levers_that_take_different_time.trig` forked, in the order the search made them — 2 of them.
# Regenerated by `pytest packages/orexis-agent-deliberation/tests --update-snapshots`; review the diff, it is the claim.

# two_levers_that_take_different_time
#
# AN ACTION TAKES TIME, and a possible world is a set of facts AT AN INSTANT. Two levers reach
# the same want and neither is better on both axes: a pour is quick and dear, a trickle is slow
# and cheap. The first iteration forks two worlds from the same parent, differing in what the
# tank reads AND in when the world is.
#
# WHAT THE ROWS SAY. Each step carries `deliberation:takes`, its action's own
# `orexis:landsAfter` evaluated where it is taken — the only place that number survives the
# pass. Each world carries `deliberation:atInstant`, the pass's clock plus every landing on the
# path to it. The instant is WRITTEN and not derived, which is forced rather than chosen: this
# engine binds nothing for duration arithmetic, so no query can add a path's seconds to a clock.
#
# TIME AND COST ARE DIFFERENT AXES and this case is built so they disagree. The search orders by
# what a path SPENDS, so the cheap slow trickle is preferred to the dear quick pour, and the
# world it reaches stands ten minutes later than the other. A search that confused the two would
# pick the pour and this snapshot would say so.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix progression: <http://example.org/orexis/progression#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix possible: <http://example.org/orexis/graph/possible/> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .



#  1. from sensed
GRAPH possible:Pouring-level-pump {
  :tank1 :level 20 .
}

#  2. from sensed
GRAPH possible:Trickling-level-dripper {
  :tank1 :level 12 .
}

#  What the pass knows about every world it made.
GRAPH graph:pass {
  graph:sensed a deliberation:PossibleWorld .
  graph:sensed deliberation:atDepth 0 .
  graph:sensed deliberation:atInstant "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
  graph:sensed deliberation:minted 0 .
  graph:sensed deliberation:signature "bb7208bc9b5d7c04" .
  graph:sensed deliberation:spent 0.0 .
  graph:sensed deliberation:takes 0.0 .
  graph:sensed..Pouring-level-pump :through :pump .
  graph:sensed..Pouring-level-pump a deliberation:Candidate .
  graph:sensed..Pouring-level-pump deliberation:from graph:sensed .
  graph:sensed..Pouring-level-pump deliberation:takes 30.0 .
  graph:sensed..Pouring-level-pump deliberation:wouldTake :Pouring .
  graph:sensed..Pouring-level-pump orexis:about :level .
  graph:sensed..Pouring-level-pump.for.in_range.pursued.tank1 a deliberation:Weighing .
  graph:sensed..Pouring-level-pump.for.in_range.pursued.tank1 deliberation:atDepth 0 .
  graph:sensed..Pouring-level-pump.for.in_range.pursued.tank1 deliberation:forWant :in_range.pursued.tank1 .
  graph:sensed..Pouring-level-pump.for.in_range.pursued.tank1 deliberation:verdict "meets the desire" .
  graph:sensed..Pouring-level-pump.for.in_range.pursued.tank1 deliberation:weighs graph:sensed..Pouring-level-pump .
  graph:sensed..Pouring-level-pump.for.in_range.pursued.tank1 deliberation:wouldReach 0.0 .
  graph:sensed..Trickling-level-dripper :through :dripper .
  graph:sensed..Trickling-level-dripper a deliberation:Candidate .
  graph:sensed..Trickling-level-dripper deliberation:from graph:sensed .
  graph:sensed..Trickling-level-dripper deliberation:takes 600.0 .
  graph:sensed..Trickling-level-dripper deliberation:wouldTake :Trickling .
  graph:sensed..Trickling-level-dripper orexis:about :level .
  graph:sensed..Trickling-level-dripper.for.in_range.pursued.tank1 a deliberation:Weighing .
  graph:sensed..Trickling-level-dripper.for.in_range.pursued.tank1 deliberation:atDepth 0 .
  graph:sensed..Trickling-level-dripper.for.in_range.pursued.tank1 deliberation:forWant :in_range.pursued.tank1 .
  graph:sensed..Trickling-level-dripper.for.in_range.pursued.tank1 deliberation:verdict "meets the desire" .
  graph:sensed..Trickling-level-dripper.for.in_range.pursued.tank1 deliberation:weighs graph:sensed..Trickling-level-dripper .
  graph:sensed..Trickling-level-dripper.for.in_range.pursued.tank1 deliberation:wouldReach 0.0 .
  graph:sensed.for.in_range.pursued.tank1 a deliberation:Weighing .
  graph:sensed.for.in_range.pursued.tank1 deliberation:expanded true .
  graph:sensed.for.in_range.pursued.tank1 deliberation:forWant :in_range.pursued.tank1 .
  graph:sensed.for.in_range.pursued.tank1 deliberation:remaining 0.0 .
  graph:sensed.for.in_range.pursued.tank1 deliberation:weighs graph:sensed .
  graph:sensed.for.in_range.pursued.tank1 deliberation:wouldReach 1.0 .
  possible:Pouring-level-pump a deliberation:PossibleWorld .
  possible:Pouring-level-pump deliberation:atDepth 1 .
