  possible:Pouring-level-pump deliberation:spent 9.0 .
  possible:Pouring-level-pump deliberation:takes 30.0 .
  possible:Pouring-level-pump.for.in_range.pursued.tank1 a deliberation:Weighing .
  possible:Pouring-level-pump.for.in_range.pursued.tank1 deliberation:forWant :in_range.pursued.tank1 .
  possible:Pouring-level-pump.for.in_range.pursued.tank1 deliberation:remaining 0.0 .
  possible:Pouring-level-pump.for.in_range.pursued.tank1 deliberation:weighs possible:Pouring-level-pump .
  possible:Pouring-level-pump.for.in_range.pursued.tank1 deliberation:wouldReach 0.0 .
  possible:Trickling-level-dripper a deliberation:PossibleWorld .
  possible:Trickling-level-dripper deliberation:atDepth 1 .
  possible:Trickling-level-dripper deliberation:atInstant "2026-01-01T12:10:00+00:00"^^xsd:dateTime .
  possible:Trickling-level-dripper deliberation:lawful true .
