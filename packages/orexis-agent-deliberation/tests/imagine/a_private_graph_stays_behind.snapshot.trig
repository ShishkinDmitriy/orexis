# a_private_graph_stays_behind
#
# WHAT CROSSES IS WHAT NO STEP MAY CHANGE, and nothing else. Every PUBLIC graph crosses — asked
# of the catalogue, never listed — and so does the catalogue itself, since the imagined world's
# own door reads it to know what its graphs are and when they hold.
#
# A graph the agent alone holds does NOT cross unless the caller names it. The readings here
# are the agent's own and nobody named them, so they stay behind: the diff says `# DROPPED:`,
# which is the whole claim of this case.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .

GRAPH :world {
  :tank1 a :Tank .
}

# DROPPED: :sensed


GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph , orexis:Graph .
  :ontology a orexis:OntologyGraph , orexis:PublicGraph , orexis:Graph .
  :world a orexis:PublicGraph , orexis:Graph .
  :sensed a orexis:StateGraph , orexis:BeliefGraph , orexis:Graph ;
      orexis:beliefsOf :keeper .
}

