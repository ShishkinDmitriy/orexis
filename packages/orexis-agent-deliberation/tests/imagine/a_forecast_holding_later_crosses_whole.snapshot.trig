# The whole store after `imagine` ran on a_forecast_holding_later_crosses_whole.trig, in the case's own order:
# `diff a_forecast_holding_later_crosses_whole.trig a_forecast_holding_later_crosses_whole.snapshot.trig` is what `imagine` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# a_forecast_holding_later_crosses_whole
#
# EVERY PUBLIC GRAPH WHATEVER ITS PERIOD (#619). A pass asks its rules at instants of its own —
# a step's landing, a want's instant — so a forecast holding hours from now is a graph the
# PRESENT has not reached and the search still must be able to see.
#
# Copied whole, the imagined world's own door filters by the instant it is asked at, exactly as
# the belief base's does. Copied at now, a search could not see past the present's weather, and
# would find nothing there rather than an error — which is this function's whole failure mode.
#
# So the forecast crosses even though its period starts in three hours, and the diff shows it
# unchanged. A version of this that filtered by the clock would show it DROPPED.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH :world {
  :tank1 a :Tank .
}

GRAPH :forecast {
  :outside :warmth 28 .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph , orexis:Graph .
  :ontology a orexis:OntologyGraph , orexis:PublicGraph , orexis:Graph .
  :world a orexis:PublicGraph , orexis:Graph .
  :forecast a orexis:PublicGraph , orexis:Graph ;
      dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T15:00:00Z"^^xsd:dateTime ;
          orexis:end "2026-01-01T18:00:00Z"^^xsd:dateTime ] .
}

# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH :ontology {
  <http://example.org/orexis/deliberation#PursuedGraph> <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph ;
      <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:WantGraph .
  <http://example.org/orexis/deliberation#ScopeGraph> <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph ;
      <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:WorkingGraph .
  orexis:BeliefGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:CatalogueGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:DesireGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:OntologyGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph ;
      <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:PublicGraph .
  orexis:PredictionGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:PublicGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:RecordGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:StateGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:BeliefGraph ;
      <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:WantGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:WorkingGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
}
