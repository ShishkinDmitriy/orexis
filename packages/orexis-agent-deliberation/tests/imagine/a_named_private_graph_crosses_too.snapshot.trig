      <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:WantGraph .
  <http://example.org/orexis/deliberation#ScopeGraph> <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph ;
      <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:WorkingGraph .
  orexis:BeliefGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:CatalogueGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:DesireGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph .
  orexis:OntologyGraph <http://www.w3.org/2000/01/rdf-schema#subClassOf> orexis:Graph ;
