# what_was_foreseen_has_arrived
#
# The want stands AT 12:30, foreseen at 11:00 from a prediction; the present now reads the level
# low. What was foreseen has arrived: the same want, re-minted at no instant.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .


GRAPH :ontology {
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range sh:property [ orexis:about :temperature ; sh:maxInclusive 30 ; sh:path :temperature ] .
  :in_range sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire .
  :keeper.in_range orexis:about :level .
  :keeper.in_range orexis:about :temperature .
  :keeper.in_range orexis:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
}

GRAPH :sensed {
  :tank1 :level 5 .
  :tank1 :temperature 20 .
  :tank2 :level 20 .
  :tank2 :temperature 20 .
}

GRAPH pursued:keeper.in_range.pursued.tank1.level {
  :keeper orexis:holds :keeper.in_range.pursued.tank1.level .
  :keeper.in_range.pursued.tank1.level a orexis:Want .
  :keeper.in_range.pursued.tank1.level orexis:about :level .
  :keeper.in_range.pursued.tank1.level orexis:holdsAt "2026-01-01T12:30:00+00:00"^^xsd:dateTime .
  :keeper.in_range.pursued.tank1.level orexis:metWhen :keeper.in_range.pursued.tank1.level.met .
  :keeper.in_range.pursued.tank1.level prov:generatedAtTime "2026-01-01T11:00:00+00:00"^^xsd:dateTime .
  :keeper.in_range.pursued.tank1.level prov:wasDerivedFrom :keeper.in_range .
  :keeper.in_range.pursued.tank1.level rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.level.met a sh:NodeShape .
  :keeper.in_range.pursued.tank1.level.met sh:property [ sh:minInclusive 10 ; sh:path :level ] .
  :keeper.in_range.pursued.tank1.level.met sh:targetNode :tank1 .
}

GRAPH :scopes {
  :fill deliberation:inScope :keeper.scope.1 .
  :heat deliberation:inScope :keeper.scope.2 .
  :keeper.scope.1 a deliberation:Scope .
  :keeper.scope.2 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.2 .
}

# What each graph IS, and when it holds — said once each, beside the data.
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  pursued:keeper.in_range.pursued.tank1.level a orexis:Graph .
  pursued:keeper.in_range.pursued.tank1.level a orexis:WantGraph .
  pursued:keeper.in_range.pursued.tank1.level dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T11:00:00+00:00"^^xsd:dateTime ] .
  pursued:keeper.in_range.pursued.tank1.level orexis:arrivedBy orexis:Derived .
  pursued:keeper.in_range.pursued.tank1.level orexis:beliefsOf :keeper .
}
