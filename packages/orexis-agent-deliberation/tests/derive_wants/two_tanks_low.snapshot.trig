# The whole store after `derive_wants` ran on two_tanks_low.trig, in the case's own order:
# `diff two_tanks_low.trig two_tanks_low.snapshot.trig` is what `derive_wants` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# two_tanks_low
#
# Two tanks low about their level: per INSTANCE, two wants, each named for its tank. The case the
# table found first — they were one name, and the second mint overwrote the first.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .


GRAPH :ontology {
  #  WHAT A WRITER ASKS ONE STEP OF. Classifying a want's graph writes every kind
  #  `deliberation:PursuedGraph` is beneath, read from here — a real store has these because
  #  genesis materialises the closure; this case has them because it says so.
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph , orexis:Graph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

GRAPH :desires {
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      rdfs:label "every tank in range" ;
      orexis:about :level , :temperature ;
      orexis:metWhen :in_range .
  :in_range a sh:NodeShape ;
      sh:targetClass :Tank ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ; orexis:about :level ] ;
      sh:property [ sh:path :temperature ; sh:maxInclusive 30 ; orexis:about :temperature ] .
}

GRAPH :sensed {
  :tank1 :level 5 ; :temperature 20 .
  :tank2 :level 5 ; :temperature 20 .
}

GRAPH :scopes {
  :fill deliberation:inScope :keeper.scope.1 .
  :heat deliberation:inScope :keeper.scope.2 .
  :keeper.scope.1 a deliberation:Scope .
  :keeper.scope.2 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.2 .
}

# What each graph IS, and when it holds — said once each, beside the data.
# CHANGED, re-rendered:
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph ;
      a orexis:Graph .
  :desires a orexis:DesireGraph ;
      a orexis:Graph .
  :ontology a orexis:Graph ;
      a orexis:OntologyGraph ;
      a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph ;
      a orexis:Graph ;
      a orexis:WorkingGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph ;
      a orexis:Graph ;
      a orexis:StateGraph .
  :world a orexis:Graph ;
      a orexis:PublicGraph .
  pursued:keeper.in_range.pursued.tank1.level a deliberation:PursuedGraph ;
      a orexis:Graph ;
      a orexis:WantGraph ;
      dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] ;
      orexis:arrivedBy orexis:Recorded ;
      orexis:beliefsOf :keeper .
  pursued:keeper.in_range.pursued.tank2.level a deliberation:PursuedGraph ;
      a orexis:Graph ;
      a orexis:WantGraph ;
      dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] ;
      orexis:arrivedBy orexis:Recorded ;
      orexis:beliefsOf :keeper .
}


# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH pursued:keeper.in_range.pursued.tank1.level {
  :keeper orexis:holds :keeper.in_range.pursued.tank1.level .
  :keeper.in_range.pursued.tank1.level a orexis:Want ;
      orexis:about :level ;
      orexis:metWhen :keeper.in_range.pursued.tank1.level.met ;
      prov:wasDerivedFrom :keeper.in_range ;
      rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.level.met a sh:NodeShape ;
      sh:property [ orexis:about :level ;
          sh:minInclusive 10 ;
          sh:path :level ] ;
      sh:targetNode :tank1 .
}

GRAPH pursued:keeper.in_range.pursued.tank2.level {
  :keeper orexis:holds :keeper.in_range.pursued.tank2.level .
  :keeper.in_range.pursued.tank2.level a orexis:Want ;
      orexis:about :level ;
      orexis:metWhen :keeper.in_range.pursued.tank2.level.met ;
      prov:wasDerivedFrom :keeper.in_range ;
      rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank2.level.met a sh:NodeShape ;
      sh:property [ orexis:about :level ;
          sh:minInclusive 10 ;
          sh:path :level ] ;
      sh:targetNode :tank2 .
}
