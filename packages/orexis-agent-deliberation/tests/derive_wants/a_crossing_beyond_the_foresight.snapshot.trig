# The whole store after `derive_wants` ran on a_crossing_beyond_the_foresight.trig, in the case's own order:
# `diff a_crossing_beyond_the_foresight.trig a_crossing_beyond_the_foresight.snapshot.trig` is what `derive_wants` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# a_crossing_beyond_the_foresight
#
# The crossing is at 14:00 and the desire foresees an hour: nothing is derived yet.
#
# The clock stands at 2026-01-01T12:00:00Z when the road runs.
#
# THE JUDGMENTS AS `judge_desires` LEFT THEM on this situation (judge_desires/a_crossing_beyond_the_foresight.trig),
# and the scopes `scope_actions` made of its levers: the desires, the scopes, whatever
# stands, the judgment graph, and the catalogue that says what each is — no world, no
# readings, no predictions, no levers. `derive_wants` reads the store and nothing in hand.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .

GRAPH :desires {
  :in_range a sh:NodeShape ;
      sh:property [ orexis:about :level ;
          sh:minInclusive 10 ;
          sh:path :level ] ;
      sh:property [ orexis:about :temperature ;
          sh:maxInclusive 30 ;
          sh:path :temperature ] ;
      sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      orexis:about :level ;
      orexis:about :temperature ;
      orexis:foresees 3600 ;
      orexis:metWhen :in_range ;
      rdfs:label "every tank in range" .
}

GRAPH :scopes {
  :fill deliberation:inScope :keeper.scope.1 .
  :heat deliberation:inScope :keeper.scope.2 .
  :keeper.scope.1 a deliberation:Scope .
  :keeper.scope.2 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.2 .
}

GRAPH :judgments {
  :keeper.in_range.judgment a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms true .
  :keeper.in_range.judgment.20260101T140000Z a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      orexis:holdsAt "2026-01-01T14:00:00+00:00"^^xsd:dateTime ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 5 ] .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph , orexis:Graph .
  :ontology a orexis:OntologyGraph , orexis:PublicGraph , orexis:Graph .
  :judgments a deliberation:JudgmentGraph , orexis:WorkingGraph , orexis:Graph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  :desires a orexis:DesireGraph , orexis:Graph .
  :scopes a deliberation:ScopeGraph , orexis:WorkingGraph , orexis:Graph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
}

# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH :ontology {
  deliberation:JudgmentGraph rdfs:subClassOf orexis:WorkingGraph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph .
  deliberation:ScopeGraph rdfs:subClassOf orexis:WorkingGraph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:CatalogueGraph rdfs:subClassOf orexis:Graph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:OntologyGraph rdfs:subClassOf orexis:PublicGraph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:PublicGraph rdfs:subClassOf orexis:Graph .
  orexis:RecordGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}
