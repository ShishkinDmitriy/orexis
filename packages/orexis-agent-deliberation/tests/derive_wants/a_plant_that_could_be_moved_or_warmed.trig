# a_plant_that_could_be_moved_or_warmed
#
# A WANT KEEPS EVERY LINK SOME ACTION COULD MOVE. The fern is judged BELOW because the air of the
# room it stands in reads below the range it wants; the other room's air already reads inside. So
# there are two plans — HEAT the cold room, or MOVE the fern to the warm one — and the want has
# to leave room for both.
#
# What is derived is one want about the fern, and what it carries is the desire's own met-test
# with the whole chain intact: where the plant stands, the air of that room, the readings of that
# air. The narrowing a want does is by INSTANCE — `sh:targetNode :fern` in place of
# `sh:targetClass water:Plant` — and never by path. Narrow the path instead, to the air the fern
# happens to be near today, and the want becomes one no move could ever satisfy: the cold room
# stays cold whatever the fern does, and heating is the only plan the search can still see.
#
# The two levers are in the scope graph, and in two scopes: heating writes a reading and moving
# writes where the plant stands, and no action touches both. One want spans both, which is what
# a scope partition is for — it says what CANNOT interact, never what one want may reach.
#
# The clock stands at 2026-01-01T12:00:00Z when the road runs.
#
# THE JUDGMENTS AS `judge_desires` LEFT THEM on this situation
# (judge_desires/a_plant_that_could_be_moved_or_warmed.trig), and the scopes `scope_actions` made
# of its levers: the desires, the scopes, whatever stands, the judgment graph, and the catalogue
# that says what each is — no world, no readings, no predictions, no levers. `derive_wants` reads
# the store and nothing in hand.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix water: <http://example.org/orexis/water#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .

GRAPH :desires {
  :keeper orexis:holds :keeper.warm_enough .
  :keeper.warm_enough a orexis:Desire ;
      rdfs:label "every plant stands where the air is inside the range it wants" ;
      orexis:about water:AirTemperature ;
      orexis:metWhen :warm_where_it_stands .

  #  THE WHOLE CHAIN, because an action may move any link of it. `:standsIn` is the plant's
  #  room, `:hasAir` is that room's air, and the inverse of `sosa:hasFeatureOfInterest` reaches
  #  the readings of it. A shape that stopped at the air the fern is near today would be a
  #  shape no move could ever satisfy — the cold room stays cold whatever the fern does — and
  #  the search would be left with heating as the only plan it could see.
  #
  #  One block per way of failing, each saying which way, as every met-test asked by band does.
  :warm_where_it_stands a sh:NodeShape ;
      sh:targetClass water:Plant ;
      sh:property [
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Below ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [
              sh:property [ sh:path sosa:observedProperty ; sh:hasValue water:AirTemperature ] ;
              sh:class sensing:BelowRegion ] ;
          sh:message "the air where this plant stands reads below the range it wants" ] ;
      sh:property [
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Above ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [
              sh:property [ sh:path sosa:observedProperty ; sh:hasValue water:AirTemperature ] ;
              sh:class sensing:AboveRegion ] ;
          sh:message "the air where this plant stands reads above the range it wants" ] .
}

#  WHAT `scope_actions` MADE OF THE TWO LEVERS (scope_actions/a_heater_and_a_trolley.trig). Heating writes what a reading is; moving writes
#  where a plant stands. Nothing touches both, so they are two scopes — and the one want reaches
#  across them, because a scope says what cannot interact and never what a want may reach.
GRAPH :scopes {
  :heat deliberation:inScope scopes:2 .
  :move deliberation:inScope scopes:1 .
  :standsIn deliberation:inScope scopes:1 .
  sosa:hasSimpleResult deliberation:inScope scopes:2 .
  scopes:1 a deliberation:Scope .
  scopes:2 a deliberation:Scope .
}

GRAPH :judgments {
  :keeper.warm_enough.judgment a deliberation:Judgment ;
      deliberation:judges :keeper.warm_enough ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Below ;
          sh:focusNode :fern ;
          sh:value :cold_reading ] .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph , orexis:Graph .
  :ontology a orexis:OntologyGraph , orexis:PublicGraph , orexis:Graph .
  :judgments a deliberation:JudgmentGraph , orexis:WorkingGraph , orexis:Graph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  :desires a orexis:DesireGraph , orexis:Graph .
  :scopes a deliberation:ScopeGraph , orexis:WorkingGraph , orexis:Graph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
}
