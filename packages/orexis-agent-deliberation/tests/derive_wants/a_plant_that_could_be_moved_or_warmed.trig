# a_plant_that_could_be_moved_or_warmed
#
# A MET-TEST REACHES AS FAR AS THE DESIRE IS ABOUT, and here that is three links. The fern does
# not have air of its own: it stands in a room, the room has air, and the air is what is read.
# So "this plant is in air it wants" is a walk — where it STANDS, the air of THAT room, the
# readings of that air — and the shape says it that way.
#
# The companion case (outside_the_range_picked_as_ideal) reaches one link, to a watched
# property's own readings, because that is as far as what it is about goes. Neither length is a
# rule; the desire says how far, and judging follows it.
#
# The fern stands in the cold room, whose air reads BELOW. The warm room's air reads inside and
# the fern is not in it, so the desire is violated through where the fern stands. The row names
# the FERN — the focus node the shape targets — and says which way, `orexis:violationIs`.
#
# The clock stands at 2026-01-01T12:00:00Z when `derive_wants` runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix water: <http://example.org/orexis/water#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix judgments: <http://example.org/orexis/graph/judgments/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .

GRAPH :world {
  #  Where the fern stands, and another room with air of its own.
  :fern a water:Plant ; :standsIn :cold_room .

  :cold_room a :Room ; :hasAir :air_of_cold_room .
  :warm_room a :Room ; :hasAir :air_of_warm_room .

  :air_of_cold_room a sosa:Sample ; sosa:isSampleOf :cold_room .
  :air_of_warm_room a sosa:Sample ; sosa:isSampleOf :warm_room .
}

GRAPH :desires {
  :keeper orexis:holds :keeper.warm_enough .
  :keeper.warm_enough a orexis:Desire ;
      rdfs:label "every plant stands where the air is inside the range it wants" ;
      orexis:about water:AirTemperature ;
      orexis:metWhen :warm_where_it_stands .

  #  THE WHOLE CHAIN. `:standsIn` is the plant's room, `:hasAir` is that room's air, and the
  #  inverse of `sosa:hasFeatureOfInterest` reaches the readings of it. What the desire is
  #  about is the air where the plant stands, which is not a fact about any one room, so the
  #  shape walks to it rather than naming the room the fern is in today.
  #
  #  One block per way of failing, each saying which way, as every met-test asked by band does.
  :warm_where_it_stands a sh:NodeShape ;
      sh:targetClass water:Plant ;
      sh:property [
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Below ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [
              sh:property [ sh:path sosa:observedProperty ; sh:hasValue water:AirTemperature ] ;
              sh:class sensing:BelowRegion ] ;
          sh:message "the air where this plant stands reads below the range it wants" ] ;
      sh:property [
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Above ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [
              sh:property [ sh:path sosa:observedProperty ; sh:hasValue water:AirTemperature ] ;
              sh:class sensing:AboveRegion ] ;
          sh:message "the air where this plant stands reads above the range it wants" ] .
}

GRAPH :sensed {
  #  The room the fern is in reads BELOW; the room it is not in reads inside. The desire is
  #  violated through the first, and only because of where the fern stands.
  :cold_reading a sosa:Observation , sensing:BelowRegion ;
      sosa:hasFeatureOfInterest :air_of_cold_room ;
      sosa:observedProperty water:AirTemperature ;
      sosa:hasSimpleResult 11 .
  :warm_reading a sosa:Observation , sensing:InRegion ;
      sosa:hasFeatureOfInterest :air_of_warm_room ;
      sosa:observedProperty water:AirTemperature ;
      sosa:hasSimpleResult 21 .
}

#  WHAT `scope_actions` MADE OF THE TWO LEVERS (scope_actions/a_heater_and_a_trolley.trig): a
#  heater writes what a reading is, a trolley writes where a plant stands, nothing touches both,
#  so they are two scopes. The one witness here is about a property no scope holds, so the
#  clustering falls to the instance and one want is minted.
GRAPH :scopes {
  :heat deliberation:inScope scopes:2 .
  :move deliberation:inScope scopes:1 .
  :standsIn deliberation:inScope scopes:1 .
  sosa:hasSimpleResult deliberation:inScope scopes:2 .
  scopes:1 a deliberation:Scope .
  scopes:2 a deliberation:Scope .
}

# What each graph IS, and when it holds — said once each, beside the data.
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph , orexis:Graph .
  :ontology a orexis:OntologyGraph , orexis:PublicGraph , orexis:Graph .
  :world a orexis:PublicGraph , orexis:Graph .
  :sensed a orexis:StateGraph , orexis:BeliefGraph , orexis:Graph .
  :desires a orexis:DesireGraph , orexis:Graph .
  :scopes a deliberation:ScopeGraph , orexis:WorkingGraph , orexis:Graph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
}
