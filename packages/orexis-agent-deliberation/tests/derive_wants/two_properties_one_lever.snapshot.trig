# The whole store after `derive_wants` ran on two_properties_one_lever.trig, in the case's own order:
# `diff two_properties_one_lever.trig two_properties_one_lever.snapshot.trig` is what `derive_wants` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# two_properties_one_lever
#
# Level and temperature both out on tank1, and ONE lever moving both: one scope, one want about
# both — the greenhouse's bed in miniature. About everything the desire is about, so named for the
# tank alone.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .


GRAPH :ontology {
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range sh:property [ orexis:about :temperature ; sh:maxInclusive 30 ; sh:path :temperature ] .
  :in_range sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire .
  :keeper.in_range orexis:about :level .
  :keeper.in_range orexis:about :temperature .
  :keeper.in_range orexis:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
}

GRAPH :sensed {
  :tank1 :level 5 .
  :tank1 :temperature 40 .
  :tank2 :level 20 .
  :tank2 :temperature 20 .
}

GRAPH :scopes {
  :fix deliberation:inScope :keeper.scope.1 .
  :keeper.scope.1 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.1 .
}

# What each graph IS, and when it holds — said once each, beside the data.
# CHANGED, re-rendered:
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  pursued:keeper.in_range.pursued.tank1 a deliberation:PursuedGraph .
  pursued:keeper.in_range.pursued.tank1 a orexis:Graph .
  pursued:keeper.in_range.pursued.tank1 a orexis:WantGraph .
  pursued:keeper.in_range.pursued.tank1 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  pursued:keeper.in_range.pursued.tank1 orexis:arrivedBy orexis:Recorded .
  pursued:keeper.in_range.pursued.tank1 orexis:beliefsOf :keeper .
}

# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH pursued:keeper.in_range.pursued.tank1 {
  :keeper orexis:holds :keeper.in_range.pursued.tank1 .
  :keeper.in_range.pursued.tank1 a orexis:Want .
  :keeper.in_range.pursued.tank1 orexis:about :level .
  :keeper.in_range.pursued.tank1 orexis:about :temperature .
  :keeper.in_range.pursued.tank1 orexis:metWhen :keeper.in_range.pursued.tank1.met .
  :keeper.in_range.pursued.tank1 prov:wasDerivedFrom :keeper.in_range .
  :keeper.in_range.pursued.tank1 rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.met a sh:NodeShape .
  :keeper.in_range.pursued.tank1.met sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :keeper.in_range.pursued.tank1.met sh:property [ orexis:about :temperature ; sh:maxInclusive 30 ; sh:path :temperature ] .
  :keeper.in_range.pursued.tank1.met sh:targetNode :tank1 .
}
