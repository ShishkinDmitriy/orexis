# The whole store after `derive_wants` ran on what_was_foreseen_has_arrived.trig, in the case's own order:
# `diff what_was_foreseen_has_arrived.trig what_was_foreseen_has_arrived.snapshot.trig` is what `derive_wants` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# what_was_foreseen_has_arrived
#
# The want stands AT 12:30, foreseen at 11:00 from a prediction; the present now reads the level
# low. What was foreseen has arrived: the same want, re-minted at no instant.
#
# The clock stands at 2026-01-01T12:00:00Z when `derive_wants` runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix judgments: <http://example.org/orexis/graph/judgments/> .

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

GRAPH :desires {
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      rdfs:label "every tank in range" ;
      orexis:about :level , :temperature ;
      orexis:metWhen :in_range .
  :in_range a sh:NodeShape ;
      sh:targetClass :Tank ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ; orexis:about :level ] ;
      sh:property [ sh:path :temperature ; sh:maxInclusive 30 ; orexis:about :temperature ] .
}

GRAPH :sensed {
  :tank1 :level 5 ; :temperature 20 .
  :tank2 :level 20 ; :temperature 20 .
}

# CHANGED, re-rendered:
GRAPH pursued:keeper.in_range.pursued.tank1.level {
  :keeper orexis:holds :keeper.in_range.pursued.tank1.level .
  :keeper.in_range.pursued.tank1.level a orexis:Want ;
      orexis:about :level ;
      orexis:metWhen :keeper.in_range.pursued.tank1.level.met ;
      prov:wasDerivedFrom :keeper.in_range ;
      rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.level.met a sh:NodeShape ;
      sh:property [ orexis:about :level ;
          sh:minInclusive 10 ;
          sh:path :level ] ;
      sh:targetNode :tank1 .
}


GRAPH :scopes {
  :fill deliberation:inScope :keeper.scope.1 .
  :heat deliberation:inScope :keeper.scope.2 .
  :keeper.scope.1 a deliberation:Scope .
  :keeper.scope.2 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.2 .
}

# What each graph IS, and when it holds — said once each, beside the data.
# CHANGED, re-rendered:
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph ;
      a orexis:Graph .
  :desires a orexis:DesireGraph ;
      a orexis:Graph .
  :ontology a orexis:Graph ;
      a orexis:OntologyGraph ;
      a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph ;
      a orexis:Graph ;
      a orexis:WorkingGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph ;
      a orexis:Graph ;
      a orexis:StateGraph .
  :world a orexis:Graph ;
      a orexis:PublicGraph .
  judgments:keeper a deliberation:JudgmentGraph ;
      a orexis:Graph ;
      a orexis:WorkingGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  pursued:keeper.in_range.pursued.tank1.level a deliberation:PursuedGraph ;
      a orexis:Graph ;
      a orexis:WantGraph ;
      dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] ;
      orexis:arrivedBy orexis:Recorded ;
      orexis:beliefsOf :keeper .
}


# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH judgments:keeper {
  :keeper.in_range.judgment a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 5 ] .
}

GRAPH :ontology {
  deliberation:JudgmentGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WorkingGraph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WantGraph .
  deliberation:ScopeGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WorkingGraph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:CatalogueGraph rdfs:subClassOf orexis:Graph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:OntologyGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:PublicGraph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:PublicGraph rdfs:subClassOf orexis:Graph .
  orexis:RecordGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph ;
      rdfs:subClassOf orexis:Graph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}
