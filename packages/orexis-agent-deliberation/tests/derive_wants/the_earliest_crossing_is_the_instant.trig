# the_earliest_crossing_is_the_instant
#
# Two predictions of tank1's level, 12:45 and 12:20: the want holds at the earliest.
#
# The clock stands at 2026-01-01T12:00:00Z when the road runs.
#
# THE JUDGMENTS AS `judge_desires` LEFT THEM on this situation (judge_desires/the_earliest_crossing_is_the_instant.trig),
# and the scopes `scope_actions` made of its levers: the desires, the scopes, whatever
# stands, the judgment graph, and the catalogue that says what each is — no world, no
# readings, no predictions, no levers. `derive_wants` reads the store and nothing in hand.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .

GRAPH :roots {
  :in_range a sh:NodeShape ;
      sh:property [ orexis:about :level ;
          sh:minInclusive 10 ;
          sh:path :level ] ;
      sh:property [ orexis:about :temperature ;
          sh:maxInclusive 30 ;
          sh:path :temperature ] ;
      sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      orexis:about :level ;
      orexis:about :temperature ;
      orexis:foresees 3600 ;
      orexis:metWhen :in_range ;
      rdfs:label "every tank in range" .
}

GRAPH :scopes {
  :fill deliberation:inScope :keeper.scope.1 .
  :heat deliberation:inScope :keeper.scope.2 .
  :keeper.scope.1 a deliberation:Scope .
  :keeper.scope.2 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.2 .
}

GRAPH :judgments {
  :keeper.in_range.judgment a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms true .
  :keeper.in_range.judgment.20260101T122000Z a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      orexis:holdsAt "2026-01-01T12:20:00+00:00"^^xsd:dateTime ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 8 ] .
  :keeper.in_range.judgment.20260101T124500Z a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      orexis:holdsAt "2026-01-01T12:45:00+00:00"^^xsd:dateTime ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 5 ] ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 8 ] .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :ontology a orexis:OntologyGraph .
  :judgments a deliberation:JudgmentGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  :roots a orexis:DesireGraph .
  :scopes a deliberation:ScopeGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
}
