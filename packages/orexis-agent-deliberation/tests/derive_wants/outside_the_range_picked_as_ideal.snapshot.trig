  :keeper.ideal.pursued.air_warmth_of_fern a orexis:Want ;
      orexis:about :air_warmth_of_fern ;
      orexis:metWhen :keeper.ideal.pursued.air_warmth_of_fern.met ;
      prov:wasDerivedFrom :keeper.ideal ;
      rdfs:label "pursued: every watched property of every sample around a plant reads inside the range picked as ideal" .
  :keeper.ideal.pursued.air_warmth_of_fern.met a sh:NodeShape ;
      sh:property [ orexis:about sh:this ;
          orexis:violationIs orexis:Above ;
          sh:message "a watched property reads above the range picked as ideal for it" ;
          sh:path [ sh:inversePath sosa:observedProperty ] ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [ sh:class sensing:AboveRegion ] ] ;
      sh:property [ orexis:about sh:this ;
          orexis:violationIs orexis:Below ;
          sh:message "a watched property reads below the range picked as ideal for it" ;
          sh:path [ sh:inversePath sosa:observedProperty ] ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [ sh:class sensing:BelowRegion ] ] ;
      sh:property [ orexis:about sh:this ;
          orexis:violationIs orexis:Unmeasured ;
          sh:message "a watched property has never been read" ;
          sh:path [ sh:inversePath sosa:observedProperty ] ;
          sh:qualifiedMinCount 1 ;
          sh:qualifiedValueShape [ sh:or ( [ sh:class sensing:BelowRegion ] [ sh:class sensing:InRegion ] [ sh:class sensing:AboveRegion ] ) ] ] ;
      sh:targetNode :air_warmth_of_fern .
}

