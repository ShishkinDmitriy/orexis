# The whole store after `derive_wants` ran on a_plant_that_could_be_moved_or_warmed.trig, in the case's own order:
# `diff a_plant_that_could_be_moved_or_warmed.trig a_plant_that_could_be_moved_or_warmed.snapshot.trig` is what `derive_wants` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# a_plant_that_could_be_moved_or_warmed
#
# A WANT NARROWS BY INSTANCE, NEVER BY PATH. The fern is judged below through three links —
# where it stands, the air of that room, the readings of that air — and the want derived under
# that judgment carries the desire's met-test with every link of the walk intact. What the
# narrowing replaces is the TARGET: `sh:targetNode :fern` in place of `sh:targetClass
# water:Plant`, so the want is about the one plant in trouble and about nothing else.
#
# Which is the whole of it. A want about the fern is about the air wherever the fern stands, and
# stays that, because the walk is what the desire said it was about and the want keeps what the
# desire said.
#
# The clock stands at 2026-01-01T12:00:00Z when the road runs.
#
# THE JUDGMENTS AS `judge_desires` LEFT THEM on this situation
# (judge_desires/a_plant_that_could_be_moved_or_warmed.trig), and the scopes `scope_actions` made
# of its levers: the desires, the scopes, whatever stands, the judgment graph, and the catalogue
# that says what each is — no world, no readings, no predictions, no levers. `derive_wants` reads
# the store and nothing in hand.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix water: <http://example.org/orexis/water#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .

GRAPH :desires {
  :keeper orexis:holds :keeper.warm_enough .
  :keeper.warm_enough a orexis:Desire ;
      rdfs:label "every plant stands where the air is inside the range it wants" ;
      orexis:about water:AirTemperature ;
      orexis:metWhen :warm_where_it_stands .

  #  THE WHOLE CHAIN. `:standsIn` is the plant's room, `:hasAir` is that room's air, and the
  #  inverse of `sosa:hasFeatureOfInterest` reaches the readings of it. What the desire is
  #  about is the air where the plant stands, which is not a fact about any one room.
  #
  #  One block per way of failing, each saying which way, as every met-test asked by band does.
  :warm_where_it_stands a sh:NodeShape ;
      sh:targetClass water:Plant ;
      sh:property [
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Below ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [
              sh:property [ sh:path sosa:observedProperty ; sh:hasValue water:AirTemperature ] ;
              sh:class sensing:BelowRegion ] ;
          sh:message "the air where this plant stands reads below the range it wants" ] ;
      sh:property [
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Above ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [
              sh:property [ sh:path sosa:observedProperty ; sh:hasValue water:AirTemperature ] ;
              sh:class sensing:AboveRegion ] ;
          sh:message "the air where this plant stands reads above the range it wants" ] .
}

#  WHAT `scope_actions` MADE OF THE TWO LEVERS (scope_actions/a_heater_and_a_trolley.trig): a
#  heater writes what a reading is, a trolley writes where a plant stands, nothing touches both,
#  so they are two scopes. The one witness here is about a property no scope holds, so the
#  clustering falls to the instance and one want is minted.
GRAPH :scopes {
  :heat deliberation:inScope scopes:2 .
  :move deliberation:inScope scopes:1 .
  :standsIn deliberation:inScope scopes:1 .
  sosa:hasSimpleResult deliberation:inScope scopes:2 .
  scopes:1 a deliberation:Scope .
  scopes:2 a deliberation:Scope .
}

GRAPH :judgments {
  :keeper.warm_enough.judgment a deliberation:Judgment ;
      deliberation:judges :keeper.warm_enough ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Below ;
          sh:focusNode :fern ;
          sh:value :cold_reading ] .
}

# CHANGED, re-rendered:
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph ;
      a orexis:Graph .
  :desires a orexis:DesireGraph ;
      a orexis:Graph .
  :judgments a deliberation:JudgmentGraph ;
      a orexis:Graph ;
      a orexis:WorkingGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  :ontology a orexis:Graph ;
      a orexis:OntologyGraph ;
      a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph ;
      a orexis:Graph ;
      a orexis:WorkingGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
  pursued:keeper.warm_enough.pursued.fern a deliberation:PursuedGraph ;
      a orexis:Graph ;
      a orexis:WantGraph ;
      dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] ;
      orexis:arrivedBy orexis:Recorded ;
      orexis:beliefsOf :keeper .
}


# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH pursued:keeper.warm_enough.pursued.fern {
  :keeper orexis:holds :keeper.warm_enough.pursued.fern .
  :keeper.warm_enough.pursued.fern a orexis:Want ;
      orexis:about water:AirTemperature ;
      orexis:metWhen :keeper.warm_enough.pursued.fern.met ;
      prov:wasDerivedFrom :keeper.warm_enough ;
      rdfs:label "pursued: every plant stands where the air is inside the range it wants" .
  :keeper.warm_enough.pursued.fern.met a sh:NodeShape ;
      sh:property [ orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Above ;
          sh:message "the air where this plant stands reads above the range it wants" ;
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [ sh:class sensing:AboveRegion ;
              sh:property [ sh:hasValue water:AirTemperature ;
                  sh:path sosa:observedProperty ] ] ] ;
      sh:property [ orexis:about water:AirTemperature ;
          orexis:violationIs orexis:Below ;
          sh:message "the air where this plant stands reads below the range it wants" ;
          sh:path ( :standsIn :hasAir [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
          sh:qualifiedMaxCount 0 ;
          sh:qualifiedValueShape [ sh:class sensing:BelowRegion ;
              sh:property [ sh:hasValue water:AirTemperature ;
                  sh:path sosa:observedProperty ] ] ] ;
      sh:targetNode :fern .
}

GRAPH :ontology {
  deliberation:JudgmentGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WorkingGraph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WantGraph .
  deliberation:ScopeGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WorkingGraph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:CatalogueGraph rdfs:subClassOf orexis:Graph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:OntologyGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:PublicGraph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:PublicGraph rdfs:subClassOf orexis:Graph .
  orexis:RecordGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph ;
      rdfs:subClassOf orexis:Graph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}
