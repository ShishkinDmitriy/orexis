# The whole store after `derive_wants` ran on a_plant_that_could_be_moved_or_warmed.trig, in the case's own order:
# `diff a_plant_that_could_be_moved_or_warmed.trig a_plant_that_could_be_moved_or_warmed.snapshot.trig` is what `derive_wants` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# a_plant_that_could_be_moved_or_warmed
#
# A MET-TEST REACHES AS FAR AS THE DESIRE IS ABOUT, and here that is three links. The fern does
# not have air of its own: it stands in a room, the room has air, and the air is what is read.
# So "this plant is in air it wants" is a walk — where it STANDS, the air of THAT room, the
# readings of that air — and the shape says it that way.
#
# The companion case (outside_the_range_picked_as_ideal) reaches one link, to a watched
# property's own readings, because that is as far as what it is about goes. Neither length is a
# rule; the desire says how far, and judging follows it.
#
# The fern stands in the cold room, whose air reads BELOW. The warm room's air reads inside and
# the fern is not in it, so the desire is violated through where the fern stands. The row names
# the FERN — the focus node the shape targets — and says which way, `orexis:violationIs`.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix water: <http://example.org/orexis/water#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :air_of_cold_room a sosa:Sample .
  :air_of_cold_room sosa:isSampleOf :cold_room .
  :air_of_warm_room a sosa:Sample .
  :air_of_warm_room sosa:isSampleOf :warm_room .
  :cold_room :hasAir :air_of_cold_room .
  :cold_room a :Room .
  :fern :standsIn :cold_room .
  :fern a water:Plant .
  :warm_room :hasAir :air_of_warm_room .
  :warm_room a :Room .
}

GRAPH :desires {
  :keeper orexis:holds :keeper.warm_enough .
  :keeper.warm_enough a orexis:Desire .
  :keeper.warm_enough orexis:about water:AirTemperature .
  :keeper.warm_enough orexis:metWhen :warm_where_it_stands .
  :keeper.warm_enough rdfs:label "every plant stands where the air is inside the range it wants" .
  :warm_where_it_stands a sh:NodeShape .
  :warm_where_it_stands sh:property _:b6 .
  :warm_where_it_stands sh:property _:b9 .
  :warm_where_it_stands sh:targetClass water:Plant .
  _:b1 sh:class sensing:AboveRegion .
  _:b1 sh:property _:b2 .
  _:b10 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> _:b7 .
  _:b10 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
  _:b11 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> :hasAir .
  _:b11 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:b10 .
  _:b12 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> _:b3 .
  _:b12 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
  _:b13 sh:class sensing:BelowRegion .
  _:b13 sh:property _:b14 .
  _:b14 sh:hasValue water:AirTemperature .
  _:b14 sh:path sosa:observedProperty .
  _:b2 sh:hasValue water:AirTemperature .
  _:b2 sh:path sosa:observedProperty .
  _:b3 sh:inversePath sosa:hasFeatureOfInterest .
  _:b4 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> :standsIn .
  _:b4 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:b11 .
  _:b5 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> :standsIn .
  _:b5 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:b8 .
  _:b6 orexis:about water:AirTemperature .
  _:b6 orexis:violationIs orexis:Above .
  _:b6 sh:message "the air where this plant stands reads above the range it wants" .
  _:b6 sh:path _:b4 .
  _:b6 sh:qualifiedMaxCount 0 .
  _:b6 sh:qualifiedValueShape _:b1 .
  _:b7 sh:inversePath sosa:hasFeatureOfInterest .
  _:b8 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> :hasAir .
  _:b8 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:b12 .
  _:b9 orexis:about water:AirTemperature .
  _:b9 orexis:violationIs orexis:Below .
  _:b9 sh:message "the air where this plant stands reads below the range it wants" .
  _:b9 sh:path _:b5 .
  _:b9 sh:qualifiedMaxCount 0 .
  _:b9 sh:qualifiedValueShape _:b13 .
}

GRAPH :sensed {
  :cold_reading a sensing:BelowRegion .
  :cold_reading a sosa:Observation .
  :cold_reading sosa:hasFeatureOfInterest :air_of_cold_room .
  :cold_reading sosa:hasSimpleResult 11 .
  :cold_reading sosa:observedProperty water:AirTemperature .
  :warm_reading a sensing:InRegion .
  :warm_reading a sosa:Observation .
  :warm_reading sosa:hasFeatureOfInterest :air_of_warm_room .
  :warm_reading sosa:hasSimpleResult 21 .
  :warm_reading sosa:observedProperty water:AirTemperature .
}

#  WHAT `scope_actions` MADE OF THE TWO LEVERS (scope_actions/a_heater_and_a_trolley.trig): a
#  heater writes what a reading is, a trolley writes where a plant stands, nothing touches both,
#  so they are two scopes. The one witness here is about a property no scope holds, so the
#  clustering falls to the instance and one want is minted.
GRAPH :scopes {
  :heat deliberation:inScope scopes:2 .
  :move deliberation:inScope scopes:1 .
  :standsIn deliberation:inScope scopes:1 .
  scopes:1 a deliberation:Scope .
  scopes:2 a deliberation:Scope .
  sosa:hasSimpleResult deliberation:inScope scopes:2 .
}

# What each graph IS, and when it holds — said once each, beside the data.
# CHANGED, re-rendered:
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  _:b1 a dcterms:PeriodOfTime .
  _:b1 orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
  pursued:keeper.warm_enough.pursued.fern a deliberation:PursuedGraph .
  pursued:keeper.warm_enough.pursued.fern a orexis:Graph .
  pursued:keeper.warm_enough.pursued.fern a orexis:WantGraph .
  pursued:keeper.warm_enough.pursued.fern dcterms:temporal _:b1 .
  pursued:keeper.warm_enough.pursued.fern orexis:arrivedBy orexis:Recorded .
  pursued:keeper.warm_enough.pursued.fern orexis:beliefsOf :keeper .
}

