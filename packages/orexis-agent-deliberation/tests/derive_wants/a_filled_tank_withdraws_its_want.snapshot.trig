# The whole store after `derive_wants` ran on a_filled_tank_withdraws_its_want.trig, in the case's own order:
# `diff a_filled_tank_withdraws_its_want.trig a_filled_tank_withdraws_its_want.snapshot.trig` is what `derive_wants` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# a_filled_tank_withdraws_its_want
#
# The want for tank1's level stands, and the tank has since filled: the desire reads MET, so the
# decomposition no longer implies that want and it is WITHDRAWN — graph and catalogue row alike.
#
# The clock stands at 2026-01-01T12:00:00Z when the derivation runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .


GRAPH :ontology {
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property _:b1 .
  :in_range sh:property _:b2 .
  :in_range sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire .
  :keeper.in_range orexis:about :level .
  :keeper.in_range orexis:about :temperature .
  :keeper.in_range orexis:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
  _:b1 orexis:about :temperature .
  _:b1 sh:maxInclusive 30 .
  _:b1 sh:path :temperature .
  _:b2 orexis:about :level .
  _:b2 sh:minInclusive 10 .
  _:b2 sh:path :level .
}

GRAPH :sensed {
  :tank1 :level 20 .
  :tank1 :temperature 20 .
  :tank2 :level 20 .
  :tank2 :temperature 20 .
}

# DROPPED: pursued:keeper.in_range.pursued.tank1.level


GRAPH :scopes {
  :fill deliberation:inScope :keeper.scope.1 .
  :heat deliberation:inScope :keeper.scope.2 .
  :keeper.scope.1 a deliberation:Scope .
  :keeper.scope.2 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :temperature deliberation:inScope :keeper.scope.2 .
}

# What each graph IS, and when it holds — said once each, beside the data.
# CHANGED, re-rendered:
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
