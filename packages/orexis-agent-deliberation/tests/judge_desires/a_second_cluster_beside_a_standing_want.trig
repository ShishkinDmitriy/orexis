# a_second_cluster_beside_a_standing_want
#
# The level's want stands; now the temperature is out too, in another scope: the second is minted
# beside the first.
#
# The clock stands at 2026-01-01T12:00:00Z when the road runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix judgments: <http://example.org/orexis/graph/judgments/> .

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

# The levers loaded. A rule text is parsed with the store's prefixes, not this file's, so
# each says its own — an unreadable lever joins every property into one scope.
GRAPH :actions {
  :fill a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . } WHERE { ?t a :Tank }""" .
  :heat a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :temperature ?x . } WHERE { ?t a :Tank }""" .
}

GRAPH :roots {
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      rdfs:label "every tank in range" ;
      orexis:about :level , :temperature ;
      orexis:foresees 3600 ;
      orexis:metWhen :in_range .
  :in_range a sh:NodeShape ;
      sh:targetClass :Tank ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ; orexis:about :level ] ;
      sh:property [ sh:path :temperature ; sh:maxInclusive 30 ; orexis:about :temperature ] .
}

GRAPH graph:sensed {
  :tank1 :level 5 ; :temperature 40 .
  :tank2 :level 20 ; :temperature 20 .
}

GRAPH pursued:keeper.in_range.pursued.tank1.level {
  :keeper orexis:holds :keeper.in_range.pursued.tank1.level .
  :keeper.in_range.pursued.tank1.level a orexis:Want ;
      prov:wasDerivedFrom :keeper.in_range ;
      orexis:metWhen :keeper.in_range.pursued.tank1.level.met ;
      orexis:about :level ;
      rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.level.met a sh:NodeShape ; sh:targetNode :tank1 ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ] .
}

# What each graph IS, and when it holds — said once each, beside the data.
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :ontology a orexis:OntologyGraph .
  :world a orexis:PublicGraph .
  :actions a orexis:PublicGraph .
  :roots a orexis:DesireGraph .
  pursued:keeper.in_range.pursued.tank1.level a deliberation:PursuedGraph ; orexis:arrivedBy orexis:Recorded .
  pursued:keeper.in_range.pursued.tank1.level dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T11:00:00Z"^^xsd:dateTime ] .
}
