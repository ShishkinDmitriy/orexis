# The whole store after `judge_desires` ran on the_earliest_crossing_is_the_instant.trig, in the case's own order:
# `diff the_earliest_crossing_is_the_instant.trig the_earliest_crossing_is_the_instant.snapshot.trig` is what `judge_desires` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# the_earliest_crossing_is_the_instant
#
# Two predictions of tank1's level, 12:45 and 12:20: the want holds at the earliest.
#
# The clock stands at 2026-01-01T12:00:00Z when the road runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix judgments: <http://example.org/orexis/graph/judgments/> .

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

# The levers loaded. A rule text is parsed with the store's prefixes, not this file's, so
# each says its own — an unreadable lever joins every property into one scope.
GRAPH :actions {
  :fill a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . } WHERE { ?t a :Tank }""" .
  :heat a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :temperature ?x . } WHERE { ?t a :Tank }""" .
}

GRAPH :desires {
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      rdfs:label "every tank in range" ;
      orexis:about :level , :temperature ;
      orexis:foresees 3600 ;
      orexis:metWhen :in_range .
  :in_range a sh:NodeShape ;
      sh:targetClass :Tank ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ; orexis:about :level ] ;
      sh:property [ sh:path :temperature ; sh:maxInclusive 30 ; orexis:about :temperature ] .
}

GRAPH graph:sensed {
  :tank1 :level 20 ; :temperature 20 .
  :tank2 :level 20 ; :temperature 20 .
}

GRAPH :predicted-0 { :tank1 :level 5 . }
GRAPH :predicted-1 { :tank1 :level 8 . }

# What each graph IS, and when it holds — said once each, beside the data.
# CHANGED, re-rendered:
GRAPH :catalogue {
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :desires a orexis:DesireGraph .
  :ontology a orexis:OntologyGraph .
  :predicted-0 a orexis:PredictionGraph ;
      dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T12:45:00+00:00"^^xsd:dateTime ] .
  :predicted-1 a orexis:PredictionGraph ;
      dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T12:20:00+00:00"^^xsd:dateTime ] .
  :world a orexis:PublicGraph .
  judgments:keeper a deliberation:JudgmentGraph ;
      orexis:arrivedBy orexis:Derived ;
      orexis:beliefsOf :keeper .
}


# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH judgments:keeper {
  :keeper.in_range.judgment a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms true .
  :keeper.in_range.judgment.20260101T122000Z a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      orexis:holdsAt "2026-01-01T12:20:00+00:00"^^xsd:dateTime ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 8 ] .
  :keeper.in_range.judgment.20260101T124500Z a deliberation:Judgment ;
      deliberation:judges :keeper.in_range ;
      orexis:holdsAt "2026-01-01T12:45:00+00:00"^^xsd:dateTime ;
      prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime ;
      sh:conforms false ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 5 ] ;
      sh:result [ a sh:ValidationResult ;
          deliberation:constraint 0 ;
          orexis:about :level ;
          sh:focusNode :tank1 ;
          sh:value 8 ] .
}

GRAPH :ontology {
  deliberation:JudgmentGraph rdfs:subClassOf orexis:WorkingGraph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph .
  deliberation:ScopeGraph rdfs:subClassOf orexis:WorkingGraph .
  orexis:CatalogueGraph rdfs:subClassOf orexis:Graph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:OntologyGraph rdfs:subClassOf orexis:PublicGraph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:PublicGraph rdfs:subClassOf orexis:Graph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}
