# an_action_stating_no_effect_is_in_no_scope
#
# An action stating no effect is one an event adopts — never on a menu, never simulated —
# so it joins nothing and is in no scope; the lever beside it is in the one scope its
# property makes.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  #  WHAT A WRITER ASKS ONE STEP OF. Classifying the scope graph writes every kind
  #  `deliberation:ScopeGraph` is beneath, read from here.
  deliberation:ScopeGraph rdfs:subClassOf orexis:WorkingGraph , orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :actions {
  :fill a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . } WHERE { ?t a :Tank }""" .
  :look a orexis:Action .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph , orexis:Graph .
  :ontology a orexis:OntologyGraph , orexis:PublicGraph , orexis:Graph .
  :actions a orexis:PublicGraph , orexis:Graph .
}
