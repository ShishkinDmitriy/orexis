# The whole store after `scope_actions` ran on an_unreadable_lever_joins_everything.trig, in the case's own order:
# `diff an_unreadable_lever_joins_everything.trig an_unreadable_lever_joins_everything.snapshot.trig` is what `scope_actions` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# an_unreadable_lever_joins_everything
#
# The two levers of two_properties_two_levers, and a third whose effect names its predicate
# by a variable: what it writes cannot be read, so it might touch anything, and it joins
# every predicate into one scope — with all three levers in it.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  #  WHAT A WRITER ASKS ONE STEP OF. Classifying the scope graph writes every kind
  #  `deliberation:ScopeGraph` is beneath, read from here.
  deliberation:ScopeGraph rdfs:subClassOf orexis:WorkingGraph , orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :actions {
  :fill a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . } WHERE { ?t a :Tank }""" .
  :heat a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :temperature ?x . } WHERE { ?t a :Tank }""" .
  :tweak a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t ?p ?x . } WHERE { ?t a :Tank ; ?p ?x }""" .
}

# CHANGED, re-rendered:
GRAPH :catalogue {
  :actions a orexis:Graph ;
      a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph ;
      a orexis:Graph .
  :ontology a orexis:Graph ;
      a orexis:OntologyGraph ;
      a orexis:PublicGraph .
  <http://example.org/orexis/graph/scopes> a deliberation:ScopeGraph ;
      a orexis:Graph ;
      a orexis:WorkingGraph ;
      orexis:arrivedBy orexis:Derived .
}


# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH <http://example.org/orexis/graph/scopes> {
  :fill deliberation:inScope scopes:1 .
  :heat deliberation:inScope scopes:1 .
  :level deliberation:inScope scopes:1 .
  :temperature deliberation:inScope scopes:1 .
  :tweak deliberation:inScope scopes:1 .
  scopes:1 a deliberation:Scope .
}
