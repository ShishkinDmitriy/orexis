# The whole store after `scope_actions` ran on a_heater_and_a_trolley.trig, in the case's own order:
# `diff a_heater_and_a_trolley.trig a_heater_and_a_trolley.snapshot.trig` is what `scope_actions` did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# a_heater_and_a_trolley
#
# TWO LEVERS THAT SERVE ONE WANT AND SHARE NOTHING. A heater changes what a reading says; a
# trolley changes where a plant stands. No predicate is touched by both, so they fall in two
# scopes — and the want they both serve reaches across the two
# (derive_wants/a_plant_that_could_be_moved_or_warmed).
#
# That is what a scope partition is and is not. It says what CANNOT interact: nothing the
# trolley writes is read by anything the heater writes, so a plan for one cannot spoil the
# other. It says nothing about which levers a want may use, which is the want's view and is
# computed backward from what its met-test reads.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .

GRAPH :actions {
  #  A rule text is parsed with the store's prefixes, not this file's, so each says its own.
  :heat a orexis:Action ;
      sh:construct """PREFIX sosa: <http://www.w3.org/ns/sosa/>
        CONSTRUCT { ?o sosa:hasSimpleResult ?x . } WHERE { ?o a sosa:Observation }""" .
  :move a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        PREFIX water: <http://example.org/orexis/water#>
        CONSTRUCT { ?p :standsIn ?room . } WHERE { ?p a water:Plant }""" .
}

# CHANGED, re-rendered:
GRAPH :catalogue {
  :actions a orexis:Graph ;
      a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph ;
      a orexis:Graph .
  :ontology a orexis:Graph ;
      a orexis:OntologyGraph ;
      a orexis:PublicGraph .
  <http://example.org/orexis/graph/scopes> a deliberation:ScopeGraph ;
      a orexis:Graph ;
      a orexis:WorkingGraph ;
      orexis:arrivedBy orexis:Derived .
}


# --- WRITTEN (the first snapshot also holds the loader's own vocabulary stub) ---

GRAPH <http://example.org/orexis/graph/scopes> {
  :heat deliberation:inScope scopes:2 .
  :move deliberation:inScope scopes:1 .
  :standsIn deliberation:inScope scopes:1 .
  <http://www.w3.org/ns/sosa/hasSimpleResult> deliberation:inScope scopes:2 .
  scopes:1 a deliberation:Scope .
  scopes:2 a deliberation:Scope .
}

GRAPH :ontology {
  deliberation:JudgmentGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WorkingGraph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WantGraph .
  deliberation:ScopeGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:WorkingGraph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:CatalogueGraph rdfs:subClassOf orexis:Graph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:OntologyGraph rdfs:subClassOf orexis:Graph ;
      rdfs:subClassOf orexis:PublicGraph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
  orexis:PublicGraph rdfs:subClassOf orexis:Graph .
  orexis:RecordGraph rdfs:subClassOf orexis:Graph .
  orexis:StateGraph rdfs:subClassOf orexis:BeliefGraph ;
      rdfs:subClassOf orexis:Graph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}
