# The whole store after the road ran on a_crossing_beyond_the_foresight.trig.
# Regenerated by `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
@prefix : <http://example.org/test#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix orexis: <http://example.org/orexis#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix roots: <http://example.org/orexis/graph/roots/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH graph:classification {
  :predicted-0 a orexis:PredictionGraph .
  roots:keeper a orexis:DesireGraph .
}

GRAPH graph:ontology {
  :actions a orexis:PublicGraph .
  :world a orexis:PublicGraph .
  graph:ontology a orexis:PublicGraph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
}

GRAPH graph:periods {
  :predicted-0 dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T14:00:00+00:00"^^xsd:dateTime ] .
}

GRAPH roots:keeper {
  :in_range a sh:NodeShape ;
      sh:property [ orexis:about :level ;
          sh:minInclusive 10 ;
          sh:path :level ] ;
      sh:property [ orexis:about :temperature ;
          sh:maxInclusive 30 ;
          sh:path :temperature ] ;
      sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      orexis:about :level ;
      orexis:about :temperature ;
      orexis:foresees 3600 ;
      orexis:metWhen :in_range ;
      rdfs:label "every tank in range" .
}

GRAPH graph:sensed {
  :tank1 :level 20 ;
      :temperature 20 .
  :tank2 :level 20 ;
      :temperature 20 .
}

GRAPH :actions {
  :fill a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . } WHERE { ?t a :Tank }""" .
  :heat a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :temperature ?x . } WHERE { ?t a :Tank }""" .
}

GRAPH :predicted-0 {
  :tank1 :level 5 .
}

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}
