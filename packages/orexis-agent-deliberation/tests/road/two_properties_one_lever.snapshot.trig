# The whole store after the road ran on two_properties_one_lever.trig, in the case's own order:
# `diff two_properties_one_lever.trig two_properties_one_lever.snapshot.trig` is what the road did. Regenerated by
# `pytest packages/orexis-agent-deliberation/tests --update-snapshots` — review the diff; it is the claim.
# two_properties_one_lever
#
# Level and temperature both out on tank1, and ONE lever moving both: one scope, one want about
# both — the greenhouse's bed in miniature. About everything the desire is about, so named for the
# tank alone.
#
# The clock stands at 2026-01-01T12:00:00Z when the road runs.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix roots: <http://example.org/orexis/graph/roots/> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

# The levers loaded. A rule text is parsed with the store's prefixes, not this file's, so
# each says its own — an unreadable lever joins every property into one scope.
GRAPH :actions {
  :fix a orexis:Action ;
      sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . ?t :temperature ?x . } WHERE { ?t a :Tank }""" .
}

GRAPH roots:keeper {
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      rdfs:label "every tank in range" ;
      orexis:about :level , :temperature ;
      orexis:foresees 3600 ;
      orexis:metWhen :in_range .
  :in_range a sh:NodeShape ;
      sh:targetClass :Tank ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ; orexis:about :level ] ;
      sh:property [ sh:path :temperature ; sh:maxInclusive 30 ; orexis:about :temperature ] .
}

GRAPH graph:sensed {
  :tank1 :level 5 ; :temperature 40 .
  :tank2 :level 20 ; :temperature 20 .
}

# What each graph IS, and when it holds — said once each, beside the data.
# CHANGED by the road, re-rendered:
GRAPH graph:classification {
  pursued:keeper.in_range.pursued.tank1 a deliberation:PursuedGraph ;
      orexis:arrivedBy orexis:Recorded ;
      orexis:beliefsOf :keeper .
  roots:keeper a orexis:DesireGraph .
}


# --- WRITTEN by the road (and the loader's own vocabulary stub) ---

GRAPH graph:ontology {
  :actions a orexis:PublicGraph .
  :world a orexis:PublicGraph .
  graph:ontology a orexis:PublicGraph .
  orexis:DesireGraph rdfs:subClassOf orexis:Graph .
  orexis:PredictionGraph rdfs:subClassOf orexis:Graph .
}

GRAPH graph:periods {
  pursued:keeper.in_range.pursued.tank1 dcterms:temporal [ a dcterms:PeriodOfTime ;
          orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
}

GRAPH pursued:keeper.in_range.pursued.tank1 {
  :keeper orexis:holds :keeper.in_range.pursued.tank1 .
  :keeper.in_range.pursued.tank1 a orexis:Want ;
      orexis:about :level ;
      orexis:about :temperature ;
      orexis:metWhen :keeper.in_range.pursued.tank1.met ;
      prov:wasDerivedFrom :keeper.in_range ;
      rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.met a sh:NodeShape ;
      sh:property [ orexis:about :level ;
          sh:minInclusive 10 ;
          sh:path :level ] ;
      sh:property [ orexis:about :temperature ;
          sh:maxInclusive 30 ;
          sh:path :temperature ] ;
      sh:targetNode :tank1 .
}
