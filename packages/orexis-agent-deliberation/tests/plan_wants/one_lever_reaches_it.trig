# one_lever_reaches_it
#
# ONE ITERATION OF THE SEARCH, and the smallest world that has one. A tank reads below its
# floor; the want derived under the keeper's desire is about that tank's level; one lever
# fills it. The search forks once, the filled world meets the want's shape, and the pass ends
# with a one-step plan.
#
# NOBODY MEASURES THIS WANT and nothing needs to. Its met-test is a shape, so the objective is
# the shape itself — unmet 1, met 0 — which is how the puzzle worlds are judged and why a case
# needs no capability loaded to be searched.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix progression: <http://example.org/orexis/progression#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
#  THE READINGS ARE THE KERNEL'S ONE NAMED GRAPH. A search stands its root world on
#  `orexis:StateGraph`'s instance by name (`planner.py:796`) — the bootstrap root the
#  graph-name rule excepts — so a case's readings go there and not in a graph it names.
@prefix graph: <http://example.org/orexis/graph/> .

GRAPH :world {
  :tank1 a :Tank .
  :valve a :Valve .
  #  A LEGAL AGENT, because the search holds every candidate world to the shipped society's
  #  shapes and not only to the want: `orexis:KeeperShape` says an agent holding a want that
  #  is not merely about knowing must state how patient it is, within the kernel's bounds.
  #  Without this the world the fill reaches is one the society refuses, and the pass ends
  #  REFUSED with the right plan in hand — which is the law working, not the case failing.
  :keeper progression:patienceS 300 .
}

GRAPH :actions {
  #  IRIs IN FULL, and this is the trap a case must know. A rule text is parsed with the
  #  STORE's prefixes and not this file's — and the search does more than parse it: it
  #  rewrites a precondition into a CONSTRUCT that keeps the WHERE **body** and drops the
  #  text's own `PREFIX` head, so a name declared here and used in the body is a prefix the
  #  rewrite cannot find. A shipped package never meets this, because the namespace it
  #  speaks is one the loader discovered from its own ontology; a test's `:` is nobody's.
  :Filling a orexis:Action ;
      orexis:available """SELECT ?via ?about WHERE {
        ?via a <http://example.org/test#Valve> .
        BIND(<http://example.org/test#level> AS ?about) }""" ;
      sh:construct """CONSTRUCT { ?t <http://example.org/test#level> 20 }
        WHERE { ?t a <http://example.org/test#Tank> }""" ;
      orexis:retracts """CONSTRUCT { ?t <http://example.org/test#level> ?was }
        WHERE { ?t a <http://example.org/test#Tank> ; <http://example.org/test#level> ?was }""" .
}

GRAPH graph:sensed {
  :tank1 :level 5 .
}

GRAPH :desires {
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire ;
      rdfs:label "every tank in range" ;
      orexis:about :level ;
      orexis:metWhen :in_range .
  :in_range a sh:NodeShape ; sh:targetClass :Tank ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ; orexis:about :level ] .
}

GRAPH pursued:keeper.in_range.pursued.tank1 {
  :keeper orexis:holds :keeper.in_range.pursued.tank1 .
  :keeper.in_range.pursued.tank1 a orexis:Want ;
      prov:wasDerivedFrom :keeper.in_range ;
      orexis:metWhen :keeper.in_range.pursued.tank1.met ;
      orexis:about :level ;
      rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.met a sh:NodeShape ; sh:targetNode :tank1 ;
      sh:property [ sh:path :level ; sh:minInclusive 10 ] .
}

GRAPH :scopes {
  :keeper.scope.1 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
  :Filling deliberation:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph , orexis:Graph .
  :ontology a orexis:OntologyGraph , orexis:PublicGraph , orexis:Graph .
  :world a orexis:PublicGraph , orexis:Graph .
  :actions a orexis:PublicGraph , orexis:Graph .
  graph:sensed a orexis:StateGraph , orexis:BeliefGraph , orexis:Graph .
  :desires a orexis:DesireGraph , orexis:Graph .
  :scopes a deliberation:ScopeGraph , orexis:WorkingGraph , orexis:Graph ;
      orexis:arrivedBy orexis:Derived ; orexis:beliefsOf :keeper .
  pursued:keeper.in_range.pursued.tank1 a deliberation:PursuedGraph , orexis:WantGraph , orexis:Graph ;
      orexis:arrivedBy orexis:Recorded ; orexis:beliefsOf :keeper .
}
