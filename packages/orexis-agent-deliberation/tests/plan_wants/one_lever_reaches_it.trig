# one_lever_reaches_it
#
# ONE ITERATION OF THE SEARCH, and the smallest world that has one. A tank reads below its
# floor; the want derived under the keeper's desire is about that tank's level; one lever
# fills it. The search forks once, the filled world meets the want's shape, and the pass ends
# with a one-step plan.
#
# NOBODY MEASURES THIS WANT and nothing needs to. Its met-test is a shape, so the objective is
# the shape itself — unmet 1, met 0 — which is how the puzzle worlds are judged and why a case
# needs no capability loaded to be searched.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix progression: <http://example.org/orexis/progression#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
#  THE READINGS ARE THE KERNEL'S ONE NAMED GRAPH. A search stands its root world on
#  `orexis:StateGraph`'s instance by name (`planner.py:796`) — the bootstrap root the
#  graph-name rule excepts — so a case's readings go there and not in a graph it names.
@prefix graph: <http://example.org/orexis/graph/> .


GRAPH :ontology {
  deliberation:PursuedGraph rdfs:subClassOf orexis:Graph .
  deliberation:PursuedGraph rdfs:subClassOf orexis:WantGraph .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :keeper progression:patienceS 300 .
  :tank1 a :Tank .
  :valve a :Valve .
}

GRAPH :actions {
  :Filling a orexis:Action .
  :Filling orexis:available """SELECT ?via ?about WHERE {
        ?via a <http://example.org/test#Valve> .
        BIND(<http://example.org/test#level> AS ?about) }""" .
  :Filling orexis:retracts """CONSTRUCT { ?t <http://example.org/test#level> ?was }
        WHERE { ?t a <http://example.org/test#Tank> ; <http://example.org/test#level> ?was }""" .
  :Filling sh:construct """CONSTRUCT { ?t <http://example.org/test#level> 20 }
        WHERE { ?t a <http://example.org/test#Tank> }""" .
}

GRAPH graph:sensed {
  :tank1 :level 5 .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property _:b1 .
  :in_range sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire .
  :keeper.in_range orexis:about :level .
  :keeper.in_range orexis:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
  _:b1 orexis:about :level .
  _:b1 sh:minInclusive 10 .
  _:b1 sh:path :level .
}

GRAPH pursued:keeper.in_range.pursued.tank1 {
  :keeper orexis:holds :keeper.in_range.pursued.tank1 .
  :keeper.in_range.pursued.tank1 a orexis:Want .
  :keeper.in_range.pursued.tank1 orexis:about :level .
  :keeper.in_range.pursued.tank1 orexis:metWhen :keeper.in_range.pursued.tank1.met .
  :keeper.in_range.pursued.tank1 prov:wasDerivedFrom :keeper.in_range .
  :keeper.in_range.pursued.tank1 rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.met a sh:NodeShape .
  :keeper.in_range.pursued.tank1.met sh:property _:b1 .
  :keeper.in_range.pursued.tank1.met sh:targetNode :tank1 .
  _:b1 sh:minInclusive 10 .
  _:b1 sh:path :level .
}

GRAPH :scopes {
  :Filling deliberation:inScope :keeper.scope.1 .
  :keeper.scope.1 a deliberation:Scope .
  :level deliberation:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a deliberation:ScopeGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  graph:sensed a orexis:BeliefGraph .
  graph:sensed a orexis:Graph .
  graph:sensed a orexis:StateGraph .
  pursued:keeper.in_range.pursued.tank1 a deliberation:PursuedGraph .
  pursued:keeper.in_range.pursued.tank1 a orexis:Graph .
  pursued:keeper.in_range.pursued.tank1 a orexis:WantGraph .
  pursued:keeper.in_range.pursued.tank1 orexis:arrivedBy orexis:Recorded .
  pursued:keeper.in_range.pursued.tank1 orexis:beliefsOf :keeper .
}
