# a_private_graph_stays_behind
#
# WHAT CROSSES IS WHAT NO STEP MAY CHANGE, and nothing else. Every PUBLIC graph crosses — asked
# of the catalogue, never listed — and so does the catalogue itself, since the imagined world's
# own door reads it to know what its graphs are and when they hold.
#
# A graph the agent alone holds does NOT cross unless the caller names it. The readings here
# are the agent's own and nobody named them, so they stay behind: the diff says `# DROPPED:`,
# which is the whole claim of this case.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

GRAPH :world {
  :tank1 a :Tank .
}

GRAPH :sensed {
  :tank1 :level 5 .
}

GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :sensed orexis:beliefsOf :keeper .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
