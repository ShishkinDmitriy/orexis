@prefix water: <http://example.org/orexis/water#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix orexis:   <http://example.org/orexis#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rules for the water domain. These check what a bid MEANS here: an agent bidding for water
# must hold a coherent valuation. Swap the domain module and these go with it.

water:WaterBidderShape a sh:NodeShape ;
    rdfs:comment "A bidder for water values it by its deficit below an aim, so it needs a pot size, a ceiling price, and an aim in the property those are denominated in. WHERE the aim may sit is not checked here: an aim inside its region is desire's arithmetic, true of any domain, and sensing:AimShape holds every aim to it. What only this domain can know is that a BID needs one — a bidder with no aim in the priced property has no deficit to value." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT ?this WHERE {
                ?this orexis:hasCapability market:Bidding .
                ?this orexis:actsFor       ?plant .
                ?plant a water:Plant .
            }
        """ ] ;
    sh:property [ sh:path water:litresPerFraction ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path water:maxValuePerL ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    # The property is followed from the domain's own statement — market:aboutProperty on
    # litresPerFraction — never hard-coded here, so a domain repriced in another property
    # carries this check with it. It is the same link the bidder module follows at startup,
    # asked before the module would fail at it.
    #
    # This spans a PRIVATE aim and the public T-Box, so it can only run where both are visible:
    # inside the agent at boot, and at the world gate, which holds every belief file it
    # authored. Nothing else ever sees the number.
    sh:sparql [
        sh:message "a bidder holds no aim in the property its bids are priced in — without one there is no deficit, and a bid computed from nothing is not a bid" ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT $this WHERE {
                water:litresPerFraction
                      market:aboutProperty ?property .
                FILTER NOT EXISTS {
                    $this sensing:aims ?aim .
                    ?aim ssn:forProperty ?property .
                }
            }""" ] .

# The dealer's mirror of the shape above (#198 / barrel arc 4): a bidder restocking a water
# source prices its bids in StoredLitres, so what IT must hold coherent is the refill
# valuation — its own conversion belief (identically 1.0 by conservation; the copy an agent
# that learned its barrel leaks would revise), the same ceiling price every buyer of water
# states, and an aim in the property the refill venue prices. Two shapes and not one with a
# disjunction, because each names the valuation term its kind of region want is priced in, and that
# term is the whole difference between a fern and a dealer at a market.
water:RefillBidderShape a sh:NodeShape ;
    rdfs:comment "A bidder whose region want is a water source values refill litres by its stock's deficit below an aim, so it needs a conversion, a ceiling price, and an aim in the property those are denominated in." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT ?this WHERE {
                ?this orexis:hasCapability market:Bidding .
                ?this orexis:actsFor       ?src .
                ?src a water:WaterSource .
            }
        """ ] ;
    sh:property [ sh:path water:litresPerStoredLitre ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path water:maxValuePerL ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:sparql [
        sh:message "a refill bidder holds no aim in the property its bids are priced in — without one there is no deficit, and a bid computed from nothing is not a bid" ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT $this WHERE {
                water:litresPerStoredLitre
                      market:aboutProperty ?property .
                FILTER NOT EXISTS {
                    $this sensing:aims ?aim .
                    ?aim ssn:forProperty ?property .
                }
            }""" ] .

water:PlantShape a sh:NodeShape ;
    rdfs:comment "A plant is drawn from a source and states its physics. It holds no desire — that belongs to its agent." ;
    sh:targetClass water:Plant ;
    sh:property [ sh:path orexis:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path water:servedBy ; sh:minCount 1 ; sh:class water:WaterSource ] ;
    sh:property [ sh:path water:litresPerFraction ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path <http://example.org/orexis/sensing#aims> ; sh:maxCount 0 ;
                  sh:message "a plant holds no desire — the aim belongs to its agent's beliefs" ] ;

    # What it MAY state is the range it needs, which is not a desire but a fact about the plant.
    # Optional, because a world may run without one; structured, because a range nobody can read
    # is worse than none. Each condition says which property it is about and both its ends.
    sh:property [ sh:path ( <http://www.w3.org/ns/ssn/systems/hasOperatingRange>
                            <http://www.w3.org/ns/ssn/systems/inCondition> ) ;
                  sh:node [ a sh:NodeShape ;
                      sh:property [ sh:path <http://www.w3.org/ns/ssn/forProperty> ;
                                    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                                    sh:message "a condition must say which property it is a range OF" ] ;
                      sh:property [ sh:path <https://schema.org/minValue> ; sh:minCount 1 ; sh:maxCount 1 ;
                                    sh:datatype xsd:decimal ] ;
                      sh:property [ sh:path <https://schema.org/maxValue> ; sh:minCount 1 ; sh:maxCount 1 ;
                                    sh:datatype xsd:decimal ] ] ] .

# Two ranges are only meaningful together, so this is what makes the pair coherent: a plant
# cannot thrive somewhere it would not survive. General to plants rather than stated per species,
# because it is arithmetic and not horticulture — a species package states two ranges and this
# refuses the pair if one has been fat-fingered.
#
# Per PROPERTY, matched through ssn:forProperty, for the same reason the target check is: a
# moisture operating range must sit inside the moisture survival range and has nothing to say
# about the temperature one.
water:RangesAgreeShape a sh:NodeShape ;
    rdfs:comment "An operating range that leaves the survival range is a contradiction in the species description, and the direction it usually goes is the dangerous one: a ceiling raised in the operating range without raising the one that says where rot starts. Both come from the same package, so nothing external can cause this — which is exactly why it is worth a cheap check rather than a careful reader." ;
    sh:targetClass water:Plant ;
    sh:sparql [
        sh:message "an operating range for a property lies outside the survival range for that same property — a plant cannot thrive where it would not survive" ;
        sh:prefixes orexis: ;
        sh:select """
            SELECT $this ?low ?high WHERE {
                $this ssn-system:hasOperatingRange ?operating ;
                      ssn-system:hasSurvivalRange  ?survival .
                ?operating ssn-system:inCondition ?wants .
                ?survival  ssn-system:inCondition ?tolerates .
                ?wants     ssn:forProperty ?property ;
                           <https://schema.org/minValue> ?low ;
                           <https://schema.org/maxValue> ?high .
                ?tolerates ssn:forProperty ?property ;
                           <https://schema.org/minValue> ?floor ;
                           <https://schema.org/maxValue> ?ceiling .
                FILTER(?low < ?floor || ?high > ?ceiling)
            }""" ] .

water:WaterSourceShape a sh:NodeShape ;
    rdfs:comment "Every source has a supplier and a physical ceiling — the constitution's allocation limit." ;
    sh:targetClass water:WaterSource ;
    sh:property [ sh:path water:suppliedBy ; sh:minCount 1 ; sh:class orexis:Agent ] ;
    sh:property [ sh:path water:capacityL ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minExclusive 0 ] .
