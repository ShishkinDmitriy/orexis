@prefix water: <http://example.org/orexis/water#> .
@prefix : <http://example.org/orexis/water#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################  What a pot does while nobody waters it  #################
#
#  THE FIRST DRIFT (#592), and the reason this file exists in a package that had no actions:
#  a pot dries whether or not its agent acts, `water:driesPerDay` has been stated on every
#  plant since #164, and nothing in planning has ever read it. So a plan could imagine three
#  hours passing and find the pot exactly as wet as when it started.
#
#  A DRIFT IS NOT AN ACTION and this is not on any menu: nobody chooses for the world. What it
#  shares with an effect is the grammar — a construct, a retraction, `$state` naming the world
#  it is asked about — and what it adds is `$elapsed`, the seconds the world has had to itself
#  between one node and the next.
#
#  IT NEEDS THE NUMBER, and that is the honest limit rather than an oversight. A reading the
#  agent OBSERVED carries one; a reading an effect PREDICTED carries a band and no value
#  (#579, deliberation-is-on-triples), so there is nothing to subtract a rate from. A pot left
#  alone therefore dries in every imagined world that still holds an observed reading, and a
#  pot already dosed keeps the band its dose declared. The alternative — a drift stated as a
#  band-to-band transition — needs to know how far into its band a reading sits, which is the
#  number again, one level down.

water:Drying
    a orexis:Drift ;

    rdfs:label "what a pot loses while nobody waters it" ;

    #  WHEN IT LEAVES ITS REGION (#619): the same arithmetic, asked as WHEN rather than
    #  whether. For each observed reading — one with a value, which is what the belief
    #  base holds — the seconds after its own instant until the rate takes it under the
    #  floor of the region minted for its subject and property. Read at the belief base by
    #  whoever derives a want from a prediction; a reading already below has no crossing
    #  ahead of it and yields no row. The dividend is cast to a double because this engine
    #  binds nothing for an exact-zero decimal dividend (AGENTS, the arithmetic traps), and
    #  a reading exactly on the floor crosses NOW rather than never.
    orexis:crossesAfter """
        SELECT ?subject ?property ?at ?seconds WHERE {
            GRAPH $state {
                ?obs sosa:hasFeatureOfInterest ?subject ;
                     sosa:observedProperty ?property ;
                     sosa:hasSimpleResult ?was ;
                     sosa:resultTime ?at . }
            FILTER(?property = water:SoilMoisture)
            ?subject water:driesPerDay ?rate .
            FILTER(?rate > 0)
            ?inside rdfs:subClassOf sensing:InRegion ;
                    sensing:ofSubject ?subject ; sensing:ofProperty ?property ;
                    owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?r .
            ?r owl:onProperty sosa:hasSimpleResult ;
               owl:someValuesFrom/owl:withRestrictions ?facets .
            ?facets rdf:rest*/rdf:first/xsd:minInclusive ?lo .
            FILTER(?was >= ?lo)
            ?world a orexis:World ; orexis:secondsPerDay ?dayS .
            BIND((((xsd:double(?was) - ?lo) / ?rate) * ?dayS) AS ?seconds)
        }""" ;

    #  HOW FAR OFF IT MAY BE (#631): the rate's uncertainty the world states beside the rate,
    #  over the same stretch — the domain's own arithmetic, in the domain's own unit. Sensing
    #  reads it to widen the bands the expected next observation may fall in; the search
    #  never reads the number. A pot stating no spread yields no row and spreads nothing.
    orexis:spreadsBy """
        SELECT ?subject ?property ?width WHERE {
            GRAPH $state {
                ?obs sosa:hasFeatureOfInterest ?subject ;
                     sosa:observedProperty ?property ;
                     sosa:hasSimpleResult ?was . }
            FILTER(?property = water:SoilMoisture)
            ?subject water:driesPerDaySpread ?spread .
            FILTER(?spread > 0 && $elapsed > 0)
            ?world a orexis:World ; orexis:secondsPerDay ?dayS .
            BIND(ROUND(($elapsed / xsd:double(?dayS)) * 1000000) / 1000000 AS ?days)
            BIND(?spread * ?days AS ?width)
        }""" ;

    #  WHAT IT REPLACES: the reading it drifts, by the upsert key the sensed graph holds — one
    #  node per (subject, property), the invariant every effect's retraction already leans on.
    orexis:retracts """
        CONSTRUCT { ?obs ?p ?o } WHERE {
            GRAPH $state {
                ?obs sosa:hasFeatureOfInterest ?pot ;
                     sosa:observedProperty water:SoilMoisture ;
                     sosa:hasSimpleResult ?was ;
                     ?p ?o }
            #  THE RATE IS PUBLIC KNOWLEDGE, unqualified: a pot's physics is how the WORLD
            #  behaves and the world graph is public, so an ordinary pattern reads it. Scoped
            #  to `$beliefs` it matched nothing, silently, and a pot that never dried is
            #  exactly the empty result this project keeps having to guard against.
            ?pot water:driesPerDay ?rate .
            FILTER(?rate > 0 && $elapsed > 0)
        }""" ;

    #  AND WHAT IT LEAVES: the same reading, lower by what the pot loses in that time. The
    #  arithmetic is the DOMAIN's, on the domain's own number — a rate the world states, in
    #  fractions of saturation per day — which is where every literal in this project is
    #  interpreted. The core stores triples and reads none of it. AND THE DAY IS THE WORLD'S
    #  (the-world-states-the-length-of-its-day): a rate per day is in the world's day, and
    #  the seconds this rule is handed are the agent's, so the stretch is divided by the day
    #  the world states rather than by a literal one — the simulation's is ten minutes.
    #
    #  PARENTHESISED, and both of them deliberately: `a / b * c` is evaluated as `a / (b * c)`
    #  by this engine, and a decimal product past eighteen fractional digits binds NOTHING, so
    #  the rate is rounded to six places before it is multiplied (AGENTS.md, the arithmetic
    #  traps). A drift that bound nothing would read as a pot that never dries.
    sh:construct """
        CONSTRUCT {
            ?obs a sosa:Observation ;
                 sosa:hasFeatureOfInterest ?pot ;
                 sosa:observedProperty water:SoilMoisture ;
                 sosa:hasSimpleResult ?now ;
                 sosa:resultTime ?at ;
                 sosa:madeBySensor ?sensor ;
                 sosa:usedProcedure ?how .
        } WHERE {
            GRAPH $state {
                ?obs sosa:hasFeatureOfInterest ?pot ;
                     sosa:observedProperty water:SoilMoisture ;
                     sosa:hasSimpleResult ?was ;
                     sosa:resultTime ?taken .
                OPTIONAL { ?obs sosa:madeBySensor ?sensor }
                OPTIONAL { ?obs sosa:usedProcedure ?how }
            }
            ?pot water:driesPerDay ?rate .
            FILTER(?rate > 0 && $elapsed > 0)
            ?world a orexis:World ; orexis:secondsPerDay ?dayS .
            BIND(ROUND(($elapsed / xsd:double(?dayS)) * 1000000) / 1000000 AS ?days)
            BIND(?was - (?rate * ?days) AS ?fell)
            #  A POT DOES NOT DRY PAST EMPTY, which is the one bound the domain knows without
            #  asking anything: a fraction of saturation has a floor at nothing.
            BIND(IF(?fell < 0.0, 0.0, ?fell) AS ?now)
            BIND($lands AS ?at)
        }""" .


#################  And what it does to a reading that carries no number  #################
#
#  THE SECOND DRIFT, and the reason there are two (#612). The one above subtracts a rate from a
#  value, which needs a value: a reading the agent OBSERVED has one, a reading an effect
#  PREDICTED does not, since #579 an effect declares the band it reaches and no number. So a
#  plan's first step erased the only thing the numeric drift could work on, and the drift was
#  correct and inert in every shipped world.
#
#  WHAT IS LEFT TO SAY WITHOUT A NUMBER is how long the band itself takes to cross: its own
#  width, which its facets give, over the rate the world states. A pot known only to be IN its
#  region falls out of it after a full width's worth of drying — the honest statement, because
#  the band is all that is known, and optimistic in the direction the world corrects: the keeper
#  verifies, and a pot that fell sooner is a surprise the next pass plans from.
#
#  A READING ALREADY BELOW ITS REGION DOES NOT FALL FURTHER: the below band is open at the
#  bottom, so its width is not a number and this rule does not match it. That is the right
#  answer rather than a gap — there is no band under it to fall to.

water:DryingABand
    a orexis:Drift ;

    rdfs:label "what a pot known only by its band loses while nobody waters it" ;

    orexis:retracts """
        CONSTRUCT { ?obs ?p ?o } WHERE {
            GRAPH $state {
                ?obs sosa:hasFeatureOfInterest ?pot ;
                     sosa:observedProperty water:SoilMoisture ;
                     a ?band ;
                     ?p ?o .
                FILTER NOT EXISTS { ?obs sosa:hasSimpleResult ?any }
            }
            ?band rdfs:subClassOf sensing:InRegion ;
                  sensing:ofSubject ?pot ; sensing:ofProperty water:SoilMoisture ;
                  owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?r .
            ?r owl:onProperty sosa:hasSimpleResult ;
               owl:someValuesFrom/owl:withRestrictions ?facets .
            ?facets rdf:rest*/rdf:first/xsd:minInclusive ?lo .
            ?facets rdf:rest*/rdf:first/xsd:maxInclusive ?hi .
            ?pot water:driesPerDay ?rate .
            FILTER(?rate > 0)
            ?world a orexis:World ; orexis:secondsPerDay ?dayS .
            BIND((((?hi - ?lo) / ?rate) * ?dayS) AS ?crossing)
            FILTER($elapsed >= ?crossing)
        }""" ;

    #  PARENTHESISED TWICE, and both are the engine rather than taste: `a / b * c` is evaluated
    #  as `a / (b * c)` here, so the crossing time would come out five orders of magnitude
    #  small, and a decimal product past eighteen fractional digits binds NOTHING at all — a
    #  drift that bound nothing would read as a pot that never dries, which is the empty result
    #  this project keeps having to guard against (AGENTS.md, the arithmetic traps).
    sh:construct """
        CONSTRUCT {
            ?obs a sosa:Observation , ?below ;
                 sosa:hasFeatureOfInterest ?pot ;
                 sosa:observedProperty water:SoilMoisture ;
                 sosa:resultTime ?at .
        } WHERE {
            GRAPH $state {
                ?obs sosa:hasFeatureOfInterest ?pot ;
                     sosa:observedProperty water:SoilMoisture ;
                     a ?band .
                FILTER NOT EXISTS { ?obs sosa:hasSimpleResult ?any }
            }
            ?band rdfs:subClassOf sensing:InRegion ;
                  sensing:ofSubject ?pot ; sensing:ofProperty water:SoilMoisture ;
                  owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?r .
            ?r owl:onProperty sosa:hasSimpleResult ;
               owl:someValuesFrom/owl:withRestrictions ?facets .
            ?facets rdf:rest*/rdf:first/xsd:minInclusive ?lo .
            ?facets rdf:rest*/rdf:first/xsd:maxInclusive ?hi .
            ?pot water:driesPerDay ?rate .
            FILTER(?rate > 0)
            ?world a orexis:World ; orexis:secondsPerDay ?dayS .
            BIND((((?hi - ?lo) / ?rate) * ?dayS) AS ?crossing)
            FILTER($elapsed >= ?crossing)
            #  THE BAND BELOW, of this subject and this property: the member genesis minted
            #  from the same range, found by its family rather than by name.
            ?below rdfs:subClassOf sensing:BelowRegion ;
                   sensing:ofSubject ?pot ; sensing:ofProperty water:SoilMoisture .
            BIND($lands AS ?at)
        }""" .
