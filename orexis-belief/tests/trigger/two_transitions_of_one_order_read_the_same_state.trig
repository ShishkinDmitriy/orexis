# two_transitions_of_one_order_read_the_same_state
#
# Three transitions a tick triggers. Two are of order 0: the count, which deletes the count before, 1,
# and inserts 2, and a witness, which says what count it saw — and saw 1, since every rule of one
# order reads the state as it stood before any of them was applied. The third is of order 1 and
# echoes the count — 2, since a later order reads what the earlier made. The count before is deleted
# where it stood, that graph left empty and forgotten; everything inserted is in the tick's own.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tick1: <http://example.org/test#tick1/> .
@prefix tick2: <http://example.org/test#tick2/> .

GRAPH :ontology {
  :TickGraph rdfs:subClassOf orexis:BeliefGraph .
  :TickGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :ontology.metadata {
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology.metadata a orexis:MetadataGraph .
  :ontology.metadata orexis:metadataOf :ontology .
}

GRAPH :world {
  :counter a :Counter .
  :keeper a orexis:Agent .
}

GRAPH :world.metadata {
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
  :world.metadata a orexis:MetadataGraph .
  :world.metadata orexis:metadataOf :world .
}

GRAPH :rules {
  :countRule a belief:Transition .
  :countRule belief:update """PREFIX : <http://example.org/test#>
      DELETE { ?c :count ?n } INSERT { ?c :count ?next }
      WHERE { ?t a :Tick . ?c a :Counter . OPTIONAL { ?c :count ?n } BIND((COALESCE(?n, 0) + 1) AS ?next) }""" .
  :countRule rdfs:label "a tick counts one more than the count before" .
  :echoRule a belief:Transition .
  :echoRule belief:update """PREFIX : <http://example.org/test#>
      INSERT { ?c :echo ?n } WHERE { ?t a :Tick . ?c a :Counter ; :count ?n }""" .
  :echoRule rdfs:label "a later order echoes the count the earlier made" .
  :echoRule sh:order 1 .
  :sawRule a belief:Transition .
  :sawRule belief:update """PREFIX : <http://example.org/test#>
      INSERT { ?c :saw ?n } WHERE { ?t a :Tick . ?c a :Counter ; :count ?n }""" .
  :sawRule rdfs:label "a witness of the same order says the count it saw" .
}

GRAPH :rules.metadata {
  :rules a orexis:Graph .
  :rules a sh:RulesGraph .
  :rules.metadata a orexis:MetadataGraph .
  :rules.metadata orexis:metadataOf :rules .
}

GRAPH :tick2 {
  :t2 a :Tick .
}

GRAPH :tick2.metadata {
  :tick2 a :TickGraph .
  :tick2 a orexis:BeliefGraph .
  :tick2 a orexis:Graph .
  :tick2 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:30:00Z"^^xsd:dateTime ; orexis:start "2026-01-01T12:10:00Z"^^xsd:dateTime ] .
  :tick2 orexis:arrivedBy orexis:Received .
  :tick2 orexis:ownedBy :keeper .
  :tick2.metadata a orexis:MetadataGraph .
  :tick2.metadata orexis:metadataOf :tick2 .
}

GRAPH tick1:believed {
  :counter :count 1 .
}

GRAPH tick1:believed.metadata {
  tick1:believed a orexis:BeliefGraph .
  tick1:believed a orexis:Graph .
  tick1:believed orexis:arrivedBy orexis:Derived .
  tick1:believed orexis:ownedBy :keeper .
  tick1:believed.metadata a orexis:MetadataGraph .
  tick1:believed.metadata orexis:metadataOf tick1:believed .
}

GRAPH :catalogue {
}
