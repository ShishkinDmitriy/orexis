@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ag:   <http://example.org/agora#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rules for the society kernel. Each ontology module ships its own shapes file next to it;
# together they are the constitution as code. Validated with `agora-validate`.

ag:AgentShape a sh:NodeShape ;
    rdfs:comment "Every agent is named and does at least one thing. An agent with no capability is a process with nothing to run." ;
    sh:targetClass ag:Agent ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "an agent must state the id it is known by" ] ;
    sh:property [ sh:path ag:hasCapability ; sh:minCount 1 ; sh:class ag:Capability ;
                  sh:message "an agent must compose at least one capability" ] .

ag:DeviceShape a sh:NodeShape ;
    rdfs:comment "A device is reachable: it states where it is on the wire, so nothing has to guess its address from a naming convention." ;
    sh:targetClass ag:Device ;
    sh:property [ sh:path ag:localId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ag:WorldShape a sh:NodeShape ;
    rdfs:comment "The world is versioned, so every fact recorded under it can say which world it was recorded in." ;
    sh:targetClass ag:World ;
    sh:property [ sh:path ag:currentVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ag:WorldVersion ] .

ag:WorldVersionShape a sh:NodeShape ;
    sh:targetClass ag:WorldVersion ;
    sh:property [ sh:path ag:versionNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

ag:BeliefsGraphShape a sh:NodeShape ;
    rdfs:comment "A beliefs graph belongs to exactly one agent — that is the write boundary." ;
    sh:targetClass ag:BeliefsGraph ;
    sh:property [ sh:path ag:beliefsOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ag:Agent ] .

#################  Devices that are not there  #################################################
#
# These are the ESP32's rules, not RDF's. They are here because a world states its wiring and
# `agora-validate` is the last moment anyone reads it before a board is flashed and buried in a
# pot. Each one has cost somebody an afternoon at least once.
#
# SPARQL constraints spell IRIs out in full: this runs on pyshacl, and a prefix that is declared
# in one file and used in another is exactly the trap `store.PREFIXES` exists to catch elsewhere.

ag:SelfReportingShape a sh:NodeShape ;
    rdfs:comment "An agent need not report on itself, but if it says how often, the figure must be usable. Deliberately NOT sh:minCount 1: absence means it reports nothing, and refusing to start an agent over instrumentation would be disproportionate — the freshness of its readings is what it exists for, not the freshness of its telemetry." ;
    sh:targetClass ag:Agent ;
    sh:property [ sh:path ag:metricsIntervalS ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minExclusive 0 ;
                  sh:message "if an agent states a metrics interval it must be a positive whole number of seconds" ] .

ag:SimulatedDeviceShape a sh:NodeShape ;
    rdfs:comment "A device that is stood in for must still be reachable like a real one. Without ag:onBus it gets no credential from agora-mqtt and no service from agora-compose, so nothing would ever publish for it — and the failure is a sensor that is simply, permanently silent, which reads exactly like hardware that is not there. Which it is not. Catching it here costs nothing; catching it in a running world costs an afternoon." ;
    sh:targetSubjectsOf ag:simulatedBy ;
    sh:property [ sh:path ag:onBus ; sh:minCount 1 ;
                  sh:message "a simulated device must be on a bus: its stand-in speaks over the wire, exactly as the real one would" ] ;
    sh:property [ sh:path ag:simulatedBy ; sh:maxCount 1 ;
                  sh:message "one device, one stand-in" ] .

ag:SimulatedActuatorShape a sh:NodeShape ;
    rdfs:comment "A stood-in actuator must say where it reports. Water reaching soil is physics, and physics has no wire — so between containers the only way a simulated sensor can learn that water actually flowed is a message from the valve that flowed it. Without a status topic the stand-in valve would open into nowhere: the command would be verified, the dose computed, and the soil would stay dry forever." ;
    sh:targetSubjectsOf ag:actuates ;
    sh:property [ sh:path ag:statusTopic ; sh:maxCount 1 ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a simulated actuator must state ag:statusTopic — its stand-in reports there, and a simulated sensor waters only on what it reports" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://example.org/agora#simulatedBy> ?model .
                FILTER NOT EXISTS { $this <http://example.org/agora#statusTopic> ?t }
            }""" ] .

ag:DeviceModelShape a sh:NodeShape ;
    rdfs:comment "What the stand-in computes between readings. Optional individually — a modelled valve has no dry rate — but each must be a number if stated at all, because the simulator reads them without a graph to check them against." ;
    sh:targetClass ag:DeviceModel ;
    sh:property [ sh:path ag:modelDryRate ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelMinValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelMaxValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ag:modelInitialValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ;
                  sh:message "an initial value is a fraction of the observed property, so 0..1" ] ;
    sh:property [ sh:path ag:modelTickSeconds ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] .
