@prefix ag:   <http://example.org/agora#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/agora/core> a owl:Ontology ;
    rdfs:label "Agora core" ;
    rdfs:comment """The society kernel: agents, the capabilities they compose, and the versioned world they share. Everything else is a MODULE layered on this — the stand it runs on, the protocols its parts speak, the parts themselves, the capabilities, and the domain. Code may reference the terms defined here; it may never reference an instance.

What is NOT here any more is everything physical. `vocabulary/stand` holds boards, peripherals, pins and wires; a concrete part is its own package beside it. The two subjects were sharing a file and growing at different rates: adding a sensor should not touch what a society IS.""" .

#################  Agents and capabilities (composition, not hierarchy)  #################

ag:Agent a owl:Class ; rdfs:label "Agent" ;
    rdfs:comment "A self-interested principal with a stake. What an agent can DO is not its class — it is the set of capabilities composed onto it, so two agents of the same kind may run different modules." .

ag:Capability a owl:Class ; rdfs:label "Capability" ;
    rdfs:comment "One thing an agent can do, defined by a module: a vocabulary (this ontology), rules (its SHACL shapes), and the code that reads them. Declaring a capability is what activates the module." .

ag:hasCapability a owl:ObjectProperty ; rdfs:domain ag:Agent ; rdfs:range ag:Capability ;
    rdfs:label "has capability" ;
    rdfs:comment "Composed onto the agent in the WORLD graph (public: peers must know what a counterparty can do). The PARAMETERS of a capability are private, in the agent's own beliefs." .

ag:actsFor a owl:ObjectProperty ; rdfs:domain ag:Agent ;
    rdfs:label "acts for" ;
    rdfs:comment "The subject whose interest this agent advances. Generic; a domain narrows the range (in the water domain, a Plant)." .

#################  Devices — dumb mechanism at the edge  #################

ag:Device a owl:Class ; rdfs:label "Device" ;
    rdfs:comment "A physical edge node: mechanism, never policy, and interchangeable with a simulated one." .

#################  Devices that are not there  #################
# A simulated device is an ORDINARY device in every statement the world makes about it: it is
# on a bus, it has topics, it has a sense mode, and an agent is wired to it with ag:polls like
# any other. The only extra fact is that a process stands in for it.
#
# The marker is on the DEVICE and never on the agent, and that is the whole design. An agent
# that could tell would be a second code path, and a second code path is what a simulation is
# supposed to avoid: world/simulation used to exercise its own implementation, so it could pass
# while the real one was broken.

ag:simulatedBy a owl:ObjectProperty ; rdfs:domain ag:Device ; rdfs:range ag:DeviceModel ;
    rdfs:label "simulated by" ;
    rdfs:comment "No such device exists; a process stands in for it, publishing on the same topics and speaking the same protocol. Read by the generators, which give it a container and a credential, and by nothing an agent runs — an agent must not be able to tell, and the surest way is that nothing it executes ever asks." .

ag:modelMinValue a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "model minimum" ;
    rdfs:comment "The floor of what this stand-in can report. A moisture fraction happens to run 0..1; a thermometer does not, so the range is stated rather than assumed." .
ag:modelMaxValue a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "model maximum" .

ag:DeviceModel a owl:Class ; rdfs:label "Device model" ;
    rdfs:comment "The physics the stand-in computes between readings. Facts about the thing being modelled rather than opinions about it, which is why they sit on the device and not in anybody's beliefs." .

ag:modelInitialValue a owl:DatatypeProperty ; rdfs:domain ag:DeviceModel ; rdfs:range xsd:decimal ;
    rdfs:label "model initial value" ;
    rdfs:comment "What it reads before anything has happened to it." .

ag:modelDryRate a owl:DatatypeProperty ; rdfs:domain ag:DeviceModel ; rdfs:range xsd:decimal ;
    rdfs:label "model dry rate" ;
    rdfs:comment "How much of the observed property is lost per tick. Named apart from domain/water's ag:dryRatePerTick, which carries rdfs:domain ag:Plant — reusing it would make every model infer as a plant and inherit a plant's obligations." .

ag:modelTickSeconds a owl:DatatypeProperty ; rdfs:domain ag:DeviceModel ; rdfs:range xsd:integer ;
    rdfs:label "model tick seconds" ;
    rdfs:comment "Wall-clock seconds per tick — how fast this modelled world runs. Used as the publish interval only by a ag:Push device, which keeps its own clock; a ag:Scheduled one keeps the interval its agent gives it, exactly as a board does." .

#################  Naming — stated, never derived  #################

ag:localId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "local id" ;
    rdfs:comment "The short name a resource is known by outside RDF. Stated here so nothing has to infer it from the shape of a URI. The ONE instance identifier a process is given is an agent's localId; everything else it discovers." .

#################  Self-reporting — what an agent says about itself  #################

ag:SelfReporting a owl:Class ; rdfs:subClassOf ag:Capability ; rdfs:label "Self reporting" ;
    rdfs:comment "Naming only, so a missing belief can say which block wanted it. NOT derived and NOT composed onto anyone: every agent reports, because every agent has a belief base and a connection whatever else it can do. See agora/metrics.py." .

ag:metricsIntervalS a owl:DatatypeProperty ; rdfs:domain ag:Agent ; rdfs:range xsd:integer ;
    rdfs:label "metrics interval (s)" ;
    rdfs:comment "How often this agent reports on itself. ABSENCE IS MEANINGFUL: an agent that states no interval reports nothing, which is a decision by omission rather than a default. A rate belongs in beliefs for the same reason the sensing cadence does — a test world may want it faster than a deployed one." .

#################  The world and its versions  #################

ag:World a owl:Class ; rdfs:label "World" ;
    rdfs:comment "The ratified world produced by genesis. Found by TYPE, never by a well-known IRI." .
ag:WorldVersion a owl:Class ; rdfs:label "World version" ;
    rdfs:comment "One ratified version of the world's topology; the chain is append-only." .
ag:currentVersion a owl:ObjectProperty ; rdfs:domain ag:World ; rdfs:range ag:WorldVersion ;
    rdfs:label "current version" .
ag:versionNumber a owl:DatatypeProperty ; rdfs:domain ag:WorldVersion ; rdfs:range xsd:integer ;
    rdfs:label "version number" .
ag:underWorldVersion a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "under world version" ;
    rdfs:comment "The world-version in force when this fact was recorded (provenance)." .

#################  Graphs — typed, self-describing (not magic strings)  #################

ag:Graph a owl:Class ; rdfs:label "Named graph" .
ag:WorldGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "World graph" ;
    rdfs:comment "Topology and composed capabilities: who is wired to what, and who can do what. Public, versioned, sovereign-authored. Stated once so no agent's beliefs repeat it." .
ag:BeliefsGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Beliefs graph" ;
    rdfs:comment "ONE agent's private parameters for the capabilities it composed. Opinion, not fact." .
ag:SensedGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Sensed graph" ;
    rdfs:comment "What sensors read. Measurement only; never a judgment." .
ag:OntologyGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Ontology graph" ;
    rdfs:comment "The T-Box: this module and every other." .
ag:beliefsOf a owl:ObjectProperty ; rdfs:domain ag:BeliefsGraph ; rdfs:range ag:Agent ;
    rdfs:label "beliefs of" ;
    rdfs:comment "Which agent owns this graph — the write boundary, made explicit." .
