@prefix ag:   <http://example.org/agora#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/agora/core> a owl:Ontology ;
    rdfs:label "Agora core" ;
    rdfs:comment """The society kernel: agents, the capabilities they compose, and the versioned world they share. Everything else is a MODULE layered on this — the microcontrollers it runs on, the protocols their parts speak, the parts themselves, the capabilities, and the domain. Code may reference the terms defined here; it may never reference an instance.

What is NOT here any more is everything physical. `vocabulary/microcontroller` holds boards, peripherals, pins and wires; a concrete part is its own package beside it. The two subjects were sharing a file and growing at different rates: adding a sensor should not touch what a society IS.""" .

#################  Agents and capabilities (composition, not hierarchy)  #################

ag:Agent a owl:Class ; rdfs:label "Agent" ;
    rdfs:comment "A self-interested principal with a stake. What an agent can DO is not its class — it is the set of capabilities composed onto it, so two agents of the same kind may run different modules." .

ag:Capability a owl:Class ; rdfs:label "Capability" ;
    rdfs:comment "One thing an agent can do, defined by a module: a vocabulary (this ontology), rules (its SHACL shapes), and the code that reads them. Declaring a capability is what activates the module." .

ag:hasCapability a owl:ObjectProperty ; rdfs:domain ag:Agent ; rdfs:range ag:Capability ;
    rdfs:label "has capability" ;
    rdfs:comment "Composed onto the agent in the WORLD graph (public: peers must know what a counterparty can do). The PARAMETERS of a capability are private, in the agent's own beliefs." .

ag:actsFor a owl:ObjectProperty ; rdfs:domain ag:Agent ;
    rdfs:label "acts for" ;
    rdfs:comment "The subject whose interest this agent advances. Generic; a domain narrows the range (in the water domain, a Plant)." .

#################  Devices — dumb mechanism at the edge  #################

ag:Device a owl:Class ; rdfs:label "Device" ;
    rdfs:comment "A physical edge node: mechanism, never policy, and interchangeable with a simulated one." .

#################  Devices that are not there  #################
# A simulated device is an ORDINARY device in every statement the world makes about it: it is
# on a bus, it has topics, it has a sense mode, and an agent is wired to it with ag:polls like
# any other. The only extra fact is that a process stands in for it.
#
# The marker is on the DEVICE and never on the agent, and that is the whole design. An agent
# that could tell would be a second code path, and a second code path is what a simulation is
# supposed to avoid: world/simulation used to exercise its own implementation, so it could pass
# while the real one was broken.

ag:simulatedBy a owl:ObjectProperty ; rdfs:domain ag:Device ; rdfs:range ag:DeviceModel ;
    rdfs:label "simulated by" ;
    rdfs:comment "No such device exists; a process stands in for it, publishing on the same topics and speaking the same protocol. Read by the generators, which give it a container and a credential, and by nothing an agent runs — an agent must not be able to tell, and the surest way is that nothing it executes ever asks." .

ag:modelMinValue a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "model minimum" ;
    rdfs:comment "The floor of what this stand-in can report. A moisture fraction happens to run 0..1; a thermometer does not, so the range is stated rather than assumed." .
ag:modelMaxValue a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "model maximum" .

ag:DeviceModel a owl:Class ; rdfs:label "Device model" ;
    rdfs:comment "The physics the stand-in computes between readings. Facts about the thing being modelled rather than opinions about it, which is why they sit on the device and not in anybody's beliefs." .

ag:modelInitialValue a owl:DatatypeProperty ; rdfs:domain ag:DeviceModel ; rdfs:range xsd:decimal ;
    rdfs:label "model initial value" ;
    rdfs:comment "What it reads before anything has happened to it." .

ag:modelDryRate a owl:DatatypeProperty ; rdfs:domain ag:DeviceModel ; rdfs:range xsd:decimal ;
    rdfs:label "model dry rate" ;
    rdfs:comment "How much of the observed property is lost per tick. Named apart from domain/water's ag:dryRatePerTick, which carries rdfs:domain ag:Plant — reusing it would make every model infer as a plant and inherit a plant's obligations." .

ag:modelTickSeconds a owl:DatatypeProperty ; rdfs:domain ag:DeviceModel ; rdfs:range xsd:integer ;
    rdfs:label "model tick seconds" ;
    rdfs:comment "Wall-clock seconds per tick — how fast this modelled world runs. Used as the publish interval only by a ag:Push device, which keeps its own clock; a ag:Scheduled one keeps the interval its agent gives it, exactly as a board does." .

#################  Where a society executes  #################
ag:ComputeHost a owl:Class ; rdfs:subClassOf ag:Device ; rdfs:label "Compute host" ;
    rdfs:comment "A machine that runs agent processes. Named so the world can say where its society actually executes." .

ag:lanAddress a owl:DatatypeProperty ; rdfs:domain ag:ComputeHost ; rdfs:range xsd:string ;
    rdfs:label "LAN address" ;
    rdfs:comment "Where this host answers for things NOT on it. A co-located agent reaches the broker at ag:brokerHost, which is loopback and must be, because host-networked agents have to agree on one name. A board on the wifi cannot use that name, so it needs the address of whichever host runs the broker. Two routes to one broker, and only the second is a fact about the network rather than about the society. It is also a DHCP lease unless the router is told otherwise, which makes it a fact with an expiry date." .

ag:runsOn a owl:ObjectProperty ; rdfs:range ag:ComputeHost ; rdfs:label "runs on" ;
    rdfs:comment "Which host executes this agent. Documents why the bus is where it is." .

#################  Naming — stated, never derived  #################

ag:localId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "local id" ;
    rdfs:comment "The short name a resource is known by outside RDF. Stated here so nothing has to infer it from the shape of a URI. The ONE instance identifier a process is given is an agent's localId; everything else it discovers." .

#################  Self-reporting — what an agent says about itself  #################

ag:SelfReporting a owl:Class ; rdfs:subClassOf ag:Capability ; rdfs:label "Self reporting" ;
    rdfs:comment "Naming only, so a missing belief can say which block wanted it. NOT derived and NOT composed onto anyone: every agent reports, because every agent has a belief base and a connection whatever else it can do. See agora/metrics.py." .

ag:metricsIntervalS a owl:DatatypeProperty ; rdfs:domain ag:Agent ; rdfs:range xsd:integer ;
    rdfs:label "metrics interval (s)" ;
    rdfs:comment "How often this agent reports on itself. ABSENCE IS MEANINGFUL: an agent that states no interval reports nothing, which is a decision by omission rather than a default. A rate belongs in beliefs for the same reason the sensing cadence does — a test world may want it faster than a deployed one." .

#################  The world and its versions  #################

ag:World a owl:Class ; rdfs:label "World" ;
    rdfs:comment "The ratified world produced by genesis. Found by TYPE, never by a well-known IRI." .
ag:WorldVersion a owl:Class ; rdfs:label "World version" ;
    rdfs:comment "One ratified version of the world's topology; the chain is append-only." .
ag:currentVersion a owl:ObjectProperty ; rdfs:domain ag:World ; rdfs:range ag:WorldVersion ;
    rdfs:label "current version" .
ag:versionNumber a owl:DatatypeProperty ; rdfs:domain ag:WorldVersion ; rdfs:range xsd:integer ;
    rdfs:label "version number" .
ag:underWorldVersion a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "under world version" ;
    rdfs:comment "The world-version in force when this fact was recorded (provenance)." .

#################  Self-review — an agent re-picking, within what it committed to  #################
#  A belief is not a constant. It is a POINT CHOSEN INSIDE A RANGE — a computer needs one
#  value to act on, so genesis picks one and the agent lives with it. What genesis wrote is
#  therefore the first pick and nothing more; it is not a bound, and treating it as one
#  confuses a choice with a constraint.
#
#  The bounds come from three places, and a review may move a belief anywhere in their
#  intersection:
#
#      WORLD   what the society allows at all — figures stated on the capability family
#      SENSOR  what the equipment can do — stated on a device (declared; nothing states one yet)
#      SELF    what THIS agent commits to — narrower than the world, in its own beliefs
#
#  So the author's job is to constrain well rather than to guess well, and how much room an
#  agent has is written down and reviewable instead of implied by whatever number was typed.
#  See knowledge/decisions/a-belief-is-a-pick-within-a-range.md.

ag:SelfReview a owl:Class ; rdfs:subClassOf ag:Capability ; rdfs:label "Self review" ;
    rdfs:comment "Naming only, so a missing belief can say which block wanted it. NOT derived and NOT composed onto anyone — the same argument as ag:SelfReporting: every agent holds settings it chose and evidence about how they are working out, whatever else it can do, so a rule granting this would fire for everybody and be the kernel wearing a disguise. What varies is whether an agent has anything worth reviewing, and that follows from the capabilities it did derive." .

ag:reviewIntervalS a owl:DatatypeProperty ; rdfs:domain ag:Agent ; rdfs:range xsd:integer ;
    rdfs:label "review interval (s)" ;
    rdfs:comment "The FLOOR between two reviews, not the schedule. A review plans its own next arising from when its decision could possibly show an effect — checking sooner than a fresh window of readings can accumulate is looking at the same evidence twice. This figure only stops it planning something absurdly soon. ABSENCE IS MEANINGFUL: an agent that states no interval never reviews itself and its beliefs stay exactly what genesis wrote, which is the right answer for a deployment that wants no drift." .

ag:maxBytesPerTriple a owl:DatatypeProperty ; rdfs:domain ag:Capability ; rdfs:range xsd:integer ;
    rdfs:label "max bytes per triple" ;
    rdfs:comment "Above this ratio a belief base is mostly write amplification rather than knowledge, and is compacted. Stated here rather than compiled in, for the same reason the cadence bounds are: it is a fact about what this society tolerates, not about how the code happens to be written." .

ag:SelfReview ag:maxBytesPerTriple 800 .

##  Which beliefs may be re-picked at all — declared by the package that owns the term
#   ONE triple per revisable belief, in that capability's own ontology.ttl, naming the
#   constitutional figures that bound it. Nothing lists them and no Python knows them: the
#   reviewer finds them by asking the merged T-Box, which is what keeps adding a capability
#   the act of adding a directory.

ag:RevisableBelief a owl:Class ; rdfs:label "Revisable belief" ;
    rdfs:comment "A belief term an agent may re-pick while running. Marking one is a statement about the TERM, made once by the package that defines it — never about an agent, and never in a world." .

ag:revisableToward a owl:ObjectProperty ; rdfs:domain ag:RevisableBelief ;
    rdfs:label "revisable toward" ;
    rdfs:comment "A constitutional figure this belief may be moved toward. Stated once per end, and which end is which is read from the VALUES rather than from the property name — so a package names the two limits it already declares and invents no ordering vocabulary." .

##  What an agent commits to — the SELF constraint, narrower than the world's
ag:Commitment a owl:Class ; rdfs:label "Commitment" ;
    rdfs:comment "One agent's own promise about how far it will let itself re-pick a term. Private, because it is an opinion about its own autonomy — the world states what any agent may do, and this states what THIS one will." .

ag:commits a owl:ObjectProperty ; rdfs:domain ag:Agent ; rdfs:range ag:Commitment ;
    rdfs:label "commits" .
ag:onTerm a owl:ObjectProperty ; rdfs:domain ag:Commitment ; rdfs:label "on term" .
ag:notBelow a owl:DatatypeProperty ; rdfs:label "not below" .
ag:notAbove a owl:DatatypeProperty ; rdfs:label "not above" .

##  What an agent has observed, summarised — a BELIEF about history, not history
#   The series lives in Influx. What the store keeps is fixed-size and derived: an agent does
#   not remember its readings, it remembers what they came to. That is the difference between
#   a log and a belief, and it is why the triple count stays flat.

ag:SummariesGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Summaries graph" ;
    rdfs:comment "What ONE agent's readings came to. Apart from :sensed on purpose, and the separation is what makes the write boundary checkable: :sensed is the measurement record, written by whatever observed and never by a review, while a summary is the agent's own derived account of its own past. In one graph, 'a review does not touch the sensed record' would have been untestable — and an invariant nothing can check is a comment." .

ag:ObservationSummary a owl:Class ; rdfs:label "Observation summary" ;
    rdfs:comment "Everything observed of one property of one subject over one window, as running totals rather than samples. Constant size whatever the window holds, so a belief base that summarises a year is the same size as one that summarises an hour." .

ag:sampleCount a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ; rdfs:range xsd:integer ;
    rdfs:label "sample count" .
ag:sampleMin a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ; rdfs:label "sample min" .
ag:sampleMax a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ; rdfs:label "sample max" ;
    rdfs:comment "Kept alongside the sums because EQUALITY WITH THE MINIMUM is the one thing a variance cannot say. A variance approaches zero for a nearly-still world and IS zero only for an instrument that has not moved at all, and those two want opposite responses." .
ag:sampleSum a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ; rdfs:label "sample sum" .
ag:sampleSumSquares a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ;
    rdfs:label "sample sum of squares" ;
    rdfs:comment "With the count and the sum, this gives the mean and the variance without keeping a single reading." .
ag:firstAt a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ; rdfs:range xsd:dateTime ;
    rdfs:label "first at" .
ag:lastAt a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ; rdfs:range xsd:dateTime ;
    rdfs:label "last at" .
ag:windowSeq a owl:DatatypeProperty ; rdfs:domain ag:ObservationSummary ; rdfs:range xsd:integer ;
    rdfs:label "window sequence" ;
    rdfs:comment "Which completed window this is, counting up. The accumulating one has none. Older windows past the ring are dropped, so the count of nodes is fixed and the newest is simply the largest." .

##  What a review saw, derived at each arising
ag:EvidenceGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Evidence graph" ;
    rdfs:comment "The reviewer's own scratch: statistics derived from the summaries, plus the range each revisable term may move in. Rebuilt at every arising and never read by anything else, so a rule can be plain SPARQL over well-known terms instead of arithmetic." .

ag:Evidence a owl:Class ; rdfs:label "Evidence" ;
    rdfs:comment "What one property of one subject has been doing. Every figure here is computable without knowing what the property MEANS, which is what lets one rule serve a domain nobody has written yet." .
ag:ofProperty a owl:ObjectProperty ; rdfs:domain ag:Evidence ; rdfs:label "of property" .
ag:sampleMean a owl:DatatypeProperty ; rdfs:domain ag:Evidence ; rdfs:label "sample mean" .
ag:sampleSpread a owl:DatatypeProperty ; rdfs:domain ag:Evidence ; rdfs:label "sample spread" ;
    rdfs:comment "The observed range as a fraction of its own mean — unit-free, because one agent's property is a fraction and another's is degrees, and a threshold in either unit is nonsense in the other. Exactly zero means the instrument did not move." .
ag:sampleGapS a owl:DatatypeProperty ; rdfs:domain ag:Evidence ; rdfs:label "sample gap (s)" ;
    rdfs:comment "Mean seconds between readings actually observed. How the reviewer works out when a fresh window could possibly exist, without knowing what it is looking at." .
ag:newestAgeS a owl:DatatypeProperty ; rdfs:domain ag:Evidence ; rdfs:label "newest age (s)" .
ag:windowsHeld a owl:DatatypeProperty ; rdfs:domain ag:Evidence ; rdfs:label "windows held" .

ag:Range a owl:Class ; rdfs:label "Range" ;
    rdfs:comment "The room one term has, after the world's, the equipment's and the agent's own constraints are intersected. Published as evidence so a rule reads a floor and a ceiling instead of re-deriving them, and so a human reading the graph can see exactly how much autonomy was in play." .

##  What it decided, and when to look again
ag:RevisionsGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Revisions graph" ;
    rdfs:comment "What ONE agent has decided about itself. Append-only, and apart from the beliefs graph so that the beliefs graph still holds exactly one value per term — which is what every capability's shapes are written against. Deliberately NOT validated: it is the record of a decision, not a belief anyone acts on." .

ag:Revision a owl:Class ; rdfs:label "Revision" ;
    rdfs:comment "One settled second thought, INCLUDING one settled as 'change nothing'. Recording a decline is what separates reflection from a twitch: without it an agent re-argues the same question at every arising and can never notice that it has declined eleven times and the problem is elsewhere." .

ag:revisedTerm a owl:ObjectProperty ; rdfs:domain ag:Revision ; rdfs:label "revised term" .
ag:fromValue a owl:DatatypeProperty ; rdfs:domain ag:Revision ; rdfs:label "from value" .
ag:toValue a owl:DatatypeProperty ; rdfs:domain ag:Revision ; rdfs:label "to value" .
ag:atTime a owl:DatatypeProperty ; rdfs:domain ag:Revision ; rdfs:range xsd:dateTime ;
    rdfs:label "at time" .
ag:dueAt a owl:DatatypeProperty ; rdfs:domain ag:Revision ; rdfs:range xsd:dateTime ;
    rdfs:label "due at" ;
    rdfs:comment "When this decision is worth revisiting — far enough out that a fresh window of readings could have accumulated. It is both the memory and the schedule: the next arising is the earliest of these, and a term whose decision is not yet due is not re-argued." .
ag:becauseOf a owl:DatatypeProperty ; rdfs:domain ag:Revision ; rdfs:range xsd:string ;
    rdfs:label "because of" ;
    rdfs:comment "The evidence, in words. An agent that cannot say why it changed its mind — or why it did not — has not reviewed anything." .
ag:outcome a owl:DatatypeProperty ; rdfs:domain ag:Revision ; rdfs:range xsd:string ;
    rdfs:label "outcome" ; rdfs:comment "taken | declined | refused. Refused means the shapes rejected it, which is a bug in a rule rather than a decision an agent made." .

#################  Graphs — typed, self-describing (not magic strings)  #################

ag:Graph a owl:Class ; rdfs:label "Named graph" .
ag:WorldGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "World graph" ;
    rdfs:comment "Topology and composed capabilities: who is wired to what, and who can do what. Public, versioned, sovereign-authored. Stated once so no agent's beliefs repeat it." .
ag:BeliefsGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Beliefs graph" ;
    rdfs:comment "ONE agent's private parameters for the capabilities it composed. Opinion, not fact." .
ag:SensedGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Sensed graph" ;
    rdfs:comment "What sensors read. Measurement only; never a judgment." .
ag:OntologyGraph a owl:Class ; rdfs:subClassOf ag:Graph ; rdfs:label "Ontology graph" ;
    rdfs:comment "The T-Box: this module and every other." .
ag:beliefsOf a owl:ObjectProperty ; rdfs:domain ag:BeliefsGraph ; rdfs:range ag:Agent ;
    rdfs:label "beliefs of" ;
    rdfs:comment "Which agent owns this graph — the write boundary, made explicit." .
