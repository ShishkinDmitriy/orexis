@prefix : <http://example.org/orexis/world/viewing#> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix translation: <http://example.org/orexis/translation#> .

<> a orexis:SocietyGraph .    # this document is one graph, and this is what it is

#  THE SOCIETY'S WIRING: the seeker, a client listening on an inbox of its own; two people, each
#  listening on the inbox the seeker's statements to them arrive on; Boris's phone, the client that
#  acts on his behalf on the bus; and the translator, the client that translates the chats
#  (speech.ttl). The filters are asserted here, as a test world's are, where `orexis-onboard` would
#  derive them.

:broker a mqtt4ssn:Broker .

:seeker a orexis:Agent , mqtt4ssn:Client ;
    orexis:localId "seeker" ;
    mqtt4ssn:hasClientID "seeker" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    mqtt4ssn:listensToTopic :seeker_inbox .
:seeker_inbox a mqtt4ssn:Topic .
:seeker_inbox_filter a mqtt4ssn:TopicFilter ; mqtt4ssn:matchesTopic :seeker_inbox ; mqtt4ssn:hasFilterPattern "agents/seeker/inbox" .

:anna a schema:Person ;
    schema:name "Anna" ;
    mqtt4ssn:listensToTopic :anna_inbox .
:anna_inbox a mqtt4ssn:Topic .
:anna_inbox_filter a mqtt4ssn:TopicFilter ; mqtt4ssn:matchesTopic :anna_inbox ; mqtt4ssn:hasFilterPattern "people/anna/inbox" .

:boris a schema:Person ;
    schema:name "Boris" ;
    mqtt4ssn:listensToTopic :boris_inbox .
:boris_inbox a mqtt4ssn:Topic .
:boris_inbox_filter a mqtt4ssn:TopicFilter ; mqtt4ssn:matchesTopic :boris_inbox ; mqtt4ssn:hasFilterPattern "people/boris/inbox" .

:boris_phone a mqtt4ssn:Client ;
    mqtt4ssn:hasClientID "boris_phone" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    prov:actedOnBehalfOf :boris .
:boris_topic a mqtt4ssn:Topic .
:boris_topic_filter a mqtt4ssn:TopicFilter ; mqtt4ssn:matchesTopic :boris_topic ; mqtt4ssn:hasFilterPattern "chats/seeker_and_boris" .

:translator a mqtt4ssn:Client ;
    mqtt4ssn:hasClientID "translator" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    translation:translates :seeker_and_anna , :seeker_and_boris .
