# Copy to .env and adjust. Loaded by docker-compose and by the Python app.

# --- InfluxDB ---
INFLUX_USER=admin
INFLUX_PASSWORD=admin12345
INFLUX_ORG=agora
INFLUX_BUCKET=sensors
INFLUX_TOKEN=dev-token-change-me

# --- Grafana / Fuseki ---
GRAFANA_PASSWORD=admin
FUSEKI_PASSWORD=admin

# --- App endpoints (host-side; the agents run on the Pi, not in a container) ---
# NOTE: the MQTT broker is NOT configured here. It is an ag:MessageBus in the world graph
# (genesis/world.ttl) — a channel name is meaningless without the broker it is on, and every
# agent must agree on it. The environment says only WHERE THE BELIEF BASE IS; the belief base
# says everything else.
INFLUX_URL=http://localhost:8086

# Each world has its OWN Fuseki dataset (/ds-<world>), so seeding one cannot overwrite
# another and readings stay with the world they were observed in. Tools that know which
# world they are acting on (agora-seed, agora-validate, agora-sim) build the URL from this
# base; an AGENT is handed the finished FUSEKI_URL by its compose service, because an agent
# knows its own id and nothing else about where it lives.
FUSEKI_BASE=http://localhost:3030

# --- Deployment toggles (NOT beliefs: the world + each agent's beliefs live in Fuseki,
#     authored at genesis in genesis/*.ttl) ---
# true = rounds may open real valves; false = decide and log only
AGORA_ACTUATE=false
# agora-sim: seconds per soil tick
AGORA_SIM_TICK_S=2
# Which plants to simulate. EMPTY MEANS EVERY PLANT IN THE WORLD — including any that a real
# ESP32 is already publishing for, and the simulator will happily talk over it on the same
# topic. When any hardware is connected, list only the VIRTUAL ones here.
AGORA_SIM_PLANTS=tomato,succulent
