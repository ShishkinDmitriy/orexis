# Copy to .env and adjust. Loaded by docker-compose and by the Python app.

# --- InfluxDB ---
INFLUX_USER=admin
INFLUX_PASSWORD=admin12345
INFLUX_ORG=agora
INFLUX_BUCKET=sensors
INFLUX_TOKEN=dev-token-change-me

# --- Grafana / Fuseki ---
GRAFANA_PASSWORD=admin
FUSEKI_PASSWORD=admin

# --- App endpoints (host-side; the agents run on the Pi, not in a container) ---
# NOTE: the MQTT broker is NOT configured here. It is an ag:MessageBus in the world graph
# (genesis/world.ttl) — a channel name is meaningless without the broker it is on, and every
# agent must agree on it. The environment says only WHERE THE BELIEF BASE IS; the belief base
# says everything else.
INFLUX_URL=http://localhost:8086
FUSEKI_URL=http://localhost:3030/ds

# --- Deployment toggles (NOT beliefs: the world + each agent's beliefs live in Fuseki,
#     authored at genesis in genesis/*.ttl) ---
# true = rounds may open real valves; false = decide and log only
AGORA_ACTUATE=false
# agora-sim: seconds per soil tick
AGORA_SIM_TICK_S=2
# which plants to simulate; unset/empty = every plant in the world, else a comma list
# (list only the VIRTUAL ones when mixing with real ESP32s)
AGORA_SIM_PLANTS=
