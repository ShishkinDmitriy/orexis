# What this installation is physically allowed to do. Deployment facts, not beliefs: no agent
# holds an opinion about whether a pump is wired.
#
# Neither the broker nor the belief base is here. The broker is an ag:MessageBus in the world —
# a channel name is meaningless without the broker it is on. The belief base is not a service
# at all: each agent builds its own from the world mounted beside it.

AGORA_ACTUATE=false
AGORA_SIM_TICK_S=2
AGORA_SIM_PLANTS=tomato,succulent
