@prefix : <http://example.org/orexis/world/tower#> .
@prefix hanoi: <http://example.org/orexis/hanoi#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/tower/ontology.ttl> .

#  THE TOWER: hanoi's puzzle on the courier's grid. The mover wants every disk on peg C and holds
#  hanoi's one move and the courier's three; the pegs stand on three cells of a 3x3 grid. It plans
#  Moves and never sees a cell, and each Move, when it comes up, is planned as drives from wherever
#  the van then stands — because the combination's rules say what a disk is on from where it
#  stands, and nothing more.

:mover a orexis:Agent ;
    orexis:localId "mover" ;
    rdfs:comment "A mind with hanoi's move and the courier's three, planning one inside the other." .

:van a courier:Van ; rdfs:label "the van" .
#  A DISK IS A PARCEL TOO, said of each: the closure relates classes and types no instance.
:disk_1 a hanoi:Disk , courier:Parcel ; hanoi:size 1 ; rdfs:label "the small disk" .
:disk_2 a hanoi:Disk , courier:Parcel ; hanoi:size 2 ; rdfs:label "the middle disk" .
:disk_3 a hanoi:Disk , courier:Parcel ; hanoi:size 3 ; rdfs:label "the large disk" .

:c0_0 a courier:Cell ; courier:x 0 ; courier:y 0 .
:c0_1 a courier:Cell ; courier:x 0 ; courier:y 1 .
:c0_2 a courier:Cell ; courier:x 0 ; courier:y 2 .
:c1_0 a courier:Cell ; courier:x 1 ; courier:y 0 .
:c1_1 a courier:Cell ; courier:x 1 ; courier:y 1 .
:c1_2 a courier:Cell ; courier:x 1 ; courier:y 2 .
:c2_0 a courier:Cell ; courier:x 2 ; courier:y 0 .
:c2_1 a courier:Cell ; courier:x 2 ; courier:y 1 .
:c2_2 a courier:Cell ; courier:x 2 ; courier:y 2 .

hanoi:PegA courier:at :c0_0 .
hanoi:PegB courier:at :c2_0 .
hanoi:PegC courier:at :c1_2 .
