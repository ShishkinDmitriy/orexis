@prefix : <http://example.org/orexis/world/tower#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .

<> a orexis:StateGraph .    # this document is one graph, and this is what it is

#  WHERE THINGS STAND, and nothing else: every disk in peg A's cell and the van in the middle. What
#  each disk is ON is not stated — the tower's rules conclude it from this.
:disk_1 courier:at :c0_0 .
:disk_2 courier:at :c0_0 .
:disk_3 courier:at :c0_0 .
:van courier:at :c1_1 .
