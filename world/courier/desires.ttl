@prefix : <http://example.org/orexis/world/courier#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:DesireGraph .    # this document is one graph, and this is what it is

#  THE GOAL, as a desire the derivation mints one want from: every parcel standing where it is
#  owed. What that means and how far it is are the domain's (`domains/courier/shapes.ttl`), which
#  the desire points at; the want is one-shot, and once the parcel is home the runtime stops.

:courier orexis:holds :every_parcel_delivered .

:every_parcel_delivered a orexis:Desire ;
    rdfs:label "every parcel where it is owed" ;
    orexis:metWhen courier:delivered ;
    orexis:estimates courier:drivesOwed .
