@prefix : <http://example.org/orexis/world/courier#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:WorldGraph .    # this document is one graph, and this is what it is

#  A 4x4 grid, one van, one parcel owed at the far corner. The state is where the van is times
#  where the parcel is or that it is aboard, 16 x 17 = 272 worlds, and a world can be nearer the
#  goal than another in the unit a drive costs, which is what makes the estimate worth having.
#  Nothing here says which cells adjoin: the drive works that out from the coordinates, the same
#  numbers the estimate measures a distance in. Where the van and the parcel stand is posed in
#  state.ttl.

:courier a orexis:Agent ;
    orexis:localId "courier" ;
    rdfs:comment "The driver: a mind with three actions, acting for nothing and owing nobody." .

:van a courier:Van ; rdfs:label "the van" .

:parcel a courier:Parcel ; courier:destination :c3_3 ;
    rdfs:label "the parcel owed at the far corner" .

:c0_0 a courier:Cell ; courier:x 0 ; courier:y 0 .
:c0_1 a courier:Cell ; courier:x 0 ; courier:y 1 .
:c0_2 a courier:Cell ; courier:x 0 ; courier:y 2 .
:c0_3 a courier:Cell ; courier:x 0 ; courier:y 3 .
:c1_0 a courier:Cell ; courier:x 1 ; courier:y 0 .
:c1_1 a courier:Cell ; courier:x 1 ; courier:y 1 .
:c1_2 a courier:Cell ; courier:x 1 ; courier:y 2 .
:c1_3 a courier:Cell ; courier:x 1 ; courier:y 3 .
:c2_0 a courier:Cell ; courier:x 2 ; courier:y 0 .
:c2_1 a courier:Cell ; courier:x 2 ; courier:y 1 .
:c2_2 a courier:Cell ; courier:x 2 ; courier:y 2 .
:c2_3 a courier:Cell ; courier:x 2 ; courier:y 3 .
:c3_0 a courier:Cell ; courier:x 3 ; courier:y 0 .
:c3_1 a courier:Cell ; courier:x 3 ; courier:y 1 .
:c3_2 a courier:Cell ; courier:x 3 ; courier:y 2 .
:c3_3 a courier:Cell ; courier:x 3 ; courier:y 3 .
