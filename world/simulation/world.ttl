@prefix : <http://example.org/agora/world/simulation#> .
@prefix review: <http://example.org/agora/review#> .
@prefix sensing: <http://example.org/agora/sensing#> .
@prefix water: <http://example.org/agora/water#> .
@prefix mqtt: <http://example.org/agora/mqtt#> .
@prefix actuation: <http://example.org/agora/actuation#> .
@prefix ag:   <http://example.org/agora#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix market: <http://example.org/agora/market#> .
@prefix scaling: <http://example.org/agora/scaling#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix schema: <https://schema.org/> .

#  A ratified world, v1 — the society, with nothing physical in it.
#
#  Not society with a flag, and no longer society with its own capabilities either. Every agent
#  here is ORDINARY: it polls a sensor with sensing:polls, derives sensing:Subscribing, and runs the same
#  sensing module a world with real boards runs. What differs is one fact about the DEVICES —
#  ag:simulatedBy — which says a process stands in for hardware that does not exist.
#
#  That is the point. This world used to be wired with ag:models to ag:ModelledSubject, and the
#  agents derived a simulated capability with its own implementation of perceiving. So the
#  simulation exercised a parallel code path, and could pass while the real one was broken —
#  the weakest possible form of simulation. Now the only untested thing is the hardware.
#
#  The market is identical, deliberately. Bidding, hosting, clearing and the claims do not
#  know that anything here is simulated — a bidder asks for "whoever perceives" and a host asks
#  for "something that can redeem", and both are answered.
#
#  Its CHANNELS are not identical, and that is deliberate too. Every topic here is prefixed
#  `sim/`, because this world once named the same strings as world/society: run both and the
#  real supplier heard simulated bids, and a real plant agent ingested a modelled reading as
#  testimony about itself. Isolating belief bases does not isolate a bus — two worlds meet
#  wherever they name the same topic, and nothing but authoring keeps them apart. Contrast
#  world/sensing, which shares society's topics ON PURPOSE so one flashed board works in
#  either. Sharing is a choice; here the choice is no.
#
#  See knowledge/domain/world.md, knowledge/decisions/series-and-bus-isolation.md.

##########  The bus everyone speaks over  ##########
#  Here rather than in .env because a topic means nothing without the broker it is on, and a
#  society whose members disagree about the bus is not one society. The ONLY thing the
#  environment tells a process is where the belief base is; this is part of what it finds there.

:local_bus a mqtt:MessageBus ;
    ag:localId "local_bus" ;
    mqtt:brokerHost "localhost" ;
    mqtt:brokerPort 1885 ;
    # Agents connect here and prove who they are with a certificate; the boards keep the
    # plaintext port above. One bus, one ACL, two ways of authenticating.
    mqtt:brokerTlsPort 8885 .

##########  World version  ##########
#  Found by TYPE (?w a ag:World), never by a well-known IRI.

#  Who ratified it. A REFERENCE, never a declaration: the world says which user stands behind
#  these files and says nothing else about them — no name, no key, no type. A user is
#  installation-level (AGENTS.md rule 3) and an agent is given only its world, so the URI is an
#  identifier it never resolves, exactly as `mqtt:brokerHost` names a host it never introspects.
#  Sovereign is the ROLE that user held HERE — stated, not assumed, because another user may
#  operate what this one ratified, and a loader that inferred the capacity could never say so.
:world a ag:World ; ag:currentVersion :version_1 ;
    #  Ten bench minutes are one simulated day, so a week of drying, deciding and dosing
    #  fits in an evening — and every stand-in ages at this one rate, or a dose sized for a
    #  day's drying would land against an hour's. Faster was tried on paper and refused: at
    #  one minute per day the slow cadence spans ten days, the trend bound pins every agent
    #  to the constitutional floor, and the machinery this world exists to show has nothing
    #  left to choose between.
    ag:timeScale 144 ;
    #  And someone with a watering can wanders through about every other simulated day,
    #  per pot: the third-party impulse of #151, made routine rather than hypothetical.
    ag:strayDoseMeanDays 2 ;
    prov:qualifiedAttribution [ prov:agent <http://example.org/agora/user/dimonina> ; prov:hadRole ag:Sovereign ] .
:version_1 a ag:WorldVersion ; ag:versionNumber 1 .


##########  The venue  ##########

:barrel1_market a market:Market ;
    ag:localId "barrel1_market" ;
    market:marketFor :barrel1 ;
    market:offerTopic   "market/barrel1/offer" ;
    market:bidTopic     "market/barrel1/bid" ;
    market:claimTopic "market/barrel1/claim" ;
    market:redeemTopic "market/barrel1/redeem" .

:barrel1 a water:WaterSource ;
    ag:localId "barrel1" ;
    water:suppliedBy :supplier ;
    water:capacityL 5.0 .

##########  The supplier — runs the venue and owns the valves  ##########
#  Derivation gives it Hosting (it owns a market) and Actuation (it holds valves), and NOT
#  Subscribing or Bidding — it is wired to no sensor and plumbed into no market as a buyer. Its
#  class says none of this; its connections do.

:supplier a ag:Agent ;
    ag:localId "supplier" ;
    market:hosts :barrel1_market ;
    #  How it matches bids to the lot. Public because a bidder cannot bid well against a
    #  rule it does not know, and it is the HOST's — an auction's terms belong to whoever
    #  convenes it, not to the venue. The capability is derived from this, never declared.
    market:matchesBy market:PayAsBid ;
    actuation:hasActuator :valve_fern , :valve_tomato , :valve_succulent .

##########  Plants — sensed and watered; no stake of their own  ##########

# WHAT EACH PLANT NEEDS, which is not the same as what its agent wants. This is the RANGE; the
# target in `beliefs/<plant>.ttl` is a PICK inside it. Public and in the world because it is a
# fact about the plant that anyone may check, where the target is private and the agent's to
# move — see knowledge/decisions/the-range-is-the-plants-and-the-pick-is-the-agents.md.
#
# Illustrative figures for a synthetic world, not measured here: what matters is that a succulent
# and a fern want different things and that each agent's target has something to answer to.
#  TWO ranges each, and the second one is what makes urgency mean anything. `hasOperatingRange`
#  is where the plant does well; `hasSurvivalRange` is where it does not die, and the agent's
#  desire is deduced from the pair — the region to hold, and how much room there is outside it
#  before the question stops being comfort. How bad it is to sit 0.05 below the region depends
#  entirely on how far below the region the floor is, and that is asymmetric per plant: the
#  succulent's dry side is nearly free and its wet side is a cliff, which its two ranges say and
#  no code here knows. See knowledge/decisions/desire-is-deduced-from-the-ranges-the-world-states.md.
#
#  The fern states TWO properties, and that is deliberate: it is the one agent here wired to a
#  thermometer as well as a probe, so it is the one that can demonstrate an agent wanting more
#  than one thing. Nothing bids on air temperature — no market relieves it — and it still changes
#  how closely the board is watched, which is the whole of what issue #110 asked for.

:fern a water:Plant ;
    ag:localId "fern" ; water:servedBy :barrel1 ;
    ag:rainTopic "rain/fern" ;
    water:driesPerDay 0.12 ; water:litresPerFraction 2.0 ;
    ssn-system:hasOperatingRange [ a ssn-system:OperatingRange ;
        ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:SoilMoisture ;
            schema:minValue 0.45 ; schema:maxValue 0.65 ; schema:unitCode unit:UNITLESS ] ,
        [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:AirTemperature ;
            schema:minValue 18.0 ; schema:maxValue 24.0 ; schema:unitCode unit:DEG_C ] ] ;
    ssn-system:hasSurvivalRange [ a ssn-system:SurvivalRange ;
        ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:SoilMoisture ;
            schema:minValue 0.20 ; schema:maxValue 0.85 ; schema:unitCode unit:UNITLESS ] ,
        [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:AirTemperature ;
            schema:minValue 5.0 ; schema:maxValue 35.0 ; schema:unitCode unit:DEG_C ] ] .

:tomato a water:Plant ;
    ag:localId "tomato" ; water:servedBy :barrel1 ;
    ag:rainTopic "rain/tomato" ;
    water:driesPerDay 0.20 ; water:litresPerFraction 2.0 ;
    ssn-system:hasOperatingRange [ a ssn-system:OperatingRange ;
        ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:SoilMoisture ;
            schema:minValue 0.40 ; schema:maxValue 0.60 ; schema:unitCode unit:UNITLESS ] ] ;
    ssn-system:hasSurvivalRange [ a ssn-system:SurvivalRange ;
        ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:SoilMoisture ;
            schema:minValue 0.18 ; schema:maxValue 0.80 ; schema:unitCode unit:UNITLESS ] ] .

:succulent a water:Plant ;
    ag:localId "succulent" ; water:servedBy :barrel1 ;
    ag:rainTopic "rain/succulent" ;
    water:driesPerDay 0.04 ; water:litresPerFraction 2.0 ;
    ssn-system:hasOperatingRange [ a ssn-system:OperatingRange ;
        ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:SoilMoisture ;
            schema:minValue 0.15 ; schema:maxValue 0.30 ; schema:unitCode unit:UNITLESS ] ] ;
    #  Bone dry is survivable and soaked is not — the same shape the Zamioculcas package
    #  documents, and the reason the envelope is carried per side rather than as one width.
    ssn-system:hasSurvivalRange [ a ssn-system:SurvivalRange ;
        ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ;
            ssn:forProperty water:SoilMoisture ;
            schema:minValue 0.02 ; schema:maxValue 0.45 ; schema:unitCode unit:UNITLESS ] ] .

##########  Plant agents — each wired to its own sensor and into the market  ##########
#  sensing:polls IS the access grant: fern's agent is wired to fern's sensor and to no other.
#  From these two connections, derivation gives each of them Subscribing + Bidding.

:fern_agent a ag:Agent ;
    ag:localId "fern" ;
    ag:actsFor :fern ;
    sensing:polls :moisture_sensor_fern , :air_temp_fern ;
    market:bidsIn :barrel1_market ;
    mqtt:eventTopic "readings/fern" .

:tomato_agent a ag:Agent ;
    ag:localId "tomato" ;
    ag:actsFor :tomato ;
    sensing:polls :moisture_sensor_tomato ;
    market:bidsIn :barrel1_market ;
    mqtt:eventTopic "readings/tomato" .

:succulent_agent a ag:Agent ;
    ag:localId "succulent" ;
    ag:actsFor :succulent ;
    sensing:polls :moisture_sensor_succulent ;
    market:bidsIn :barrel1_market ;
    mqtt:eventTopic "readings/succulent" .

##########  What each agent may re-pick, and how far  ##########
#  A MANDATE: the room this world gives an agent on one of its own settings. Here rather than in
#  its beliefs because latitude GRANTED is a governance fact — what an agent is allowed, not what
#  it wants. The pick inside the range stays private; the range does not.
#
#  Stating one is also what GRANTS the review capability: room to move and the ability to use it
#  are one decision said once, so `capabilities/review/rules.ru` derives review:Reckoning from exactly
#  these triples. An agent with no mandate never arises, which is how a deployment that wants no
#  drift says so — by granting none, rather than by omitting a belief and hoping something
#  notices. The supplier has none: it holds no revisable setting, so there is nothing to give it
#  room on.
#
#  Note what is NOT written here: no ag:hasCapability. See AGENTS.md.

:fern_agent review:commits [ review:onTerm sensing:slowSleepS ; review:notBelow 600 ; review:notAbove 900 ] .
:tomato_agent review:commits [ review:onTerm sensing:slowSleepS ; review:notBelow 600 ; review:notAbove 900 ] .
:succulent_agent review:commits [ review:onTerm sensing:slowSleepS ; review:notBelow 900 ; review:notAbove 900 ] .

#  And the jolt threshold — what counts as a big-enough in-band move to wake the board for.
#  0.25 was an estimate measured on nothing, which is exactly what latitude is for: the agent
#  corrects it from what its own sensors do, and being wrong costs a retained command, not a
#  reflash. The succulent gets none, deliberately: its cadence mandate is already fixed at
#  900..900, and a world that wants no drift says so by granting no room.
:fern_agent review:commits [ review:onTerm sensing:alarmDeltaFraction ; review:notBelow 0.1 ; review:notAbove 0.5 ] .
:tomato_agent review:commits [ review:onTerm sensing:alarmDeltaFraction ; review:notBelow 0.1 ; review:notAbove 0.5 ] .

##########  Sensors — ordinary in every respect but one: nothing is there  ##########
#  Each states what any board states: the bus it is on, the subject it monitors, the property it
#  observes, its topics, and who holds the clock. An agent reads these and cannot tell.
#
#  sensing:senseMode sensing:ScheduledProcedure means the stand-in keeps the interval its agent gives it, exactly
#  as a deep-sleeping board does — so this world exercises the retained-cadence mechanism, which
#  the old simulation never touched at all.

#  fern's board reports TWO properties down one line, which is what a KY-015 does and what
#  `world/sensing` states for real hardware. Two sensors, one reading topic, one message — and
#  each takes its own number out of it with a JSON Pointer.
#
#  Note which one carries mqtt:onBus and which does not. The board holds ONE credential and
#  publishes ONE message, so `ag:air_temp_fern` mints no principal of its own: a second credential
#  for a client that never connects is exactly what the hardware world refuses. It is reachable
#  because its neighbour publishes for it, which is what `ag:SimulatedDeviceShape` now tests.

:moisture_sensor_fern a sosa:Sensor , ag:Device ;
    ag:localId "moisture_sensor_fern" ;
    mqtt:onBus :local_bus ;
    sensing:senseMode sensing:ScheduledProcedure ;
    #  This CHANNEL is watched for crossings (#151): the agent commands its region's edges
    #  beside the cadence, and the stand-in watches them between heartbeats as a ULP would.
    ssn:implements sensing:AlarmProcedure ;
    sensing:monitors :fern ;
    sosa:observes water:SoilMoisture ;
    scaling:quantityUnit unit:UNITLESS ;   # a fraction of saturation, 0-1
    mqtt:readingTopic "sensors/moisture_sensor_fern/reading" ;
    #  Named for what it measures, like /temperature beside it — the anonymous /value default
    #  exists for devices that state nothing, and a moisture reading is not anonymous.
    mqtt:readingPointer "/moisture" ;
    mqtt:commandTopic "sensors/moisture_sensor_fern/command" ;
    ag:simulatedBy [ a ag:DeviceModel ;
        ag:modelMinValue 0.0 ; ag:modelMaxValue 1.0 ;
        ag:modelInitialValue 0.45 ;
        #  No drying stated here since #164: the pot's own water:driesPerDay above is the
        #  physics, entailed into the kernel's term, and this model would only override it.
        ag:modelTickSeconds 3 ] .

#  The second property on that same wire. No bus, no command topic of its own, no principal —
#  it is the same device speaking, and the only thing that makes it a separate SENSOR is that it
#  observes a different property. Its range is degrees, not a fraction, which is the assumption
#  ag:DeviceModelShape had to stop making.
:air_temp_fern a sosa:Sensor , ag:Device ;
    ag:localId "air_temp_fern" ;
    #  Watched too (#151): a stand-in may watch every channel it has, where a real ESP32's ULP
    #  reaches only the analog probe — the per-channel statement is exactly for that asymmetry.
    ssn:implements sensing:AlarmProcedure ;
    #  no senseMode since #96: the clock is the device's, stated once where it connects
    sensing:monitors :fern ;
    sosa:observes water:AirTemperature ;
    scaling:quantityUnit unit:DEG_C ;      # the one reading here that is NOT a fraction
    mqtt:readingTopic "sensors/moisture_sensor_fern/reading" ;
    mqtt:readingPointer "/temperature" ;
    mqtt:commandTopic "sensors/moisture_sensor_fern/command" ;
    ag:simulatedBy [ a ag:DeviceModel ;
        ag:modelMinValue -10.0 ; ag:modelMaxValue 45.0 ;
        ag:modelInitialValue 21.0 ;
        #  A room, not a trend: 21 at the shoulders, ~25 mid-afternoon, ~17 before dawn. The
        #  old model warmed forever, one step per reading — the artifact the model loss term's
        #  comment records, wearing a minus sign.
        ag:modelDailySwing 4.0 ;
        ag:modelTickSeconds 3 ] .

:moisture_sensor_tomato a sosa:Sensor , ag:Device ;
    ag:localId "moisture_sensor_tomato" ;
    mqtt:onBus :local_bus ;
    sensing:senseMode sensing:ScheduledProcedure ;
    #  This CHANNEL is watched for crossings (#151): the agent commands its region's edges
    #  beside the cadence, and the stand-in watches them between heartbeats as a ULP would.
    ssn:implements sensing:AlarmProcedure ;
    sensing:monitors :tomato ;
    sosa:observes water:SoilMoisture ;
    scaling:quantityUnit unit:UNITLESS ;   # a fraction of saturation, 0-1, like the fern's
    mqtt:readingTopic "sensors/moisture_sensor_tomato/reading" ;
    #  Named for what it measures, like /temperature beside it — the anonymous /value default
    #  exists for devices that state nothing, and a moisture reading is not anonymous.
    mqtt:readingPointer "/moisture" ;
    mqtt:commandTopic "sensors/moisture_sensor_tomato/command" ;
    ag:simulatedBy [ a ag:DeviceModel ;
        ag:modelInitialValue 0.45 ;
        #  The thirsty one: a fifth of saturation per day, which is why it is also the anxious
        #  one — its cadence beliefs and its physics agree about how fast trouble arrives.
        ag:modelTickSeconds 3 ] .

:moisture_sensor_succulent a sosa:Sensor , ag:Device ;
    ag:localId "moisture_sensor_succulent" ;
    mqtt:onBus :local_bus ;
    sensing:senseMode sensing:ScheduledProcedure ;
    #  This CHANNEL is watched for crossings (#151): the agent commands its region's edges
    #  beside the cadence, and the stand-in watches them between heartbeats as a ULP would.
    ssn:implements sensing:AlarmProcedure ;
    sensing:monitors :succulent ;
    sosa:observes water:SoilMoisture ;
    scaling:quantityUnit unit:UNITLESS ;   # a fraction of saturation, 0-1, like the fern's
    mqtt:readingTopic "sensors/moisture_sensor_succulent/reading" ;
    #  Named for what it measures, like /temperature beside it — the anonymous /value default
    #  exists for devices that state nothing, and a moisture reading is not anonymous.
    mqtt:readingPointer "/moisture" ;
    mqtt:commandTopic "sensors/moisture_sensor_succulent/command" ;
    ag:simulatedBy [ a ag:DeviceModel ;
        ag:modelInitialValue 0.45 ;
        #  A succulent barely drinks: a watering every week or two, real and simulated.
        ag:modelTickSeconds 3 ] .

##########  The supplier's valves — real valves, stood in for  ##########
#
#  actuation:Valve, not a separate class: the supplier holds actuation:hasActuator and derives plain
#  actuation:Actuation, so it co-signs every command exactly as it would for hardware. What is
#  simulated is the DEVICE at the other end, which is what ag:simulatedBy says — the same
#  mark the sensors carry.
#
#  mqtt:statusTopic is where the stand-in reports what it actually dispensed. A simulated
#  sensor waters on THAT and never on the command, so a command it refuses leaves the soil
#  dry — which is the whole point of making it verify.

:valve_fern a actuation:Valve ;
    ag:localId "valve_fern" ; mqtt:onBus :local_bus ; actuation:actuates :fern ; actuation:drawsFrom :barrel1 ;
    ag:simulatedBy [ a ag:DeviceModel ] ;
    mqtt:commandTopic "actuators/valve_fern/command" ;
    mqtt:statusTopic "actuators/valve_fern/status" ;
    actuation:mlPerSecond 10.0 ; actuation:maxDoseMl 1000.0 .

:valve_tomato a actuation:Valve ;
    ag:localId "valve_tomato" ; mqtt:onBus :local_bus ; actuation:actuates :tomato ; actuation:drawsFrom :barrel1 ;
    ag:simulatedBy [ a ag:DeviceModel ] ;
    mqtt:commandTopic "actuators/valve_tomato/command" ;
    mqtt:statusTopic "actuators/valve_tomato/status" ;
    actuation:mlPerSecond 10.0 ; actuation:maxDoseMl 1000.0 .

:valve_succulent a actuation:Valve ;
    ag:localId "valve_succulent" ; mqtt:onBus :local_bus ; actuation:actuates :succulent ; actuation:drawsFrom :barrel1 ;
    ag:simulatedBy [ a ag:DeviceModel ] ;
    mqtt:commandTopic "actuators/valve_succulent/command" ;
    mqtt:statusTopic "actuators/valve_succulent/status" ;
    actuation:mlPerSecond 10.0 ; actuation:maxDoseMl 1000.0 .
