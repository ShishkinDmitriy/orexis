#  GENERATED by `orexis-onboard` from this world's own documents — do not edit. The filter each topic is
#  named by, where the society states none: by the rule in onboarding/requirements.ttl, one convention
#  for every world — sensors/<client>/reading for what a board publishes, sensors/<client>/command for
#  what it listens to, actuators/<device>/command, agents/<agent>/inbox, people/<person>/inbox, and
#  chats/<chat> for the topic a chat goes through. A filter the society asserts itself is kept, and
#  wins (knowledge/domain/onboarding/requirement.md).

@prefix : <http://example.org/orexis/world/lane#> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix orexis: <http://example.org/orexis#> .

<> a orexis:SocietyGraph .    # this document is one graph, and this is what it is

:courier_a_inbox_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "agents/courier_a/inbox" ;
    mqtt4ssn:matchesTopic :courier_a_inbox .
:courier_b_inbox_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "agents/courier_b/inbox" ;
    mqtt4ssn:matchesTopic :courier_b_inbox .
:readings_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "sensors/simulation/reading" ;
    mqtt4ssn:matchesTopic :readings .
:van_a_commands_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "actuators/van_a/command" ;
    mqtt4ssn:matchesTopic :van_a_commands .
:van_b_commands_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "actuators/van_b/command" ;
    mqtt4ssn:matchesTopic :van_b_commands .
