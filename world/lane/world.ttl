@prefix : <http://example.org/orexis/world/lane#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix sim: <http://example.org/orexis/sim#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/courier/ontology.ttl> ,         # the domain this world poses
                <../../domains/courier/actions.answered.ttl> , # with its drives answered by the world, told to the van
                <../../domains/courier/driver.ttl> ,           # and the boarding, since a van has a driver
                <../../domains/sim/ontology.ttl> .             # the simulator plays the van and its fix

#  THE LANE (a-boat-is-a-van-and-a-contact-becomes-a-belief-by-the-rules, parked onto vans; #1002). The
#  world two minds will meet in: a single-track lane with one passing place, open road two cells wide at
#  each end, and vans whose drives the world answers. This document is the first slice of it, one van:
#  its drive is a command to the van itself, the simulator has the van on the cell forty-five seconds on,
#  the van's position fix reports the cell, and the courier's transition concludes where the van is. The
#  second van, the contact that sees it and the two minds come with #1003 and #1004.
#
#  THE GRID: columns 0 and 1 and columns 5 and 6 are open road, three rows deep; columns 2 to 4 are the
#  lane, row 1 alone, and (3, 2) is the passing place. Each cell states its NUMBER, 3 x + y, which is what
#  every instrument here reports and the van is told: an instrument gives numbers and a cell is an IRI,
#  so the world says once which is which (knowledge/domain/courier/position.md).
#
#  THE VAN: `van_a` stands at the western end with its driver aboard; its parcel waits a cell east and is
#  owed at the eastern end. The agent acts for the van, reads its position fix and commands it; the fix
#  reports every ten seconds and the van is on the cell it is told forty-five seconds on, inside the
#  drive's band of thirty to sixty. Where the van stands is never posed: its first fix says
#  (knowledge/domain/courier/position.md).

:courier_a a orexis:Agent ;
    orexis:localId "courier_a" ;
    orexis:actsFor :van_a ;
    courier:hasDriver :driver_a ;
    rdfs:comment "The courier of van A: a mind with the courier's actions over one van, through the driver it has." .

:driver_a a courier:Driver ; rdfs:label "the driver of van A" .
:van_a a courier:Van ;
    courier:drivenBy :driver_a ;
    sim:simulatedBy [ a sim:Model ; sim:delayS 45 ] ;    # told a cell, it is there forty-five seconds on
    rdfs:label "van A" .
:parcel_a a courier:Parcel ; courier:destination :c6_1 ;
    rdfs:label "the parcel owed at the eastern end" .

#  The van's instrument, hosted by the van and played by the simulator: the fix at the van's cell, exactly —
#  a fix that reports the same cell twice is a van that has not moved, not a stuck instrument, so its
#  agent lets it repeat (beliefs/courier_a.self.ttl).
:fix_a a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 1 ; sim:jitter 0 ] ;
    sosa:isHostedBy :van_a ;
    sosa:observes courier:Position ;
    sensing:readingPointer "/cell" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .

#  Western road
:c0_0 a courier:Cell ; courier:x 0 ; courier:y 0 ; courier:number 0 .
:c0_1 a courier:Cell ; courier:x 0 ; courier:y 1 ; courier:number 1 .
:c0_2 a courier:Cell ; courier:x 0 ; courier:y 2 ; courier:number 2 .
:c1_0 a courier:Cell ; courier:x 1 ; courier:y 0 ; courier:number 3 .
:c1_1 a courier:Cell ; courier:x 1 ; courier:y 1 ; courier:number 4 .
:c1_2 a courier:Cell ; courier:x 1 ; courier:y 2 ; courier:number 5 .
#  The lane, and its passing place
:c2_1 a courier:Cell ; courier:x 2 ; courier:y 1 ; courier:number 7 .
:c3_1 a courier:Cell ; courier:x 3 ; courier:y 1 ; courier:number 10 .
:c3_2 a courier:Cell ; courier:x 3 ; courier:y 2 ; courier:number 11 .
:c4_1 a courier:Cell ; courier:x 4 ; courier:y 1 ; courier:number 13 .
#  Eastern road
:c5_0 a courier:Cell ; courier:x 5 ; courier:y 0 ; courier:number 15 .
:c5_1 a courier:Cell ; courier:x 5 ; courier:y 1 ; courier:number 16 .
:c5_2 a courier:Cell ; courier:x 5 ; courier:y 2 ; courier:number 17 .
:c6_0 a courier:Cell ; courier:x 6 ; courier:y 0 ; courier:number 18 .
:c6_1 a courier:Cell ; courier:x 6 ; courier:y 1 ; courier:number 19 .
:c6_2 a courier:Cell ; courier:x 6 ; courier:y 2 ; courier:number 20 .
