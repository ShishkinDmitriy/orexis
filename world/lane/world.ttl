@prefix : <http://example.org/orexis/world/lane#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix sim: <http://example.org/orexis/sim#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/courier/ontology.ttl> ,         # the domain this world poses
                <../../domains/courier/actions.answered.ttl> , # with its drives answered by the world, told to the van
                <../../domains/courier/driver.ttl> ,           # and the boarding, since a van has a driver
                <../../domains/sim/ontology.ttl> .             # the simulator plays the van and its fix

#  THE LANE (a-boat-is-a-van-and-a-contact-becomes-a-belief-by-the-rules, parked onto vans; #1002). The
#  world two minds will meet in: a single-track lane with one passing place, open road two cells wide at
#  each end, and vans whose drives the world answers. This document is the first slice of it, one van:
#  its drive is a command to the van itself, the simulator has the van on the cell forty-five seconds on,
#  the van's position fix reports the cell, and the courier's transition concludes where the van is. The
#  second van, the contact that sees it and the two minds come with #1003 and #1004.
#
#  THE GRID: columns 0 and 1 and columns 5 and 6 are open road, three rows deep; columns 2 to 4 are the
#  lane, row 1 alone, and (3, 2) is the passing place. A cell is its two coordinates, which is what the
#  van's fix reports and what the van is told: an instrument gives numbers, and the coordinates are the
#  courier's own (knowledge/domain/courier/position.md).
#
#  THE VAN: `van_a` stands at the western end with its driver aboard; its parcel waits a cell east and is
#  owed at the eastern end; a second courier, B, acts for van B on the eastern road, its parcel already where
#  it is owed, so it stands and watches (#1004; the passing is #923's). Each van carries a receiver standing
#  for the other and one radar slot standing for whatever else comes within two cells - the contact (#1003):
#  what is seen is believed at the cell its vector lands on, and nothing is believed of what is beyond. A
#  courier's parcels are its own beliefs (beliefs/<agent>.state.ttl), so each wants its own deliveries and
#  knows nothing of the other's. The agent plays the driver, a role carrying the van it drives, stated in this
#  document because a peer finds the agent to ask by it (#929, #1002); it acts for the van, reads its
#  position fix and commands it; the fix
#  reports every ten seconds and the van is on the cell it is told forty-five seconds on, inside the
#  drive's band of thirty to sixty. Where the van stands is never posed: its first fix says
#  (knowledge/domain/courier/position.md).

:courier_a a orexis:Agent ;
    orexis:localId "courier_a" ;
    orexis:actsFor :van_a ;
    orexis:plays :driver_a ;    # the role, stated here and not in its self graph, since a peer finds the agent by it
    rdfs:comment "The courier of van A: a mind with the courier's actions over one van, through the driver it plays." .

:driver_a a courier:Driver ; courier:drives :van_a ; rdfs:label "the driver of van A" .
:van_a a courier:Van ;
    sim:simulatedBy [ a sim:Model ; sim:delayS 45 ] ;    # told a cell, it is there forty-five seconds on
    rdfs:label "van A" .
:courier_b a orexis:Agent ;
    orexis:localId "courier_b" ;
    orexis:actsFor :van_b ;
    orexis:plays :driver_b ;
    rdfs:comment "The courier of van B: the same mind over the other van, with nothing left to deliver." .

:driver_b a courier:Driver ; courier:drives :van_b ; rdfs:label "the driver of van B" .
:van_b a courier:Van ;
    sim:simulatedBy [ a sim:Model ; sim:delayS 45 ] ;
    rdfs:label "van B" .

#  Each van's position fix, two sensors hosted by the van and played by the simulator, the column and the
#  row of the van's cell, exactly — a fix that reports the same cell twice is a van that has not moved, not
#  a stuck instrument, so its agent lets it repeat (beliefs/<agent>.self.ttl). Every sensor of the world
#  rides in the simulator's one message, each at a pointer under its van.
:fix_a_column a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 0 ; sim:jitter 0 ] ;    # van A column 0
    sosa:isHostedBy :van_a ;
    sosa:observes courier:Column ;
    sensing:readingPointer "/van_a/fix/x" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:fix_a_row a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 1 ; sim:jitter 0 ] ;    # van A row 1
    sosa:isHostedBy :van_a ;
    sosa:observes courier:Row ;
    sensing:readingPointer "/van_a/fix/y" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .

#  The contacts each van carries (knowledge/domain/courier/contact.md): a receiver standing for the other
#  van, as AIS demultiplexes by vessel, and one radar slot standing for nothing named, an obstacle while
#  something is in it. Each is two sensors, the contact's vector from the carrying van, seeing two cells;
#  the simulator plays them from the true positions.
:contact_b a sosa:Sample ; sosa:isSampleOf :van_b ; sosa:isHostedBy :van_a ; rdfs:label "van B as van A's receiver has it" .
:receiver_b_column a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ; sim:radius 2 ] ;
    sosa:isHostedBy :contact_b ;
    sosa:observes courier:RelativeColumn ;
    sensing:readingPointer "/van_a/van_b/x" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:receiver_b_row a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ] ;
    sosa:isHostedBy :contact_b ;
    sosa:observes courier:RelativeRow ;
    sensing:readingPointer "/van_a/van_b/y" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .

:contact_1 a sosa:Sample , courier:Obstacle ; sosa:isHostedBy :van_a ; rdfs:label "van A's one radar slot" .
:radar_1_column a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ; sim:radius 2 ] ;
    sosa:isHostedBy :contact_1 ;
    sosa:observes courier:RelativeColumn ;
    sensing:readingPointer "/van_a/contact_1/x" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:radar_1_row a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ] ;
    sosa:isHostedBy :contact_1 ;
    sosa:observes courier:RelativeRow ;
    sensing:readingPointer "/van_a/contact_1/y" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .

#  Van B's fix and contacts, the mirror of van A's.
:fix_b_column a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 6 ; sim:jitter 0 ] ;    # van B column 6
    sosa:isHostedBy :van_b ;
    sosa:observes courier:Column ;
    sensing:readingPointer "/van_b/fix/x" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:fix_b_row a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 0 ; sim:jitter 0 ] ;    # van B row 0
    sosa:isHostedBy :van_b ;
    sosa:observes courier:Row ;
    sensing:readingPointer "/van_b/fix/y" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:contact_a a sosa:Sample ; sosa:isSampleOf :van_a ; sosa:isHostedBy :van_b ; rdfs:label "van A as van B's receiver has it" .
:receiver_a_column a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ; sim:radius 2 ] ;
    sosa:isHostedBy :contact_a ;
    sosa:observes courier:RelativeColumn ;
    sensing:readingPointer "/van_b/van_a/x" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:receiver_a_row a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ] ;
    sosa:isHostedBy :contact_a ;
    sosa:observes courier:RelativeRow ;
    sensing:readingPointer "/van_b/van_a/y" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:contact_2 a sosa:Sample , courier:Obstacle ; sosa:isHostedBy :van_b ; rdfs:label "van B's one radar slot" .
:radar_2_column a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ; sim:radius 2 ] ;
    sosa:isHostedBy :contact_2 ;
    sosa:observes courier:RelativeColumn ;
    sensing:readingPointer "/van_b/contact_2/x" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .
:radar_2_row a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:jitter 0 ] ;
    sosa:isHostedBy :contact_2 ;
    sosa:observes courier:RelativeRow ;
    sensing:readingPointer "/van_b/contact_2/y" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:SEC ] ] .

#  Western road
:c0_0 a courier:Cell ; courier:x 0 ; courier:y 0 .
:c0_1 a courier:Cell ; courier:x 0 ; courier:y 1 .
:c0_2 a courier:Cell ; courier:x 0 ; courier:y 2 .
:c1_0 a courier:Cell ; courier:x 1 ; courier:y 0 .
:c1_1 a courier:Cell ; courier:x 1 ; courier:y 1 .
:c1_2 a courier:Cell ; courier:x 1 ; courier:y 2 .
#  The lane, and its passing place
:c2_1 a courier:Cell ; courier:x 2 ; courier:y 1 .
:c3_1 a courier:Cell ; courier:x 3 ; courier:y 1 .
:c3_2 a courier:Cell ; courier:x 3 ; courier:y 2 .
:c4_1 a courier:Cell ; courier:x 4 ; courier:y 1 .
#  Eastern road
:c5_0 a courier:Cell ; courier:x 5 ; courier:y 0 .
:c5_1 a courier:Cell ; courier:x 5 ; courier:y 1 .
:c5_2 a courier:Cell ; courier:x 5 ; courier:y 2 .
:c6_0 a courier:Cell ; courier:x 6 ; courier:y 0 .
:c6_1 a courier:Cell ; courier:x 6 ; courier:y 1 .
:c6_2 a courier:Cell ; courier:x 6 ; courier:y 2 .
