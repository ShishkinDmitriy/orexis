# How THIS world is deployed here. Installation facts, scoped to one world — not beliefs, and
# not part of the world's model: no agent holds an opinion about whether a pump is wired.
#
# Gitignored, like any .env. `.env.example` beside it is the template.

# true = this world's supplier may open real valves; false = decide and log, water nothing.
AGORA_ACTUATE=false

# Which of THIS world's subjects are simulated. Empty means every one of them — including any
# a real board already publishes for, and two publishers on one topic both ingest. List only
# the virtual ones when hardware is connected.
AGORA_SIM_PLANTS=tomato,succulent

# seconds per soil tick, for the simulated ones
AGORA_SIM_TICK_S=2
