@prefix : <http://example.org/agora/world/sensing#> .
@prefix sensing: <http://example.org/agora/sensing#> .
@prefix mqtt: <http://example.org/agora/mqtt#> .
@prefix ag:   <http://example.org/agora#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dht11: <http://example.org/agora/dht11#> .
@prefix onewire: <http://example.org/agora/onewire#> .
@prefix probe: <http://example.org/agora/moisture-probe#> .
@prefix rgbled: <http://example.org/agora/rgb-led#> .
@prefix mc: <http://example.org/agora/microcontroller#> .
@prefix governed: <http://example.org/agora/firmware/moisture-sensor#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix water: <http://example.org/agora/water#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix esp32: <http://example.org/agora/esp32#> .
@prefix wokwi: <http://example.org/agora/wokwi#> .

# The hardware this world runs on: what is physically here and how it is wired.
#
# Separate from the society beside it because they change for different reasons and are read by
# different people. A plant is added by editing the society; a probe is moved to another pin by
# editing this. Both are loaded into the one world graph, so every query sees them together —
# `ag:moisture_sensor_fern` is declared in world.ttl as a sensor and given its wiring here,
# rather than being described twice.
#
# What this is FOR, beyond documentation: the shapes in kernel/shapes.ttl hold it to the
# ESP32's actual rules, so `agora-validate` refuses a pin that cannot work before anything is
# soldered or flashed.

##########  What runs the society  ##########

:raspberry a ag:ComputeHost ;
    ag:localId "raspberry" ;
    mc:model "Raspberry Pi 5" ;
    # A NAME, because the address was a fact with an expiry date and it expired three times.
    # .126, then .130, then .133 — and the third cost a day: the board went on opening TCP to
    # .130, failed with a bare "connection failed", and the broker logged nothing at all because
    # nothing arrived. Every other participant was unaffected, since agents reach the broker on
    # loopback via mqtt:brokerHost and only a board off-host uses this.
    #
    # Answered by the avahi already running on this Pi, and resolvable from the board because
    # ESP32's lwIP is built with CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES. `raspberry.speedport.ip`
    # is the same machine over the router's own DNS and is the fallback if multicast is blocked.
    #
    # A DHCP reservation is still worth having. It makes the lease stop moving; this makes the
    # world stop caring whether it does.
    ag:lanHost "raspberry.local" ;
    rdfs:comment "Runs the agent containers, the broker for this world, and the shared store." .

:fern_agent ag:runsOn :raspberry .

##########  The board at the edge  ##########

# BOTH, spelled out rather than inferred. esp32:DevKitC is rdfs:subClassOf
# mc:Microcontroller and RDFS would derive the second from the first — but the
# shapes run with inference and the runtime does not (issue #27), so a query for
# a Microcontroller found nothing and the firmware generator reported that this
# world states no boards at all. Third time that gap has cost something.
:esp32_fern a mc:Microcontroller , esp32:DevKitC ;
    ag:localId "esp32_fern" ;
    mc:model "ESP32-WROOM-32D" ;
    mqtt:onBus :local_bus ;
    #  No mc:firmware stated since #175: the board's connecting DEVICE is typed governed:Node
    #  in world.ttl — the two nodes are one physical board wearing two roles (#81) — and the
    #  firmware name is entailed onto the device from its class. The generator reads it
    #  through the hosting this board's deployment already produces. NOT typed here too: the
    #  class entails a senseMode, and a mode on the bare microcontroller node would demand a
    #  command channel that belongs to the device role, not this one.
    ssn:inDeployment :fern_windowsill_deployment ;
    rdfs:comment "Deep-sleeps between readings, which is why its agent is sensing:Subscribing: the board keeps the interval and cannot be reached in between." .

#  The deployment this hosting is PRODUCED by (#99). `sosa:hosts` used to be asserted here — a
#  conclusion whose premise was nowhere in the graph, since SSN entails hosting from exactly
#  this: which systems, on which platform, from when, for what. The closure now entails the
#  hosts, so rewiring means editing THIS block and the hosting follows; the society's copy in
#  world.ttl stays asserted for its own audience, held to agreeing by test_layout as ever.
#
#  What a deployment carries that a wiring could not: the DATE this board went to this window
#  (a board that used to be somewhere else is a different fact from one that was always here),
#  and the PURPOSE — which is also where a powering condition belongs the day #59's
#  conditioned capabilities need resolving: "on battery" is a fact about this deployment, not
#  about any part's datasheet.
:fern_windowsill_deployment a ssn:Deployment ;
    ssn:deployedOnPlatform :esp32_fern ;
    ssn:deployedSystem :moisture_sensor_fern , :status_led_fern , :air_sensor_fern ;
    prov:startedAtTime "2026-08-05T17:00:00Z"^^xsd:dateTime ;
    #  What this SITE does to an instrument (#111): the ambient envelope a deployment commits
    #  its systems to witnessing, in the same Condition idiom the plants and the parts already
    #  speak. A Berlin windowsill, indoors: mild and heated. The shape holds every deployed
    #  sensor's stated MeasurementRange to CONTAIN this envelope — which is exactly the check
    #  the terrace question exposed as missing: a DHT11 (0..50 °C, 20..90 %RH) passes here and
    #  would refuse an outdoor envelope, from its own datasheet figures, at agora-validate
    #  time instead of at the first frost.
    ssn-system:inCondition
        [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty water:AirTemperature ;
          schema:minValue 15.0 ; schema:maxValue 32.0 ; schema:unitCode unit:DEG_C ] ,
        [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty water:AirHumidity ;
          schema:minValue 25 ; schema:maxValue 70 ; schema:unitCode unit:PERCENT ] ;
    rdfs:comment "The windowsill bench: one fern, watched where it lives, on battery." .

##########  The board's own legs  ##########
#
# Stated, because the other end of every wire is one of them. A GPIO line carries its number and
# no role — it is general purpose until something is wired to it. A rail carries its voltage,
# which is what makes the 3V3-versus-VIN choice checkable rather than a warning in a comment.
#
# TWO naming systems, and neither derives from the other, so both are said.
#
#   skos:notation  what is PRINTED beside the leg. For a person with a jumper in their hand.
#   wokwi:name     what the SIMULATOR calls it. For a generated diagram.json.
#
# They disagree more often than not. Wokwi names a general-purpose leg by its bare number where
# the board prints D34; it calls the three ground legs GND.1/.2/.3 where the board prints GND on
# all three, so the silkscreen does not even identify a pin uniquely. They agree on 3V3, which
# is exactly how this went unnoticed — that was the one wire that drew.
#
# Both stated rather than one computed from the other. `wokwi:name "34"` could be derived from
# `mc:gpio 34` today and would be a rule about Wokwi's conventions hidden in Python, wrong the
# day they name something differently, and unfindable from the graph. When issue #55 lands these
# move to the board-model classes and are said once for the family instead of once per board.

:esp32_fern mc:hasPin :pin_gpio25 , :pin_gpio26 , :pin_gpio27 ,
                        :pin_gpio32 , :pin_gpio34 , :pin_3v3 , :pin_gnd ;
    mc:logicVolts 3.3 .

:pin_gpio25 a mc:Pin ; mc:gpio 25 ; skos:notation "D25" ; wokwi:name "25" .
:pin_gpio26 a mc:Pin ; mc:gpio 26 ; skos:notation "D26" ; wokwi:name "26" .
:pin_gpio27 a mc:Pin ; mc:gpio 27 ; skos:notation "D27" ; wokwi:name "27" .
:pin_gpio32 a mc:Pin ; mc:gpio 32 ; skos:notation "D32" ; wokwi:name "32" .
:pin_gpio34 a mc:Pin ; mc:gpio 34 ; skos:notation "D34" ; wokwi:name "34" .
:pin_3v3    a mc:Pin ; mc:pinRole mc:PowerPinRole ; mc:railVolts 3.3 ;
                         skos:notation "3V3" ; wokwi:name "3V3" .
# Three legs on this board are printed GND, so the silkscreen does not identify one of them.
# Wokwi disambiguates where the board does not, which is what wokwi:name is for. Everything
# here grounds to the same rail, so which of the three is arbitrary — but it has to be SAID.
:pin_gnd    a mc:Pin ; mc:pinRole mc:GroundPinRole ; skos:notation "GND" ;
                         wokwi:name "GND.1" .

##########  What is wired to it  ##########

# Declared as a sensor in world.ttl; this says what KIND of instrument it is, what legs it has,
# and what its numbers mean. GPIO 34 is deliberate and should not be moved casually: it is ADC1,
# the only ADC that keeps working while WiFi is up.
:moisture_sensor_fern a probe:CapacitiveMoistureProbe ;
    mc:model "Capacitive Soil Moisture Sensor v2.0" ;
    mc:hasPin :probe_out , :probe_vcc , :probe_gnd ;
    # Measured on this probe, in this pot. Carried here rather than in the firmware because it
    # is per-instance and re-measured over time; changing it must not need a screwdriver.
    probe:rawDry 3200 ;
    probe:rawWet 1300 .

:probe_out a mc:Pin ; mc:pinRole mc:AnalogInPinRole .
:probe_vcc a mc:Pin ; mc:pinRole mc:PowerPinRole .
:probe_gnd a mc:Pin ; mc:pinRole mc:GroundPinRole .

# This board has no user LED of its own, so an external one says what the agent makes of the pot.
# 25/26/27 are safe outputs — no strapping duty at boot, and their ADC2 membership costs nothing
# to a driven line. It is lit only while the board is awake and dark through every sleep.
:status_led_fern a rgbled:RgbLed ;
    ag:localId "status_led_fern" ;
    mc:model "KY-016 4-pin RGB LED (common cathode)" ;
    mc:hasPin :led_r , :led_g , :led_b , :led_common .

:led_r      a mc:Pin ; mc:pinRole rgbled:RedPinRole .
:led_g      a mc:Pin ; mc:pinRole rgbled:GreenPinRole .
:led_b      a mc:Pin ; mc:pinRole rgbled:BluePinRole .
# Common CATHODE, so the return goes to ground. A common anode would go to the 3V3 rail instead,
# and every colour would come out as its complement — which used to be a comment telling you to
# check before soldering. It is a wire now, and a wire is a thing a checker can read.
:led_common a mc:Pin ; mc:pinRole rgbled:CommonPinRole .

# Wired and stated, NOT yet polled — see issue #51. Its data leg is on 32 rather than 34 or 35
# and the difference is not cosmetic: a one-wire line is DRIVEN, and 34-39 cannot drive.
:air_sensor_fern a dht11:Dht11 ;
    ag:localId "air_sensor_fern" ;
    mc:model "KY-015 (DHT11)" ;
    mc:hasPin :air_data , :air_vcc , :air_gnd .

:air_data a mc:Pin ; mc:pinRole onewire:DataPinRole .
:air_vcc  a mc:Pin ; mc:pinRole mc:PowerPinRole .
:air_gnd  a mc:Pin ; mc:pinRole mc:GroundPinRole .

# WHICH HALF each of the society's two air sensors is. The society already declares them and
# says what they observe and where they publish; what it cannot say is that this one is the
# thermistor, because that is a fact about the part and the society is never given the part.
#
# Stating it here is what makes the vocabulary's description of a DHT11 reach these two devices:
# `dht11:TemperatureSensor` carries the accuracy, the resolution and the procedure it
# implements, and rule 5 lands them on `ag:air_temp_fern` without any of it being written twice.
# The type is the only new fact — everything that follows from it is already in the package.
:air_temp_fern     a dht11:TemperatureSensor .
:air_humidity_fern a dht11:HumiditySensor .

##########  The wires  ##########
#
# What someone can point at on the breadboard, and what they get wrong. Every rule about this
# board is asked of these: the role lives on the peripheral's leg and the line number on the
# board's, and neither end knows the other until a wire joins them.
#
# The 3V3 rail rather than VIN for both powered parts. VIN is 5V, and a KY-015's pull-up idles
# its data line at whatever it is powered from — 5V into a 3.3V input that is not 5V tolerant.
# That is now a refusable statement rather than a paragraph hoping to be read.

# Named rather than blank, because a wire is the thing you point at when something is wrong,
# and you cannot point at a blank node. The colour is the one on the actual jumper: it is a
# fact about this bench and nothing electrical depends on it, which is exactly why it is worth
# writing down — it is how you find the right wire among nine without tracing each to its end.
:w_probe_sig a mc:Wire ; mc:joins :probe_out , :pin_gpio34 ; mc:colour "green" .
:w_probe_pwr a mc:Wire ; mc:joins :probe_vcc , :pin_3v3    ; mc:colour "red" .
:w_probe_gnd a mc:Wire ; mc:joins :probe_gnd , :pin_gnd    ; mc:colour "black" .

# The LED's three channels take their own colours, which is the case where this earns itself:
# on the breadboard they are otherwise three identical jumpers into three adjacent pins.
:w_led_r   a mc:Wire ; mc:joins :led_r      , :pin_gpio25 ; mc:colour "red" .
:w_led_g   a mc:Wire ; mc:joins :led_g      , :pin_gpio26 ; mc:colour "green" .
:w_led_b   a mc:Wire ; mc:joins :led_b      , :pin_gpio27 ; mc:colour "blue" .
:w_led_com a mc:Wire ; mc:joins :led_common , :pin_gnd    ; mc:colour "black" .

:w_air_data a mc:Wire ; mc:joins :air_data , :pin_gpio32 ; mc:colour "yellow" .
:w_air_pwr  a mc:Wire ; mc:joins :air_vcc  , :pin_3v3    ; mc:colour "red" .
:w_air_gnd  a mc:Wire ; mc:joins :air_gnd  , :pin_gnd    ; mc:colour "black" .
