@prefix : <http://example.org/orexis/world/sensing#> .
@prefix onboarding: <http://example.org/orexis/onboarding#> .
@prefix schema: <https://schema.org/> .

<> a onboarding:DeploymentGraph .    # this document is one graph, and this is what it is

#  WHERE THE SENSING WORLD'S BROKER LISTENS: the world's own, on ports no other world's broker
#  uses. Onboarding reads this to run the broker, to tell the agent through its environment and
#  to flash the board's port into its config.h; the kind is onboarding's, so an agent's boot
#  passes over it and no container is handed it.
:broker schema:url "mqtt://localhost:1884" , "mqtts://localhost:8884" .
