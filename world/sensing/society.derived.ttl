#  GENERATED by `orexis-onboard` from this world's own documents — do not edit. The filter each topic is
#  named by, where the society states none: by the rule in onboarding/requirements.ttl, one convention
#  for every world — sensors/<client>/reading for what a board publishes, sensors/<client>/command for
#  what it listens to, actuators/<device>/command, agents/<agent>/inbox, people/<person>/inbox. A filter
#  the society asserts itself is kept, and wins (knowledge/domain/onboarding/requirement.md).

@prefix : <http://example.org/orexis/world/sensing#> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix orexis: <http://example.org/orexis#> .

<> a orexis:SocietyGraph .    # this document is one graph, and this is what it is

:fern_commands_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "sensors/moisture_sensor_fern/command" ;
    mqtt4ssn:matchesTopic :fern_commands .
:fern_readings_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "sensors/moisture_sensor_fern/reading" ;
    mqtt4ssn:matchesTopic :fern_readings .
