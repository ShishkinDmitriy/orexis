@prefix : <http://example.org/orexis/world/terrace#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix prediction: <http://example.org/orexis/prediction#> .
@prefix speech: <http://example.org/orexis/speech#> .
@prefix account: <http://example.org/orexis/account#> .

<> a orexis:SelfGraph .    # this document is one graph, and this is what it is

#  WHO THIS AGENT IS: the agent acting for the terrace bed, and this document is its own by the self
#  it states. Booted as "terrace", the agent checks that this is so.
#
#  WHAT IT RUNS: it observes the bed's probe and the forecast and foresees them, and wants nothing,
#  so it is no planner and no executor; an observer is a deliberator too, so what its percepts are of is concluded.
#  It is in a chat with its sovereign (speech.ttl), so it is a speaker, listening on its inbox, and a reporter,
#  giving an account of itself on its account topic every time what it observes changes.

:terrace_agent a orexis:Self ;
    orexis:plays [ a sensing:Observer ;
                   sensing:sensor :air_humidity_terrace ,
                                  :air_pressure_terrace ,
                                  :air_temp_terrace ,
                                  :battery_sensor_terrace ,
                                  :forecast_terrace ,
                                  :moisture_sensor_terrace ] ,
                 [ a prediction:Predictor ] ,
                 [ a speech:Speaker ] ,
                 [ a account:Reporter ] .
