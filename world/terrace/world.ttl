@prefix : <http://example.org/orexis/world/terrace#> .
@prefix climate: <http://example.org/orexis/climate#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/climate/ontology.ttl> .

#  THE TERRACE, on Agent 0.2.0. "1 esp32, 1 moisture sensor, 1 bme. For now just monitoring. All
#  outside." One bed, one board, one agent, and nothing to pursue: the agent holds no desire, so it
#  watches — every reading written, its side concluded, what comes next predicted — and never acts.
#
#  The board is a SENTINEL (firmware/outdoor-sentinel): it takes no orders, its ULP watches the
#  soil for movement while everything sleeps, and a heartbeat every twenty minutes keeps silence
#  distinguishable from death. It publishes ONE document with four values on one topic, and each
#  sensor reads its own by pointer; nothing here changed on the wire, so the flashed board goes on
#  as it is.
#
#  This graph is the bed and the sensors. The agent, the board as a client and its topic are
#  society.ttl; where the broker listens is deployment.ttl; the parts' pins and calibration are
#  hardware.ttl.

:terrace_bed a sosa:FeatureOfInterest ;
    orexis:localId "terrace_bed" ;
    rdfs:comment "The planter bed on the terrace, outdoors. Watched, not yet cared for." ;
    ssn-system:hasOperatingRange :terrace_bed_operating .
:terrace_bed_operating a ssn-system:OperatingRange ;
    ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:SoilMoisture ;
                             schema:minValue 0.25 ; schema:maxValue 0.60 ; schema:unitCode unit:UNITLESS ] .

#  THE FOUR VALUES of one message, one sensor each, every one reporting at the board's heartbeat.
:moisture_sensor_terrace a sosa:Sensor ;
    orexis:localId "moisture_sensor_terrace" ;
    schema:unitCode unit:UNITLESS ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:SoilMoisture ;
    sensing:readingPointer "/moisture" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .

:air_sensor_terrace a ssn:System ;
    orexis:localId "air_sensor_terrace" ;
    ssn:hasSubSystem :air_temp_terrace , :air_humidity_terrace , :air_pressure_terrace ;
    rdfs:comment "One part reporting three properties; a single forced-mode conversion yields all its values together, which is why they share an instant." .

:air_temp_terrace a sosa:Sensor ;
    orexis:localId "air_temp_terrace" ;
    schema:unitCode unit:DEG_C ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:AirTemperature ;
    sensing:readingPointer "/temperature" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .

:air_humidity_terrace a sosa:Sensor ;
    orexis:localId "air_humidity_terrace" ;
    schema:unitCode unit:UNITLESS ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:AirHumidity ;
    sensing:readingPointer "/humidity" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .

:air_pressure_terrace a sosa:Sensor ;
    orexis:localId "air_pressure_terrace" ;
    schema:unitCode unit:HectoPA ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:AirPressure ;
    sensing:readingPointer "/pressure" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .
