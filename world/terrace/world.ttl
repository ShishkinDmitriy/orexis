@prefix : <http://example.org/orexis/world/terrace#> .
@prefix climate: <http://example.org/orexis/climate#> .
@prefix power: <http://example.org/orexis/power#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/climate/ontology.ttl> , <../../domains/power/ontology.ttl> .

#  THE TERRACE, on Agent 0.2.0. "1 esp32, 1 moisture sensor, 1 bme. For now just monitoring. All
#  outside." One bed, one board, one agent, and nothing to pursue: the agent holds no desire, so it
#  watches — every reading written, its side concluded, what comes next predicted — and never acts.
#
#  The board is a SENTINEL (firmware/outdoor-sentinel): it takes no orders, its ULP watches the
#  soil for movement while everything sleeps, and a heartbeat every twenty minutes keeps silence
#  distinguishable from death. It publishes ONE document on one topic — the probe's raw count, the
#  air's three values and the battery's voltage — and each sensor reads its own by pointer. The
#  probe's count becomes a moisture through the scaling stated below, so recalibrating is editing
#  two numbers here and restarting the agent, never fetching the board.
#
#  This graph is the bed and the sensors. The agent, the board as a client and its topic are
#  society.ttl; where the broker listens is deployment.ttl; the parts' pins and calibration are
#  hardware.ttl.

#  THE TERRACE ITSELF, the place a forecast's rain falls on, and the bed in it. How fast the bed
#  dries and how much a millimetre of rain wets it are guesses until they are fitted from the
#  history the agent already keeps; the rain drift reads a forecast hour for the terrace, and until
#  one arrives the bed only dries.
:terrace a schema:Place ;
    rdfs:comment "The terrace: outdoors, open to the rain. Where it is — its schema:geo — is in secrets/place.ttl, which is not committed." .

:terrace_bed a sosa:FeatureOfInterest ;
    orexis:localId "terrace_bed" ;
    rdfs:comment "The planter bed on the terrace, outdoors. Watched, not yet cared for." ;
    schema:containedInPlace :terrace ;
    climate:driesPerDay 0.04 ;
    climate:wetsPerMm 0.01 ;
    ssn-system:hasOperatingRange :terrace_bed_operating .
:terrace_bed_operating a ssn-system:OperatingRange ;
    ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:SoilMoisture ;
                             schema:minValue 0.25 ; schema:maxValue 0.60 ; schema:unitCode unit:UNITLESS ] .

#  THE FORECAST: a weather service's hourly rain on the terrace, a sensor that reads a SERIES — software,
#  which SOSA admits as a sensor. Each amount is what falls in the hour up to its time, so its instants
#  END their stretches. It is asked for hourly; where it is read is society.ttl, filled from the
#  terrace's location in secrets/place.ttl.
:forecast_terrace a sosa:Sensor ;
    orexis:localId "forecast_terrace" ;
    schema:unitCode unit:MilliM-PER-HR ;
    sosa:isHostedBy :terrace ;
    sosa:observes climate:Precipitation ;
    sensing:readingPointer "/hourly/precipitation" ;
    sensing:endsPointer "/hourly/time" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 60 ; schema:unitCode unit:MIN ] ] .

#  THE FIVE VALUES of one message, one sensor each, every one reporting at the board's heartbeat.
#  The probe publishes its raw ADC count, a moisture through :probe_scaling.
:moisture_sensor_terrace a sosa:Sensor ;
    orexis:localId "moisture_sensor_terrace" ;
    schema:unitCode unit:UNITLESS ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:SoilMoisture ;
    sensing:readingPointer "/moisture_raw" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .

#  THE PROBE'S SCALING, a rescale: its ADC count is a fraction of saturation on the line through what it
#  reads in dry air and in water. These are the counts the firmware shipped with, not yet measured on
#  this probe: read the count in the agent's log with the probe in air, then in water, and put them here
#  (knowledge/runbooks/calibrate-a-probe.md). The generator sizes the board's wake window from them too.
:probe_scaling a sensing:TwoPointScaling ;
    sensing:scales :moisture_sensor_terrace ;
    sensing:point [ rdfs:label "dry" ; sensing:reads 3200 ; sensing:standsFor 0.0 ] ,
                  [ rdfs:label "wet" ; sensing:reads 1300 ; sensing:standsFor 1.0 ] .

:air_sensor_terrace a ssn:System ;
    orexis:localId "air_sensor_terrace" ;
    ssn:hasSubSystem :air_temp_terrace , :air_humidity_terrace , :air_pressure_terrace ;
    rdfs:comment "One part reporting three properties; a single forced-mode conversion yields all its values together, which is why they share an instant." .

:air_temp_terrace a sosa:Sensor ;
    orexis:localId "air_temp_terrace" ;
    schema:unitCode unit:DEG_C ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:AirTemperature ;
    sensing:readingPointer "/temperature" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .

:air_humidity_terrace a sosa:Sensor ;
    orexis:localId "air_humidity_terrace" ;
    schema:unitCode unit:UNITLESS ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:AirHumidity ;
    sensing:readingPointer "/humidity" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .

:air_pressure_terrace a sosa:Sensor ;
    orexis:localId "air_pressure_terrace" ;
    schema:unitCode unit:HectoPA ;
    sosa:isHostedBy :terrace_bed ;
    sosa:observes climate:AirPressure ;
    sensing:readingPointer "/pressure" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .

#  THE BOARD'S BATTERY, a 1S LiPo on its JST port, read through the board's own divider on GPIO34 and
#  published in volts, the ESP32's factory ADC calibration applied. Low below 3.3 V, full at 4.2.
:terrace_battery a power:Battery ;
    orexis:localId "terrace_battery" ;
    rdfs:comment "The LiPo cell the terrace's board runs on." ;
    schema:containedInPlace :terrace ;
    ssn-system:hasOperatingRange :terrace_battery_operating .
:terrace_battery_operating a ssn-system:OperatingRange ;
    ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty power:BatteryVoltage ;
                             schema:minValue 3.3 ; schema:maxValue 4.2 ; schema:unitCode unit:V ] .

:battery_sensor_terrace a sosa:Sensor ;
    orexis:localId "battery_sensor_terrace" ;
    schema:unitCode unit:V ;
    sosa:isHostedBy :terrace_battery ;
    sosa:observes power:BatteryVoltage ;
    sensing:readingPointer "/battery" ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 20 ; schema:unitCode unit:MIN ] ] .
