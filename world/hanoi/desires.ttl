@prefix : <http://example.org/orexis/world/hanoi#> .
@prefix hanoi: <http://example.org/orexis/hanoi#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:DesireGraph .    # this document is one graph, and this is what it is

#  THE GOAL, as a desire the derivation mints one want from: every disk home on peg C. What that
#  means and how far it is are the domain's (`domains/hanoi/shapes.ttl`), which the desire points
#  at; the want this becomes is one-shot, and once the tower stands the runtime stops.

:hanoi orexis:holds :every_disk_home .

:every_disk_home a orexis:Desire ;
    rdfs:label "every disk home on peg C" ;
    orexis:metWhen hanoi:solved ;
    orexis:estimates hanoi:disksAstray .
