@prefix : <http://example.org/orexis/world/hanoi#> .
@prefix hanoi: <http://example.org/orexis/hanoi#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:WorldGraph .    # this document is one graph, and this is what it is

#  One agent, three disks. The mover acts for nothing, senses nothing and owes nobody — a pure
#  mind with one move, which is what makes this world a test of the search and of nothing else.
#  The pegs are the puzzle's, in ontology.ttl; where the disks rest is posed in state.ttl.

:hanoi a orexis:Agent ;
    orexis:localId "hanoi" ;
    rdfs:comment "The mover." .

:disk_1 a hanoi:Disk ; hanoi:size 1 ; rdfs:label "the small disk" .
:disk_2 a hanoi:Disk ; hanoi:size 2 ; rdfs:label "the middle disk" .
:disk_3 a hanoi:Disk ; hanoi:size 3 ; rdfs:label "the large disk" .
