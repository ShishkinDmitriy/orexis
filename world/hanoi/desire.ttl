@prefix : <http://example.org/orexis/world/hanoi#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix hanoi: <http://example.org/orexis/hanoi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#  The goal, ratified as a DESIRE — the asserted block, the door built for exactly this.
#  A want met by absence: unmet while any disk rests off peg C, by the pattern the hanoi
#  package declares (`hanoi:diskAstray`), and approached by its count of disks astray
#  (`hanoi:disksAstray`). The world says what it wants; the package says what that means and
#  how far it is. Scope is orexis:AtEnd — the first honest writer of the achievement scope:
#  nothing erodes while the puzzle sits, the plan's end is the whole of what is asked. Binary
#  urgency, judged by the kernel from the pattern; the optimal solution is the cheapest
#  achiever, by no code of this world's.
GRAPH <http://example.org/orexis/graph/desire/asserted> {
  :hanoi orexis:holds :every_disk_home .
  :every_disk_home a orexis:Desire ;
      orexis:bindsWhen orexis:AtEnd ;
      rdfs:label "every disk home on peg C — the sentence the puzzle is" ;
      orexis:unmetWhen hanoi:diskAstray ;
      orexis:estimates hanoi:disksAstray .
}
