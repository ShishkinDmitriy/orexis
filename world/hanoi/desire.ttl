#  The goal, ratified as a DESIRE — the asserted block, the door built for exactly this.
#  A want met by absence: unmet while any disk rests off peg C. Scope is orexis:AtEnd — the
#  first honest writer of the achievement scope: nothing erodes while the puzzle sits, the
#  plan's end is the whole of what is asked. Binary urgency, judged by the kernel from the
#  pattern below; the optimal solution is the cheapest achiever, by no code of this world's.
GRAPH <http://example.org/orexis/graph/desire/asserted> {
  <http://example.org/orexis/world/hanoi#hanoi> <http://example.org/orexis#holds> <http://example.org/orexis/world/hanoi#every_disk_home> .
  <http://example.org/orexis/world/hanoi#every_disk_home> a <http://example.org/orexis#Desire> ;
      <http://example.org/orexis#bindsWhen> <http://example.org/orexis#AtEnd> ;
      <http://www.w3.org/2000/01/rdf-schema#label>
          "every disk home on peg C — the sentence the puzzle is" ;
      <http://example.org/orexis#unmetWhen> <http://example.org/orexis/world/hanoi#a_disk_astray> .
  <http://example.org/orexis/world/hanoi#a_disk_astray> <http://www.w3.org/ns/shacl#select>
      """SELECT (1 AS ?astray) WHERE {
          GRAPH $state { ?d <http://example.org/orexis/hanoi#on> ?rest . ?d (<http://example.org/orexis/hanoi#on>)+ ?p }
          ?p a <http://example.org/orexis/hanoi#Peg> .
          FILTER(?p != <http://example.org/orexis/hanoi#PegC>)
      }""" ;
      <http://www.w3.org/2000/01/rdf-schema#comment>
          "rows while any disk's chain bottoms out on a peg that is not C" .
}
