@prefix : <http://example.org/orexis/world/driver#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/courier/ontology.ttl> ,    # the domain this world poses
                <../../domains/courier/actions.ttl> ,      # with its drives fictive: nothing here answers a van (#1002)
                <../../domains/courier/driver.ttl> .      # and the boarding, since this world has a driver

#  THE DRIVER (#903): the dispatcher's two vans and two parcels, and ONE DRIVER the agent has,
#  who sits in a van, drives it, and must board the other before it can move. The dispatcher is a
#  child with two hands and two toy cars, moving both vans at once if it likes; here "one van at a
#  time" is a fact about the world — where the driver is — and every plan respects it by
#  construction: a drive moves only the van its driver is aboard (`domains/courier/actions.ttl`),
#  and a boarding moves the driver from one van to the other (`domains/courier/driver.ttl`).
#
#  THE TWO VANS STAND ON TWO GRIDS a continent apart: the first is the courier's 4x4, the second a
#  4x4 at x 10 to 13, and no cell of one is a neighbour of any cell of the other, so no drive crosses
#  and no cell can ever hold both vans. The only thing the two deliveries share is the driver, and
#  the driver is what makes them one plan: drive one van, board the other, drive it
#  (`constraints.ttl` says how the derivation is told so).

#  WHOSE THE DRIVER IS: a ROLE the dispatcher plays, `orexis:plays` (#929, #1002), stated here in the world
#  and not in the self graph, since it is what admits a drive or a boarding in the dispatcher's search and
#  what a peer would find it by; it loads nothing. The role carries the vans it drives. Without it the
#  driver is nobody's, and nothing here moves.

:dispatcher a orexis:Agent ;
    orexis:localId "dispatcher" ;
    orexis:plays :driver ;
    rdfs:comment "The dispatcher: a mind with the courier's actions and one driver to act through, acting for no subject and owing nobody." .

:driver a courier:Driver ; courier:drives :van_a , :van_b ; rdfs:label "the driver" .

:van_a a courier:Van ; rdfs:label "van A, at the western columns" .
:van_b a courier:Van ; rdfs:label "van B, ten columns east" .

:parcel_a a courier:Parcel ; courier:destination :top_of_the_first_column ;
    rdfs:label "the parcel owed at the top of the first column" .
:top_of_the_first_column courier:x 0 ; courier:y 3 ; rdfs:label "where parcel A is owed" .
:parcel_b a courier:Parcel ; courier:destination :top_of_the_tenth_column ;
    rdfs:label "the parcel owed at the top of the tenth column, ten cells east" .
:top_of_the_tenth_column courier:x 10 ; courier:y 3 ; rdfs:label "where parcel B is owed" .

#  THE FIRST GRID

#  THE SECOND GRID, seven columns east of the first
