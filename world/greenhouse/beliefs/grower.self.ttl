@prefix : <http://example.org/orexis/world/greenhouse#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix journal: <http://example.org/orexis/journal#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix prediction: <http://example.org/orexis/prediction#> .

<> a orexis:SelfGraph .    # this document is one graph, and this is what it is

#  WHO THIS AGENT IS: the grower, and this document is its own by the self it states. Booted as
#  "grower", the agent checks that this is so.
#
#  WHAT IT RUNS, in the packages' words, since no domain has one for a grower: it observes its bed's
#  sensors and foresees them, plans for the bed it wants comfortable and walks the plans through its
#  pump and heater. An observer is a deliberator too, so what its percepts are of is concluded.

:grower a orexis:Self ;
    orexis:plays [ a planning:Planner ] ,
                 [ a execution:Executor ] ,
                 [ a sensing:Observer ; sensing:sensor :moisture_probe , :thermometer ] ,
                 [ a prediction:Predictor ] .

#  IT KEEPS A JOURNAL of what happened to it, so it is a recorder (knowledge/domain/journal/recorder.md): the
#  history view and its own account of itself read what it kept. Without the role its packages say what happens
#  and nobody writes it down.
:grower orexis:plays [ a journal:Recorder ;
    journal:tracedBy :tracer ;
    journal:archivedIn :grower_archive ] .
