@prefix :            <http://example.org/orexis/world/greenhouse#> .
@prefix greenhouse:  <http://example.org/orexis/greenhouse#> .
@prefix sensing:     <http://example.org/orexis/sensing#> .
@prefix water:       <http://example.org/orexis/water#> .
@prefix actuation:   <http://example.org/orexis/actuation#> .
@prefix reporting:   <http://example.org/orexis/reporting#> .
@prefix progression: <http://example.org/orexis/progression#> .
@prefix deliberation: <http://example.org/orexis/deliberation#> .
@prefix ssn:         <http://www.w3.org/ns/ssn/> .
@prefix schema:      <https://schema.org/> .

#  The grower's PRIVATE beliefs. Two aims rather than one, because it steers two properties —
#  and an aim is what an ACTOR sizes an act against when it takes a step, never what the search
#  plans on (#579).
:grower
    sensing:fastSleepS 30 ;
    sensing:slowSleepS 600 ;
    sensing:readingGraceS 45 ;
    sensing:maxReadingAgeS 300 .

:grower sensing:aims [ ssn:forProperty water:SoilMoisture ; schema:value 0.45 ] ,
                     [ ssn:forProperty water:AirTemperature ; schema:value 21.0 ] .

:grower water:litresPerFraction 2.0 .
:grower progression:patienceS 600 .
:grower actuation:doseGraceS 10 .
:grower reporting:metricsIntervalS 60 .
#  A budget wider than a plant's: two halves are searched in one cone today, so the worlds a
#  pass forks is the product of what each half offers rather than the sum. That is the number
#  this world exists to measure.
:grower deliberation:budgetWorlds 128 .
