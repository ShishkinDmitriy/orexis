@prefix : <http://example.org/orexis/world/greenhouse#> .
@prefix climate: <http://example.org/orexis/climate#> .
@prefix actuation: <http://example.org/orexis/actuation#> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix sim: <http://example.org/orexis/sim#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/climate/ontology.ttl> , <../../domains/actuation/ontology.ttl> ,
                <../../domains/sim/ontology.ttl> .

#  ONE BED, TWO PROPERTIES, TWO DEVICES, ONE DESIRE.
#
#  The grower holds one desire — the bed is comfortable — about the soil AND the air, and no single
#  device serves it: the pump moves the first, the heater the second. The ranges are the bed's own
#  and NAMED, since a step's effect says which range a reading comes to be inside. The probe and
#  the thermometer publish on MQTT4SSN topics the grower subscribes to because it acts for the bed
#  they are hosted by; the pump and the heater listen on topics of their own for the command a
#  step is sized to when it is taken. The vent and the outdoor thermometer of the 0.1.0 world wait
#  until an agent can listen to a feature it does not act for.

#  THE BROKER, and where it listens: the world's own, on ports no other world's broker uses. The
#  operator's tools read these to run it and to tell each agent through its environment; an agent
#  never reads them off the world.
:broker a mqtt4ssn:Broker ;
    schema:url "mqtt://localhost:1889" , "mqtts://localhost:8889" .

#  THE BED'S BOARD: one client hosting the bed's four devices, as a real board hosts its
#  peripherals — and one connection for the simulator that plays them.
:bed_board a mqtt4ssn:Client ; mqtt4ssn:hasClientID "bed_board" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    mqtt4ssn:hosts :moisture_probe , :thermometer , :pump , :heater .

:grower a orexis:Agent , mqtt4ssn:Client ;
    orexis:localId "grower" ;
    mqtt4ssn:hasClientID "grower" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    orexis:actsFor :bed ;
    actuation:hasActuator :pump , :heater .

#  THE BED. The soil is comfortable between 0.30 and 0.60 and survives between 0.10 and 0.85; the
#  air is comfortable between 18 and 24 degrees and survives between 5 and 35.
:bed a sosa:FeatureOfInterest ;
    rdfs:label "the heated bed" ;
    climate:driesPerDay 0.04 ;
    climate:litresPerFraction 2.0 ;
    ssn-system:hasOperatingRange :bed_operating ;
    ssn-system:hasSurvivalRange :bed_survival .

:bed_operating a ssn-system:OperatingRange ;
    ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:SoilMoisture ;
                             schema:minValue 0.30 ; schema:maxValue 0.60 ; schema:unitCode unit:UNITLESS ] ,
                           [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:AirTemperature ;
                             schema:minValue 18.0 ; schema:maxValue 24.0 ; schema:unitCode unit:DEG_C ] .

:bed_survival a ssn-system:SurvivalRange ;
    ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:SoilMoisture ;
                             schema:minValue 0.10 ; schema:maxValue 0.85 ; schema:unitCode unit:UNITLESS ] ,
                           [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:AirTemperature ;
                             schema:minValue 5.0 ; schema:maxValue 35.0 ; schema:unitCode unit:DEG_C ] .

:water_butt a climate:WaterSource ; rdfs:label "the water butt" ; climate:capacityL 20.0 .

#  THE INSTRUMENTS, each reporting every ten minutes on a topic of its own.
#  None of the four exists: the simulator plays them, from where each reading starts.
:moisture_probe a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 0.40 ; sim:minValue 0.0 ; sim:maxValue 1.0 ] ;
    sosa:isHostedBy :bed ;
    sosa:observes climate:SoilMoisture ;
    mqtt4ssn:observesTopic :moisture_readings ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:MIN ] ] .
:moisture_readings a mqtt4ssn:Topic .
:moisture_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "sensors/moisture_probe/reading" ; mqtt4ssn:matchesTopic :moisture_readings .

:thermometer a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 21.0 ; sim:minValue -10.0 ; sim:maxValue 45.0 ] ;
    sosa:isHostedBy :bed ;
    sosa:observes climate:AirTemperature ;
    mqtt4ssn:observesTopic :thermometer_readings ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:MIN ] ] .
:thermometer_readings a mqtt4ssn:Topic .
:thermometer_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "sensors/thermometer/reading" ; mqtt4ssn:matchesTopic :thermometer_readings .

#  THE DEVICES. The pump pours ten millilitres a second and at most half a litre a command; the
#  heater warms the bed two degrees an hour and runs at most an hour a command.
:pump a actuation:Valve ;
    sim:simulatedBy [ a sim:Model ] ;
    rdfs:label "the pump" ;
    actuation:actuates :bed ;
    actuation:actuatesProperty climate:SoilMoisture ;
    actuation:drawsFrom :water_butt ;
    actuation:mlPerSecond 10.0 ;
    actuation:maxDoseMl 500.0 ;
    mqtt4ssn:listensToTopic :pump_commands .
:pump_commands a mqtt4ssn:Topic .
:pump_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "actuators/pump/command" ; mqtt4ssn:matchesTopic :pump_commands .

:heater a climate:Heater ;
    sim:simulatedBy [ a sim:Model ] ;
    rdfs:label "the heater" ;
    climate:warms :bed ;
    climate:warmsProperty climate:AirTemperature ;
    climate:degreesPerHour 2.0 ;
    climate:maxHeatS 3600.0 ;
    mqtt4ssn:listensToTopic :heater_commands .
:heater_commands a mqtt4ssn:Topic .
:heater_filter a mqtt4ssn:TopicFilter ;
    mqtt4ssn:hasFilterPattern "actuators/heater/command" ; mqtt4ssn:matchesTopic :heater_commands .
