@prefix : <http://example.org/orexis/world/greenhouse#> .
@prefix climate: <http://example.org/orexis/climate#> .
@prefix actuation: <http://example.org/orexis/actuation#> .
@prefix sim: <http://example.org/orexis/sim#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<> a orexis:WorldGraph ;    # this document is one graph, and this is what it is
    owl:imports <../../domains/climate/ontology.ttl> , <../../domains/actuation/ontology.ttl> ,
                <../../domains/sim/ontology.ttl> .

#  ONE BED, TWO PROPERTIES, TWO DEVICES, ONE DESIRE.
#
#  The grower holds one desire — the bed is comfortable — about the soil AND the air, and no single
#  device serves it: the pump moves the first, the heater the second. The ranges are the bed's own
#  and NAMED, since a step's effect says which range a reading comes to be inside. The vent and the
#  outdoor thermometer of the 0.1.0 world wait until an agent can listen to a feature it does not
#  act for.
#
#  This graph is the bed and its devices. Who acts for it and the topics its devices speak on are
#  society.ttl; where the broker listens is deployment.ttl.

#  THE BED. The soil is comfortable between 0.30 and 0.60 and survives between 0.10 and 0.85; the
#  air is comfortable between 18 and 24 degrees and survives between 5 and 35.
:bed a sosa:FeatureOfInterest ;
    rdfs:label "the heated bed" ;
    climate:driesPerDay 0.04 ;
    climate:litresPerFraction 2.0 ;
    ssn-system:hasOperatingRange :bed_operating ;
    ssn-system:hasSurvivalRange :bed_survival ;
    orexis:hasNarrowerRange :bed_narrower .

:bed_operating a ssn-system:OperatingRange ;
    ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:SoilMoisture ;
                             schema:minValue 0.30 ; schema:maxValue 0.60 ; schema:unitCode unit:UNITLESS ] ,
                           [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:AirTemperature ;
                             schema:minValue 18.0 ; schema:maxValue 24.0 ; schema:unitCode unit:DEG_C ] .

:bed_survival a ssn-system:SurvivalRange ;
    ssn-system:inCondition [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:SoilMoisture ;
                             schema:minValue 0.10 ; schema:maxValue 0.85 ; schema:unitCode unit:UNITLESS ] ,
                           [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:AirTemperature ;
                             schema:minValue 5.0 ; schema:maxValue 35.0 ; schema:unitCode unit:DEG_C ] .

#  THE NARROWER RANGE, inside the operating range by the whole spread of the reading's noise — twice
#  what an instrument strays either way, the most two readings of one value can differ by: the
#  probe's number strays a ten-thousandth (the simulator's count, stated by no `sim:jitter`), the
#  thermometer's a hundredth (its `sim:jitter`). A dry or cold bed is wanted from the operating range's
#  floor, as ever, and the want is reached only back in here, so a reading straying across a floor
#  on its noise mints one want and withdraws none (#944, knowledge/domain/kernel/narrower-range.md).
#  Both middles are the operating range's, where the dose and the heating aim.
:bed_narrower ssn-system:inCondition
        [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:SoilMoisture ;
          schema:minValue 0.3002 ; schema:maxValue 0.5998 ; schema:unitCode unit:UNITLESS ] ,
        [ a ssn-system:Condition , schema:PropertyValue ; ssn:forProperty climate:AirTemperature ;
          schema:minValue 18.02 ; schema:maxValue 23.98 ; schema:unitCode unit:DEG_C ] .

:water_butt a climate:WaterSource ; rdfs:label "the water butt" ; climate:capacityL 20.0 .

#  THE INSTRUMENTS, each reporting every ten minutes.
#  None of the four exists: the simulator plays them, from where each reading starts. The bed starts
#  comfortable and a quarter of a day from its floor, so a world brought up shows its loop — the
#  drying, the dose, the reading that answers it — in the first hours of its time and not its third day.
#  The thermometer's number strays a hundredth of a degree, a thermometer's count, since nobody heats
#  the air for hours at a time and a number that never moves is a stuck instrument to the grower
#  (#879); the probe strays by what the simulator publishes to, a ten-thousandth, which is a hundredth
#  of the gap between where it starts and the floor it dries to.
:moisture_probe a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 0.31 ; sim:minValue 0.0 ; sim:maxValue 1.0 ] ;
    sosa:isHostedBy :bed ;
    sosa:observes climate:SoilMoisture ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:MIN ] ] .

:thermometer a sosa:Sensor ;
    sim:simulatedBy [ a sim:Model ; sim:initialValue 21.0 ; sim:minValue -10.0 ; sim:maxValue 45.0 ; sim:jitter 0.01 ] ;
    sosa:isHostedBy :bed ;
    sosa:observes climate:AirTemperature ;
    ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty
        [ a ssn-system:Frequency , schema:PropertyValue ; schema:value 10 ; schema:unitCode unit:MIN ] ] .

#  THE DEVICES. The pump pours ten millilitres a second and at most half a litre a command; the
#  heater warms the bed two degrees an hour and runs at most an hour a command.
:pump a actuation:Valve ;
    sim:simulatedBy [ a sim:Model ] ;
    rdfs:label "the pump" ;
    actuation:actuates :bed ;
    actuation:actuatesProperty climate:SoilMoisture ;
    actuation:drawsFrom :water_butt ;
    actuation:mlPerSecond 10.0 ;
    actuation:maxDoseMl 500.0 .

:heater a climate:Heater ;
    sim:simulatedBy [ a sim:Model ] ;
    rdfs:label "the heater" ;
    climate:warms :bed ;
    climate:warmsProperty climate:AirTemperature ;
    climate:degreesPerHour 2.0 ;
    climate:maxHeatS 3600.0 .
