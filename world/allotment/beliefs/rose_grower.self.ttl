@prefix : <http://example.org/orexis/world/allotment#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix journal: <http://example.org/orexis/journal#> .
@prefix market: <http://example.org/orexis/market#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix prediction: <http://example.org/orexis/prediction#> .

<> a orexis:SelfGraph .    # this document is one graph, and this is what it is

#  WHO THIS AGENT IS: the rose grower, and this document is its own by the self it states. Booted
#  as "rose_grower", the agent checks that this is so; booted as any other, this is not its document.
#
#  WHAT IT RUNS: a bidder, in the market's word, and an observer of its plot's probe and a predictor
#  of its soil, in the packages' own, since no domain has a word for those.

:rose_grower a orexis:Self ;
    orexis:plays [ a market:Bidder ] ,
                 [ a sensing:Observer ; sensing:sensor :rose_probe ] ,
                 [ a prediction:Predictor ] .

#  IT KEEPS A JOURNAL of what happened to it, so it is a recorder (knowledge/domain/journal/recorder.md): the
#  history view and its own account of itself read what it kept. Without the role its packages say what happens
#  and nobody writes it down.
:rose_grower orexis:plays [ a journal:Recorder ] .
