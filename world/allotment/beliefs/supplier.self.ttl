@prefix actuation: <http://example.org/orexis/actuation#> .
@prefix speech: <http://example.org/orexis/speech#> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix : <http://example.org/orexis/world/allotment#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix journal: <http://example.org/orexis/journal#> .
@prefix market: <http://example.org/orexis/market#> .

<> a orexis:SelfGraph .    # this document is one graph, and this is what it is

#  WHO THIS AGENT IS: the supplier, and this document is its own by the self it states. Booted as
#  "supplier", the agent checks that this is so; booted as any other, this is not its document.
#
#  WHAT IT RUNS: the market's host, in the market's word — beneath the planner, the executor, the
#  speaker and the deliberator, which the boot loads for it. Its own word about itself, here and never
#  in the world's: a peer finds the host by `market:hosts`, which the society states, and learns
#  nothing of what the host runs.

:supplier a orexis:Self ;
    orexis:plays [ a market:Host ] .

#  IT KEEPS A JOURNAL of what happened to it, so it is a recorder (knowledge/domain/journal/recorder.md): the
#  history view and its own account of itself read what it kept. Without the role its packages say what happens
#  and nobody writes it down.
:supplier orexis:plays [ a journal:Recorder ;
    journal:archivedIn :supplier_archive ;
    journal:servedAt :supplier_endpoint ] .

#  WHAT ITS ROLES DEPEND ON, played beside them (`orexis:dependsOn`, knowledge/domain/kernel/role.md):
#  its host works only beside these, and each is a role of its own.
:supplier orexis:plays [ a planning:Planner ] ,
    [ a execution:Executor ] ,
    [ a speech:Speaker ] ,
    [ a belief:Deliberator ] .

#  IT OPERATES DEVICES, so it is an operator (knowledge/domain/actuation/operator.md): what a step it takes commands is
#  sent to the device through the transport. Without the role its steps would be taken and no device told.
:supplier orexis:plays [ a actuation:Operator ] .
