@prefix : <http://example.org/orexis/world/allotment#> .
@prefix orexis: <http://example.org/orexis#> .

<> a orexis:SelfGraph .    # this document is one graph, and this is what it is

#  WHO THIS AGENT IS: the supplier, and this document is its own by the self it states. Booted as
#  "supplier", the agent checks that this is so; booted as any other, this is not its document.

:supplier a orexis:Self .
