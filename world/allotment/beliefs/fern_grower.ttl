@prefix : <http://example.org/orexis/world/allotment#> .
@prefix climate: <http://example.org/orexis/climate#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix planning: <http://example.org/orexis/planning#> .

<> a planning:DesireGraph .    # this document is one graph, and this is what it is
<> orexis:beliefsOf :fern_grower .    # and whose it is — said here, never by the file's name

#  THE FERN GROWER'S ONE DESIRE: its plot's soil is not believed dry, in climate's words (#944). It
#  holds no valve, so what repairs a dry plot is a claim on the supplier's water, presented.

:fern_grower planning:holds :the_fern_is_watered .

:the_fern_is_watered a planning:Desire ;
    rdfs:label "the fern's soil is not believed dry" ;
    planning:metWhen :fern_watered .

:fern_watered a sh:NodeShape ;
    sh:targetNode :fern_grower ;
    sh:property [
        sh:path orexis:actsFor ;
        planning:about climate:SoilMoisture ;
        sh:qualifiedMaxCount 0 ;
        sh:qualifiedValueShape [ sh:property [ sh:path climate:soil ; sh:hasValue climate:Dry ] ] ;
        sh:message "the fern's soil is believed dry" ] .
