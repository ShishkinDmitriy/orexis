@prefix : <http://example.org/orexis/world/allotment#> .
@prefix climate: <http://example.org/orexis/climate#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix planning: <http://example.org/orexis/planning#> .

<> a planning:DesireGraph .    # this document is one graph, and this is what it is
<> orexis:beliefsOf :rose_grower .    # and whose it is — said here, never by the file's name

#  THE ROSE GROWER'S ONE DESIRE: its plot's soil is not read below the operating range the plot
#  states. It holds no valve, so what repairs a dry plot is a claim on the supplier's water, presented.
#  Two tests, one each way (#944): the met-test mints where a reading is below a range the plot has AS
#  ITS OPERATING RANGE, the path walking back from the range to whatever has it as one; the reaching
#  test is what a want minted here is reached by, no reading below ANY range the plot states, the
#  narrower one among them (world.ttl).

:rose_grower planning:holds :the_rose_is_watered .

:the_rose_is_watered a planning:Desire ;
    rdfs:label "the rose's soil is inside the ranges its plot states" ;
    planning:metWhen :rose_watered ;
    planning:reachedWhen :rose_watered_again .

:rose_watered a sh:NodeShape ;
    sh:targetNode :rose_grower ;
    sh:property [
        sh:path ( orexis:actsFor [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
        planning:about climate:SoilMoisture ;
        sh:qualifiedMaxCount 0 ;
        sh:qualifiedValueShape [
            sh:property [ sh:path sosa:observedProperty ; sh:hasValue climate:SoilMoisture ] ;
            sh:property [ sh:path ( sensing:below [ sh:inversePath ssn-system:hasOperatingRange ] ) ; sh:minCount 1 ] ] ;
        sh:message "the rose's soil is below its plot's operating range" ] .

:rose_watered_again a sh:NodeShape ;
    sh:targetNode :rose_grower ;
    sh:property [
        sh:path ( orexis:actsFor [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
        planning:about climate:SoilMoisture ;
        sh:qualifiedMaxCount 0 ;
        sh:qualifiedValueShape [
            sh:property [ sh:path sosa:observedProperty ; sh:hasValue climate:SoilMoisture ] ;
            sh:property [ sh:path sensing:below ; sh:minCount 1 ] ] ;
        sh:message "the rose's soil is below a range its plot states" ] .
