@prefix : <http://example.org/orexis/world/allotment#> .
@prefix climate: <http://example.org/orexis/climate#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:DesireGraph .    # this document is one graph, and this is what it is

#  THE ROSE GROWER'S ONE DESIRE: its plot's soil is not read below a range the plot states. It holds
#  no valve, so what repairs a dry plot is a claim on the supplier's water, presented.

:rose_grower orexis:holds :the_rose_is_watered .

:the_rose_is_watered a orexis:Desire ;
    rdfs:label "the rose's soil is inside the ranges its plot states" ;
    orexis:metWhen :rose_watered .

:rose_watered a sh:NodeShape ;
    sh:targetNode :rose_grower ;
    sh:property [
        sh:path ( orexis:actsFor [ sh:inversePath sosa:hasFeatureOfInterest ] ) ;
        orexis:violationIs orexis:Below ;
        orexis:about climate:SoilMoisture ;
        sh:qualifiedMaxCount 0 ;
        sh:qualifiedValueShape [
            sh:property [ sh:path sosa:observedProperty ; sh:hasValue climate:SoilMoisture ] ;
            sh:property [ sh:path sensing:below ; sh:minCount 1 ] ] ;
        sh:message "the rose's soil is below a range its plot states" ] .
