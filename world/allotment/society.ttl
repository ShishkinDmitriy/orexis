@prefix : <http://example.org/orexis/world/allotment#> .
@prefix actuation: <http://example.org/orexis/actuation#> .
@prefix market: <http://example.org/orexis/market#> .
@prefix mqtt4ssn: <https://www.w3id.org/MQTT4SSN-Ontology#> .
@prefix orexis: <http://example.org/orexis#> .

<> a orexis:SocietyGraph .    # this document is one graph, and this is what it is

#  THE ALLOTMENT'S SOCIETY: who its principals are and how they reach one another. Three agents and
#  one board, each a client of the world's one broker, and the topics each listens or publishes on.
#  A topic is named by a filter no society states: `orexis-onboard` derives each by one convention
#  into society.derived.ttl, beside this file (onboarding/requirements.ttl). The broker is here as
#  what the clients are connected to; where it listens is deployment.ttl's, which onboarding reads
#  and no agent does.

:broker a mqtt4ssn:Broker .

#  THE AGENTS, each a client of the broker listening on a topic of its own for what its peers say.
:supplier a orexis:Agent , mqtt4ssn:Client ;
    orexis:localId "supplier" ;
    mqtt4ssn:hasClientID "supplier" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    market:hosts :water ;
    actuation:hasActuator :rose_valve , :fern_valve ;
    mqtt4ssn:listensToTopic :supplier_inbox .
:supplier_inbox a mqtt4ssn:Topic .

:rose_grower a orexis:Agent , mqtt4ssn:Client ;
    orexis:localId "rose_grower" ;
    mqtt4ssn:hasClientID "rose_grower" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    orexis:actsFor :rose_plot ;
    market:bidsIn :water ;
    market:valuePerL 3.0 ;
    mqtt4ssn:listensToTopic :rose_grower_inbox .
:rose_grower_inbox a mqtt4ssn:Topic .

:fern_grower a orexis:Agent , mqtt4ssn:Client ;
    orexis:localId "fern_grower" ;
    mqtt4ssn:hasClientID "fern_grower" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    orexis:actsFor :fern_plot ;
    market:bidsIn :water ;
    market:valuePerL 2.0 ;
    mqtt4ssn:listensToTopic :fern_grower_inbox .
:fern_grower_inbox a mqtt4ssn:Topic .

#  THE BOARD IN THE BEDS: one client hosting both probes and both valves, as a real board hosts its
#  peripherals — and one connection for the simulator that plays them.
:plot_board a mqtt4ssn:Client ; mqtt4ssn:hasClientID "plot_board" ;
    mqtt4ssn:isConnectedToBroker :broker ;
    mqtt4ssn:hosts :rose_probe , :fern_probe , :rose_valve , :fern_valve .

#  WHERE EACH DEVICE SPEAKS: the board publishes both probes' readings as one document on one topic,
#  each probe reading its own value by pointer (world.ttl), and each grower subscribes to it for the
#  probe it reads; a valve listens on a topic of its own for the command a step is sized to when it is
#  taken.
:plot_readings a mqtt4ssn:Topic .
:rose_probe mqtt4ssn:observesTopic :plot_readings .
:fern_probe mqtt4ssn:observesTopic :plot_readings .

:rose_valve mqtt4ssn:listensToTopic :rose_valve_commands .
:rose_valve_commands a mqtt4ssn:Topic .

:fern_valve mqtt4ssn:listensToTopic :fern_valve_commands .
:fern_valve_commands a mqtt4ssn:Topic .
