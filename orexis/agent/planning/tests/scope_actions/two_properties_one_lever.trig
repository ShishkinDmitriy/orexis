# two_properties_one_lever
#
# One lever writes both properties, so the two are one scope and the lever is in it: a want
# about a tank low and cold is one want, planned in one cone.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix graph: <http://example.org/orexis/graph/> .
@prefix scopes: <http://example.org/orexis/graph/scopes/> .


GRAPH :ontology {
  planning:ScopeGraph rdfs:subClassOf orexis:Graph .
  planning:ScopeGraph rdfs:subClassOf orexis:WorkingGraph .
  orexis:WorkingGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :actions {
  :fix a orexis:Action .
  :fix sh:construct """PREFIX : <http://example.org/test#>
        CONSTRUCT { ?t :level ?x . ?t :temperature ?x . } WHERE { ?t a :Tank }""" .
}

GRAPH :catalogue {
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
}
