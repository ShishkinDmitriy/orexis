# one_lever_two_tanks
#
# Two tanks below their floor and one lever taking a tank: the precondition binds two rows, so
# the ground admits TWO candidates, one filling each — which is where `$tank = tank1` comes from.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .
@prefix possible: <http://example.org/orexis/graph/possible/> .
@prefix plan: <http://example.org/orexis/graph/plan/> .

GRAPH :ontology {
  :level a rdf:Property .
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:localId "keeper" .
  :tank1 a :Tank .
  :tank2 a :Tank .
}

GRAPH :actions {
  :fill a orexis:Action .
  :fill orexis:available """PREFIX : <http://example.org/test#>
      SELECT ?tank WHERE {
      ?tank a :Tank ; :level ?l .
      FILTER(?l < 10) }""" .
  :fill orexis:costs """PREFIX : <http://example.org/test#>
      SELECT (1 AS ?cost) WHERE { }""" .
  :fill orexis:retracts """PREFIX : <http://example.org/test#>
      DELETE { GRAPH $state { $tank :level ?l } }
      WHERE  { GRAPH $state { $tank :level ?l } }""" .
  :fill orexis:takes :tank .
  :fill sh:construct """PREFIX : <http://example.org/test#>
      CONSTRUCT { ?tank :level ?next } WHERE {
      $tank :level ?l .
      BIND($tank AS ?tank) BIND(?l + 5 AS ?next) }""" .
  :tank a orexis:Parameter .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire .
  :keeper.in_range orexis:about :level .
  :keeper.in_range orexis:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
}

GRAPH :sensed {
  :tank1 :level 0 .
  :tank2 :level 0 .
}

GRAPH :scopes {
  :fill planning:inScope :keeper.scope.1 .
  :keeper.scope.1 a planning:Scope .
  :level planning:inScope :keeper.scope.1 .
}

GRAPH :catalogue {
  :actions a orexis:Graph .
  :actions a orexis:PublicGraph .
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
  ground:2026-01-01T120000p0000 a planning:GroundGraph .
  ground:2026-01-01T120000p0000 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  ground:2026-01-01T120000p0000 orexis:arrivedBy orexis:Derived .
  ground:2026-01-01T120000p0000 orexis:hash "sha256:3da550989c3e7a9c5a0a850a82b91a2ab3e8f2878f27eeb7631e00672b1b0665" .
  ground:2026-01-01T120000p0000.for.keeper.in_range a planning:Weighing .
  ground:2026-01-01T120000p0000.for.keeper.in_range planning:for :keeper.in_range .
  ground:2026-01-01T120000p0000.for.keeper.in_range planning:met false .
  ground:2026-01-01T120000p0000.for.keeper.in_range planning:violation [ orexis:about :level ; planning:constraint 0 ; planning:instance :tank1 ] .
  ground:2026-01-01T120000p0000.for.keeper.in_range planning:violation [ orexis:about :level ; planning:constraint 0 ; planning:instance :tank2 ] .
  ground:2026-01-01T120000p0000.for.keeper.in_range planning:weighs ground:2026-01-01T120000p0000 .
  pursued:2026-01-01T120000p0000--open a orexis:Graph .
  pursued:2026-01-01T120000p0000--open a orexis:WantGraph .
  pursued:2026-01-01T120000p0000--open dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T12:00:00+00:00"^^xsd:dateTime ] .
  pursued:2026-01-01T120000p0000--open orexis:arrivedBy orexis:Derived .
  pursued:2026-01-01T120000p0000--open orexis:beliefsOf :keeper .
}

GRAPH ground:2026-01-01T120000p0000 {
  :tank1 :level 0 .
  :tank2 :level 0 .
}

GRAPH pursued:2026-01-01T120000p0000--open {
  :keeper orexis:holds :keeper.in_range.pursued.tank1 .
  :keeper orexis:holds :keeper.in_range.pursued.tank2 .
  :keeper.in_range.pursued.tank1 a orexis:Want .
  :keeper.in_range.pursued.tank1 orexis:metWhen :keeper.in_range.pursued.tank1.met .
  :keeper.in_range.pursued.tank1 orexis:state orexis:Recognized .
  :keeper.in_range.pursued.tank1 prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
  :keeper.in_range.pursued.tank1 prov:wasDerivedFrom :keeper.in_range .
  :keeper.in_range.pursued.tank1 rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank1.met a sh:NodeShape .
  :keeper.in_range.pursued.tank1.met sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :keeper.in_range.pursued.tank1.met sh:targetNode :tank1 .
  :keeper.in_range.pursued.tank2 a orexis:Want .
  :keeper.in_range.pursued.tank2 orexis:metWhen :keeper.in_range.pursued.tank2.met .
  :keeper.in_range.pursued.tank2 orexis:state orexis:Recognized .
  :keeper.in_range.pursued.tank2 prov:generatedAtTime "2026-01-01T12:00:00+00:00"^^xsd:dateTime .
  :keeper.in_range.pursued.tank2 prov:wasDerivedFrom :keeper.in_range .
  :keeper.in_range.pursued.tank2 rdfs:label "pursued: every tank in range" .
  :keeper.in_range.pursued.tank2.met a sh:NodeShape .
  :keeper.in_range.pursued.tank2.met sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :keeper.in_range.pursued.tank2.met sh:targetNode :tank2 .
}
