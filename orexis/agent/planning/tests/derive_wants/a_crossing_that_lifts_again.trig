# a_crossing_that_lifts_again
#
# A tank in range now, foreseen low from 12:30, and foreseen back in range from 13:00 —
# a forecast that says the trouble is TRANSIENT. The want is in trouble over that stretch and
# no longer: its graph holds from 12:30 to 13:00, and a reader standing at 13:30 is handed
# nothing.
#
# WHAT THIS IS FOR. Until the derivation judged at every boundary it could only find the
# instant trouble BEGINS: `read_ahead` stopped at the first instant a way of failing read
# unmet and never asked what came after, so a pot that dries at half past and is refilled at
# one was a want with a beginning and no end. Both ends of a period are boundaries now, so the
# same loop that finds the crossing finds the lifting.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pursued: <http://example.org/orexis/graph/pursued/keeper/> .
@prefix ground: <http://example.org/orexis/graph/ground/> .


GRAPH :ontology {
  orexis:WantGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :world {
  :tank1 a :Tank .
  :tank2 a :Tank .
}

GRAPH :desires {
  :in_range a sh:NodeShape .
  :in_range sh:property [ orexis:about :level ; sh:minInclusive 10 ; sh:path :level ] .
  :in_range sh:property [ orexis:about :temperature ; sh:maxInclusive 30 ; sh:path :temperature ] .
  :in_range sh:targetClass :Tank .
  :keeper orexis:holds :keeper.in_range .
  :keeper.in_range a orexis:Desire .
  :keeper.in_range orexis:about :level .
  :keeper.in_range orexis:about :temperature .
  :keeper.in_range orexis:metWhen :in_range .
  :keeper.in_range rdfs:label "every tank in range" .
}

GRAPH :sensed {
  :tank1 :level 20 .
  :tank1 :temperature 20 .
  :tank2 :level 20 .
  :tank2 :temperature 20 .
}

#  LOW FROM HALF PAST — the drift's reading for that window.
GRAPH :predicted-0 {
  :tank1 :level 5 .
}

#  AND BACK IN RANGE FROM ONE: rain, a refill, whatever the drift read. The graph's START is
#  what ends the trouble, since the reading it carries is what the met-test sees from then.
GRAPH :predicted-1 {
  :tank1 :level 20 .
}

GRAPH :scopes {
  :fill planning:inScope :keeper.scope.1 .
  :heat planning:inScope :keeper.scope.2 .
  :keeper.scope.1 a planning:Scope .
  :keeper.scope.2 a planning:Scope .
  :level planning:inScope :keeper.scope.1 .
  :temperature planning:inScope :keeper.scope.2 .
}

# What each graph IS, and when it holds — said once each, beside the data.
GRAPH :catalogue {
  :catalogue a orexis:CatalogueGraph .
  :catalogue a orexis:Graph .
  :desires a orexis:DesireGraph .
  :desires a orexis:Graph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology a orexis:PublicGraph .
  :predicted-0 a orexis:Graph .
  :predicted-0 a orexis:PredictionGraph .
  :predicted-0 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T13:00:00+00:00"^^xsd:dateTime ; orexis:start "2026-01-01T12:30:00+00:00"^^xsd:dateTime ] .
  :predicted-0 orexis:retracts "PREFIX : <http://example.org/test#> DELETE { GRAPH $state { :tank1 :level ?was } } WHERE { GRAPH $state { :tank1 :level ?was } }" .
  :predicted-1 a orexis:Graph .
  :predicted-1 a orexis:PredictionGraph .
  :predicted-1 dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:start "2026-01-01T13:00:00+00:00"^^xsd:dateTime ] .
  :predicted-1 orexis:retracts "PREFIX : <http://example.org/test#> DELETE { GRAPH $state { :tank1 :level ?was } } WHERE { GRAPH $state { :tank1 :level ?was } }" .
  :scopes a orexis:Graph .
  :scopes a orexis:WorkingGraph .
  :scopes a planning:ScopeGraph .
  :scopes orexis:arrivedBy orexis:Derived .
  :scopes orexis:beliefsOf :keeper .
  :sensed a orexis:BeliefGraph .
  :sensed a orexis:Graph .
  :sensed a orexis:StateGraph .
  :world a orexis:Graph .
  :world a orexis:PublicGraph .
}
