# a_graph_is_its_content_and_not_its_name
#
# The claim the search leans on. :here and :there are differently NAMED, their triples went
# in in a different ORDER, and neither is part of where a plan stands — so they hash alike,
# and the two rows below say so in the same digest. :elsewhere holds one thing more and does
# not.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


GRAPH :ontology {
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :ontology.metadata {
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology.metadata a orexis:MetadataGraph .
  :ontology.metadata orexis:metadataOf :ontology .
}

GRAPH :here {
  :tank :holds :water .
  :tank :level 5 .
}

GRAPH :here.metadata {
  :here a orexis:Graph .
  :here.metadata a orexis:MetadataGraph .
  :here.metadata orexis:metadataOf :here .
}

GRAPH :there {
  :tank :holds :water .
  :tank :level 5 .
}

GRAPH :there.metadata {
  :there a orexis:Graph .
  :there.metadata a orexis:MetadataGraph .
  :there.metadata orexis:metadataOf :there .
}

GRAPH :elsewhere {
  :tank :feeds :fern .
  :tank :holds :water .
  :tank :level 5 .
}

GRAPH :elsewhere.metadata {
  :elsewhere a orexis:Graph .
  :elsewhere.metadata a orexis:MetadataGraph .
  :elsewhere.metadata orexis:metadataOf :elsewhere .
}

GRAPH :catalogue {
}
