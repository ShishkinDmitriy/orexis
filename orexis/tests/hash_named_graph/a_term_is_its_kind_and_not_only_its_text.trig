# a_term_is_its_kind_and_not_only_its_text
#
# THE ONE TOLERANCE IS THE ROUNDING, and these were not tolerances at all. Every term used to
# canonicalise to a bare Python value — an IRI to its string, and every literal to whatever
# `float()` made of it — so three pairs no domain would call equal hashed alike. All six
# digests below differ, and that is the whole case.
#
#   :iri    <urn:x>      against  :text   "urn:x"
#   :one    "1"          against  :number 1
#   :en     "hi"@en      against  :de     "hi"@de

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


GRAPH :ontology {
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :ontology.metadata {
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology.metadata a orexis:MetadataGraph .
  :ontology.metadata orexis:metadataOf :ontology .
}

GRAPH :number {
  :s :p 1 .
}

GRAPH :number.metadata {
  :number a orexis:Graph .
  :number.metadata a orexis:MetadataGraph .
  :number.metadata orexis:metadataOf :number .
}

GRAPH :de {
  :s :p "hi"@de .
}

GRAPH :de.metadata {
  :de a orexis:Graph .
  :de.metadata a orexis:MetadataGraph .
  :de.metadata orexis:metadataOf :de .
}

GRAPH :en {
  :s :p "hi"@en .
}

GRAPH :en.metadata {
  :en a orexis:Graph .
  :en.metadata a orexis:MetadataGraph .
  :en.metadata orexis:metadataOf :en .
}

GRAPH :iri {
  :s :p <urn:x> .
}

GRAPH :iri.metadata {
  :iri a orexis:Graph .
  :iri.metadata a orexis:MetadataGraph .
  :iri.metadata orexis:metadataOf :iri .
}

GRAPH :one {
  :s :p "1" .
}

GRAPH :one.metadata {
  :one a orexis:Graph .
  :one.metadata a orexis:MetadataGraph .
  :one.metadata orexis:metadataOf :one .
}

GRAPH :text {
  :s :p "urn:x" .
}

GRAPH :text.metadata {
  :text a orexis:Graph .
  :text.metadata a orexis:MetadataGraph .
  :text.metadata orexis:metadataOf :text .
}

GRAPH :catalogue {
}
