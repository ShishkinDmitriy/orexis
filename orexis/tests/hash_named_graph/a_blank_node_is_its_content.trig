# a_blank_node_is_its_content
#
# WHY THE CANONICAL FORM EXISTS AT ALL. A rule that mints with `BNODE()` mints a different
# label every run, so two paths reaching one place would hash differently and every world
# would look novel — cycle detection would be decorative, which is #258.
#
# :minted and :again say the same thing through blank nodes written under different labels,
# and hash alike. :deeper nests one inside another to hold the recursive walk; :cyclic points
# a blank node back at itself, which the walk closes rather than following for ever.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


GRAPH :ontology {
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :ontology.metadata {
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology.metadata a orexis:MetadataGraph .
  :ontology.metadata orexis:metadataOf :ontology .
}

GRAPH :minted {
  :tank :reading [ :at :probe ; :says 5 ] .
}

GRAPH :minted.metadata {
  :minted a orexis:Graph .
  :minted.metadata a orexis:MetadataGraph .
  :minted.metadata orexis:metadataOf :minted .
}

GRAPH :deeper {
  :tank :reading [ :at :probe ; :within [ :from 1 ; :to 9 ] ] .
}

GRAPH :deeper.metadata {
  :deeper a orexis:Graph .
  :deeper.metadata a orexis:MetadataGraph .
  :deeper.metadata orexis:metadataOf :deeper .
}

GRAPH :cyclic {
  :tank :reading _:b1 .
  _:b1 :at :probe .
  _:b1 :beside _:b1 .
}

GRAPH :cyclic.metadata {
  :cyclic a orexis:Graph .
  :cyclic.metadata a orexis:MetadataGraph .
  :cyclic.metadata orexis:metadataOf :cyclic .
}

GRAPH :again {
  :tank :reading [ :at :probe ; :says 5 ] .
}

GRAPH :again.metadata {
  :again a orexis:Graph .
  :again.metadata a orexis:MetadataGraph .
  :again.metadata orexis:metadataOf :again .
}

GRAPH :catalogue {
}
