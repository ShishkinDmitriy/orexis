#pragma once
// Copy this to config.h and fill in. config.h is gitignored (WiFi secrets).

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

#define MQTT_HOST "192.168.1.50" // the Raspberry Pi's LAN IP (runs mosquitto)
// Each world runs its own broker on its own port — see ag:brokerPort in that world's
// world.ttl. society is 1883, sensing 1884, simulation 1885.
#define MQTT_PORT 1883

// --- Who this board is on the bus ---
// The broker no longer accepts anonymous clients: every principal connects as itself and may
// say and hear exactly what the world wires it to. Copy these two values out of
// world/<world>/secrets/mqtt-<DEVICE_ID>.env, which `orexis-mqtt <world>` generated for THIS
// board IN THAT WORLD. A board belongs to one world: it is flashed with one host and port, so
// it reaches exactly one broker, and each world mints its own password for it. Moving a board
// between worlds means taking the credential AND the port from the other world and reflashing.
// Changing a board's identity here means re-running `orexis-mqtt` and reflashing.
#define MQTT_USER "valve_fern"
#define MQTT_PASS "paste-from-world/<world>/secrets/mqtt-<device>.env"

// Which plant's valve this board drives. Subscribes to actuators/<PLANT_ID>/valve
// and publishes status to actuators/<PLANT_ID>/valve/status.
#define PLANT_ID "fern"

// Relay/valve GPIO. ACTIVE_HIGH=1 if the relay opens on HIGH, 0 if it opens on LOW.
#define VALVE_PIN 26
#define VALVE_ACTIVE_HIGH 1

// Fail-safe: the valve NEVER stays open longer than this, whatever a command says.
// The hard physical constitution at the edge.
#define MAX_OPEN_SECONDS 20.0

// Reporting only: the executor already calibrates litres->seconds; this lets the
// board estimate ml dispensed for its status message.
#define ML_PER_SECOND 10.0
