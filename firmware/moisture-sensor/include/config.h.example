#pragma once
// Copy this to config.h and fill in. config.h is gitignored (WiFi secrets).

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

#define MQTT_HOST "192.168.1.50" // the Raspberry Pi's LAN IP (runs mosquitto)
// Each world runs its own broker on its own port — see ag:brokerPort in that world's
// world.ttl. society is 1883, sensing 1884, simulation 1885.
#define MQTT_PORT 1883

// --- Who this board is on the bus ---
// The broker no longer accepts anonymous clients: every principal connects as itself and may
// say and hear exactly what the world wires it to. Copy these two values out of
// world/<world>/secrets/mqtt-<DEVICE_ID>.env, which `orexis-mqtt <world>` generated for THIS
// board IN THAT WORLD. A board belongs to one world: it is flashed with one host and port, so
// it reaches exactly one broker, and each world mints its own password for it. Moving a board
// between worlds means taking the credential AND the port from the other world and reflashing.
// Changing a board's identity here means re-running `orexis-mqtt` and reflashing.
#define MQTT_USER "moisture_sensor_fern"
#define MQTT_PASS "paste-from-world/<world>/secrets/mqtt-<device>.env"

// Which subject this board measures. The topics are built from PLANT_ID, so it must match
// the ag:readingTopic / ag:commandTopic that genesis/world.ttl states for this board's
// sensor; SENSOR_ID must match that sensor's ag:localId, and is recorded as provenance.
// Use "bench" / "moisture_sensor_bench" to bring a board up with no market running.
#define PLANT_ID "fern"
#define SENSOR_ID "moisture_sensor_fern"

// Capacitive soil-moisture sensor on an ADC1 pin (GPIO 32-39). Avoid ADC2 pins —
// they don't work while WiFi is on. GPIO 34-39 are input-only, ideal here.
#define MOISTURE_PIN 34

// Calibration — raw analogRead() values (0..4095) for your sensor. Measure once:
//   ADC_DRY = reading in dry air / bone-dry soil (highest)
//   ADC_WET = reading fully submerged / saturated soil (lowest)
// A capacitive sensor reads HIGH when dry, LOW when wet.
#define ADC_DRY 3200
#define ADC_WET 1300

// --- Pull-based cadence (the agent owns how often; the board just senses + sleeps) ---
// On each wake the board reads, publishes, then briefly listens for a retained cadence
// command on sensors/<PLANT_ID>/cmd  ({"sleep_s":N} and/or {"sense":true}), then deep-sleeps.
#define DEFAULT_SLEEP_S 60   // cadence until the agent sets one
#define MIN_SLEEP_S 5        // don't sense more often than this (rate ceiling)
#define MAX_SLEEP_S 900      // NEVER sleep longer than this — the constitutional cadence
                             // floor, so a plant can't go blind through a drought
#define MQTT_TRIES 10       // give up connecting after this many tries and
                     // sleep, rather than holding the battery open forever
#define CMD_WAIT_MS 1500     // listen window after publishing, to catch a cadence command
