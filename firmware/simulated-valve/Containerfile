# A stand-in for a valve, and nothing else.
#
# Its own image, like the sensor's: a device has no business holding an agent's code, and
# sharing an image means sharing a dependency set. It carries `cryptography` where the sensor
# does not, and that is honest rather than wasteful — a real valve verifies signatures too, and
# a stand-in that skipped the check would test everything except the part anyone worries about.
#
# It holds PUBLIC keys only, mounted read-only. There is no private key in this image and no way
# for this process to author a command.
#
# Two things about building it here:
#
#   - `--network=host` is required on this host: DNS does not resolve inside the build sandbox.
#   - the context is THIS directory, not the repo root, which .containerignore excludes from
#     image contexts anyway — correctly, since the agent image must not carry firmware and
#     firmware must not carry the agent.
#
#   podman build --network=host -t orexis-valve:local firmware/simulated-valve

FROM docker.io/library/python:3.12-alpine

# PINNED, like the broker and the sensor: an upgrade should be a decision rather than a side
# effect of rebuilding on a day upstream published something. cryptography verifies the
# signatures the whole market rests on, so a silent change there is worth noticing.
ARG PAHO_VERSION=2.1.0
ARG CRYPTOGRAPHY_VERSION=44.0.0
RUN pip install --no-cache-dir \
      "paho-mqtt==${PAHO_VERSION}" \
      "cryptography==${CRYPTOGRAPHY_VERSION}"

# Not root. It holds one bus credential and two public keys; nothing here needs privilege.
RUN adduser -D -u 10001 valve
USER valve

WORKDIR /app
COPY valve.py /app/valve.py

# Unbuffered, or a refusal arrives in a block and a silent valve is indistinguishable from a
# stalled one — which is exactly the diagnosis this exists to make easy.
ENV PYTHONUNBUFFERED=1

CMD ["python", "/app/valve.py"]
