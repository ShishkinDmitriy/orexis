# a_reading_already_below_crosses_only_the_survival_floor
#
# Read at 0.05, already under the operating floor: the one change left is the survival floor, 0.03
# away at half a fraction a day, 86 minutes out. Two stretches.
#
# The clock stands at 2026-01-01T12:00:00Z.

@prefix : <http://example.org/test#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix prediction: <http://example.org/orexis/prediction#> .
@prefix sensing: <http://example.org/orexis/sensing#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix predicted: <http://example.org/orexis/graph/predicted/keeper/> .
@prefix observed: <http://example.org/orexis/graph/observed/keeper/> .

GRAPH :ontology {
  :predictor_shape sh:property [ sh:defaultValue 3600 ; sh:path prediction:rateHeldS ] .
  :predictor_shape sh:property [ sh:defaultValue 86400 ; sh:path prediction:horizonS ] .
  :predictor_shape sh:targetClass prediction:Predictor .
  belief:RevisionGraph rdfs:subClassOf orexis:Graph .
  orexis:BeliefGraph rdfs:subClassOf orexis:Graph .
  orexis:ForecastGraph rdfs:subClassOf orexis:BeliefGraph .
  orexis:ForecastGraph rdfs:subClassOf orexis:Graph .
  sensing:ObservationGraph rdfs:subClassOf orexis:Graph .
}

GRAPH :ontology.metadata {
  :ontology a orexis:BeliefGraph .
  :ontology a orexis:Graph .
  :ontology a orexis:OntologyGraph .
  :ontology.metadata a orexis:MetadataGraph .
  :ontology.metadata orexis:metadataOf :ontology .
}

GRAPH :world {
  :keeper a orexis:Agent .
  :keeper orexis:actsFor :zamioculcas .
  :keeper orexis:localId "keeper" .
  :probe a sosa:Sensor .
  :probe sosa:isHostedBy :zamioculcas .
  :probe sosa:observes :moisture .
  :zamioculcas :driesPerDay 0.5 .
  :zamioculcas a :Pot .
  :zamioculcas ssn-system:hasOperatingRange :zamioculcas.operating .
  :zamioculcas ssn-system:hasSurvivalRange :zamioculcas.survival .
  :zamioculcas.operating a ssn-system:OperatingRange .
  :zamioculcas.operating ssn-system:inCondition [ schema:maxValue 0.3 ; schema:minValue 0.1 ; ssn:forProperty :moisture ] .
  :zamioculcas.survival a ssn-system:SurvivalRange .
  :zamioculcas.survival ssn-system:inCondition [ schema:maxValue 0.45 ; schema:minValue 0.02 ; ssn:forProperty :moisture ] .
}

GRAPH :world.metadata {
  :world a orexis:BeliefGraph .
  :world a orexis:Graph .
  :world.metadata a orexis:MetadataGraph .
  :world.metadata orexis:metadataOf :world .
}

GRAPH :actions {
  :Drying a prediction:Flow .
  :Drying prediction:moves :moisture .
  :Drying prediction:rate """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      PREFIX : <http://example.org/test#>
      SELECT ?rate ?until WHERE {
          $feature :driesPerDay ?perDay .
          BIND(-xsd:double(?perDay) / 86400.0 AS ?rate)
          BIND(0.0 AS ?until)
      }""" .
  :Drying rdfs:label "what a pot loses while nobody waters it" .
}

GRAPH :actions.metadata {
  :actions a orexis:FlowGraph .
  :actions a orexis:Graph .
  :actions.metadata a orexis:MetadataGraph .
  :actions.metadata orexis:metadataOf :actions .
}

GRAPH observed:zamioculcas_moisture {
  :probe.20260101T120000Z a sosa:Observation .
  :probe.20260101T120000Z prov:wasGeneratedBy :keeper .
  :probe.20260101T120000Z sosa:hasFeatureOfInterest :zamioculcas .
  :probe.20260101T120000Z sosa:hasSimpleResult 0.05 .
  :probe.20260101T120000Z sosa:madeBySensor :probe .
  :probe.20260101T120000Z sosa:observedProperty :moisture .
  :probe.20260101T120000Z sosa:resultTime "2026-01-01T12:00:00Z"^^xsd:dateTime .
}

GRAPH observed:zamioculcas_moisture.metadata {
  observed:zamioculcas_moisture a orexis:Graph .
  observed:zamioculcas_moisture a sensing:ObservationGraph .
  observed:zamioculcas_moisture dcterms:temporal [ a dcterms:PeriodOfTime ; orexis:end "2026-01-01T12:15:00Z"^^xsd:dateTime ; orexis:start "2026-01-01T12:00:00Z"^^xsd:dateTime ] .
  observed:zamioculcas_moisture orexis:arrivedBy orexis:Received .
  observed:zamioculcas_moisture orexis:ownedBy :keeper .
  observed:zamioculcas_moisture.metadata a orexis:MetadataGraph .
  observed:zamioculcas_moisture.metadata orexis:metadataOf observed:zamioculcas_moisture .
}

GRAPH :catalogue {
}
