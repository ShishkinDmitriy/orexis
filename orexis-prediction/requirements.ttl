@prefix prediction: <http://example.org/orexis/prediction#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix : <http://example.org/orexis/prediction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix onboarding: <http://example.org/orexis/onboarding#> .

<> a onboarding:RequirementGraph .    # this document is one graph, and this is what it is

#  WHAT A WORLD MUST STATE OF prediction's WORDS, held by onboarding alone before anything is granted
#  (knowledge/domain/onboarding/requirement.md, #838). No agent loads this graph: its kind is
#  onboarding's, and the boot passes over it as it passes over a world's hardware.

[] a sh:NodeShape ;
    sh:targetClass :Predictor ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a predictor with no sensor of its own or no flow: it would foresee nothing" ;
        sh:select """SELECT $this WHERE { ?me orexis:plays $this
            FILTER (NOT EXISTS { ?me orexis:actsFor ?subject . ?subject schema:containedInPlace* ?host .
                                 ?sensor sosa:isHostedBy/(sosa:isSampleOf)? ?host }
                    || NOT EXISTS { ?flow a prediction:Flow }) }""" ] .

#  A PREDICTOR'S FIGURES, ONE EACH, on whichever role states them: a domain's role beneath the predictor may, so each
#  shape targets what states the figure. The predictor reads them in one query as it is made and judges nothing of
#  them, this being where they are judged; that two roles do not state two values of one figure is onboarding's
#  own requirement, of every package's figures.
[] a sh:NodeShape ;
    sh:targetSubjectsOf prediction:horizonS ;
    sh:property [ sh:path prediction:horizonS ; sh:maxCount 1 ; sh:minExclusive 0 ;
                  sh:message "a predictor's horizon is one number of seconds above nought" ] .
[] a sh:NodeShape ;
    sh:targetSubjectsOf prediction:rateHeldS ;
    sh:property [ sh:path prediction:rateHeldS ; sh:maxCount 1 ; sh:minExclusive 0 ;
                  sh:message "a predictor holds a rate for one number of seconds above nought" ] .
