@prefix actuation: <http://example.org/orexis/actuation#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:ActionGraph .    # this document is one graph, and this is what it is

#  THE DOSE, stated in the concepts the rules conclude: a reading of what a valve moves, below a
#  range of the subject the valve acts on, comes to be inside it. The search runs no rules, so the
#  effect writes the side and not a number; the executor answers the step when the next reading is
#  revised inside. How much to pour is not the search's: `execution:command` is run over the
#  present when the step is taken, and sizes the dose from how far the reading is below the middle
#  of the range, by the subject's litres per fraction, at most the valve's cap.

actuation:Dosing a orexis:Action ;
    rdfs:label "dose a subject from a valve until its reading is inside its range" ;
    orexis:takes actuation:valve , actuation:reading ;
    orexis:available """PREFIX actuation: <http://example.org/orexis/actuation#>
        PREFIX sensing: <http://example.org/orexis/sensing#>
        SELECT DISTINCT ?valve ?reading WHERE {
            $me actuation:hasActuator ?valve ; orexis:actsFor ?subject .
            ?valve actuation:actuates ?subject ; actuation:actuatesProperty ?property .
            ?reading sosa:hasFeatureOfInterest ?subject ; sosa:observedProperty ?property ;
                     sensing:below ?range .
        }""" ;
    orexis:costs """SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    orexis:retracts """PREFIX sensing: <http://example.org/orexis/sensing#>
        DELETE { GRAPH $state { $reading sensing:below ?range } }
        WHERE  { GRAPH $state { $reading sensing:below ?range } }""" ;
    sh:construct """PREFIX sensing: <http://example.org/orexis/sensing#>
        CONSTRUCT { $reading sensing:inside ?range } WHERE { $reading sensing:below ?range }""" ;
    execution:command """PREFIX actuation: <http://example.org/orexis/actuation#>
        PREFIX climate: <http://example.org/orexis/climate#>
        SELECT ?actuator ?payload WHERE {
            $reading sosa:hasFeatureOfInterest ?subject ; sosa:hasSimpleResult ?value ;
                     sosa:observedProperty ?property .
            ?subject ssn-system:hasOperatingRange/ssn-system:inCondition ?condition .
            ?condition ssn:forProperty ?property ; schema:minValue ?lo ; schema:maxValue ?hi .
            ?subject climate:litresPerFraction ?litres .
            $valve actuation:maxDoseMl ?cap .
            BIND(((xsd:double(?lo) + xsd:double(?hi)) / 2.0) AS ?aim)
            BIND((?aim - xsd:double(?value)) * xsd:double(?litres) * 1000.0 AS ?wanted)
            BIND(IF(?wanted > xsd:double(?cap), xsd:double(?cap), IF(?wanted < 0.0, 0.0, ?wanted)) AS ?ml)
            BIND($valve AS ?actuator)
            BIND(CONCAT('{"dose_ml": ', STR(xsd:integer(ROUND(?ml))), '}') AS ?payload)
        }""" .
