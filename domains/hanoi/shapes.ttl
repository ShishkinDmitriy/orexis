@prefix hanoi: <http://example.org/orexis/hanoi#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:ShapesGraph .    # this document is one graph, and this is what it is

#  WHAT SOLVING MEANS AND HOW FAR IT IS, the domain's: a world's desire points here with
#  `orexis:metWhen` and `orexis:estimates`. Solved is the shape — on every disk in play, following
#  hanoi:on one or more times reaches peg C — and the estimate counts the disks astray, which never
#  overstates the moves left, a promise about this domain's own move that no world could keep.

hanoi:solved a sh:NodeShape ;
    rdfs:label "every disk's chain bottoms out on peg C" ;
    sh:targetSubjectsOf hanoi:on ;
    sh:property [ sh:path [ sh:oneOrMorePath hanoi:on ] ; sh:hasValue hanoi:PegC ] .

hanoi:disksAstray rdfs:label "disks not yet home" ;
    sh:select """PREFIX hanoi: <http://example.org/orexis/hanoi#>
        SELECT (COUNT(DISTINCT ?d) AS ?estimate) WHERE {
            ?d hanoi:on ?rest . ?d (hanoi:on)+ ?p .
            ?p a hanoi:Peg .
            FILTER(?p != hanoi:PegC)
        }""" .
