@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix planning: <http://example.org/orexis/planning#> .

<> a orexis:ActionGraph .    # this document is one graph, and this is what it is

#  THREE ACTIONS, one ground instance per legal filling the state admits. FICTIVE, because the
#  grid is its own physics: no instrument answers a drive, so the executor writes what the step
#  predicted into the state itself, and that is the world moving. The texts declare `courier:`
#  themselves, since the store's dictionary learns no domain's namespace.

courier:Drive a orexis:Action ;
    rdfs:label "drive the van to a neighbouring cell" ;
    orexis:takes courier:van , courier:to ;
    execution:implementation [ a execution:Implementation ;
        execution:operation [ a execution:Fictive ] ] ;
    planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT ?van ?to WHERE {
            ?van courier:at ?here .
            ?van a courier:Van .
            ?here courier:x ?hx ; courier:y ?hy .
            ?to a courier:Cell ; courier:x ?ax ; courier:y ?ay .
            FILTER(ABS(?ax - ?hx) + ABS(?ay - ?hy) = 1)
        }""" ;
    planning:costs """SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    planning:effect [ a planning:Effect ;
        sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { $van courier:at ?old  }
        WHERE  { $van courier:at ?old  }""" ] ,
                [ a sh:SPARQLRule ; sh:construct """PREFIX courier: <http://example.org/orexis/courier#>
        CONSTRUCT { $van courier:at $to } WHERE { }""" ] ] .

#  THE PICK DELETES: it removes where the parcel stood and puts it aboard, a different pair, so
#  nothing replaces the fact that goes.
courier:Pick a orexis:Action ;
    rdfs:label "load a parcel standing where the van stands" ;
    orexis:takes courier:parcel , courier:van ;
    execution:implementation [ a execution:Implementation ;
        execution:operation [ a execution:Fictive ] ] ;
    planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT ?parcel ?van WHERE {
            ?van courier:at ?cell . ?parcel courier:at ?cell .
            ?parcel a courier:Parcel .
            ?van a courier:Van .
        }""" ;
    planning:costs """SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    planning:effect [ a planning:Effect ;
        sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { $parcel courier:at ?cell  }
        WHERE  { $parcel courier:at ?cell  }""" ] ,
                [ a sh:SPARQLRule ; sh:construct """PREFIX courier: <http://example.org/orexis/courier#>
        CONSTRUCT { $parcel courier:carriedBy $van } WHERE { }""" ] ] .

courier:Drop a orexis:Action ;
    rdfs:label "set a carried parcel down where the van stands" ;
    orexis:takes courier:parcel , courier:to ;
    execution:implementation [ a execution:Implementation ;
        execution:operation [ a execution:Fictive ] ] ;
    planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT ?parcel ?to WHERE {
            ?parcel courier:carriedBy ?van . ?van courier:at ?to .
            ?parcel a courier:Parcel .
        }""" ;
    planning:costs """SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    planning:effect [ a planning:Effect ;
        sh:rule [ a sh:SPARQLRule ; planning:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { $parcel courier:carriedBy ?van  }
        WHERE  { $parcel courier:carriedBy ?van  }""" ] ,
                [ a sh:SPARQLRule ; sh:construct """PREFIX courier: <http://example.org/orexis/courier#>
        CONSTRUCT { $parcel courier:at $to } WHERE { }""" ] ] .
