@prefix : <http://example.org/orexis/courier#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<> a planning:ConstraintGraph .    # this document is one graph, and this is what it is

#  WHAT NO VAN DOES - physics and not preferences (knowledge/domain/planning/constraint.md): no two vans stand
#  at one position, and no van stands where an obstacle is - a thing a radar sees and nothing
#  identifies, believed at two coordinates while it is in range (#1003), a hedge or a fence among them. Authored
#  as the avoided state, `planning:unmetWhen`, the honest polarity for a prohibition (#892). The search marks a
#  world violating either `planning:impossible`, so a plan goes round an obstacle and a parked van, and a belief
#  that puts one on a walking plan's next position reopens the plan (#921).
#
#  AND NO VAN STANDS NEAR A SILENT PEER'S VAN: a van moves a cell a drive, and what the agent believes of a peer's
#  van may be a drive behind - its walk woken by its own fix takes the next drive before the peer's reading is
#  concluded - while the peer lands one more drive during this agent's; so two cells between where this agent's van
#  will stand and where it believes the peer's stands is what leaves the two apart whatever the peer does, and a
#  peer that is silent (knowledge/domain/coordination/conflict.md) says nothing of what it does next. Three cells
#  between where the lot the agent drew alone this round was lost: the present then violates it, nothing repairs a
#  present, and every world but one that drives away is impossible - the loser backs off, the winner keeps two,
#  and they part the first round the lots differ. A peer that answers is none of this: its holdings say where it
#  will be. Read off the agent's own conclusions, which no other agent shares, its key is nothing two agents can
#  both want, so nobody is ever asked about it.
#
#  The domain states the constraints and no holder: who holds them is each world's to say of its agents, in a
#  constraint graph of its own (`world/lane/constraints.ttl`), since the domain knows no agent. Stated by the
#  worlds in their own words before, two vans' worlds had two spellings of one physics.

:no_two_vans_at_one_position a planning:Constraint ;
    rdfs:label "no two vans stand at one position" ;
    planning:unmetWhen :two_vans_at_one_position .

:two_vans_at_one_position
    sh:message "two vans stand at one position" ;
    sh:select """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT $this ?value WHERE {
            $this a courier:Van ;
                courier:x ?x ; courier:y ?y .
            ?value a courier:Van ;
                courier:x ?x ; courier:y ?y .
            FILTER(?value != $this)
        }""" .

:no_van_on_an_obstacle a planning:Constraint ;
    rdfs:label "no van stands where an obstacle is" ;
    planning:unmetWhen :a_van_on_an_obstacle .

:a_van_on_an_obstacle
    sh:message "a van stands where an obstacle is" ;
    sh:select """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT $this ?value WHERE {
            $this a courier:Van ;
                courier:x ?x ; courier:y ?y .
            ?value a courier:Obstacle ;
                courier:x ?x ; courier:y ?y .
        }""" .

:no_van_near_a_silent_peers_van a planning:Constraint ;
    rdfs:label "no van stands within two cells of the van of a peer silent to its agent, nor within three where its lot was lost" ;
    planning:unmetWhen :a_van_near_a_silent_peers_van .

:a_van_near_a_silent_peers_van
    sh:message "a van stands too near the van of a peer that is silent to its agent" ;
    sh:select """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT $this ?value WHERE {
            ?conflict coordination:silent true ; coordination:standing true ; coordination:with ?peer ; coordination:draw ?draw .
            ?peer orexis:actsFor ?value .
            ?value a courier:Van ; courier:x ?vx ; courier:y ?vy .
            ?me a orexis:Self ; orexis:actsFor $this .
            $this a courier:Van ; courier:x ?x ; courier:y ?y .
            OPTIONAL { ?draw coordination:wonBy ?won }
            BIND(IF(COALESCE(?won = ?peer, false), 4, 3) AS ?clear)
            FILTER((ABS(?x - ?vx) + ABS(?y - ?vy)) < ?clear)
        }""" .
