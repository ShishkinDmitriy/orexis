@prefix : <http://example.org/orexis/courier#> .
@prefix courier: <http://example.org/orexis/courier#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a sh:RulesGraph .    # this document is one graph, and this is what it is

#  WHERE A VAN STANDS, CONCLUDED OF WHAT ITS INSTRUMENTS GAVE (#1002). A position fix is two sensors hosted
#  by the van, one observing `courier:Column` and one `courier:Row`, each reporting a number; a transition is
#  handed its one arrival and the agent's own derived state (#947), so the arriving coordinate replaces the
#  one held of the van, `courier:x` or `courier:y`, and that is the position: two numbers on the thing, and
#  no cell found for them (the-grid-is-infinite-and-a-position-is-two-coordinates). The first fix leaves the
#  van with one coordinate until its second lands, a reading later, and a thing with one coordinate stands
#  nowhere a constraint or a met-test can read. The feature of interest is the van the sensor is hosted by,
#  or, where the sensor observes a contact standing for a van in range (#1003), what the contact `isSampleOf`,
#  and the contact's own vector is RELATIVE: `relativeColumnRule` and `relativeRowRule` add it to the
#  coordinates held of the van carrying the contact and write the sum on the peer the contact stands for, or
#  on the contact itself where it stands for nothing named, an obstacle - INSIDE THE RANGE THE SENSOR
#  DECLARES, `ssn-system:MeasurementRange`, and outside it they delete the coordinate held and write none,
#  which is how a contact beyond range comes to be believed nowhere: by the instrument's own range, never a
#  sentinel and never a silence (the-grid-is-infinite-and-a-position-is-two-coordinates). Imported by
#  `actions.answered.ttl`, the one document of the courier's whose drive a fix answers, so a world with the
#  fictive drive and no belief package never loads a rules graph it has no reader for.

:columnRule a belief:Transition ; sh:order 0 ;
    rdfs:label "the column a van stands in, concluded of its fix" ;
    belief:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { ?van courier:x ?was }
        INSERT { ?van courier:x ?x }
        WHERE {
            ?obs a sosa:Observation ; sosa:observedProperty courier:Column ; sosa:hasSimpleResult ?n ;
                 sosa:hasFeatureOfInterest/(sosa:isSampleOf)? ?van .
            ?van a courier:Van .
            BIND(xsd:integer(?n) AS ?x)
            OPTIONAL { ?van courier:x ?was }
        }""" .

:rowRule a belief:Transition ; sh:order 0 ;
    rdfs:label "the row a van stands in, concluded of its fix" ;
    belief:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { ?van courier:y ?was }
        INSERT { ?van courier:y ?y }
        WHERE {
            ?obs a sosa:Observation ; sosa:observedProperty courier:Row ; sosa:hasSimpleResult ?n ;
                 sosa:hasFeatureOfInterest/(sosa:isSampleOf)? ?van .
            ?van a courier:Van .
            BIND(xsd:integer(?n) AS ?y)
            OPTIONAL { ?van courier:y ?was }
        }""" .

:relativeColumnRule a belief:Transition ; sh:order 0 ;
    rdfs:label "the column of what a contact stands for, its vector added to the carrying van's, inside the sensor's range" ;
    belief:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { ?subject courier:x ?was }
        INSERT { ?subject courier:x ?x }
        WHERE {
            ?obs a sosa:Observation ; sosa:observedProperty courier:RelativeColumn ; sosa:hasSimpleResult ?d ;
                 sosa:hasFeatureOfInterest ?contact ; sosa:madeBySensor ?sensor .
            ?sensor ssn-system:hasSystemCapability/ssn-system:hasSystemProperty ?range .
            ?range a ssn-system:MeasurementRange ; schema:minValue ?least ; schema:maxValue ?most .
            ?contact sosa:isHostedBy ?mine . ?mine courier:x ?mx .
            OPTIONAL { ?contact sosa:isSampleOf ?peer }
            BIND(COALESCE(?peer, ?contact) AS ?subject)
            BIND(IF(?d >= ?least && ?d <= ?most, xsd:integer(?mx) + xsd:integer(?d), ?beyond) AS ?x)
            OPTIONAL { ?subject courier:x ?was }
        }""" .

:relativeRowRule a belief:Transition ; sh:order 0 ;
    rdfs:label "the row of what a contact stands for, its vector added to the carrying van's, inside the sensor's range" ;
    belief:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { ?subject courier:y ?was }
        INSERT { ?subject courier:y ?y }
        WHERE {
            ?obs a sosa:Observation ; sosa:observedProperty courier:RelativeRow ; sosa:hasSimpleResult ?d ;
                 sosa:hasFeatureOfInterest ?contact ; sosa:madeBySensor ?sensor .
            ?sensor ssn-system:hasSystemCapability/ssn-system:hasSystemProperty ?range .
            ?range a ssn-system:MeasurementRange ; schema:minValue ?least ; schema:maxValue ?most .
            ?contact sosa:isHostedBy ?mine . ?mine courier:y ?my .
            OPTIONAL { ?contact sosa:isSampleOf ?peer }
            BIND(COALESCE(?peer, ?contact) AS ?subject)
            BIND(IF(?d >= ?least && ?d <= ?most, xsd:integer(?my) + xsd:integer(?d), ?beyond) AS ?y)
            OPTIONAL { ?subject courier:y ?was }
        }""" .
