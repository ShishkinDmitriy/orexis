@prefix courier: <http://example.org/orexis/courier#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<> a orexis:ActionGraph ;    # this document is one graph, and this is what it is
    owl:imports <rules.ttl> .    # and the transition that concludes where the van is, of its fix

#  THE COURIER'S ACTIONS WHERE THE WORLD ANSWERS A DRIVE (#1002). A world imports this document or
#  `actions.ttl`, never both: the two declare the same three actions, and differ in one implementation.
#  Here a drive is a COMMAND to the van itself — `{"to": {"x": <column>, "y": <row>}}`, the coordinates of
#  the cell to reach, on the topic the van listens to — and the world moves the van: the simulator over the drive's band, a real
#  van as its own driving will (navigation-is-a-body-a-mover-and-a-move, §5). The step lands when the van's
#  position fix shows the cell, as a dose lands when the probe shows the soil moist, and fails a patience
#  past its latest landing when it does not; the executor says only what happened, and writes no outcome of
#  its own (a-boat-is-a-van-and-a-contact-becomes-a-belief-by-the-rules). Pick and Drop are as `actions.ttl`
#  has them, fictive: a thing set down where the van stands is nothing an instrument reports yet.
#
#  The precondition, the cost, the landing band and the effect are `actions.ttl`'s, letter for letter: what
#  the search plans on is the same whichever document a world imports, and only how a step is taken differs.

courier:Drive a orexis:Action ;
    rdfs:label "drive the van to a neighbouring cell, told to the van" ;
    orexis:takes courier:van , courier:to ;
    execution:implementation [ a execution:Implementation ;
        execution:operation [ a execution:Command ; sh:select """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT ?actuator ?payload WHERE {
            $to courier:x ?x ; courier:y ?y .
            BIND($van AS ?actuator)
            BIND(CONCAT('{"to": {"x": ', STR(?x), ', "y": ', STR(?y), '}}') AS ?payload)
        }""" ] ] ;
    #  A VAN SOMEBODY DRIVES MOVES ONLY WITH THEM ABOARD (#903), AND ONLY BY THE AGENT THAT HAS THEM
    #  (#929): the last filter refuses a van a driver `drives` who is not `aboard` it or whom the
    #  agent does not `orexis:plays`, and asks nothing of a van the world names no driver for,
    #  which is every van of the dispatcher's, the courier's and the tower's — so their drives are
    #  the fillings they were. Where a world names one driver for two vans, one van at a time is
    #  where the driver is, and no plan can drive the other without a boarding first; where two
    #  agents each have a driver, neither's search drives the other's van. A driver no agent has is
    #  nobody's to drive, the same refusal as a driver elsewhere. The inner filter opens on the
    #  pattern both its variables are bound in, since a `NOT EXISTS` is evaluated per row from there.
    planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT ?van ?to WHERE {
            ?van courier:at ?here .
            ?van a courier:Van .
            ?here courier:x ?hx ; courier:y ?hy .
            ?to a courier:Cell ; courier:x ?ax ; courier:y ?ay .
            FILTER(ABS(?ax - ?hx) + ABS(?ay - ?hy) = 1)
            FILTER NOT EXISTS { ?driver courier:drives ?van .
                FILTER NOT EXISTS { ?driver courier:aboard ?van . ?me a orexis:Self ; orexis:plays ?driver } }
        }""" ;
    planning:costs """SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    #  HOW LONG A DRIVE TAKES TO SHOW, as a BAND (#901): a van is on the road to the next cell
    #  between half a minute and a minute, which is the courier's figure for its own grid, stated
    #  here as the dose states the cadence of the sensor that shows it — a world that knows its
    #  streets better is where a truer figure would come from, never the search. The band is what
    #  makes a drive an ACT IN FLIGHT rather than a move in a puzzle: a step lands as long after it
    #  is taken as this says, the executor looks for the van at `$to` from the least and gives up
    #  a patience past the most, and two drives' windows can overlap only once they have a length
    #  (a-landing-is-a-band-and-a-world-holds-over-a-period). Declared as nothing, every world of a
    #  delivery stood at the pass's one instant, and a fleet had no time axis to be scheduled on.
    planning:landsAfter """SELECT ?least ?most WHERE { BIND(30 AS ?least) BIND(60 AS ?most) }""" ;
    planning:effect [ a planning:Effect ;
        sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { $van courier:at ?old }
        INSERT { $van courier:at $to }
        WHERE  { $van courier:at ?old }""" ] ] .

#  THE PICK DELETES: it removes where the parcel stood and puts it aboard, a different pair, so
#  nothing replaces the fact that goes.
courier:Pick a orexis:Action ;
    rdfs:label "load a parcel standing where the van stands" ;
    orexis:takes courier:parcel , courier:van ;
    execution:implementation [ a execution:Implementation ;
        execution:operation [ a execution:Fictive ] ] ;
    #  A VAN SOMEBODY DRIVES IS LOADED ONLY WITH THEM ABOARD, AND ONLY BY THE AGENT THAT HAS THEM (#931):
    #  the drive's last filter, word for word, since the driver is the one body at a van's cell and a
    #  van it has left stands where nobody is to load it. A van no driver is named for is refused nothing.
    planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT ?parcel ?van WHERE {
            ?van courier:at ?cell . ?parcel courier:at ?cell .
            ?parcel a courier:Parcel .
            ?van a courier:Van .
            FILTER NOT EXISTS { ?driver courier:drives ?van .
                FILTER NOT EXISTS { ?driver courier:aboard ?van . ?me a orexis:Self ; orexis:plays ?driver } }
        }""" ;
    planning:costs """SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    #  A PICK SHOWS AT ONCE: the parcel is aboard as the door shuts, nought twice — declared rather
    #  than left out, since an action that says nothing of its landing claims immediacy by silence.
    planning:landsAfter """SELECT ?least ?most WHERE { BIND(0 AS ?least) BIND(0 AS ?most) }""" ;
    planning:effect [ a planning:Effect ;
        sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { $parcel courier:at ?cell }
        INSERT { $parcel courier:carriedBy $van }
        WHERE  { $parcel courier:at ?cell }""" ] ] .

courier:Drop a orexis:Action ;
    rdfs:label "set a carried parcel down where the van stands" ;
    orexis:takes courier:parcel , courier:to ;
    execution:implementation [ a execution:Implementation ;
        execution:operation [ a execution:Fictive ] ] ;
    #  AND UNLOADED THE SAME WAY (#931): the van is the one carrying the parcel, bound by the first
    #  pattern though the drop does not take it, and the filter is the pick's.
    planning:precondition """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT ?parcel ?to WHERE {
            ?parcel courier:carriedBy ?van . ?van courier:at ?to .
            ?parcel a courier:Parcel .
            FILTER NOT EXISTS { ?driver courier:drives ?van .
                FILTER NOT EXISTS { ?driver courier:aboard ?van . ?me a orexis:Self ; orexis:plays ?driver } }
        }""" ;
    planning:costs """SELECT ?cost WHERE { BIND(1.0 AS ?cost) }""" ;
    #  A DROP SHOWS AT ONCE, as the pick does: nought twice, declared.
    planning:landsAfter """SELECT ?least ?most WHERE { BIND(0 AS ?least) BIND(0 AS ?most) }""" ;
    planning:effect [ a planning:Effect ;
        sh:rule [ a belief:Transition ; belief:update """PREFIX courier: <http://example.org/orexis/courier#>
        DELETE { $parcel courier:carriedBy ?van }
        INSERT { $parcel courier:at $to }
        WHERE  { $parcel courier:carriedBy ?van }""" ] ] .
