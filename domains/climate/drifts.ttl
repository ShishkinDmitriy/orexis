@prefix climate: <http://example.org/orexis/climate#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix prediction: <http://example.org/orexis/prediction#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a orexis:DriftGraph .    # this document is one graph, and this is what it is

#  WHAT MOVES A SUBJECT'S SOIL WHILE NOBODY WATERS IT, one drift per flow, each answering a rate
#  per second of the one timeline; the prediction package adds them and accumulates the sum. A drift
#  says nothing of a state: what the subject is foreseen to be — dry, moist —
#  is what this domain's transitions make of the predicted number
#  in the ground the planner lays it into (#944).

#  THE DRYING: `climate:driesPerDay` a day, until nothing is left.
climate:Drying a prediction:Drift ;
    rdfs:label "what a subject's soil loses while nobody waters it" ;
    prediction:moves climate:SoilMoisture ;
    prediction:rate """PREFIX climate: <http://example.org/orexis/climate#>
        SELECT ?rate ?until WHERE {
            $feature climate:driesPerDay ?perDay .
            BIND(-xsd:double(?perDay) / 86400.0 AS ?rate)
            BIND(0.0 AS ?until)
        }""" .

#  THE RAIN: what a forecast hour says falls on the subject's place, `climate:wetsPerMm` a
#  millimetre, until the soil is saturated. A forecast giving a range of millimetres gives a range
#  of rates, and the prediction a corridor; a subject stating no `wetsPerMm` is sheltered.
climate:Raining a prediction:Drift ;
    rdfs:label "what rain on a subject's place gives its soil" ;
    prediction:moves climate:SoilMoisture ;
    prediction:rate """PREFIX climate: <http://example.org/orexis/climate#>
        SELECT ?low ?high ?until WHERE {
            $feature climate:wetsPerMm ?perMm ; schema:containedInPlace ?place .
            ?rain sosa:hasFeatureOfInterest ?place ; sosa:observedProperty climate:Precipitation .
            { ?rain sosa:hasSimpleResult ?least . BIND(?least AS ?most) }
            UNION
            { ?rain sosa:hasResult ?result . ?result schema:minValue ?least ; schema:maxValue ?most }
            BIND(xsd:double(?perMm) * xsd:double(?least) / 3600.0 AS ?low)
            BIND(xsd:double(?perMm) * xsd:double(?most) / 3600.0 AS ?high)
            BIND(1.0 AS ?until)
        }""" .
