@prefix : <http://example.org/orexis/market#> .
@prefix market: <http://example.org/orexis/market#> .
@prefix orexis: <http://example.org/orexis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix execution: <http://example.org/orexis/execution#> .
@prefix speech: <http://example.org/orexis/speech#> .
@prefix belief: <http://example.org/orexis/belief#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix onboarding: <http://example.org/orexis/onboarding#> .

<> a onboarding:RequirementGraph .    # this document is one graph, and this is what it is

#  WHAT A WORLD MUST STATE OF the market's WORDS, held by onboarding alone before anything is granted
#  (knowledge/domain/onboarding/requirement.md, #838). No agent loads this graph: its kind is
#  onboarding's, and the boot passes over it as it passes over a world's hardware.

[] a sh:NodeShape ;
    sh:targetClass :Host ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a host that hosts no venue: there is nothing for it to hold" ;
        sh:select """PREFIX market: <http://example.org/orexis/market#>
SELECT $this WHERE { ?me orexis:plays $this FILTER NOT EXISTS { ?me market:hosts ?venue } }""" ] .

[] a sh:NodeShape ;
    sh:targetClass :Bidder ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a bidder that bids in no venue: there is nowhere for it to bid" ;
        sh:select """PREFIX market: <http://example.org/orexis/market#>
SELECT $this WHERE { ?me orexis:plays $this FILTER NOT EXISTS { ?me market:bidsIn ?venue } }""" ] .
