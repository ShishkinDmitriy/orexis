@prefix : <http://example.org/orexis/road#> .
@prefix planning: <http://example.org/orexis/planning#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<> a planning:ConstraintGraph .    # this document is one graph, and this is what it is

#  WHAT NO VAN ON THE ROAD DOES - physics and not preferences (knowledge/domain/planning/constraint.md): no
#  cell holds two vans, the dispatcher's, and no van stands where an obstacle is - a contact a radar sees and
#  nothing identifies, believed at a cell while it is in range (#1003). Authored as the avoided state,
#  `planning:unmetWhen`, the honest polarity for a prohibition (#892). The search marks a world violating
#  either `planning:impossible`, so a plan goes round an obstacle and a parked van, and a belief that puts
#  one on a walking plan's next cell reopens the plan (#921).
#
#  The road states the constraints and no holder: who holds them is each world's to say of its agents, in a
#  constraint graph of its own (`world/lane/constraints.ttl`), since the road knows no agent.

:no_cell_holds_two_vans a planning:Constraint ;
    rdfs:label "no cell holds two vans" ;
    planning:unmetWhen :two_vans_on_one_cell .

:two_vans_on_one_cell
    sh:message "two vans stand on one cell" ;
    sh:select """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT $this ?value WHERE {
            $this a courier:Van ;
                courier:at ?value .
            ?other a courier:Van ;
                courier:at ?value .
            FILTER(?other != $this)
        }""" .

:no_van_on_an_obstacle a planning:Constraint ;
    rdfs:label "no van stands where an obstacle is" ;
    planning:unmetWhen :a_van_on_an_obstacle .

:a_van_on_an_obstacle
    sh:message "a van stands on an obstacle's cell" ;
    sh:select """PREFIX courier: <http://example.org/orexis/courier#>
        SELECT $this ?value WHERE {
            $this a courier:Van ;
                courier:at ?value .
            ?obstacle a courier:Obstacle ;
                courier:at ?value .
        }""" .
