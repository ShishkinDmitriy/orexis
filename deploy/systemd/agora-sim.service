[Unit]
Description=Agora physical edge (virtual plants: sense when asked, sleep, get watered)
After=agora-infra.service
Wants=agora-infra.service

[Service]
WorkingDirectory=/home/dimonina/projects/agora
ExecStart=/home/dimonina/projects/agora/.venv/bin/agora-sim
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
