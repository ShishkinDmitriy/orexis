[Unit]
Description=Agora round runner (fires a round when a plant hits :LOW)
After=agora-infra.service
Wants=agora-infra.service
# Needs the plant edge running too (agora-sim, or real devices) to supply readings + :sensed.

[Service]
WorkingDirectory=/home/dimonina/projects/not-yet
ExecStart=/home/dimonina/projects/not-yet/.venv/bin/agora-loop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
