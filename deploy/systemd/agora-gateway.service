[Unit]
Description=Agora gateway (sensor MQTT -> InfluxDB + Fuseki :attested)
After=agora-infra.service network-online.target
Wants=agora-infra.service

[Service]
WorkingDirectory=/home/dimonina/projects/not-yet
ExecStart=/home/dimonina/projects/not-yet/.venv/bin/agora-gateway
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
