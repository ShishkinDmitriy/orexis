[Unit]
Description=Agora infra (InfluxDB, Fuseki, Grafana) via podman compose
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/dimonina/projects/not-yet
ExecStart=/usr/bin/podman compose up -d
ExecStop=/usr/bin/podman compose down
TimeoutStartSec=300

[Install]
WantedBy=default.target
